     <p class=MsoNormal><span style='font-size:12.0pt;line-height:115%;
     font-family:"Courier New";color:black'>procedure junk;</span></p>
     </div>
     <![if !mso]></td>
    </tr>
   </table>
   <![endif]></v:textbox>
 </v:rect><v:rect id="_x0000_s1128" style='position:absolute;left:704;top:1161;
