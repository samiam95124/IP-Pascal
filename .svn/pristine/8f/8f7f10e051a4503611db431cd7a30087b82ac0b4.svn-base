     font-family:"Arial","sans-serif";color:black'>7</span></b></p>
     </div>
     <![if !mso]></td>
    </tr>
   </table>
   <![endif]></v:textbox>
 </v:rect><v:rect id="_x0000_s1165" style='position:absolute;left:1810;top:-149;
  width:5920;height:1991;v-text-anchor:middle' filled="f" stroked="f">
  <v:textbox style='mso-next-textbox:#_x0000_s1165' inset="0,0,0,0">
   <![if !mso]>
   <table cellpadding=0 cellspacing=0 width="100%">
    <tr>
     <td><![endif]>
     <div>
     <p class=MsoNormal align=center style='text-align:center'><b><span
     style='font-size:23.0pt;line-height:115%;font-family:"Arial","sans-serif";
     color:black'>Chapter Seven<o:p></o:p></span></b></p>
     <p class=MsoNormal align=center style='text-align:center'><b><span
     style='font-size:23.0pt;line-height:115%;font-family:"Arial","sans-serif";
     color:black'>Extention Library</span></b></p>
     </div>
     <![if !mso]></td>
    </tr>
   </table>
   <![endif]></v:textbox>
 </v:rect><w:wrap type="none"/>
 <w:anchorlock/>
