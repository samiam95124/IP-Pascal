  <v:textbox inset="0,0,0,0">
   <![if !mso]>
   <table cellpadding=0 cellspacing=0 width="100%">
    <tr>
     <td><![endif]>
     <div>
     <p class=MsoNormal><span style='font-size:12.0pt;line-height:115%;
     font-family:"Courier New";color:black'>overload procedure junk(i: integer);</span></p>
     </div>
     <![if !mso]></td>
    </tr>
   </table>
   <![endif]></v:textbox>
 </v:rect><v:rect id="_x0000_s1131" style='position:absolute;left:724;top:1905;
  width:5430;height:267' filled="f" strokeweight="44e-5mm">
