@echo off
rem
rem Create an internal release
rem
rem Creates an internal with "no cdrom only" flags, no time limit, and the demo
rem flag on. This is used to create the version we use here. Because internal
rem versions have build numbers that are uncoordinated (not "rolled", or having
rem all component programs brought up to the same number) we use the "wildcard"
rem build number rem "99". This does not mean there will never be versions less
rem than this, since build change releases are possible.
rem
rem The demo flag has nothing to do with the functionality of the software, it
rem just causes the registration to be skipped.
rem
createrel/ncdromonly/version=1.12.99
