typedef struct {

   char a;
   char b;
   char c;
   char d;

} b;

 typedef struct {

   char c;
   b d;
   char e;

} f;

f g;

main () {

    printf("sizeof(b):  %d\n", sizeof(b));
    printf("addr g.c:   %p\n", &g.c);
    printf("addr g.d.a: %p\n", &g.d.a);
    printf("addr g.e:   %p\n", &g.e);

}
