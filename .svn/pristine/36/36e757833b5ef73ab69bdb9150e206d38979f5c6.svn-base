module winsup;

uses stddef;

{ get windows error string }

procedure geterr(e: integer; var p: pstring);

{ copy string }

procedure copy(var  d: pstring; view s: string);

begin

   new(d, max(s)); { create destination }
   d^ := s { copy string }

end;

begin

   case e of { error }

