{ write windows error }

procedure writerr(var f: text; e: integer);

var p: pstring;

begin

   geterr(e, p); { get the corresponding error string }
   write(f, p^); { write that }
   dispose(p) { release it }
                   
end;               
                   
begin              
end.               
