type {*************************************************************************}

WORD      = 0..65535;         { windows word }
BOOL      = integer;          { windows boolean }
DWORD     = integer;          { windows double word }
WCHAR     = 0..65535;         { windows unicode character }
CHAR      = char;             { windows ascii character }
SHORT     = -32767..32767;    { windows short }
long      = integer;          { windows long }
int       = integer;          { windows int }
UINT      = integer;          { windows unsigned integer }
INT_PTR   = integer;          { windows integer/pointer }
HANDLE    = integer;          { windows file handle }
LPSTR     = ^char;            { character pointer }
LPCSTR    = ^char;            { character pointer }
BYTE      = byte;             { byte }
LPBYTE    = bytptr;           { pointer to byte }
intarr    = array of integer; { general integer array }
hbitmap   = integer;          { handle to bitmap }
hdc       = integer;          { handke to device context }    
hgdiobj   = integer;          { handle to gdi object }
hbrush    = integer;          { handle to brush }
colorref  = integer;          { color number }
hpen      = integer;          { handle to pen }
hwnd      = integer;          { handle to window }
lparam    = integer;          { void pointer }
hfont     = integer;          { handle to font }
ulong_ptr = dword;         { unsigned long that can also be pointer }
hinstance = integer;          { handle to instance }
hmenu     = integer;          { handle for menu }
lpvoid    = integer;
LPTSTR    = LPSTR;
lpctstr   = lpstr;
lpfrhookproc = ^c_lang_function;
lpcfhookproc = ^c_lang_function;
tchar     = char;

{ Open ended character arrays and arrays of arrays. These are used to
  directly emulate C types. }

chrarr    = array [0..maxint] of char;
chrptr    = ^chrarr;
chrptrarr = array [0..maxint] of chrptr;
chrptrptr = ^chrptrarr;

filetime = record

   lowdatetime:  integer; { low date/time }
   highdatetime: integer; { high date/time }

end;

win32_find_dataa = record

   fileattributes:    integer;     { attrbutes on file }
   creationtime:      filetime; { creation time of file }
   lastaccesstime:    filetime; { last access time }
   lastwritetime:     filetime; { last write time }
   filesizehigh:      integer;     { file size high }
   filesizelow:       integer;     { file size low }
   reserved0:         integer;     { reserved for undocumented features }
   reserved1:         integer;
   filename:          packed array [1..max_path] of char; { filename }
   alternatefilename: packed array [1..14] of char; { alternate filename }

end;

systemtime = packed record

   year:         word; { year }
   month:        word; { month (1..12) }
   dayofweek:    word; { day of week (0..6, sun = 0) }
   day:          word; { day of month (1..31) }
   hour:         word; { hour (0..23) }
   minute:       word; { minute (0..59) }
   second:       word; { second (0..59) }
   milliseconds: word  { milliseconds }

end;

{ time zone information record }

time_zone_information = record

   bias:         integer; { adjustment to UTC in minutes }
   standardname: packed array [1..32] of word; { name of standard time zone }
   standarddate: systemtime; { time of daylight to standard time change }
   standardbias: integer; { standard adjustment to bias in minutes }
   daylightname: packed array [1..32] of word; { name of daylight time zone }
   daylightdate: systemtime; { time of standard to daylight time change }
   daylightbias: integer { daylight adjustment to bias in minutes }

end;

{ windows class record }

wndclassa = record

   style:      integer;
   WndProc:    integer; { routine pointer }
   ClsExtra:   integer;
   WndExtra:   integer;
   Instance:   integer;
   Icon:       integer;
   Cursor:     integer;
   Background: integer;
   MenuName:   pstring;
   ClassName:  pstring

end;
wndclass = wndclassa;

{ point structure }

point = record

   x: integer;
   y: integer

end;

point_arr = array of point;

{ Message structure }

msg = record

   hwnd:    integer;
   message: integer;
   wParam:  integer;
   lParam:  integer;
   time:    integer;
   pt:      point

end;

{ rectangle }

rect = record

   left:   integer;
   top:    integer;
   right:  integer;
   bottom: integer

end;


{ paint structure }

paint = record

   hdc:       integer; { device context handle }
   erase:     integer; { 32 bit boolean }
   paint:     rect;
   restore:   integer; { 32 bit boolean }
   incupdate: integer; { 32 bit boolean }
   reserved:  array [1..32] of byte

end;

{  Logical Brush (or Pattern) }

logbrush = record

    lbStyle: uint;
    lbColor: colorref;
    lbHatch: long
              
end;

{ text metrics record }

textmetric = record

   tmHeight:           integer;
   tmAscent:           integer;
   tmDescent:          integer;
   tmInternalLeading:  integer;
   tmExternalLeading:  integer;
   tmAveCharWidth:     integer;
   tmMaxCharWidth:     integer;
   tmWeight:           integer;
   tmOverhang:         integer;
   tmDigitizedAspectX: integer;
   tmDigitizedAspectY: integer;
   tmFirstChar:        byte;
   tmLastChar:         byte;
   tmDefaultChar:      byte;
   tmBreakChar:        byte;
   tmItalic:           byte;
   tmUnderlined:       byte;
   tmStruckOut:        byte;
   tmPitchAndFamily:   byte;
   tmCharSet:          byte

end;

panose = record

   bFamilyType: BYTE;
   bSerifStyle: BYTE;
   bWeight: BYTE;
   bProportion: BYTE;
   bContrast: BYTE;
   bStrokeVariation: BYTE;
   bArmStyle: BYTE;
   bLetterform: BYTE;
   bMidline: BYTE;
   bXHeight: BYTE;

end;

outlinetextmetric = record

   otmSize: UINT;
   otmTextMetrics: TEXTMETRIC;
   otmFiller: BYTE;
   otmPanoseNumber: PANOSE;
   otmfsSelection: UINT;
   otmfsType: UINT;
   otmsCharSlopeRise: c_lang_int;
   otmsCharSlopeRun: c_lang_int;
   otmItalicAngle: c_lang_int;
   otmEMSquare: UINT;
   otmAscent: c_lang_int;
   otmDescent: c_lang_int;
   otmLineGap: UINT;
   otmsCapEmHeight: UINT;
   otmsXHeight: UINT;
   otmrcFontBox: RECT;
   otmMacAscent: c_lang_int;
   otmMacDescent: c_lang_int;
   otmMacLineGap: UINT;
   otmusMinimumPPEM: UINT;
   otmptSubscriptSize: POINT;
   otmptSubscriptOffset: POINT;
   otmptSuperscriptSize: POINT;
   otmptSuperscriptOffset: POINT;
   otmsStrikeoutSize: UINT;
   otmsStrikeoutPosition: c_lang_int;
   otmsUnderscoreSize: c_lang_int;
   otmsUnderscorePosition: c_lang_int;
   otmpFamilyName: integer;
   otmpFaceName: integer;
   otmpStyleName: integer;
   otmpFullName: integer;
   { a trick is done with this structure, the strings above are placed after the
     structure according to a passed length. so we provide a padding area for
     those strings to retrive them in type safety }
   name: packed array [1..256] of char

end;

const outlinetextmetric_len = 145+10+53+256;

type

logfont = record

    lfHeight: long;
    lfWidth: long;
    lfEscapement: long;
    lfOrientation: long;
    lfWeight: long;
    lfItalic: byte;
    lfUnderline: byte;
    lfStrikeOut: byte;
    lfCharSet: byte;
    lfOutPrecision: byte;
    lfClipPrecision: byte;
    lfQuality: byte;
    lfPitchAndFamily: byte;
    lfFaceName: packed array [1..LF_FACESIZE] of char;

end;

lplogfont = ^logfont;

evsptr = ^evsrec;
evsrec = record

   str: pstring;
   next: evsptr

end;

{ startup info record }

STARTUPINFOA = record

    cb:              DWORD;
    lpReserved:      LPSTR;
    lpDesktop:       LPSTR;
    lpTitle:         LPSTR;
    dwX:             DWORD;
    dwY:             DWORD;
    dwXSize:         DWORD;
    dwYSize:         DWORD;
    dwXCountChars:   DWORD;
    dwYCountChars:   DWORD;
    dwFillAttribute: DWORD;
    dwFlags:         DWORD;
    wShowWindow:     WORD;
    cbReserved2:     WORD;
    lpReserved2:     LPBYTE;
    hStdInput:       HANDLE;
    hStdOutput:      HANDLE;
    hStdError:       HANDLE;

end;

LPSTARTUPINFOA = ^STARTUPINFOA;

PROCESS_INFORMATION = record

    hProcess:    HANDLE;
    hThread:     HANDLE;
    dwProcessId: DWORD;
    dwThreadId:  DWORD;

end;

PPROCESS_INFORMATION = ^PROCESS_INFORMATION;
LPPROCESS_INFORMATION = ^PROCESS_INFORMATION;

enumlogfontex = record

    elfLogFont: logfont;
    elfFullName: packed array [1..LF_FULLFACESIZE] of char;
    elfStyle: packed array [1..LF_FACESIZE] of char;
    elfScript: packed array [1..LF_FACESIZE] of char;

end;

newtextmetric = record

    tmHeight: long;
    tmAscent: long;
    tmDescent: long;
    tmInternalLeading: long;
    tmExternalLeading: long;
    tmAveCharWidth: long;
    tmMaxCharWidth: long;
    tmWeight: long;
    tmOverhang: long;
    tmDigitizedAspectX: long;
    tmDigitizedAspectY: long;
    tmFirstChar: byte;
    tmLastChar: byte;
    tmDefaultChar: byte;
    tmBreakChar: byte;
    tmItalic: byte;
    tmUnderlined: byte;
    tmStruckOut: byte;
    tmPitchAndFamily: byte;
    tmCharSet: byte;
    ntmFlags: dword;
    ntmSizeEM: uint;
    ntmCellHeight: uint;
    ntmAvgWidth: uint;

end;

fontsignature = record

    fsUsb: array [0..4-1] of dword;
    fsCsb: array [0..2-1] of dword

end;

newtextmetricex = record

    ntmTm: newtextmetric;
    ntmFontSig: fontsignature

end;

abc = record

   abca: c_lang_int;
   abcb: uint;
   abcc: c_lang_int

end;

abcs = array [0..255] of abc;

glyphmetrics = record

   gmBlackBoxX: uint;
   gmBlackBoxY: uint;
   gmptGlyphOrigin: point;
   gmCellIncX: short;
   gmCellIncY: short

end;

fixed = record

   fract: word;
   value: short;

end;

mat2 = record

   eM11: fixed;
   eM12: fixed;
   eM21: fixed;
   eM22: fixed

end;

size = record

   cx: long;
   cy: long

end;

list_entry = record

    flink: ^list_entry;
    blink: ^list_entry

end;

critical_section_debug = record

    Typeof: word;
    CreatorBackTraceIndex: word;
