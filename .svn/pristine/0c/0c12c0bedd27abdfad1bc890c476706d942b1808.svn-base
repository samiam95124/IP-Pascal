{***************************** WINCON.H ***************************************}

const

RIGHT_ALT_PRESSED  = $0001; 
LEFT_ALT_PRESSED   = $0002; 
RIGHT_CTRL_PRESSED = $0004; 
LEFT_CTRL_PRESSED  = $0008; 
SHIFT_PRESSED      = $0010; 
NUMLOCK_ON         = $0020; 
SCROLLLOCK_ON      = $0040; 
CAPSLOCK_ON        = $0080; 
ENHANCED_KEY       = $0100; 

FROM_LEFT_1ST_BUTTON_PRESSED = $0001;
RIGHTMOST_BUTTON_PRESSED     = $0002;
FROM_LEFT_2ND_BUTTON_PRESSED = $0004;
FROM_LEFT_3RD_BUTTON_PRESSED = $0008;
FROM_LEFT_4TH_BUTTON_PRESSED = $0010;

MOUSE_MOVED  = $0001;
DOUBLE_CLICK = $0002;

KEY_EVENT             = $0001;
MOUSE_EVENT           = $0002;
WINDOW_BUFFER_S_EVENT = $0004;
MENU_EVENT            = $0008;
FOCUS_EVENT           = $0010;

FOREGROUND_BLUE      = $0001;
FOREGROUND_GREEN     = $0002;
FOREGROUND_RED       = $0004;
FOREGROUND_INTENSITY = $0008;
BACKGROUND_BLUE      = $0010;
BACKGROUND_GREEN     = $0020;
BACKGROUND_RED       = $0040;
BACKGROUND_INTENSITY = $0080;

CTRL_C_EVENT        = 0;
CTRL_BREAK_EVENT    = 1;
CTRL_CLOSE_EVENT    = 2;
CTRL_LOGOFF_EVENT   = 5;
CTRL_SHUTDOWN_EVENT = 6;

ENABLE_PROCESSED_INPUT = $0001;
ENABLE_LINE_INPUT      = $0002;
ENABLE_ECHO_INPUT      = $0004;
ENABLE_WINDOW_INPUT    = $0008;
ENABLE_MOUSE_INPUT     = $0010;

ENABLE_PROCESSED_OUTPUT   = $0001;
ENABLE_WRAP_AT_EOL_OUTPUT = $0002;

CONSOLE_TEXTMODE_BUFFER = 1;

type 

COORD = record

   x: SHORT;
   y: SHORT;

end;
pcoord = integer; { packed COORD }

small_rect = record

   left:   short;
   top:    short;
   right:  short;
   bottom: short

end;

chrtyp = (unichr, ascchr); 
sinchr = record

   case chrtyp of

      unichr: (UnicodeChar: WCHAR);
      ascchr: (AsciiChar:   CHAR);

end;
KEY_EVENT_RECORD = record

   space1:            WORD; { spacer }
   bKeyDown:          BOOL;
   wRepeatCount:      WORD;
   wVirtualKeyCode:   WORD;
   wVirtualScanCode:  WORD;
   uChar:             sinchr;
   dwControlKeyState: DWORD;
   
end;

MOUSE_EVENT_RECORD = record

   space1:            WORD; { spacer }
   dwMousePosition:   COORD;
   dwButtonState:     DWORD;
   dwControlKeyState: DWORD;
   dwEventFlags:      DWORD;

end;

WINDOW_BUFFER_SIZE_RECORD = record

   Size: COORD;

end;

MENU_EVENT_RECORD = record

   CommandId: UINT;

end;

FOCUS_EVENT_RECORD = record

   SetFocus: BOOL;

end;

irtype = (irtkey, irtmou, irtwbs, irtmen, irtfou);
INPUT_RECORD = record

   EventType: WORD;
   case irtype of

      irtkey: (KeyEvent:              KEY_EVENT_RECORD);
      irtmou: (MouseEvent:            MOUSE_EVENT_RECORD);
      irtwbs: (WindowBufferSizeEvent: WINDOW_BUFFER_SIZE_RECORD);
      irtmen: (MenuEvent:             MENU_EVENT_RECORD);
      irtfou: (FocusEvent:            FOCUS_EVENT_RECORD);

   { end }

end;
input_record_arr = array of input_record;

char_info = record

   asciichar: char;
   pad: byte;
   attributes: word

end;

console_screen_buffer_info = record

   dwsize:             coord;
   dwcursorposition:   coord;
   wattributes:        word;
   srwindow:           small_rect;
   dwmaximmwindowsize: coord

end;

console_cursor_info = record

   dwsize: dword;
   bvisible: bool

end;

