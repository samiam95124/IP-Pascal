      eovrscls:     write(f, 'Override method to same class as virtual method');
      eovrcdup:     write(f, 'Override already exists in this class');
      eovrnic:      write(f, 'No override exists in current class');
      evarmbrr:     write(f, 'Variable access must be record or reference');
