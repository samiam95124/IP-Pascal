      edircls:      write(f, 'Must access class member via reference');
      etoexp:       write(f, '''to'' expected');
      ercrftex:     write(f, 'Record or reference type expected');
      ensmtc:       write(f, 'No such member ''', s:0, ''' this class');
      enacmem:      write(f, '''', s:0, ''' not a member of any class');
