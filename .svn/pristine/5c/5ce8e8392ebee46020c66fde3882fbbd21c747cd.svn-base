      eclsgbl:      write(f, 'Class must be declared in global module');
      eovlnpf:      write(f, 'Overload must be to procedure or function');
      eovrnpf:      write(f, 'Override must be to procedure or function');
      embpor:       write(f, 'Parameter must be pointer or reference');
      einhuse:      write(f, 'Cannot access inherited method here');
