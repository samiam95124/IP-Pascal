{******************************************************************************
*                                                                             *
*                             VO DISK IMAGE CREATOR                           *
*                                                                             *
*                        COPYRIGHT (C) 2007 S. A. MOORE                       *
*                                                                             *
* Creates volume images for VO in the progressive indexed format. Can create  *
* an entire volume including the boot block, and any number of root files.    *
* This is used to create initial discs for VO, including simulation disk      *
* images.                                                                     *
*                                                                             *
* Takes a script control file of the following format:                        *
*                                                                             *
* ! comment                                                                   *
*                                                                             *
* Creates a comment. Can be placed on any line alone or after a command.      *
* Ignores the rest of the line.                                               *
*                                                                             *
* volsize <size>                                                              *
*                                                                             *
* Defines the size of the volume to be created.                               *
*                                                                             *
* bootsize <block>                                                            *
*                                                                             *
* Gives the offset of the directory prime block. Defaults to 1.               *
*                                                                             *
* bootfile <file>                                                             *
*                                                                             *
* Gives the bootstrap file. This must fit within the number of blocks defined *
* by bootsize. This defaults to no boot block, which means that the boot      *
* block is filled with zeros. Alternatively, if the volume is not to be       *
* bootable, a specific filler block or a stub booter can be created, such     *
* that an error is output.                                                    *
*                                                                             *
* blocksize <length>                                                          *
*                                                                             *
* Gives the size of blocks on the target volume.                              *
*                                                                             *
* reverseindex                                                                *
*                                                                             *
* Reverses the index under file order so that the index appears after the     *
* file. Normally the index for the file appears before it. This is optimal    *
* access/caching speed, so that the index can be loaded into a cache before   *
* the file data that is to be accessed. However, if the file is placed first, *
* the boot file naturally has the characteristic that it is linear and can be *
* found easily by skipping the directory block and using the simple length    *
* of the file to load it (assuming a fixed length prime directory). This      *
* option can greatly simplify booting for systems that have trouble fitting   *
* into a single boot block.                                                   *
*                                                                             *
* rootfile <file>                                                             *
*                                                                             *
* Places a file into the root directory, in the order given. Any number of    *
* root files can be specified.                                                *
*                                                                             *
* systemfile <file>                                                           *
*                                                                             *
* Places a file into the "boot" file in the root directory. This is the       *
* second level bootstrap, and usually contains the entire system to be        *
* booted. The name of the file will be changed to whatever is given. Note     *
* that the default name for the boot file is simply "boot". The bootstrap     *
* file is not to be confused with the first level bootstrap above.            *
* Note that the default is to create an entry called "boot" that has no       *
* length, which effectively disables second level bootstrapping.              *
*                                                                             *
* fillvolume                                                                  *
*                                                                             *
* Fills the unallocated space on a volume image with zeros. After all of the  *
* files, freespace and other data is placed in the volume, the rest of the    *
* indicated space will be filled out with zero. The default is to end the     *
* volume after the required data has been placed on the volume. It can be     *
* impractical to completely fill out a very large volume, say, gigabytes.     *
* But it may make sense, and even be required, for smaller volumes. Note that *
* many systems can take partial volumes, including the Bochs simulator.       *
*                                                                             *
* outputfile <file>                                                           *
*                                                                             *
* Sets the output filename. The default is "volume.img".                      *
*                                                                             *
* Right now, everything is 32 bit limited, and file times are simply zeroed   *
* out.                                                                        *
*                                                                             *
* The creation script is loaded from the file image.fmt                       *
*                                                                             *
* Need to do:                                                                 *
*                                                                             *
* Possible features:                                                          *
*                                                                             *
* 1. Subdirectories. Use of subdirectories might be useful in creating a      *
* fully featured release disk, for example.                                   *
*                                                                             *
******************************************************************************}

program creatimg(output);

uses stddef, { standard definitions }
     strlib, { string library }
     parlib; { parsing }

const linmax = 250; { size of parsing line }
      filmax = 250; { size of filename }
      labmax = 40;  { size of command label }

type filnam = packed array filmax of char; { name for file }
     labl   = packed array labmax of char; { command label }
     ptrfil = ^filety; { file entry pointer }
     filety = record

         next: ptrfil;  { next entry }
         name: filnam;  { filename }
         inx:  integer; { prime index for this file }
         len:  integer; { length of file in bytes }
         blk:  integer; { length of file in blocks }
         ihd:  integer; { index overhead }
         lvl:  integer; { index level }
         sys:  boolean; { this is a system entry, not an actual file }

     end;

var fmthan: parhan;  { handle for format file parsing }
    cmd:    labl;    { command word }
    err:    boolean; { error holder }
    valfch: chrset;  { valid file characters }

    { volume parameters }
    volsize:   integer; { total size of volume }
    bootsize:  integer; { size of boot block }
    blocksize: integer; { size of block }
    bootname:  filnam;  { filename of boot block }
    rootlist:  ptrfil;  { list of root files }
    rootlast:  ptrfil;  { end of root file list }
    fp:        ptrfil;  { pointer for files list }
    blktot:    integer; { total blocks in volume }
    inxsiz:    integer; { number of bytes in an index }
    blkinx:    integer; { number of indexes that fit in a block }
    maxlvl:    integer; { maximum indexing level }
    dirmin:    integer; { minimum size of directory }
    inxohd:    integer; { indexing overhead }
    botfil:    bytfil;  { bootstrap file }
    volfil:    bytfil;  { resulting volume file }
    rotfil:    bytfil;  { root image file }
    numroot:   integer; { number of files in root directory }
    namroot:   integer; { total of name characters in root files }
    totdir:    integer; { total space in root directory }
    blkdir:    integer; { number of blocks required by root directory }
    filsiz:    integer; { number of bytes in file sizes }
    filalc:    integer; { file block allocation position }
    inxalc:    integer; { index block allocation position }
    curalc:    integer; { current allocation position }
    finxrv:    boolean; { place index in reverse order (last) }
    bootdir:   ptrfil; { pointer to system bootstrap directory entry }
    selfdir:   ptrfil; { pointer to self directory entry }
    pardir:    ptrfil; { pointer to parent directory entry }
    freedir:   ptrfil; { pointer to freespace directory entry }
    ffilvol:   boolean; { fill the volume after allocated space }
    outnam:    filnam; { output filename }
    i, x:      integer;

{*******************************************************************************

Find whole number division

Divides a by b, but rounds up instead of rounding down, as div does.

*******************************************************************************}

function divrup(a, b: integer): integer;

var r: integer;

begin

   r := a div b;
   if a mod b <> 0 then r := r+1;

   divrup := r

end;

{*******************************************************************************

bytsiz

Find byte size of number.

*******************************************************************************}

function bytsiz(i: integer): integer;

var byt: integer;

begin

   { set size }
   if i < 256 then byt := 1
   else if i < 65536 then byt := 2
   else if i < 16777216 then byt := 3
   else byt := 4;

   bytsiz := byt { return result }

end;

{*******************************************************************************

indexover

Find index overhead for a given block length

*******************************************************************************}

function indexover(l: integer): integer;

var i, x, o: integer;

begin

   { find total index overhead for volume }
   o := 0; { clear overhead }
   { check single block, which can be direct indexed }
   if l > 1 then begin

      i := l; { set space to index }
      repeat

         x := divrup(i, blkinx); { find index blocks to represent total }
         o := o+x; { add to overhead }
         i := x; { now let's index that }

      until x <= 1

   end;

   indexover := o { return result }

end;

{*******************************************************************************

freeindexover

Find index overhead for a given block length on the free file. Finding the
index overhead on the free file is unusual in that the index space comes out of
the total free space, and thus reduces the free space, which changes the index
overhead, etc. The calculation is interactive. This is solved by relaxing the
equation. We give the algoritim n tries to converge.

*******************************************************************************}

function freeindexover(l: integer): integer;

var ihd, ihdsav: integer; { index overhead and save }
    freesp:      integer; { net freespace }
    relax:       integer; { relaxation counter }

begin

   ihd := 0; { assume to start that the index has no overhead }
   relax := 1; { clear relaxation counter }
   repeat { find index overhead based on size }

      if relax >= 100 then begin { we are stuck }

         writeln('*** Freespace calculation would not converge');
         halt

      end;
      ihdsav := ihd; { save previous value of index overhead }
      freesp := l-ihd; { find net freespace }
      ihd := indexover(freesp); { find index overhead on new allocation }
      relax := relax+1 { count relaxation cycles }
  

   until ihd = ihdsav; { we have converged }

   freeindexover := ihd { return result }

end;

{*******************************************************************************

maximumlevel

Find maximum level for a given block length

*******************************************************************************}

function maximumlevel(b: integer): integer; { length in blocks }

var i, ml: integer;
    x:     integer;

begin

   { find indexing level }
   ml := 0;
   if b > 1 then begin 

      { level zero would be one block on the entire disk, with no indexing, 
        obviously impossible. Level 1 means the entire volume can be covered
        in a single index block, which is unlikely. }
      ml := ml+1;
      i := b;
      while i > blkinx do begin

         x := divrup(i, blkinx);
         i := x;
         ml := ml+1

      end

   end;

   maximumlevel := ml { return result }

end;

{*******************************************************************************

wrtvar

Write variable length unsigned big endian word

*******************************************************************************}

procedure wrtvar(var f: bytfil;   { file to write to }
                     v: integer;  { value to write }
                     l: integer); { length }

var i: integer;

begin

   { we can only write 32 bits in this version, so pad the rest }
   for i := 1 to l-4 do write(f, 0);
   if l >= 4 then write(f, v div 16777216 mod 256); { write high }
   if l >= 3 then write(f, v div 65536 mod 256); { write middle high }
   if l >= 2 then write(f, v div 256 mod 256); { write middle low }
   if l >= 1 then write(f, v div 1 mod 256); { write middle low }

end;

{*******************************************************************************

wrtdir

Write directory entry

*******************************************************************************}

procedure wrtdir(var f:  bytfil;     { file to write to }
                     dp: ptrfil;     { directory entry to write }
                     perm: integer); { permissions }

var l: integer; { length of filename }
    i: integer;

begin

   wrtvar(f, dp^.inx, inxsiz); { write root index }
   write(f, dp^.lvl); { write indexing level }
   wrtvar(f, dp^.len, filsiz); { write length }
   wrtvar(f, perm, 4); { write initial flags values }
   wrtvar(f, 0, 8); { write dummy creation time }
   wrtvar(f, 0, 8); { write dummy last write time }
   l := len(dp^.name); { get length of filename }
   write(f, l); { write length of name }
   { write name as Unicode, with upper 8 bits zeroed }
   for i := 1 to l do wrtvar(f, ord(dp^.name[i]), 2)

end;

{*******************************************************************************

copyfile

Copy file into target volume

*******************************************************************************}

procedure copyfile(var  s:  bytfil;   { source file, not open }
                   var  d:  bytfil;   { destination file, already open }
                   view fn: string;   { source filename }
                        l:  integer); { expected length of source file }

var b: byte; { byte holder }

begin

   assign(s, fn);
   reset(s);
   if length(s) <> l then begin

      writeln('*** File size of ', fn:0, 
              ' is not equal to the specified allocation');
      halt

   end;
   while not eof(s) do begin read(s, b); write(d, b) end;
   close(s); { close source file }

end;

{*******************************************************************************

wrtinx

Write index set to volume. Accepts the file to write to, the current index block
position on the volume, the current file position on the volume, the total
number of blocks to allocate, and the indexing level.

The index position is the block position in the volume where the index for the
file will be placed. This MUST be the same as what block we are writting to
the destination file. This position is advanced past the index that is written.

The file position is the block position in the volume where the file itself
will be placed. This is simple accounting, and we are not writing the contents
of this here. The position is advanced past the allocation.

The indexes are written in "forward order", which means that the most
significant index set is written first, followed by the next, until the "direct"
index is written, which is the set of indexes that directly index each of the
file blocks.

The algorithim works by recursion. We find the value or "power" of index blocks
at the current level, then output the index at the current level, then recurse
to write the next level, until we reach index level 1.

*******************************************************************************}

procedure wrtinx(var f:   bytfil;   { file to write to }
                 var ip:  integer;  { current index block position in volume }
                 var fp:  integer;  { current file block position in volume }
                     nb:  integer;  { number of blocks to allocate }
                     lvl: integer); { what level we are at }

var bv: integer; { number of blocks per index block at this level }
    br: integer; { blocks required at this index level }
    ir: integer; { indexes required }
    ib: integer; { indexes output for this block }
    ap: integer; { pointer to after this index }
    i:  integer;

{ finish out current block }

procedure endblock;

var x: integer;

begin

   { pad to end of block }
   for x := 1 to blocksize-ib*inxsiz do write(f, 0);
   ip := ip+1; { next block in the index }
   ib := 0 { reset index count per block }

end;

{ find indexing power at level }

function lvlblk(lvl: integer): integer;

var p: integer;

begin

   p := 0; { set no indexing at 0 }
   if lvl > 0 then begin

      p := 1; { set index one block per index }
      while lvl > 1 do begin { find index powers }

         p := p*blkinx; { multiply times indexes per block }
         lvl := lvl-1 { count off }

      end

   end;

   lvlblk := p { return result }

end;

begin

   if lvl > 0 then begin { there is an index to write }

      { find the power of an index at this level, the number of blocks it can
        index }
      bv := lvlblk(lvl);
      { first, find the number of indexes required at this level }
      ir := divrup(nb, bv);
      { now find how many blocks that takes }
      br := divrup(ir, blkinx);
      if lvl > 1 then ap := ip+br { find next index allocation after this one }
      else ap := fp; { else we are working on the file allocation }
      ib := 0; { reset indexes per block }
      for i := 1 to ir do begin { generate block indexes }

         wrtvar(f, ap, inxsiz); { write an index }
         ap := ap+1; { next block in the data (next index or data) }
         ib := ib+1; { next index }
         if ib >= blkinx then endblock { index overflow, skip to new block }

      end;
      endblock; { process any partial block }
      { go allocate the next index level }
      wrtinx(f, ip, ap, nb, lvl-1);
      { advance file position if we are at level 1 }
      if lvl = 1 then fp := ap

   end

end;

{*******************************************************************************

plcfil

Place new file entry. Accepts a filename, and adds that as a new entry at the
back of the root file list. Sets the location of the new file entry.

*******************************************************************************}

procedure plcfil(view fn: string;  { filename }
                 var  fp: ptrfil); { file entry pointer returned }

begin

   new(fp); { get a new file pointer }
   copy(fp^.name, fn); { place name }
   fp^.inx := 0; { set no index }
   fp^.len := 0; { set 0 length }
   fp^.blk := 0;
   fp^.ihd := 0; { set no indexing overhead }
   fp^.lvl := 0; { set no indexing level }
   fp^.sys := false; { set not a system entry }
   fp^.next := nil; { clear next }
   if (rootlast = nil) then rootlist := fp { set as first entry }
   else rootlast^.next := fp; { set as next }
   rootlast := fp; { set next }
   numroot := numroot+1; { count files in root }
   namroot := namroot+len(fp^.name) { count total name characters }

end;
   
{*******************************************************************************

parfmt

Parse format file

*******************************************************************************}

procedure parfmt(view fmtnam: string);

label nextline; { go to next line }

var fp: ptrfil; { pointer for files list }
    fn: filnam; { filename }

procedure fmterr(view es: string);

begin

   prterr(fmthan, output, es, true); { print error }
   getlin(fmthan); { skip to new line }
   goto nextline

end;

begin

   openpar(fmthan); { open parser }
   filchr(valfch); { get the filename valid characters }
   valfch := valfch-['=']; { remove parsing characters }
   setfch(fmthan, valfch); { set that for active parsing }

   openfil(fmthan, fmtnam, linmax); { open file to parse }
   nextline: { start new line }

   while not endfil(fmthan) do begin { process instructions }
   
      skpspc(fmthan); { skip leading spaces }
      if chkchr(fmthan) = '!' then { skip comment line }
         while not endlin(fmthan) do getchr(fmthan)
      else if not endlin(fmthan) then begin { command line }

         parlab(fmthan, cmd, err); { get command word }
         if err then fmterr('Invalid command');
         if compp(cmd, 'volsize') then begin

            { set total volume size }
            parnum(fmthan, volsize, 10, err);
            if err then fmterr('Invalid volume size')

         end else if compp(cmd, 'bootsize') then begin

            { set boot block size }
            parnum(fmthan, bootsize, 10, err);
            if err then fmterr('Invalid boot size')

         end else if compp(cmd, 'bootfile') then begin

            { set file to read bootblock from }
            parfil(fmthan, bootname, false, err);
            if err then fmterr('Invalid bootblock file name')

         end else if compp(cmd, 'blocksize') then begin

            { set block size }
            parnum(fmthan, blocksize, 10, err);
            if err then fmterr('Invalid boot size')

         end else if compp(cmd, 'rootfile') then begin

            { set a rootfile list }
            parfil(fmthan, fn, false, err);
            if err then fmterr('Invalid root file name');
            plcfil(fn, fp) { place }

         end else if compp(cmd, 'systemfile') then begin

            { set a rootfile list }
            parfil(fmthan, fn, false, err);
            if err then fmterr('Invalid system file name');
            { remove old name from count }
            namroot := namroot-len(bootdir^.name);
            copy(bootdir^.name, fn); { copy filename over the default }
            namroot := namroot+len(bootdir^.name); { add new name to count }
            bootdir^.sys := false { set not a system entry }

         end else if compp(cmd, 'outputfile') then begin

            { set a rootfile list }
            parfil(fmthan, outnam, false, err);
            if err then fmterr('Invalid output file name')

         end else if compp(cmd, 'reverseindex') then 
            { set indexes over files in the allocation }
            finxrv := true 
         else if compp(cmd, 'fillvolume') then ffilvol := true { fill volume }
         else fmterr('No such instruction');
         skpspc(fmthan); { skip trailing spaces }
         if chkchr(fmthan) = '!' then { skip comment line }
            while not endlin(fmthan) do getchr(fmthan);
         if not endlin(fmthan) then fmterr('Invalid command')
         
      end;
      getlin(fmthan) { skip to new line }

   end;
   closefil(fmthan); { close the format file }
   closepar(fmthan); { close the parser instance }

end;

{*******************************************************************************

Main program

*******************************************************************************}

begin

   { initalize volume defaults }
   volsize := 0; { volume size not set }
   bootsize := 1; { single boot block }
   blocksize := 0; { block size not set }
   clears(bootname); { set no boot block file } 
   rootlist := nil; { clear root file list }
   rootlast := nil;
   numroot := 0; { clear number of files in root list }
   namroot := 0; { clear total name characters in root list }
   finxrv := false; { allocate indexes before files }
   ffilvol := false; { do not fill out volume with blanks }
   copy(outnam, 'volume.img'); { set default output filename }

   { place root system files }
   plcfil('boot', fp); { place bootstrap file }
   bootdir := fp; { set pointer to that }
   fp^.sys := true; { set is a system entry }
   plcfil('.', fp); { place '.' self directory pointer }
   selfdir := fp; { set pointer to that }
   fp^.sys := true; { set is a system entry }
   plcfil('..', fp); { place '..' parent directory pointer }
   pardir := fp; { set pointer to that }
   fp^.sys := true; { set is a system entry }
   plcfil('freespace', fp);
   freedir := fp; { set pointer to that }
   fp^.sys := true; { set is a system entry }

   parfmt('image.fmt'); { parse default file }

   { validate parameters requested }
   if volsize = 0 then begin

      writeln('*** Output volume size must be set');
      halt

   end;
   if blocksize = 0 then begin

      writeln('*** Output block size must be set');
      halt

   end;

   blktot := volsize div blocksize; { find total blocks on disk }
   inxsiz := bytsiz(blktot-1); { find index size }

   { find indexes per block }
   blkinx := divrup(blocksize, inxsiz);

   { find indexing level }
   maxlvl := maximumlevel(blktot);

   { find bytes in file size }
   filsiz := bytsiz(volsize);

   { find directory entry size }
   dirmin := inxsiz+1+filsiz+4+8+8+1; { index+level+size+flags+timc+timm+nlen }

   { find total index overhead for volume }
   inxohd := indexover(blktot);

   { find total space in root directory }
   totdir := numroot*dirmin+namroot*2;

   { find number of blocks needed for root directory }
   blkdir := divrup(totdir, blocksize);

   { start allocations by setting up the start of free space after 1st level 
     boot }
   filalc := bootsize;

   { perform system file accounting }
   selfdir^.len := blkdir*blocksize; { set length of root directory }
   selfdir^.blk := blkdir; { set blocks in root directory }
   selfdir^.ihd := indexover(selfdir^.blk); { find index overhead }
   selfdir^.lvl := maximumlevel(selfdir^.blk); { find maximum level }
   selfdir^.inx := filalc; { place prime index for file }
   { skip index and file to arrive at next allocation }
   filalc := filalc+selfdir^.ihd+selfdir^.blk;
   { copy self to parent, since root is it's own parent }
   pardir^.len := selfdir^.len; { set length of root directory }
   pardir^.blk := selfdir^.blk; { set blocks in root directory }
   pardir^.ihd := selfdir^.ihd; { find index overhead }
   pardir^.lvl := selfdir^.lvl; { find maximum level }
   pardir^.inx := selfdir^.inx; { place prime index for file }

   { find the lengths and index overheads for each of the root files, and 
     establish each files prime index }
   fp := rootlist; { index top of list }
   while fp <> nil do begin { traverse the root file list }

      if not fp^.sys then begin { not a system special file }

         assign(rotfil, fp^.name); { open this file }
         reset(rotfil);
         fp^.len := length(rotfil); { find the length of the file }
         close(rotfil); { close it again }
         fp^.blk := divrup(fp^.len, blocksize); { find length in blocks }
         fp^.ihd := indexover(fp^.blk); { find index overhead }
         fp^.lvl := maximumlevel(fp^.blk); { find maximum level }
         { place prime index for file }
         if finxrv then fp^.inx := filalc+fp^.blk { file, then index }
         else fp^.inx := filalc; { index, then file }
         { skip index and file to arrive at next allocation }
         filalc := filalc+fp^.ihd+fp^.blk;

      end;
      fp := fp^.next { next file in list } 

   end;

   { find the parameters of the freespace file }
   freedir^.blk := blktot-filalc; { set total block allocation }
   freedir^.len := freedir^.blk*blocksize; { set total size in bytes }
   freedir^.ihd := freeindexover(freedir^.blk); { find index overhead for that }
   freedir^.lvl := maximumlevel(freedir^.blk-freedir^.lvl); { find level }
   freedir^.inx := filalc; { place freespace index at end of allocation }

   { check if the total allocated space is greater than the space on the 
     volume }
   if filalc > blktot then begin

      writeln;
      writeln('*** Allocated space on volume of ', filalc*blocksize:1, 
              ' exceeds its size of ', blktot*blocksize:1);
      writeln('*** Halting');
      writeln;
      halt

   end;

   { print statistics }
   writeln;
   writeln('Target volume will be created in ', outnam:0);
   writeln;
   writeln('Volume size in bytes:                          ', volsize:1);
   writeln('Block size in bytes:                           ', blocksize:1);
   writeln('Total blocks in volume:                        ', blktot:1);
   writeln('Number of boot blocks:                         ', bootsize:1);
   writeln('Index size in bytes:                           ', inxsiz:1);
   writeln('Number of indexes per block:                   ', blkinx:1);
   writeln('Maximum number of levels required:             ', maxlvl:1);
   writeln('Size of file sizes in bytes:                   ', filsiz:1);
   writeln('Minimum size of directory entry:               ', dirmin:1);
   writeln('Maximum size of directory entry:               ', dirmin+255*2:1);
   writeln('Maximum number of directory entries per block: ', dirmin:1);
   writeln('Index overhead:                                %', inxohd*100/blktot:1:3);
   writeln('Number of files to place in root directory:    ', numroot:1);
   writeln('Total space in root directory entries:         ', totdir:1);
   writeln('Number of blocks occupied by root directory:   ', blkdir:1);
   writeln('Total occupied space on volume in bytes:       ', 
           filalc*blocksize:1);
   writeln('Total occupied space on volume in blocks:      ', 
           filalc:1);
   writeln('Free space on volume in bytes:                 ', 
           freedir^.blk*blocksize:1);
   writeln('Free space on volume in blocks:                ', 
           freedir^.blk:1);
   writeln;
   writeln('Boot block file:                               ', bootname:0);
   writeln;
   writeln('Root files to load (first in list is boot image):');
   writeln;
   fp := rootlist;
   while fp <> nil do begin

      writeln('File:           ', fp^.name:0);
      writeln('Length:         ', fp^.len:1);
      writeln('blocks:         ', fp^.blk:1);
      writeln('Index overhead: ', fp^.ihd:1);
      writeln('Prime index:    ', fp^.inx:1);
      writeln('Index level:    ', fp^.lvl:1);
      writeln;
      fp := fp^.next

   end;

   { open output file } 
   assign(volfil, outnam);
   rewrite(volfil);

   { copy boot file }
   copyfile(botfil, volfil, bootname, bootsize*blocksize);

   { write root directory }
   fp := rootlist;
   while fp <> nil do begin

      { permissions set as follows:
        Sys: File entry is occupied, not erased.
        Other: read (nothing else)
        Group: read (nothing else)
        User: read (nothing else) }
      wrtdir(volfil, fp, $01010101); { write directory entry }
      fp := fp^.next

   end;
   { pad to even root blocks }
   for i := 1 to blkdir*blocksize-totdir do write(volfil, 0);

   { write indexes for system files }
   curalc := bootsize+blkdir; { index start of free space after directory }
   { root directory }
   inxalc := curalc;
   filalc := curalc+selfdir^.ihd;
   wrtinx(volfil, inxalc, filalc, selfdir^.blk, selfdir^.lvl);
   curalc := filalc; { go next after file allocation }

   { write each index and file out to the volume }  
   fp := rootlist;
   curalc := bootsize+blkdir; { index start of free space after directory }
   while fp <> nil do begin

      if not fp^.sys then begin { not a system file }

         { place index on volume }
         if not finxrv then begin { allocate index then file }
      
            { set up index and file positions }
            inxalc := curalc;
            filalc := curalc+fp^.ihd;
            wrtinx(volfil, inxalc, filalc, fp^.blk, fp^.lvl);
            curalc := filalc { go next after file allocation }
      
         end else begin { allocate file then index }
      
            { set up index and file positions }
            filalc := curalc;
            inxalc := curalc+fp^.blk;
            wrtinx(volfil, inxalc, filalc, fp^.blk, fp^.lvl);
            curalc := inxalc { go next after index allocation }
      
         end;
         curalc := curalc+fp^.ihd+fp^.blk; { skip complete file allocation }
         { copy file onto volume }
         copyfile(rotfil, volfil, fp^.name, fp^.len);
         { fill last block as required }
         if fp^.len mod blocksize <> 0 then
            for i := 1 to blocksize-fp^.len mod blocksize do write(volfil, 0)

      end;
      fp := fp^.next

   end;

   { Place freespace index. We place it last, because it is very large and would
     cause the bootstrap to have to reach over it on startup. The tradeoff, of
     course, is we have to read it to start file operations on the volume. }
   inxalc := curalc;
   filalc := curalc+freedir^.ihd;
   wrtinx(volfil, inxalc, filalc, freedir^.blk, freedir^.lvl);
   curalc := filalc; { go next after file allocation }

   { clear the rest of the volume if that is selected }
   if ffilvol then begin

      writeln('Clearing the free space on the volume');
      writeln;
      while curalc < blktot do begin { fill blocks }

          for i := 1 to blocksize do write(volfil, 0); { fill }
          curalc := curalc+1 { count }

      end

   end;

   close(volfil); { close volume file }
   writeln('Function complete');

end.
