rem ****************************************************************************
rem *                                                                          *
rem *                       UPDATE WINDOWS SPECIFIC LIBRARIES                  *
rem *                                                                          *
rem ****************************************************************************

rem
rem Standard serial I/O library
rem
copy serlib.obj \ip\windows\i80386\lib\serlib.obj
copy serlib.sym \ip\windows\i80386\lib\serlib.sym
copy serlibx.obj \ip\windows\i80386\lib\serlibx.obj
copy serlibx.sym \ip\windows\i80386\lib\serlibx.sym
copy serlib.obj \ipdemo\windows\i80386\lib\serlib.obj
copy serlib.sym \ipdemo\windows\i80386\lib\serlib.sym
copy serlib.obj \iprel\windows\i80386\lib\serlib.obj
copy serlib.sym \iprel\windows\i80386\lib\serlib.sym


rem
rem Extended operating system services
rem
copy extlib.obj \ip\windows\i80386\lib\extlib.obj
copy extlib.sym \ip\windows\i80386\lib\extlib.sym
copy extlibx.obj \ip\windows\i80386\lib\extlibx.obj
copy extlibx.sym \ip\windows\i80386\lib\extlibx.sym
copy extlib.obj \ipdemo\windows\i80386\lib\extlib.obj
copy extlib.sym \ipdemo\windows\i80386\lib\extlib.sym
copy extlib.obj \iprel\windows\i80386\lib\extlib.obj
copy extlib.sym \iprel\windows\i80386\lib\extlib.sym

rem
rem The logical "trmlib" under windows is the console mode.
rem
copy conlib.obj \ip\windows\i80386\lib\trmlib.obj
copy conlib.sym \ip\windows\i80386\lib\trmlib.sym
copy conlib.obj \ipdemo\windows\i80386\lib\trmlib.obj
copy conlib.sym \ipdemo\windows\i80386\lib\trmlib.sym
copy conlib.obj \iprel\windows\i80386\lib\trmlib.obj
copy conlib.sym \iprel\windows\i80386\lib\trmlib.sym

rem
rem The original trmlib, no longer used, was an ANSI terminal control sequence
rem library. This will evolve into a general purpose termcap library.
rem
rem copy trmlib.obj \ip\windows\i80386\lib\trmlib.obj
rem copy trmlib.sym \ip\windows\i80386\lib\trmlib.sym
rem copy trmlib.obj \ipdemo\windows\i80386\lib\trmlib.obj
rem copy trmlib.sym \ipdemo\windows\i80386\lib\trmlib.sym
rem copy trmlib.obj \iprel\windows\i80386\lib\trmlib.obj
rem copy trmlib.sym \iprel\windows\i80386\lib\trmlib.sym

rem
rem Console mode version of trmlib
rem
copy conlib.obj \ip\windows\i80386\lib\conlib.obj
copy conlib.sym \ip\windows\i80386\lib\conlib.sym
copy conlib.obj \ipdemo\windows\i80386\lib\conlib.obj
copy conlib.sym \ipdemo\windows\i80386\lib\conlib.sym
copy conlib.obj \iprel\windows\i80386\lib\conlib.obj
copy conlib.sym \iprel\windows\i80386\lib\conlib.sym

rem
rem Graphics/windowing/widget library
rem
copy gralib.obj \ip\windows\i80386\lib\gralib.obj
copy gralib.sym \ip\windows\i80386\lib\gralib.sym
copy gralibx.obj \ip\windows\i80386\lib\gralibx.obj
copy gralibx.sym \ip\windows\i80386\lib\gralibx.sym
copy gralib.obj \ipdemo\windows\i80386\lib\gralib.obj
copy gralib.sym \ipdemo\windows\i80386\lib\gralib.sym
copy gralib.obj \iprel\windows\i80386\lib\gralib.obj
copy gralib.sym \iprel\windows\i80386\lib\gralib.sym

rem
rem MIDI and wave sound library
rem
copy sndlib.obj \ip\windows\i80386\lib\sndlib.obj
copy sndlib.sym \ip\windows\i80386\lib\sndlib.sym
copy sndlib.obj \ipdemo\windows\i80386\lib\sndlib.obj
copy sndlib.sym \ipdemo\windows\i80386\lib\sndlib.sym
copy sndlib.obj \iprel\windows\i80386\lib\sndlib.obj
copy sndlib.sym \iprel\windows\i80386\lib\sndlib.sym

rem
rem The Windows API
rem
copy windows.pas \ip\windows\i80386\lib

rem
rem Locking procedures (that are not already in a base library)
rem

copy reglock.obj \ip\windows\i80386\lib\reglock.obj
copy reglock.sym \ip\windows\i80386\lib\reglock.sym
copy reglockx.obj \ip\windows\i80386\lib\reglockx.obj
copy reglockx.sym \ip\windows\i80386\lib\reglockx.sym
copy timelock.obj \ip\windows\i80386\lib\timelock.obj
copy timelock.sym \ip\windows\i80386\lib\timelock.sym
copy timelockx.obj \ip\windows\i80386\lib\timelockx.obj
copy timelockx.sym \ip\windows\i80386\lib\timelockx.sym
copy blotter.obj \ip\windows\i80386\lib\blotter.obj
copy blotter.sym \ip\windows\i80386\lib\blotter.sym
