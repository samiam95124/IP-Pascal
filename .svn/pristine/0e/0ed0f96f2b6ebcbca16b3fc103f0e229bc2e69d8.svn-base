@echo off
@echo *** Normal ***
..\pparse\parse pascals=pascals/nrf/standard
encode pascals=pascals
ln runfile=c:\ip\windows\i80386\lib\serlib c:\ip\windows\i80386\lib\main pascals c:\ip\windows\i80386\lib\cap /nu
genpe pascals=runfile c:\windows\system32\kernel32 c:\windows\system32\user32 c:\windows\system32\gdi32 c:\windows\system32\winmm/v/sc
del runfile.*
pascals standards.pas > standards.out
diff standards.out standards.ref > standards.norm.dif

