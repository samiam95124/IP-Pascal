actual-parameter } ')' .</p>

<p class=MsoNormal><o:p>&nbsp;</o:p></p>

<p class=MsoNormal>adding-operator = '+' | '-' | 'or' | 'xor' .</p>

<p class=MsoNormal><o:p>&nbsp;</o:p></p>

<p class=MsoNormal>apostrophe-image = '&quot;' .</p>

<p class=MsoNormal><o:p>&nbsp;</o:p></p>

<p class=MsoNormal>array-type = 'array' [ dimension-specifier ] 'of'
component-type .</p>

<p class=MsoNormal><o:p>&nbsp;</o:p></p>

<p class=MsoNormal>array-value-constructor = 'array' value-constructor { ','
value-constructor } 'end' .</p>

<p class=MsoNormal><o:p>&nbsp;</o:p></p>

<p class=MsoNormal>array-variable = variable-access .</p>

<p class=MsoNormal><o:p>&nbsp;</o:p></p>

<p class=MsoNormal>assignment-statement = ( variable-access | function-identifier
) ':=' expression .</p>

<p class=MsoNormal><o:p>&nbsp;</o:p></p>

<p class=MsoNormal>attribute = 'overload' | 'static' | 'virtual' | 'override' <span
style='mso-spacerun:yes'> </span>| ‘operator’ .</p>

<p class=MsoNormal><o:p>&nbsp;</o:p></p>

<p class=MsoNormal>base-type = ordinal-type .</p>

<p class=MsoNormal><o:p>&nbsp;</o:p></p>

<p class=MsoNormal>binary-digit = '0' | '1' | '_' .</p>

<p class=MsoNormal><o:p>&nbsp;</o:p></p>

