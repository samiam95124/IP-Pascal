<p class=MsoNormal><o:p>&nbsp;</o:p></p>

<p class=MsoNormal>block = { declaration } [ 'private' { declaration } ]
statement-part [ ';' statement-part ] .</p>

<p class=MsoNormal><o:p>&nbsp;</o:p></p>

<p class=MsoNormal>Boolean-expression = expression .</p>

<p class=MsoNormal><o:p>&nbsp;</o:p></p>

<p class=MsoNormal>buffer-variable = file-variable '&quot;' .</p>

<p class=MsoNormal><o:p>&nbsp;</o:p></p>

