ln runfile=c:\ip\windows\i80386\lib\serlib c:\ip\windows\i80386\lib\strlib c:\ip\windows\i80386\lib\extlib c:\ip\windows\i80386\lib\trnlib c:\ip\windows\i80386\lib\main dpint c:\ip\windows\i80386\lib\cap/nu
genpe dpint=runfile/v/sc
del runfile.*
