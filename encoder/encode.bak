{******************************************************************************

List intermediate section

Lists a linear intermediate section. The indent offset is specified, which
starts with zero at the left.

******************************************************************************}

procedure lstintsec(ip: intptr; off: integer); { list to print }

begin

   while ip <> nil do begin { list }

      lstinttree(ip, off); { list this tree }
      ip := ip^.flow { next flow entry }

   end

end;

{******************************************************************************

Perform intermediate flow listing

Lists the intermediate in tree structure form.

******************************************************************************}

procedure lstint;

begin

   writeln('Tree listing');
   writeln;
   write('Intermediates for block: [');
   blknam(blkstk); { print block name }
   writeln('] ', blkstk^.lvl:1);
   if blkstk^.entry <> nil then begin

      writeln;
      writeln('Entry list:');
      writeln;
      lstintsec(blkstk^.entry, 0);
      writeln

   end;
   if blkstk^.exit <> nil then begin

      writeln;
      writeln('Exit list:');
      writeln;
      lstintsec(blkstk^.exit, 0);
      writeln

   end

end;

{******************************************************************************

List individual intermediate tree

As lstinttree, but does not need a list indent value.

******************************************************************************}

procedure lstinttre(ip: intptr);

begin

   lstinttree(ip, 0) { perform listing }

end;

{******************************************************************************

Find length of label

Finds the length of a space padded label.

******************************************************************************}

function lablen(view s: string): integer;

var l: integer; { length holder }

begin

   l := max(s); { index end of string }
   if l <> 0 then begin { not null string }

      { find the end of the string }
      while (l > 1) and (s[l] = ' ') do l := l-1;
      if s[l] = ' ' then l := 0 { set zero length case }

   end;
   lablen := l { return string length }

end;

{******************************************************************************

Check labels equal

Checks if the given labels are equal to one another, regardless of case.

******************************************************************************}

function labequ(view a, b: string): boolean;

var i:      integer; { index for labels }
    f:      boolean; { match flag }
    la, lb: integer; { lengths of strings }

begin

   f := true; { set matches }
   la := lablen(a); { find lengths }
   lb := lablen(b);
   if la <> lb then f := false { lengths don't match, set no match }
   else begin

      { check label matches }
      for i := 1 to la do if lcase(a[i]) <> lcase(b[i]) then f := false;

   end;
   labequ := f { return match status }

end;
{}
{******************************************************************************

Input variger

Inputs a variger to the given separated sign integer.
Varigers are of the following format:

   1. (byte) the tag byte.
   2-N. The variger value.

The tag byte values are:

   bit 7 - Low for integer number, high for float.
   bit 6 - Contains the sign of the integer. 
   bit 5 - Unused.
   bit 4 - Length of integer in bytes, 1-32, in -1 format.
   bit 3 -      ""              ""
   bit 2 -      ""              ""
   bit 1 -      ""              ""
   bit 0 -      ""              ""

The integer is converted by removing the sign bit and converting
to signed magnitude, then determining the byte size, then
outputting the tag and number.

******************************************************************************}

procedure rdvar(var n: ssint); { integer to input }

var t: byte;     { tag byte }
    b: byte;     { read byte holder }

begin

   read(intfil, t); { get tag byte }
   if (t and $80) <> 0 then error(einvfmt); { invalid format }
   if (t and $40) <> 0 then n.s := true else n.s := false; { set sign of value }
   if (t and $20) <> 0 then error(einvfmt); { invalid format }
   t := (t and $1f)+1; { mask byte length and adjust }
   n.v := 0; { clear result }
   while t <> 0 do begin { read in bytes of value }

      n.v := n.v*256; { scale up bytes for big endian format }
      read(intfil, b); { get the next byte }
      n.v := n.v+b; { add in }
      t := t-1 { count bytes read }

   end

end;
{}
{**************************************************************

Read real number from intermediate file

Reads a 64 bit real number to from the intermediate file.

**************************************************************}

procedure rdreal(var r: real);

var rc: record case boolean of { data convertion }

           false: (r: real);
           true:  (b: packed array [1..8] of byte)

        end;
    rcs: record case boolean of { data convertion, short real }

           false: (r: sreal);
           true:  (b: packed array [1..4] of byte)

        end;
    i:  1..8; { index for byte array }
    b:  byte;
    s: integer; { size }

begin

   read(intfil, b); { get tag byte }
   if (b and $80) = 0 then error(einvfmt); { not a float }
   s := b and $1f+1; { get size }
   if (s <> 4) and (s <> 8) then error(einvfmt); { not a size we support }
   if s = 8 then begin { standard real format }

      for i := 1 to 8 do begin { read bytes of real in }

         read(intfil, b);
         rc.b[i] := b

      end;
      r := rc.r { return real }

   end else begin { short real format }

      for i := 1 to 4 do begin { read bytes of real in }

         read(intfil, b);
         rcs.b[i] := b

      end;
      r := rcs.r { return real }

   end

end;

{******************************************************************************

Make type entry

Either recycles a free type entry, or gets a new one, initalizes and returns
that.

******************************************************************************}

procedure maktyp(var tp: typptr; { type pointer to return type }
                     t:  types); { entry type to get }

begin

   if fretyp[t] <> nil then begin { return existing entry }
  
      tp := fretyp[t]; { index top entry }
      fretyp[t] := tp^.next { gap the list }
      
   end else begin

      case t of { type }

         tudf:       new(tp, tudf);    
         tnil:       new(tp, tnil);    
         tlab:       new(tp, tlab);    
         ticst:      new(tp, ticst);   
         tscst:      new(tp, tscst);   
         tccst:      new(tp, tccst);   
         trcst:      new(tp, trcst);   
         tstcst:     new(tp, tstcst);   
         tstet:      new(tp, tstet);   
         tarrcst:    new(tp, tarrcst);
         tarrcel:    new(tp, tarrcel);
         treccst:    new(tp, treccst);
         treccel:    new(tp, treccel);
         tenum:      new(tp, tenum);   
         tenme:      new(tp, tenme);   
         tsub:       new(tp, tsub);    
         tptr:       new(tp, tptr);    
         tarray:     new(tp, tarray);  
         tgarry:     new(tp, tgarry);  
         tfile:      new(tp, tfile);   
         tset:       new(tp, tset);    
         trecord:    new(tp, trecord); 
         tfield:     new(tp, tfield);  
         tftag:      new(tp, tftag);   
         tfcas:      new(tp, tfcas);   
         tvar:       new(tp, tvar);   
         tfix:       new(tp, tfix); 
         tproc:      new(tp, tproc);   
         tfunc:      new(tp, tfunc);   
         tpar:       new(tp, tpar);    
         tvpar:      new(tp, tvpar);   
         twpar:      new(tp, twpar);   
         tpproc:     new(tp, tpproc);  
         tpfunc:     new(tp, tpfunc);  
         tinteger:   new(tp, tinteger);
         tlinteger:  new(tp, tlinteger);
         tcardinal:  new(tp, tcardinal);
         tlcardinal: new(tp, tlcardinal);
         tchar:      new(tp, tchar);   
         tboolean:   new(tp, tboolean);
         treal:      new(tp, treal);   
         tsreal:     new(tp, tsreal);  
         ttext:      new(tp, ttext);   
         teset:      new(tp, teset);   
         tglbl:      new(tp, tglbl);   
         tsemaphore: new(tp, tsemaphore);   
         tclass:     new(tp, tclass);   
         tatom:      new(tp, tatom);   
         tthread:    new(tp, tthread);   
         treference: new(tp, treference);   
         texception: new(tp, texception);   
         tnull:      new(tp, tnull);
         tfuncr:     new(tp, tfuncr);
         tlink:      new(tp, tlink);
         tcastbl:    new(tp, tcastbl);
         thshtbl:    new(tp, thshtbl);
         tcassel:    new(tp, tcassel);
         trot:       new(tp, trot);
         tpgm:       new(tp, tpgm);
         tvrs:       new(tp, tvrs);

      end;
      tp^.t := t { set type of entry }

   end;
   tp^.next := nil; { clear next }
   tp^.addr := 0; { clear others }
   tp^.local := false;
   tp^.level := blkcnt;
   tp^.blk := blkstk;
   tp^.classt := nil

end;

{******************************************************************************

Get type entry

Either recycles a free type entry, or gets a new one, and places that into the
current block list. The standard block list is maintained into incoming order,
so that the entry numbers match up.

******************************************************************************}

procedure gettyp(var tp: typptr; { type pointer to return type }
                     t:  types); { entry type to get }

begin

   maktyp(tp, t); { make a type entry }
   if blkstk^.lst <> nil then blkstk^.lst^.next := tp { insert at end }
   else blkstk^.typ := tp; { insert at beginning }
   blkstk^.lst := tp; { set new last }
   if blkstk^.res = nil then blkstk^.res := tp { if resolved empty, set new }

end;

{******************************************************************************

Get alternate type entry

Either recycles a free type entry, or gets a new one, and places that into the
alternate block list.

The alternates list is kept because we want to create occasional types
for internal purposes, and those cannot be created in the normal list, because
those types are carefully metered from the intermediate so that they can be
found. Virtually all operations are performed to both lists, so any type
of entry, including variables and locals, can be created internally.
The alternate list does not maintain entry order, since there will be no
unresolved references to entrys in it.

******************************************************************************}

procedure gettypa(var tp: typptr; { type pointer to return type }
                      t:  types); { entry type to get }

begin

   maktyp(tp, t); { make a type entry }
   if blkstk^.lsta <> nil then blkstk^.lsta^.next := tp { insert at end }
   else blkstk^.typa := tp; { insert at beginning }
   blkstk^.lsta := tp; { set new last }
   if blkstk^.resa = nil then blkstk^.resa := tp { if resolved empty, set new }

end;

{******************************************************************************

Get type entry for system block

Either recycles a free type entry, or gets a new one, and places that into the
system block list. The system block contains definitions we use in the encoder,
and some definitions need to be made there regardless of nesting level.
The alternates for system are not used, since there is no requirement for
specific ordering. So all definitions go into the standard type list.

******************************************************************************}

procedure gettypsys(var tp: typptr; { type pointer to return type }
                        t:  types); { entry type to get }

var blk: blkptr; { index for blocks }

begin

   { find system block 0 }
   blk := blkstk; { index top of block stack }
   while blk^.next <> nil do blk := blk^.next; { index next block }
   maktyp(tp, t); { make a type entry }
   if blk^.lst <> nil then blk^.lst^.next := tp { insert at end }
   else blk^.typ := tp; { insert at beginning }
   blk^.lst := tp; { set new last }
   if blk^.res = nil then blk^.res := tp { if resolved empty, set new }

end;

{******************************************************************************

Put type entry

Returns a given type entry to the free lists. Because entrys are allocated
for the exact size required for the type, there is a free list for each type,
and each entry is placed back into the indivdual list by type.

******************************************************************************}

procedure puttyp(tp: typptr); { type pointer }

begin

   tp^.next := fretyp[tp^.t]; { link to appropriate free list }
   fretyp[tp^.t] := tp

end;

{******************************************************************************

Delete type

Removes a type entry from any block list. Only the alternate lists are
searched, since it would invalidate the sequence numbers from a main list to
delete from it.

******************************************************************************}

procedure deltyp(tp: typptr); { type pointer }

var blk: blkptr; { index for blocks }
    f:   boolean; { found flag }

{ perform search/delete on list }

procedure scdlst;

var lp: typptr; { last entry }
    p:  typptr; { pointer for list }

begin

   p := blk^.typa; { index top of list }
   lp := nil; { clear last }
   while (p <> tp) and (p <> nil) do begin { traverse }

      lp := p; { set new last }
      p := p^.next { next }

   end;
   if p <> nil then begin { found }

      f := true; { set found }
      if lp = nil then blk^.typa := blk^.typa^.next { gap out at top }
      else lp^.next := p^.next; { gap out middle }
      { Now correct the last entry pointer }
      if blk^.typa = nil then blk^.lsta := nil { list is empty now }
      else begin { find end }

         tp := blk^.typa; { index top of list }
         while tp^.next <> nil do tp := tp^.next; { find end }
         blk^.lsta := tp { set }

      end
  
   end

end;
   
begin

   f := false; { set not found }
   blk := blkstk; { index top of block stack }
   while not f and (blk <> nil) do begin { search through stack }

      scdlst; { perform search/delete on alternate list }
      blk := blk^.next { link next }

   end;
   if not f then error(esysflt35) { not found, bad }

end;

{******************************************************************************

Get symbol entry

Gets a symbol. Either returns one from the free list, or allocates a new one.

******************************************************************************}

procedure getsym(var lp: labptr); { label to return }

begin

   if frelab <> nil then begin { return free label entry }

      lp := frelab; { index that }
      frelab := frelab^.next { gap the list }

   end else new(lp); { else get a new one }
   lp^.next := nil; { clear next entry }
   lp^.lab := nil; { clear label }
   lp^.typ := nil; { clear type }
   lp^.exp := false { set not exportable }

end;

{******************************************************************************

Put symbol entry

Returns the given symbol to free storage.

******************************************************************************}

procedure fresym(lp: labptr); { label to return }

begin

   lp^.next := frelab; { insert to free list }
   frelab := lp

end;

{******************************************************************************

Get symbol entry into list

Gets a symbol and places it into the current block list.

******************************************************************************}

procedure lstsym(var lp: labptr); { label to return }

begin

   getsym(lp); { get a symbol }
   lp^.next := blkstk^.sym; { insert to symbols list }
   blkstk^.sym := lp

end;

{******************************************************************************

Get intermediate entry

Either recycles a free intermediate entry, or gets a new one, initalizes and
returns that. The entry is automatically placed on the block intermediates
list.

******************************************************************************}

procedure getint(var ip: intptr;   { intermediate pointer to return }
                     i:  tintcod); { entry type to get }

begin

   if freint <> nil then begin { return existing entry }
  
      ip := freint; { index top entry }
      freint := ip^.next { gap the list }
      
   end else new(ip); { else get a new one }
   ip^.next := nil; { clear next }
   ip^.up := nil; { clear up link }
   ip^.i := i; { set type of entry }
   ip^.flow := nil; { clear flow pointer }
   ip^.flow2 := nil;
   ip^.flow3 := nil;
   ip^.left := nil; { clear operator pointers }
   ip^.right := nil;
   ip^.xtra := nil;
   ip^.xtra2 := nil;
   ip^.base := nil; { clear type pointers }
   ip^.base2 := nil;
   ip^.base3 := nil;
   ip^.rbase := nil;
   ip^.rsreg := rgnull; { clear registers }
   ip^.rsregx := rgnull;
   ip^.freg := rgnull;
   ip^.fregx := rgnull;
   ip^.lreg := rgnull;
   ip^.lregx := rgnull;
   ip^.rreg := rgnull;
   ip^.rregx := rgnull;
   ip^.xreg := rgnull;
   ip^.xregx := rgnull;
   ip^.x2reg := rgnull;
   ip^.x2regx := rgnull;
   ip^.t1reg := rgnull;
   ip^.t1regx := rgnull;
   ip^.t2reg := rgnull;
   ip^.t2regx := rgnull;
   ip^.t3reg := rgnull;
   ip^.t3regx := rgnull;
   ip^.push := []; { clear the tracking sets }
   ip^.alc := [];
   ip^.skip := false; { set no skip }
   ip^.rcxt := nil { clear stored context }

end;

{******************************************************************************

Put intermediate entry

Releases the given intermediate entry.

******************************************************************************}

procedure putint(ip: intptr); { intermediate }

begin

   ip^.next := freint; { link to appropriate free list }
   freint := ip

end;

{******************************************************************************

Put intermediate entrys

Releases all the intermediate entries from the given list.

******************************************************************************}

procedure putints(lp: intptr); { intermediates list }

var ip: intptr; { intermediate pointer }

begin

   while lp <> nil do begin { empty the list }

      ip := lp; { index entry }
      lp := lp^.next; { gap from list }
      putint(ip) { release }

   end

end;

{******************************************************************************

Find existing link

Given the level and entry numbers, finds an entry by that link. If none is
found, a nil is returned.

******************************************************************************}

procedure fndlnk(var tp: typptr;   { link to resolve }
                     l:  integer;  { level number }
                     e:  integer); { entry number }

var mc:  integer; { match number }
    tsp: blkptr;  { types stack pointer }

begin

   tsp := blkstk; { index top of stack }
   mc := blkcnt; { set match count }
   while l <> mc do begin { back up to proper level }
   
      if tsp = nil then error(einvfmt); { no corresponding block }
      tsp := tsp^.next; { go deeper in types stack }
      mc := mc-1 { count off }
   
   end;
   if tsp = nil then error(einvfmt); { no corresponding block }
   tp := tsp^.typ; { index 1st type entry at level }
   while (e <> 1) and (tp <> nil) do begin { traverse to entry }
   
      tp := tp^.next; { next entry }
      e := e-1 { count }
   
   end

end;

{******************************************************************************

Get and process link

Gets the complete intermediate address of the given type entry. The logical
address of a type entry consists of it's logical type level number, and it's
logical type entry number. This is converted to a real pointer by reaching
down to the indicated level and finding the specified entry.

******************************************************************************}

procedure getlnk(var tp: typptr);

var l: ssint; { level number }
    e: ssint; { entry number }

begin

   rdvar(l); { get level number }
   rdvar(e); { get entry number }
   { level numbers should always be positive }
   if l.s or e.s then error(einvfmt);
   if ssequ(l, false, 0) and ssequ(e, false, 0) then tp := nil { nil linkage }
   else begin

      fndlnk(tp, l.v, e.v); { find any type }
      if tp = nil then begin

         { well, we didn't find it, because it has not arrived yet (forward
           reference). so create a linkage entry for it instead }
         gettypa(tp, tlink); { get linkage entry }
         tp^.lnkl := l.v; { place level }
         tp^.lnke := e.v { place entry }

      end;

   end

end;

{******************************************************************************

Get character

Reads a character from the intermediate file. The character is read as a UCS-16
character in big endian.

Since this version is compiled for 8 bit characters, incoming characters
greater than 255 are flagged as unimplemented errors.

******************************************************************************}

procedure getintchr(var c: char);

var b1, b2: byte; { byte holders }

begin

   read(intfil, b1); { get high byte }
   read(intfil, b2); { get low byte }
   { if the character code is > 255, flag unimplemented }
   if b1 > 0 then error(eunimp);
   c := ascii2chr(b2) { convert character }

end;

{******************************************************************************

Get string

A string is a length, followed by the string characters. Loads the string from
the intermediate file to the given string entry.

******************************************************************************}

procedure getstr(var s: pstring);

var l: byte; { string length }
    i: byte; { string index }
    c: char; { character holder }

begin

   read(intfil, l); { get the string length }
   new(s, l); { create a new string }
   for i := 1 to l do begin { get string characters }

      getintchr(c); { get a string character }
      s^[i] := c { place }

   end

end;

{******************************************************************************

Push new block level

Creates a new block level entry, and pushes that onto the block stack.

*******************************************************************************}

procedure pshblk;

var bsp: blkptr;  { types stack pointer }

begin

   new(bsp); { get a new type level }
   bsp^.next   := blkstk; { push onto stack }
   blkstk      := bsp;
   { the parent link looks redundant now, but will keep the nesting structure
     as the block list is unwound into the master list }
   bsp^.prnt   := bsp^.next; { place parent entry }
   bsp^.typ    := nil; { clear root }
   bsp^.lst    := nil; { clear last }
   bsp^.res    := nil; { clear next resolable alternate }
   bsp^.typa   := nil; { clear alternate types list }
   bsp^.lsta   := nil; { clear last alternate }
   bsp^.resa   := nil; { clear next resolvable alternate }
   bsp^.lvl    := blkcnt; { set level number }
   bsp^.mark   := nil; { clear mark entry }
   bsp^.marks  := nil; { clear mark symbol }
   bsp^.sym    := nil; { clear symbols list }
   bsp^.entry  := nil; { clear entry code list }
   bsp^.exit   := nil; { clear exit code list }
   bsp^.entreg := []; { clear entry block registers used }
   bsp^.extreg := []; { clear exit block registers used }
   bsp^.fvar   := false; { block variables contain files }

end;

{******************************************************************************

Pop block level

Removes the top block level, and transfers the entry onto the types list.

*******************************************************************************}

procedure popblk;

var bsp: blkptr;  { types stack pointer }

begin

   bsp := blkstk; { save top entry }
   blkstk := blkstk^.next; { pop top of stack }
   { place onto types list, which will contain all of the type entries
     when the program is completely read }
   bsp^.next := blklst; { insert to list }
   blklst := bsp

end;

{******************************************************************************

Get intermediate stack entry

Gets a new intermediate stack entry, either from the free list, or a new one.

******************************************************************************}

procedure getist(var sp: istptr); { entry to return }

begin

   if freist <> nil then begin { return free entry }

      sp := freist; { index that }
      freist := freist^.next { gap the list }

   end else new(sp); { else get a new one }
   sp^.next := nil; { clear next entry }
   sp^.ent := nil { clear container }

end;

{******************************************************************************

Put intermediate stack entry

Returns the given entry to free storage.

******************************************************************************}

procedure putist(sp: istptr); { entry to return }

begin

   sp^.next := freist; { insert to free list }
   freist := sp

end;

{******************************************************************************

Push to intermediate stack

Pushes an intermediate entry onto the contruction stack. A new stack entry is
created, then attached to the given intermediate. Then, that is linked into
the contruction stack.

*******************************************************************************}

procedure pshint(ip: intptr); { intermediate tolken pointer }

var isp: istptr; { stack entry pointer }

begin

   getist(isp); { get a new stack entry }
   isp^.ent := ip; { link to tolken }
   isp^.next := istack; { push onto stack }
   istack := isp;
   stklvl := stklvl+1 { add level to stack }

end;

{******************************************************************************

Pop from intermediate stack

Pops the next tolken from the intermediate stack.

*******************************************************************************}

procedure popint(var ip: intptr); { intermediate tolken pointer }

var isp: istptr; { stack entry pointer }

begin

   { check stack underflow, which would have to indicate a corrupted
     intermediate format }
   if istack = nil then error(einvfmt); { flag invalid format }
   isp := istack; { get top stack entry }
   istack := istack^.next; { gap from list }
   ip := isp^.ent; { get contained entry }
   putist(isp); { release stack entry }
   stklvl := stklvl-1 { remove level from stack }

end;

{******************************************************************************

Push new 'with' stack entry

Gets a 'with' stack entry. Either gets an entry from the free list, or 
allocate it from the free list. The entry is then pushed onto the with scoping
stack.

*******************************************************************************}

procedure pshwth;

var p: wthptr; { pointer for 'with' entry }

begin

   if wthfre <> nil then begin { used 'with' entries exist, reuse one }

      p := wthfre; { index the top entry }
      wthfre := wthfre^.next { gap out }

   end else new(p); { else get a new entry }
   p^.next := wthstk; { push onto 'with' stack }
   wthstk := p;
   p^.rect := nil; { clear both fields }
   p^.vart := nil

end;      

{******************************************************************************

Pop  'with' stack entry

Removes the top level of the 'with' stack, and places that onto the free stack.

*******************************************************************************}

procedure popwth;

var p: wthptr; { pointer for 'with' entry }

begin

   if wthstk = nil then error(esysflt18); { stack empty }
   p := wthstk; { index top of stack }
   wthstk := wthstk^.next; { gap top of stack }
   p^.next := wthfre; { push onto free list }
   wthfre := p

end;

{******************************************************************************

Get module entry

Gets a module tracking entry. There is no recycling, because the list stays
active for the whole compile.

*******************************************************************************}

procedure getmod(var p: modptr);

begin

   new(p);
   p^.next := nil; { clear next }
   p^.inx := 0; { set no index }
   p^.modn := nil; { set no name }
   p^.modf := nil { set no file }

end;

{******************************************************************************

Find module entry by ordinal

Given a module ordinal number, finds the associated module tracking entry.

*******************************************************************************}

function fndmod(mo: integer) { module ordinal }
                : modptr;    { module pointer }

var mp, fp: modptr; { module entry pointer }

begin

   fp := nil; { set no module entry }
   if mo <> 0 then begin { not a null }

      mp := modlst; { index top of module tracking list }
      while mp <> nil do { traverse }
         if mp^.inx = mo then begin fp := mp; mp := nil end { found }
         else mp := mp^.next; { next entry }
      if fp = nil then error(einvfmt) { should have been found }

   end;

   fndmod := fp { return result }

end;

{******************************************************************************

Adjust parameter list levels

Adjusts the parameter list block levels to equal the current block level. The
parameters and function return lives in the caller, not the callee level,
because the compiler needs them for prototyping. But they are accessed just as
locals in the callee level. So we move them into the current level before
coding starts.

******************************************************************************}

procedure adjpar;

{ adjust type list }

procedure adjust(tp: typptr);

begin

   while tp <> nil do begin { traverse }

      tp^.level := blkcnt; { set level to current }
      case tp^.t of { parameter, find next }

         tpar:   tp := tp^.parn; { parameter }
         tvpar:  tp := tp^.vprn; { variable parameter }
         twpar:  tp := tp^.wprn; { view parameter }
         tpproc: tp := tp^.pprn; { procedure parameter }
         tpfunc: tp := tp^.pfnn  { function parameter }

      end

   end;

end;

begin

   if blkstk^.mark^.t = tproc then adjust(blkstk^.mark^.prcp) { procedure }
   else if blkstk^.mark^.t = tfunc then begin { function }

      adjust(blkstk^.mark^.fncp); { adjust parameters }
      blkstk^.mark^.fncr^.level := blkcnt { adjust result }

   end

end;

{******************************************************************************

Resolve type entry

Checks the given type entry for a linkage type. If that is so, the real type
entry corresponding is found, and the type entry pointer is replaced with a
pointer to the real type. If no corresponding type entry is found, this will
cause a format error, as all such entries should be defined when this routine
is called.

******************************************************************************}

procedure resolve(var tp: typptr);

begin

   if tp <> nil then { not a null entry }
      if tp^.t = tlink then begin { it's a linkage entry, process }

         fndlnk(tp, tp^.lnkl, tp^.lnke); { find the entry }
         if tp = nil then error(einvfmt) { not found, invalid format }

      end

end;

{******************************************************************************

Resolve forward references in block

Searches through all the type entries in the current block, and finds any
unresolved references, as marked by linkage entries. The corresponding real
entries are found, and the real pointer to them replaces the link entry 
pointer. If there still is no corresponding real entry, this is a format error
(should not happen).

This routine MUST be called before two crucial events occur. The first is
the start of a nested block, because that block could reference entries in the
current block and expect them to be resolved. The second is the start of a
code block, because those entries must be resolved. Because either of these
two events may happen first, and it would create unessary work to do it twice,
a flag indicating if the work has been performed should be kept.
After all entries are resolved, all of the link entries are returned to free
storage, as they are no longer needed.

******************************************************************************}

procedure resblk;

var tp: typptr; { type entry pointer }
    lp: typptr; { last entry pointer }
    np: typptr; { next entry pointer }
    sp: labptr; { symbol list pointer }

{ resolve types list }

procedure dores(tp: typptr); { list to resolve }
   
begin

   while tp <> nil do begin { traverse list }

      { perform resolution on all entries of type }
      case tp^.t of { types }

         tudf:       ;              
         tnil:       ;              
         tlab:       ;              
         ticst:      ; 
         tscst:      ; 
         tccst:      ;
         trcst:      ;    
         tstcst:     begin resolve(tp^.stct); resolve(tp^.stcc) end;
         tstet:      begin resolve(tp^.sten); resolve(tp^.steh) end;
         tarrcst:    resolve(tp^.arcn);
         tarrcel:    begin resolve(tp^.aren); resolve(tp^.arec) end;
         treccst:    resolve(tp^.recn);
         treccel:    begin resolve(tp^.reen); resolve(tp^.reec) end;
         tenum:      resolve(tp^.enc);
         tenme:      begin resolve(tp^.enx); resolve(tp^.enh) end;
         tsub:       resolve(tp^.subt);
         tptr:       resolve(tp^.ptrt);
         tarray:     begin resolve(tp^.arrt); resolve(tp^.arri) end;
         tgarry:     resolve(tp^.gart);
         tfile:      resolve(tp^.filt);
         tset:       resolve(tp^.sett);
         trecord:    resolve(tp^.recf);
         tfield:     begin resolve(tp^.fldn); resolve(tp^.fldh); 
                           resolve(tp^.fldt) end;
         tftag:      begin resolve(tp^.ftgc); resolve(tp^.ftgh); 
                           resolve(tp^.ftgt) end;
         tfcas:      begin resolve(tp^.fcsn); resolve(tp^.fcsf) end;
         tvar:       resolve(tp^.vart);
         tfix:       begin resolve(tp^.fixt); resolve(tp^.fixc) end;
         tproc:      begin resolve(tp^.prcp); resolve(tp^.prch); 
                           resolve(tp^.prcol); resolve(tp^.prcoh); 
                           resolve(tp^.prccl) end;
         tfunc:      begin resolve(tp^.fncp); resolve(tp^.fncr);
                           resolve(tp^.fnch); resolve(tp^.fncol); 
                           resolve(tp^.fncoh); resolve(tp^.fnccl) end;
         tpar:       begin resolve(tp^.parn); resolve(tp^.part); 
                           resolve(tp^.parh) end;
         tvpar:      begin resolve(tp^.vprn); resolve(tp^.vprt); 
                           resolve(tp^.vprh) end;
         twpar:      begin resolve(tp^.wprn); resolve(tp^.wprt); 
                           resolve(tp^.wprh) end;
         tpproc:     begin resolve(tp^.pprp); resolve(tp^.pprn) end;
         tpfunc:     begin resolve(tp^.pfnp); resolve(tp^.pfnr); 
                           resolve(tp^.pfnn) end;
         tinteger:   ;              
         tlinteger:  ;              
         tcardinal:  ;              
         tlcardinal: ;              
         tchar:      ;              
         tboolean:   resolve(tp^.bnc);
         treal:      ;              
         tsreal:     ;              
         ttext:      ;              
         teset:      ;              
         tglbl:      ;              
         tsemaphore: ;
         tclass:     resolve(tp^.clsi);
         tatom:      resolve(tp^.atmi);
         tthread:    resolve(tp^.thdi);
         treference: resolve(tp^.reft);
         texception: ;
         tnull:      ;              
         tfuncr:     resolve(tp^.fnrt);
         tlink:      ;
{ ????? do the following need resolution ? }
         tcastbl:    ;
         thshtbl:    ;
         tcassel:    ;
         trot:       ;
         tpgm:       ;
         tvrs:       ;

      end;
      tp := tp^.next { next entry }

   end

end;

begin

   dores(blkstk^.res); { resolve standard list }
   dores(blkstk^.resa); { resolve alternates list }
   resolve(blkstk^.mark); { resolve the mark linkage }
   { resolve symbols list }
   sp := blkstk^.sym; { index top of list }
   while sp <> nil do begin { traverse }

      resolve(sp^.typ); { resolve this entry }
      sp := sp^.next { find next entry }

   end;
   { return link entries to free }
   tp := blkstk^.typa; { there aren't going to be any in the main list }
   lp := nil; { set no last entry }
   while tp <> nil do begin { traverse }

      if tp^.t = tlink then begin { delete entry }

         if lp = nil then blkstk^.typa := tp^.next { gap start of list }
         else lp^.next := tp^.next; { gap list }
         np := tp^.next; { save next entry }
         { If the last entry indexes this, we have deleted the last entry in the
           list. Move back to the entry that indexes it. }
         if blkstk^.lsta = tp then blkstk^.lsta := lp; { move last }
         { if we deleted the last resolved entry, move it forward }
         if blkstk^.resa = tp then blkstk^.resa := tp^.next; { move resolve }
         puttyp(tp); { release current entry }
         tp := np { and resume with next entry }

      end else begin

         lp := tp; { set last entry }
         tp := tp^.next { next entry }

      end

   end

end;

{*******************************************************************************

Move global status to procedures and functions

Copies the global status from symbols into any procedures and functions that
they reference. There are two statuses for procedures and functions, if they
are exportable, and if they are external. The exportable status is in the symbol
entry, and the external status is in the procedure or function type entry. The
global status of a procedure or function, that is, if it can be accessed by
other modules, is true if the symbol is exportable, but the procedure or
function is not external. We calculate this flag, and place it into the 
procedure or function type itself. This flag is then used to determine global
status for monitors.

*******************************************************************************}

procedure setgbl;

var sp: labptr; { symbol list pointer }

begin

   { process the symbols list }
   sp := blkstk^.sym; { index top of list }
   while sp <> nil do begin { traverse }

      if sp^.typ^.t = tproc then { procedure }
         sp^.typ^.prcx := sp^.exp and not sp^.typ^.prce
      else if sp^.typ^.t = tfunc then { function }
         sp^.typ^.fncx := sp^.exp and not sp^.typ^.fnce;
      sp := sp^.next { find next entry }

   end

end;

{******************************************************************************

Load ordinal constant value

Loads the constant from the given type entry. Will load as an integer any of
an integer, single character string, or enumerated type.

If the ordinal is a character, and single character encoding is enabled, then
the encoded version is loaded.

*******************************************************************************}

function consti(tp: typptr): integer;

var i: integer; { result holder }

begin

   if tp^.t = ticst then i := tp^.ival.v { integer constant }
   else if tp^.t = tscst then begin { string constant }

      if max(tp^.sval^) = 1 then { single character }
         i := chr2ascii(tp^.sval^[1]) { load }
      else error(einvfmt) { must be single character }

   end else if tp^.t = tccst then i := chr2ascii(tp^.cval) { string constant }
   else if tp^.t = tenme then i := tp^.env { enumerated }
   else error(einvfmt); { invalid format }

   consti := i { return result }

end;

{******************************************************************************

Load ordinal constant sign

Loads the constant from the given type entry. Will load as an integer any of
an integer, single character string, or enumerated type.

If the ordinal is a character, and single character encoding is enabled, then
the encoded version is loaded.

*******************************************************************************}

function constis(tp: typptr): boolean;

var s: boolean; { result holder }

begin

   if tp^.t = ticst then s := tp^.ival.s { integer constant }
   else if tp^.t = tscst then begin { string constant }

      if max(tp^.sval^) = 1 then s := false { single character }
      else error(einvfmt) { must be single character }

   end else if tp^.t = tccst then s := false { string constant }
   else if tp^.t = tenme then s := false { enumerated }
   else error(einvfmt); { invalid format }

   constis := s { return result }

end;

{******************************************************************************

Check ordinal constant

Checks if the type entry is an ordinal constant.

*******************************************************************************}

function chkconsti(tp: typptr): boolean;

var f: boolean; { result holder }

begin

   f := false; { set false by default }
   if tp^.t = ticst then f := true { integer constant }
   else if tp^.t = tscst then begin { string constant }

      if max(tp^.sval^) = 1 then f := true { single character }

   end else if tp^.t = tccst then f := true { character constant }
   else if tp^.t = tenme then f := true; { enumerated }

   chkconsti := f { return result }

end;

{******************************************************************************

Check signed byte integer

Checks if the value fits a signed byte.

*******************************************************************************}

function sbyte(i: ssint): boolean;

begin

   sbyte := ssgeq(i, true, 128) and ssleq(i, false, 127)

end;

overload function sbyte(i: integer): boolean;

begin

   sbyte := (i >= -128) and (i <= 127)

end;

{******************************************************************************

Check unsigned byte integer

Checks if the value fits an unsigned byte.

*******************************************************************************}

function ubyte(i: integer): boolean;

begin

   ubyte := (i >= 0) and (i <= 255)

end;

{******************************************************************************

Find base type with subranges

Returns the base type for the given type. Finds the type root of the entry
given.

*******************************************************************************}

function basest(tp: typptr): typptr;

begin

   case tp^.t of { type }

      tudf:       ; { already at base type }
      tnil:       ; { no base type exists }
      tlab:       ; { no base type }
      ticst:      tp := gblint; { integer }
      tscst:      ; { not possible base for strings, since it depends on length }
      tccst:      tp := gblchr; { character }
      trcst:      tp := gblreal; { real }
      tstcst:     ; { must itself be a type }
      tstet:      tp := tp^.steh; { link head }
      tarrcst:    ; { already at base type }
      tarrcel:    tp := tp^.arec; { link constant }
      treccst:    ; { already at base type }
      treccel:    tp := tp^.reec; { link constant }
      tenum:      ; { already at base type }
      tenme:      tp := tp^.enh; { link enumerated head }
      tsub:       ; { leave at subrange }
      tptr:       ; { already at base type }
      tarray:     ; { already at base type }
      tgarry:     ; { already at base type }
      tfile:      ; { already at base type }
      tset:       ; { already at base type }
      trecord:    ; { already at base type }
      tfield:     tp := tp^.fldt; { link record head }
      tftag:      tp := tp^.ftgt; { link record head }
      tfcas:      ; { no base type (would actually be it's tag entry) }
      tvar:       tp := tp^.vart; { link type }
      tfix:       tp := tp^.fixt; { link type }
      tproc:      ; { no base type }
      tfunc:      tp := tp^.fncr; { link return type for function }
      tpar:       tp := tp^.part; { link type }
      tvpar:      tp := tp^.vprt; { link type }
      twpar:      tp := tp^.wprt; { link type }
      tpproc:     ; { already at base type }
      tpfunc:     ; { already at base type }
      tinteger:   ; { already at base type } 
      tlinteger:  ; { already at base type } 
      tcardinal:  ; { already at base type } 
      tlcardinal: ; { already at base type } 
      tchar:      ; { already at base type }
      tboolean:   ; { already at base type }
      treal:      ; { already at base type }
      tsreal:     ; { already at base type }
      ttext:      ; { already at base type }
      teset:      ; { already at base type }
      tglbl:      ; { no base type }
      tsemaphore: ; { already at base type }
      tclass:     ; { already at base type }
      tatom:      ; { already at base type }
      tthread:    ; { already at base type }
      treference: ; { already at base type }
      texception: ; { already at base type }
      tnull:      ; { no base type }
      tfuncr:     tp := tp^.fnrt; { link type }
      tlink:      ; { no base type }

   end;
   basest := tp { return type }

end;

{******************************************************************************

Find base type

Returns the base type for the given type. The base type is the given type
with subranges removed, and enumerated entries linked back to the head type. 
Basically the base type in this context is the type at which two different
types may be compared.

*******************************************************************************}

function baset(tp: typptr): typptr;

begin

   { remove any subranges }
   while tp^.t = tsub do tp := tp^.subt;
   tp := basest(tp); { find base with subrange }
   { remove any subranges }
   while tp^.t = tsub do tp := tp^.subt;
   baset := tp { return type }

end;

{******************************************************************************

Check signed type

Checks if the given type is signed. There are only two such types, integer, and
subranges of integer with negative lower bounds.

******************************************************************************}

function chksgn(tp: typptr) { type to check }
                : boolean; { signed status }

var s: boolean; { signed type flag }

begin

   tp := basest(tp); { find base type with subranges }
   s := false; { set not signed }
   if (tp^.t = tinteger) or (tp^.t = tlinteger) then 
      s := true { integer is signed }
   else if tp^.t = tsub then { subrange }
      s := tp^.subl.s; { set signed status }

   chksgn := s { return result }

end;   

{******************************************************************************

Check is an overload

Checks if the type entry is a procedure or function, and if so, if it is an
overload. A procedure or function is an overload if its head linkage is not
null.

******************************************************************************}

function chkovl(tp: typptr): boolean;

var f: boolean; { flag }

begin

   f := false; { set is not overload }
   if tp^.t = tproc then f :=  (tp^.prch <> nil) and (tp^.prch <> tp)
   else if tp^.t = tfunc then f :=  (tp^.fnch <> nil) and (tp^.fnch <> tp);

   chkovl := f { return result }

end;

{******************************************************************************

Check integer type

Checks if the given type is an integer. This can be either an integer constant, 
or the integer type.

*******************************************************************************}

function intt(tp: typptr): boolean;

begin

   tp := baset(tp); { find the base type }
   { result true if it's integer constant or integer type }
   intt := (tp^.t = tinteger) or (tp^.t = tlinteger) or (tp^.t = tcardinal) or
           (tp^.t = tlcardinal) or (tp^.t = ticst)

end;

{******************************************************************************

Check char type

Checks if the given type is a char. This can be either a string constant with
one character, or a char type.

*******************************************************************************}

function chart(tp: typptr): boolean;

var m: boolean; { match result }

begin

   tp := baset(tp); { find the base type }
   m := true; { set char type }
   if tp^.t <> tchar then { check for single character string constant }
      if tp^.t <> tscst then m := false { not a string constant }
      else m := max(tp^.sval^) = 1; { must be single character }
   chart := m

end;

{******************************************************************************

Check real type

Checks if the given type is a real. This can be a short real, a long real, or
a real constant.

*******************************************************************************}

function realt(tp: typptr): boolean;

begin

   tp := baset(tp); { find base type }
   { result true if it's a short or a long real }
   realt := (tp^.t = treal) or (tp^.t = tsreal)

end;

{******************************************************************************

Check short real type

Checks if the given type is a short real.

*******************************************************************************}

function srealt(tp: typptr): boolean;

begin

   tp := baset(tp); { find base type }
   { result true if it's a short real }
   srealt := tp^.t = tsreal

end;

{******************************************************************************

Check set type

Checks if the given type is a set. This can be either a string constant with
one character, or a char type.

*******************************************************************************}

function sett(tp: typptr): boolean;

begin

   tp := baset(tp); { find the base type }
   sett := tp^.t = tset { check is a set }

end;

{******************************************************************************

Check tagged pointer type

Checks if the given type is a tagged pointer. This is either a pointer to a
general array, or a var or view parameter that is a general array.

*******************************************************************************}

function tgpt(tp: typptr): boolean;

var m: boolean; { match result }

begin

   m := false; { set no match }
   if tp^.t = tptr then begin

      m := tp^.ptrt^.t = tgarry { check is a general array base }

   end else if tp^.t = tvpar then begin

      m := tp^.vprt^.t = tgarry { check is a general array base }

   end else if tp^.t = twpar then begin

      { check is a general array base }
      m := (tp^.wprt^.t = tgarry) or tgpt(tp^.wprt)

   end else if tp^.t = tpar then begin

      m := tgpt(tp^.part) { check is a tagged pointer itself }

   end else m := tp^.t = tnil; { allow nils to be tagged as well } 

   tgpt := m { return result }

end;   

{******************************************************************************

Check procedure or function parameter type

Checks if the given type is a procedure or function parameter.

*******************************************************************************}

function pfpt(tp: typptr): boolean;

begin

   pfpt := (tp^.t = tpproc) or (tp^.t = tpfunc)

end;   

{******************************************************************************

Check procedure or function is external

Checks if the given procedure or function is defined external to this module.

*******************************************************************************}

function chkrotext(tp: typptr): boolean;

var f: boolean;

begin

   f := false; { set not external by default }
   if tp^.t = tproc then begin

      if tp^.prce or tp^.prcas then f := true { set external status }

   end else if tp^.t = tfunc then begin

      if tp^.fnce or tp^.fncas then f := true { set external status }

   end else error(esysflt90);

   chkrotext := f { return result }

end;

{******************************************************************************

Find lower bound of type

Finds the lower bound of an ordinal type.

*******************************************************************************}

function lbound(tp: typptr): integer;

var lb: integer; { result holder }

begin

   tp := basest(tp); { find base type with subranges }
   if tp^.t = tenum then lb := tp^.enc^.env { return enumerated }
   else if tp^.t = tenme then lb := tp^.enh^.enc^.env { return enumerated }
   else if tp^.t = tsub then lb := tp^.subl.v { return subrange }
   else if tp^.t = tcardinal then lb := 0 { return cardinal }
   else if tp^.t = tlinteger then lb := mmaxlint { return long integer }
   else if tp^.t = tlcardinal then lb := 0 { return long cardinal }
   else if tp^.t = tinteger then lb := mmaxint { return integer }
   else if chart(tp) then lb := 0 { return character }
   else if tp^.t = tboolean then lb := 0 { return boolean }
   else if tp^.t = tudf then lb := maxint { undefined, return minimum }
   else error(einvfmt); { else is invalid type }   

   lbound := lb

end;

{******************************************************************************

Find lower bound sign of type

Finds the lower bound sign of an ordinal type.

*******************************************************************************}

function lbounds(tp: typptr): boolean;

var s: boolean; { result holder }

begin

   tp := basest(tp); { find base type with subranges }
   if tp^.t = tenum then s := false { return enumerated is unsigned }
   else if tp^.t = tenme then s := false { return enumerated is unsigned }
   else if tp^.t = tsub then s := tp^.subl.s { return subrange sign }
   else if tp^.t = tcardinal then s := false { return cardinal }
   else if tp^.t = tlinteger then s := true { return long integer }
   else if tp^.t = tlcardinal then s := false { return long cardinal }
   else if tp^.t = tinteger then s := true { return integer }
   else if chart(tp) then s := false { return character unsigned }
   else if tp^.t = tboolean then s := false { return boolean unsigned }
   else if tp^.t = tudf then s := true { undefined, return minimum negative }
   else error(einvfmt); { else is invalid type }   

   lbounds := s

end;

{******************************************************************************

Find upper bound of type

Finds the upper bound of an ordinal type.

*******************************************************************************}

function ubound(tp: typptr): integer;

var ub: integer; { result holder }

begin

   tp := basest(tp); { find base type with subranges }
   if (tp^.t = tenum) or (tp^.t = tenme) then begin

        if tp^.t = tenme then tp := tp^.enh; { find head of type }
        tp := tp^.enx; { index 1st enum entry }
        while tp^.enx <> nil do tp := tp^.enx; { find ending entry }
        ub := tp^.env { return enumerated }

   end else if tp^.t = tsub then ub := tp^.subu.v { return subrange }
   else if tp^.t = tcardinal then ub := mmaxcard { return cardinal }
   else if tp^.t = tlinteger then ub := mmaxlint { return long integer }
   else if tp^.t = tlcardinal then ub := mmaxlcard { return long cardinal }
   else if tp^.t = tinteger then ub := mmaxint { return integer }
   else if chart(tp) then ub := 255 { return character }
   else if tp^.t = tboolean then ub := 1 { return boolean }
   else if tp^.t = tudf then ub := maxint { undefined, return maximum }
   else error(einvfmt); { else is invalid type }   

   ubound := ub

end;

{******************************************************************************

Find upper bound sign of type

Finds the upper bound sign of an ordinal type.

*******************************************************************************}

function ubounds(tp: typptr): boolean;

var s: boolean; { result holder }

begin

   tp := basest(tp); { find base type with subranges }
   if (tp^.t = tenum) or (tp^.t = tenme) then begin s := false { unsigned }
   end else if tp^.t = tsub then s := tp^.subu.s { return subrange }
   else if tp^.t = tcardinal then s := false { return cardinal }
   else if tp^.t = tlinteger then s := false { return long integer }
   else if tp^.t = tlcardinal then s := false { return long cardinal }
   else if tp^.t = tinteger then s := false { return integer }
   else if chart(tp) then s := false { return character unsigned }
   else if tp^.t = tboolean then s := false { return boolean unsigned }
   else if tp^.t = tudf then s := false { undefined, return maximum unsigned }
   else error(einvfmt); { else is invalid type }   

   ubounds := s

end;

{******************************************************************************

Check in monitor

Checks if the current block is a monitor.

******************************************************************************}

function inmonitor: boolean;

var f: boolean;

begin

   f := false; { set not in monitor }
   if blkstk^.mark^.blk^.mark^.t = tglbl then
      if blkstk^.mark^.blk^.mark^.mrkt = mtmonitor then f := true; { yes }

   inmonitor := f { return result }

end;

{******************************************************************************

Find record field

Finds a field in the given record scope, and returns true if the field exists
in the scope. All of the variants are searched.

******************************************************************************}

function inscope(tp: typptr; { record scope to search }
                 sp: typptr) { field to search for }
                : boolean;   { found status }

var m: boolean; { found flag }

begin

   m := false; { set no match found }
   while tp <> nil do begin { traverse field list }

      if tp = sp then m := true; { set field found }
      if tp^.t = tfield then tp := tp^.fldn { index next field entry }
      else begin { must be tagfield }

         if tp^.t <> tftag then error(einvfmt); { bad format }
         tp := tp^.ftgc; { index case constant list }
         while tp <> nil do begin { traverse cases }

            if tp^.t <> tfcas then error(einvfmt); { bad format }
            if inscope(tp^.fcsf, sp) then m := true; { found }
            tp := tp^.fcsn { link next }

         end

      end

   end;
   inscope := m { return match status }

end;

{******************************************************************************

Find 'with' record base variable

Searches the 'with' scoping stack for the given record field entry, and returns
the base variable for that. If it is not found, a file format error occurs,
since there should never be a referenced field without a 'with' scope enclosing
it.

******************************************************************************}

procedure fndwth(    ft: typptr;  { field type to search for }
                 var fv: typptr); { with base address }

var p: wthptr; { pointer for 'with' scoping stack }

begin

   fv := nil; { set no base variable found }
   p := wthstk; { index top of with stack }
   { search stack }
   while (p <> nil) and (fv = nil) do begin { not end of stack, not found }

      if inscope(p^.rect^.recf, ft) then fv := p^.vart; { found, set variable }
      p := p^.next { next stack entry }

   end;
   if fv = nil then error(einvfmt) { not found, invalid format }      

end;

{******************************************************************************

Find tag field and case constant

Given a field from a record, will find if there is a tag field and case list
that controls the field. These are returned if so, otherwise, they are both
returned nil.

This routine is used to find the tagfield controlling a given field.

Note that it only find the first matching tagfield and case entry. It is
possible for any number of such case entries to exist under the tagfield.

******************************************************************************}

procedure fndtag(    fp:  typptr;  { field pointer }
                 var tp:  typptr;  { returns tag field pointer }
                 var cp:  typptr); { returns case entry }

var f:  boolean; { found field }
    mp: typptr;  { pointer to match field }

{ find field in field list }

procedure fndtaglst(    fp: typptr;   { field pointer }
                    var tp: typptr;   { returns tag field pointer }
                    var cp: typptr;   { returns case entry }
                    var f:  boolean); { found }

begin

   f := false; { set no match }
   while fp <> nil do begin { search for field }

      if fp = mp then begin { found field }
   
         f := true; { set found }
         fp := nil { terminate search }
    
      end else begin { no match }

         if fp^.t = tfield then fp := fp^.fldn { link next field }
         else begin { must be tagfield }
        
            if fp^.t <> tftag then error(einvfmt); { should be tagfield }
            tp := fp; { set last tagfield found }
            fp := fp^.ftgc; { index case constant list }
            while fp <> nil do begin { traverse cases }
        
               if fp^.t <> tfcas then error(einvfmt); { bad format }
               cp := fp; { set last case found }
               fndtaglst(fp^.fcsf, tp, cp, f); { search this list }
               if f then fp := nil { stop search }
               else fp := fp^.fcsn { link next }
        
            end
        
         end

      end

   end

end;

begin

   tp := nil; { set tag pointer nil }
   cp := nil; { set case pointer nil }
   mp := fp; { save field to match against }
   fp := fp^.fldh; { link record head }
   if fp^.t <> trecord then error(einvfmt); { should be record }
   fndtaglst(fp^.recf, tp, cp, f); { find in list }
   if not f then begin { not found, clear pointers }

      tp := nil; { set tag pointer nil }
      cp := nil; { set case pointer nil }

   end

end;

{******************************************************************************

Find tag field and case constant count

Given a field from a record, will find the count of tag field and case 
references that control the field.

******************************************************************************}

function fndtagcnt(fp:  typptr) { field pointer }
                  : integer;    { tag/case count }

var mp: typptr;   { pointer to match field }
    cnt: integer; { count of case references found }

{ find field in field list }

procedure fndtaglst(fp: typptr);  { field pointer }

begin

   while fp <> nil do begin { search for field }

      if fp = mp then cnt := cnt+1; { found field }
      if fp^.t = tfield then fp := fp^.fldn { link next field }
      else begin { must be tagfield }
      
         if fp^.t <> tftag then error(einvfmt); { should be tagfield }
         fp := fp^.ftgc; { index case constant list }
         while fp <> nil do begin { traverse cases }
      
            if fp^.t <> tfcas then error(einvfmt); { bad format }
            fndtaglst(fp^.fcsf); { search this list }
            fp := fp^.fcsn { link next }
      
         end
      
      end

   end

end;

begin

   cnt := 0; { clear count }
   mp := fp; { save field to match against }
   fp := fp^.fldh; { link record head }
   if fp^.t <> trecord then error(einvfmt); { should be record }
   fndtaglst(fp^.recf); { find in list }

   fndtagcnt := cnt { return count }

end;

{******************************************************************************

Find length of string

Finds the length of a space padded string.

******************************************************************************}

function strlen(view s: string): integer;

var l: integer; { length holder }

begin

   l := max(s); { index end of string }
   if l <> 0 then begin { not null string }

      { find the end of the string }
      while (l > 1) and (s[l] = ' ') do l := l-1;
      if s[l] = ' ' then l := 0 { set zero length case }

   end;
   strlen := l { return string length }

end;

{******************************************************************************

Check type contains, or is, a file

Checks if the given type is a file, or contains a file. Note that procedure and
function types are not considered to "contain" anything.

******************************************************************************}

function chkconfil(tp: typptr): boolean;

var isfile: boolean;

{ check field list for file components }

function chkconfilrec(tp: typptr): boolean; { head of field list }

var isfile: boolean; { match }

begin

   isfile := false; { set no file component }
   while tp <> nil do begin { traverse }

      if tp^.t = tfield then begin { field list }

         if chkconfil(tp^.fldt) then isfile := true; { set file type }
         tp := tp^.fldn { next entry }

      end else if tp^.t = tftag then begin { tagfield }

         { note that the tag field itself cannot be a file }
         tp := tp^.ftgc; { index top of case list }
         while tp <> nil do begin { traverse }

            if tp^.t <> tfcas then error(esysflt10); { verify }
            if chkconfilrec(tp^.fcsf) then isfile := true; { set file type }
            tp := tp^.fcsn { next entry }

         end

      end else error(esysflt11) { verify entry type }

   end;
   chkconfilrec := isfile { return result }

end;

begin

   isfile := false; { set not file by default }
   case tp^.t of { type }

      tudf, tnil, tlab, ticst, tscst, tccst, trcst, tstcst, tstet, tarrcst,
      tarrcel, treccst, treccel, tenum, tenme, tsub, tset, tftag, tfix, tproc,
      tfunc, tpproc, tpfunc, tinteger, tlinteger, tcardinal, tlcardinal, tchar,
      tboolean, treal, tsreal, teset, tglbl, tsemaphore, tclass, tatom, tthread,
      treference, texception, tnull, tfuncr, tlink, tcastbl, thshtbl, tcassel,
      trot, tpgm, tvrs, tptr: ;

      tarray:   isfile := chkconfil(tp^.arrt);
      tgarry:   isfile := chkconfil(tp^.gart);
      tfile:    isfile := true;
      trecord:  isfile := chkconfilrec(tp^.recf);  
      tfield:   isfile := chkconfil(tp^.fldt);
      tfcas:    isfile := chkconfilrec(tp^.fcsf);
      tvar:     isfile := chkconfil(tp^.vart);
      tpar:     isfile := chkconfil(tp^.part);
      tvpar:    isfile := chkconfil(tp^.vprt);
      twpar:    isfile := chkconfil(tp^.wprt);
      ttext:    isfile := true

   end;
   chkconfil := isfile { return result }

end;

{******************************************************************************

Check type list contains

Checks if a file exists in the given type list.

******************************************************************************}

function chkconfillst(tp: typptr): boolean;

var isfile: boolean;

begin

   isfile := false; { set does not contain a file }
   while tp <> nil do begin { traverse }

      if chkconfil(tp) then isfile := true; { found a file, set }
      tp := tp^.next { next in list }

   end;
   chkconfillst := isfile { return result }

end;

{******************************************************************************

Copy string

Copies the source string into the destination. If the destination string is
longer than the source string, the destination is padded with blanks.

******************************************************************************}

procedure strcpy(var  d: string; { destination }
                 view s: string); { source }

var i: integer; { index for string }
    l: integer; { length of string }

begin

   l := strlen(s); { find length of source string }
   if l > max(d) then error(esysflt3); { should not happen }
   for i := 1 to l do d[i] := s[i]; { copy string into place }
   for i := l+1 to max(d) do d[i] := ' ' { pad end }

end;

{******************************************************************************

Place storage string

Places the source string into storage, as indexed by the destination.

******************************************************************************}

procedure strplc(var  d: pstring; { destination }
                 view s: string); { source }

begin

   new(d, strlen(s)); { allocate a new string with the source length }
   strcpy(d^, s) { place contents of string there }

end;

{******************************************************************************

Make rld entry

Creates and rld entry with the given address, type linkage and insertion type.

******************************************************************************}

procedure makrld(adr: integer; { address to place }
                 off: integer; { offset to address }
                 tp:  typptr; { type entry to use }
                 it:  ityp);  { insertion type }

var rp: rldptr; { relocation entry pointer }

begin

   new(rp); { get a new relocation entry }
   rp^.addr := adr; { set address to patch }
   rp^.off := off; { set offset }
   rp^.lab := tp; { set patch entry }
   rp^.it := it; { place insertion type }
   rp^.out := false; { set not output }
   rp^.next := rldlst; { push onto rld list }
   rldlst := rp

end;

{******************************************************************************

Emit byte

Outputs a single byte to the object deck, and advances the program address.

******************************************************************************}

procedure emitbyt(i: integer);

var c: record case boolean of { convertion }

          false: (i: integer); { integer form }
          true:  (b: packed array[1..intsiz] of byte); { byte format }

       end;

begin

   if foutlst then begin { list output bytes }

      write('Byte: '); 
      prthex(2, i); 
      writeln

   end;
   if not fsupout then begin { output is enabled }

      c.i := i; { place integer }
      write(objfil, c.b[1]) { output byte }

   end;
   pgmcnt := pgmcnt+1 { next location }

end;

overload procedure emitbyt(i: ssint);

begin

   if i.v > maxint then error(esysflt92);
   if i.s then emitbyt(-i.v) else emitbyt(i.v)

end;

{******************************************************************************

Emit word

Outputs a 16 bit word to the object deck, and advances the program address.

******************************************************************************}

procedure emitwrd(i: integer);

var c: record case boolean of { convertion }

          false: (i: integer); { integer form }
          true:  (b: packed array[1..intsiz] of byte); { byte format }

       end;
    bi: 1..intsiz; { index for convertion array }  

begin

   if foutlst then begin { list output word }

      write('Word: '); 
      prthex(4, i); 
      writeln

   end;
   if not fsupout then begin

      c.i := i; { place integer }
      { output byte equivalent }
      for bi := 1 to 2 do write(objfil, c.b[bi])

   end;
   pgmcnt := pgmcnt+2 { count off }

end;

overload procedure emitwrd(i: ssint);

begin

   if i.v > maxint then error(esysflt93);
   if i.s then emitwrd(-i.v) else emitwrd(i.v)

end;

{******************************************************************************

Emit code integer

Outputs a 32 bit integer to the object.

******************************************************************************}

procedure emitint(i: integer);

var c: record case boolean of { convertion }

          false: (i: integer); { integer form }
          true:  (b: packed array[1..intsiz] of byte); { byte format }

       end;
    bi: 1..intsiz; { index for convertion array }  

begin

   if foutlst then begin { list output word }

      write('Integer: '); 
      prthex(8, i); 
      writeln

   end;
   if not fsupout then begin { not output supressed }

      c.i := i; { place integer }
      { place byte equivalent in memory }
      for bi := 1 to intsiz do write(objfil, c.b[bi])

   end;
   pgmcnt := pgmcnt+intsiz { count off }

end;

overload procedure emitint(i: ssint);

begin

   if i.v > maxint then error(esysflt91);
   if i.s then emitint(-i.v) else emitint(i.v)

end;

{******************************************************************************

Emit code real

Outputs a 64 bit real to the object.

******************************************************************************}

procedure emitrl(r: real);

var c: record case boolean of { convertion }

          false: (r: real); { real form }
          true:  (b: packed array[1..relsiz] of byte); { byte format }

       end;
    bi: 1..relsiz; { index for convertion array }  

begin

   if foutlst then writeln('Real: ', r); 
   if not fsupout then begin { not output supressed }
 
      c.r := r; { place real }
      { output byte equivalent }
      for bi := 1 to relsiz do write(objfil, c.b[bi])

   end;
   pgmcnt := pgmcnt+relsiz { count off }

end;

{******************************************************************************

Emit code short real

Places a 32 bit real into the code memory at the current program load
address, and advances the address to after it. Errors on the program load
being at the end of memory.

******************************************************************************}

procedure emitsrl(r: real);

var c: record case boolean of { convertion }

          false: (r: sreal); { 32 bit real form }
          true:  (b: packed array[1..srlsiz] of byte); { byte format }

       end;
    bi: 1..srlsiz; { index for convertion array }  

begin

   if foutlst then writeln('Short real: ', r); 
   if not fsupout then begin { not output supressed }

      c.r := r; { place short real }
      { place byte equivalent in memory }
      for bi := 1 to srlsiz do write(objfil, c.b[bi])

   end;
   pgmcnt := pgmcnt+srlsiz { count off }

end;

{******************************************************************************

Emit code string

Places a string constant into the code memory at the current program load
address, and advances the address to after it. Errors on the program load
being at the end of memory.

The characters are output via the character transliteration table. This
table is used to obfuscate characters in the object. It is normally set to
1:1 translation, unless set otherwise by option.

******************************************************************************}

procedure emitstr(view s: string);

var i: integer; { index for string }

begin

   if foutlst then writeln('String: ', s); 
   if not fsupout then begin { not output supressed }

      if funicode then { unicode }
         for i := 1 to max(s) do begin { place characters }

            write(objfil, chr2ascii(s[i]) mod 256);
            write(objfil, chr2ascii(s[i]) div 256)

      end else { ISO 8859-1 }
         for i := 1 to max(s) do { place characters }
            write(objfil, chr2ascii(s[i]));

   end;
   pgmcnt := pgmcnt+max(s) { count off }

end;

{******************************************************************************

Emit code address

Accepts a type entry. Emits an address for the entry, and adds a relocation
patch for that location.

******************************************************************************}

procedure emitadr(tp: typptr; { type entry to use }
                  it: ityp);  { insertion type }

begin

   if foutlst then write('Addr: '); 
   makrld(pgmcnt, 0, tp, it); { make an rld for that }
   case it of { insertion type }

      itadr:   emitint(tp^.addr); { output address }
      itradr:  emitint(tp^.addr-(pgmcnt+2)); { output relative address }
      itbradr: emitbyt(tp^.addr-(pgmcnt+1)) { output relative address }

   end

end;

{*******************************************************************************

Emit code address with offset

Accepts a type entry. Emits an address for the entry, with the given offset,
and adds a relocation patch for that location.

*******************************************************************************}

procedure emitadro(tp:  typptr;   { type entry to use }
                   it:  ityp;     { insertion type }
                   off: integer); { offset to address }

begin

   if foutlst then write('Addr: '); 
   makrld(pgmcnt, off, tp, it); { make an rld for that }
   case it of { insertion type }

      itadr:   emitint(tp^.addr+off); { output address }
      itradr:  emitint(tp^.addr+off-(pgmcnt+2)); { output relative address }
      itbradr: emitbyt(tp^.addr+off-(pgmcnt+1)) { output relative address }

   end

end;

{******************************************************************************

Emit goto offset

Accepts a procedure or function type entry. Emits a single-shot relocator for
the goto offset. This is required because we may not know the exact offset
of a goto target when the code for it is emitted.

******************************************************************************}

procedure emitgto(tp: typptr); { type entry to use }

begin

   if foutlst then write('Goto offset: '); 
   makrld(pgmcnt, 0, tp, itgto); { make an rld for that }
   if tp^.t = tproc then emitint(tp^.prcg)
   else emitint(tp^.fncg)

end;

{******************************************************************************

Sort case table

Sorts a case table for ascending order. This is done prior to processing its
layout. Uses a not particularly efficient "pull" sort because it is easy.
Case lists are not likely to be very long.

******************************************************************************}

procedure srtcas(var cl: typptr); { case list }

var tl:      typptr;  { holding list }
    p:       typptr;  { list pointer }
    m:       ssint;    { maximum constant }
    mp:      typptr;  { maximum case selector }
    lp, mlp: typptr;  { last entry pointer }
    mv:      boolean; { max is valid }

begin

   tl := nil; { clear holding list }
   while cl <> nil do begin { clear source list }

      p := cl; { index top of list }
      m.v := 0; { clear the max }
      m.s := false;
      mp := nil;
      lp := nil; { set no last entry }
      mlp := nil;
      { because case values can be anything, the max can have never been set }
      mv := false; { set no valid max }
      while p <> nil do begin { traverse list }

         if not mv or ssgtn(p^.csv, m) then begin { found a new max }

            mp := p; { set max entry }
            mlp := lp; { set last entry }
            m := p^.csv; { set new max }
            mv := true { set max is now valid }

         end;
         lp := p; { set new last entry }
         p := p^.csn { next entry }

      end;
      if mp = nil then error(esysflt4); { that should not happen }
      { remove from source list }
      if mlp = nil then cl := cl^.csn { gap top of list }
      else mlp^.csn := mp^.csn; { gap over entry }
      mp^.csn := tl; { insert to holding list }
      tl := mp

   end;
   { Now the holding list is sorted for lowest to highest, because we
     selected the max entries and pushed them backwards. }
   cl := tl { set holding list as original }

end;

{******************************************************************************

Check case duplicates

Checks for duplicates in the case list. Several routines in case processing
won't tolerate duplicates.
We check and produce a fatal error here, but this mode of error processing
needs improvement since the parser passes duplicates.
The list must have been sorted.

******************************************************************************}

procedure chkcasdup(cl: typptr); { case list }

var lc: ssint; { last case }

begin

   lc := cl^.csv; { set last case }
   cl := cl^.csn; { link next }
   while cl <> nil do begin { clear source list }

      if ssequ(cl^.csv, lc) then error(ecasdup);
      lc := cl^.csv; { set new last case }
      cl := cl^.csn { next case }

   end

end;

{******************************************************************************

Set case staticstics

Sets up the case parameters, the number of cases, and the low case and high
case.

******************************************************************************}

procedure cassts(    tp:    typptr;  { head of case select list }
                 var total: integer; { number of case entries }
                 var low:   ssint;    { low case value }
                 var high:  ssint);   { high case value }
                
begin

   total := 0;
   while tp <> nil do begin { traverse }

      total := total+1; { count }
      if total = 1 then low := tp^.csv; { set low case }
      high := tp^.csv; { keep high as running track }
      tp := tp^.csn { link next }

   end

end;

{******************************************************************************

Find case table occupancy

Expects an ascending sorted case table. The occupancy, or number of sequentail
case selectors is found, returned as a percentage from 0 - 100 (integer).
This value is used to determine if a case table needs too much padding to be
profitably implemented as a straight jump table, which requires padding entries
at every missing selector in the case list.

******************************************************************************}

function occupancy(tp: typptr): integer; { case list to check }

var max: integer; { total number of cases, including pads }
    pad: integer; { total number of pads }
    cnt: ssint;    { running counter for case selects }
    t:   ssint;

begin

   max := 0; { clear number of case selects }
   pad := 0; { clear padding }
   if tp = nil then error(esysflt5); { should not happen }
   cnt := tp^.csv; { set 1st case select }
   max := 1; { count that }
   tp := tp^.csn; { link next case }
   while tp <> nil do begin { traverse }

      { find cnt+1 }
      t.v := ssadd(cnt, false, 1);
      t.s := ssadds(cnt, false, 1);
      if ssequ(tp^.csv, t) then begin { it's sequential }

         max := max+1; { count total cases }
         cnt := t { advance counter }

      end else begin { not sequential }

         { find new total }
         t.v := ssadd(tp^.csv, not cnt.s, cnt.v);
         t.s := ssadds(tp^.csv, not cnt.s, cnt.v);
         if t.s then error(esysflt90); { should not be negative }
         max := max+t.v; { add to total }
         pad := pad+t.v-1; { find number of pads required }
         cnt := tp^.csv { skip to this entry }

      end;
      tp := tp^.csn { link next entry }

   end;
   occupancy := 100*(max-pad) div max { calculate occupancy percentage }

end;

{******************************************************************************

Make jump table

Making a jump table out of the list of select values given consists of adding
error jump entries to fill out gaps in the case list. Must be a non-empty case
jump table.

This routine has the potential for failure if the gaps are unusually large,
because it will try to fill them, which may not complete in reasonable time or
storage. For this reason, the occupancy percentage should never be set to zero.

******************************************************************************}

procedure makjpt(tp: typptr); { jump table to pad }

var cnt: ssint;   { running count }
    tl:  typptr; { holding list }
    lp:  typptr; { last entry pointer }
    p:   typptr; { case select pointer }
    t:   ssint;

{ insert to holding list }

procedure insert(p: typptr);

begin

   if lp = nil then tl := p { list is empty }
   else lp^.csn := p; { set as next }
   lp := p { set new last }

end;

begin

   tl := nil; { clear holding list }
   lp := nil; { clear last entry }
   p := tp^.ctn; { index 1st entry }
   cnt := p^.csv; { set 1st count }
   tp^.ctn := tp^.ctn^.csn; { gap list head }
   insert(p); { insert to holding }
   while tp^.ctn <> nil do begin { move all entries }

      { advance count }
      t.v := ssadd(cnt, false, 1);
      t.s := ssadds(cnt, false, 1);
      cnt := t;
      while ssnequ(tp^.ctn^.csv, cnt) do begin

         { insert padding entries }
         gettypa(p, tcassel); { get a new case select entry }
         p^.csp := true; { set is a padding entry }
         p^.csv := cnt; { set value }
         p^.csm := nil; { clear missed hash chain }
         p^.csi := -1;
         { advance count }
         t.v := ssadd(cnt, false, 1);
         t.s := ssadds(cnt, false, 1);
         cnt := t;
         insert(p) { place padding entry }

      end;      
      p := tp^.ctn; { index entry }
      tp^.ctn := tp^.ctn^.csn; { gap list head }
      insert(p); { insert to holding }

   end;
   tp^.ctn := tl { place holding as active list }

end;

{******************************************************************************

Place up links

Given an intermediate block, tours the block and places the up links. The up
links are required for register allocation.

******************************************************************************}

procedure plcup(ip: intptr);

procedure plcupexp(ip, par: intptr); forward;

{ place parameter up links }

procedure plcupplst(ip, par: intptr);

begin

   while ip <> nil do begin { traverse this forward flow }

      if ip^.i <> ticalpar then error(esysflt49);
      ip^.up := par; { place up link }
      plcupexp(ip^.left, ip); { place expression }
      ip := ip^.flow { next in flow }

   end

end;

{ place expression up links }

procedure plcupexp(ip, par: intptr);

begin

   if ip^.up <> nil then error(esysflt8); { would mean we looped }
   ip^.up := par; { place parent entry }
   case ip^.i of { intermediate }

      tifnccal, tifnccalo: plcupplst(ip^.flow2, ip); { parameter list }

      tifnccali: begin

         plcupexp(ip^.left, ip); { address of function }
         plcupplst(ip^.flow2, ip) { parameter list }

      end;

      tilodset, tilodsrc, tilimns, tilodadr, tilodint, tilodrel, tilodsrl, tilodchr, 
      tilodbol, tilodptr, tilimint, tilimrel, tilodfadr, tilodtgp: ;

      tieolt, tieof, tiloc, tilodafbuf, tilodafbuft, tiexist, tildiset, tildisrc, 
      ticvtntg, tildiint, tildichr, tildibol, tildiptr, tildirel, tildisrl, tinotint,
      tinotbol, tilodlen, ticvtgtf, tinegint, tiabsint, tisqrint, tiodd, tisucint, 
      tiprdint, tirngchk, tilditgp, ticvtftg, ticvtitr, tinegrel, tiabsrel, tisqrrel,
      tiatnrel, ticosrel, tiexprel, tilgnrel, tisinrel, tisqtrel, tirnd, tirecoff,
      titrc, ticvtrtsr, tilen, tiaddintimm, timltintimm, tiandintimm, tiequintimm,
      tiequtgpimm, tineqintimm, tineqtgpimm, tiorintimm, tixorintimm, tileqintimm,
      tigeqintimm, tiltnintimm, tigtnintimm, tisubintimm, tiaddintlod, 
      timltintlod, tiandintlod, tiequintlod, tiequtgplod, tineqintlod,
      tineqtgplod, tiorintlod, tixorintlod, tileqintlod, tigeqintlod,
      tiltnintlod, tigtnintlod, tisubintlod: plcupexp(ip^.left, ip);

      tidivint, timodint, tiintset, tiuniset, tidifset, tiarfgar, timltint, tiaddint,
      tisubint, tiandint, tiorint, tixorint, tisinset, tiarrref, tiincset, tiequset,
      tineqset, tileqset, tigeqset, timltrel, tidivrel, tiaddrel, tisubrel, tiequrel,
      tineqrel, tileqrel, tigeqrel, tiltnrel, tigtnrel, tiequgst, tineqgst, tigeqgst,
      tiltngst, tigtngst, tiequtgp, tineqtgp, tiequint, tineqint, tileqint, tigeqint,
      tiltnint, tigtnint, tiequstr, tineqstr, tileqstr, tigeqstr, tiltnstr, 
      tigtnstr, tileqgst, tiaddintldi, timltintldi, tiandintldi, tiequintldi,
      tiequtgpldi, tineqintldi, tineqtgpldi, tiorintldi, tixorintldi,
      tileqintldi, tigeqintldi, tiltnintldi, tigtnintldi, tisubintldi: begin

         plcupexp(ip^.left, ip); 
         plcupexp(ip^.right, ip) 

      end;

      tirngset: begin

         plcupexp(ip^.left, ip); 
         plcupexp(ip^.right, ip);
         plcupexp(ip^.xtra, ip)

      end

      { trap other cases }
      else error(esysflt71) { should not occur }

   end

end;

{ place single operand up link }

procedure plcupop(ip: intptr);

begin

   if ip^.up <> nil then error(esysflt9); { would mean we looped }
   ip^.up := ip; { place parent is self }
   case ip^.i of { intermediate }

      tigoto, tilabequ, tihalt: ; { no action }

      tiprccal, tiprccalo: plcupplst(ip^.flow2, ip); { parameter list }

      tiprccali: begin { procedure/function call }

         plcupexp(ip^.left, ip); { address }
         plcupplst(ip^.flow2, ip) { parameter list }

      end;

      tigotot, tigotof, tiwrteolt, tiredeolt, tiget, tigett, tiput, tireset,
      tirewrite, ticlose, tiupdate, tiappend, tipaget, tidel, tinew, tidisp, 
      tistoint, tistosrl, tistorel, tistochr, tistobol, tistoset, tistosrc, 
      tistofint, tistofsrl, tistofrel, tistofchr, tistofbol, tidspgar,
      tistogar, tistotgp, tistoftgp, ticalpar, tisignal, tisignalone, 
      tiwait: plcupexp(ip^.left, ip);

      tiwrtsrc, tiwrtintt, tiwrtchrt, tiwrtbolt, tiwrtrelt, tiwrtstrt,
      tistiint, tistisrl, tistirel, tistichr, tistibol, tistiset, tistisrc, 
      tistifint, tistifsrl, tistifrel, tistifchr, tistifbol, tiwrtsrl,
      tiwrtrel, tiwrtset, tiwrtbol, tiwrtchr, tiwrtint, tiredsrc, tiredintt,
      tiredchrt, tiredrelt, tiredsrlt, tipos, tichg, tiwrtgstt, tistigar, tistitgp,
      tistiftgp, tiassign, tinewgar, tiassert: begin

         plcupexp(ip^.left, ip);
         plcupexp(ip^.right, ip);

      end;
      tiwrtintft, tiwrtchrft, tiwrtbolft, tiwrtrelft, tiwrtstrft, tipack,
      tiunpack, tiwrtgstft: begin

         plcupexp(ip^.left, ip);
         plcupexp(ip^.right, ip);
         plcupexp(ip^.xtra, ip);

      end;
      tiwrtrelfft: begin

         plcupexp(ip^.left, ip); 
         plcupexp(ip^.right, ip);
         plcupexp(ip^.xtra, ip); 
         plcupexp(ip^.xtra2, ip);

      end;

      { structured entries }

      tiifbgn: begin { if statement }

         plcupexp(ip^.left, ip);
         plcup(ip^.flow2); { process true flow }
         plcup(ip^.flow3) { process false flow }

      end;

      tiwhlbgn, tirptbgn, ticasbgn: begin

         plcupexp(ip^.left, ip);
         plcup(ip^.flow2) { process enclosed flow }

      end;

      tiwthbgn: begin

         plcupexp(ip^.left, ip); { record base address }
         plcup(ip^.flow2) { process enclosed flow }

      end;

      tifortint, tifortchr, tifortbol, tifordint, tifordchr,
      tifordbol: begin

         plcupexp(ip^.left, ip); { start }
         plcupexp(ip^.right, ip); { end }
         plcup(ip^.flow2) { for loop }

      end;

      ticasstb, ticasels: plcup(ip^.flow2); { case entry }
 
      titrybgn: begin

         plcup(ip^.flow2); { protected block }
         plcup(ip^.flow3) { exception clause list }

      end;

      titryexp: begin

         plcupexp(ip^.left, ip); { exception variable }
         plcup(ip^.flow2) { exception statement block }

      end;

      titryels: plcup(ip^.flow2) { else statement block }

      else error(esysflt62) { should not occur }

   end

end;

begin

   while ip <> nil do begin { traverse this forward flow }

      plcupop(ip); { follow secondary flows single node }
      ip := ip^.flow { next in flow }

   end

end;

{******************************************************************************

Copy intermediate tree

Makes a new copy of an intermediate tree. Used to duplicate the file access
tree in chained read/write statements.

Only works on expression trees at present.

******************************************************************************}

procedure cpyint(sp: intptr; var dp: intptr);

begin

   getint(dp, sp^.i); { get a copy entry for this operator }
   dp^.base := sp^.base; { copy type bases }
   dp^.base2 := sp^.base2;
   dp^.base3 := sp^.base3;
   case sp^.i of { intermediate }

      tifnccali: begin

         cpyint(sp^.left, dp^.left); { copy function address expression }
         cpyint(sp^.flow2, dp^.flow2) { copy parameter list }

      end;
      tifnccal: cpyint(sp^.flow2, dp^.flow2); { copy parameter list }
      ticalpar: begin

         cpyint(sp^.left, dp^.left); { copy parameter expression }
         if sp^.flow <> nil then { there are further parameters }
            cpyint(sp^.flow, dp^.flow) { copy next parameter in list }

      end;

      tilodset, tilodsrc, tilimns, tilodadr, tilodint, tilodrel, tilodsrl, tilodchr, 
      tilodbol, tilodptr, tilimint, tilimrel, tilodfadr, tilodtgp: ;

      { unary operators }

      tieolt, tieof, tiloc, tilodafbuf, tilodafbuft, tiexist, tildiset, tildisrc, 
      ticvtntg, tildiint, tildichr, tildibol, tildiptr, tildirel, tildisrl, tinotint,
      tinotbol, tilodlen, ticvtgtf, tinegint, tiabsint, tisqrint, tiodd, tisucint, 
      tiprdint, tirngchk, tilditgp, ticvtftg, ticvtitr, tinegrel, tiabsrel, tisqrrel,
      tiatnrel, ticosrel, tiexprel, tilgnrel, tisinrel, tisqtrel, tirnd, tirecoff,
      titrc, tilen, tiaddintimm, timltintimm, tiandintimm, tiequintimm, tiequtgpimm,
      tineqintimm, tineqtgpimm, tiorintimm, tixorintimm, tileqintimm, tigeqintimm,
      tiltnintimm, tigtnintimm, tisubintimm, tiaddintlod, timltintlod, tiandintlod,
      tiequintlod, tiequtgplod, tineqintlod, tineqtgplod, tiorintlod, tixorintlod, 
      tileqintlod, tigeqintlod, tiltnintlod, tigtnintlod, 
      tisubintlod: cpyint(sp^.left, dp^.left);

      { binary operators }

      tidivint, timodint, tiintset, tiuniset, tidifset, tiarfgar, timltint, tiaddint,
      tisubint, tiandint, tiorint, tixorint, tisinset, tiarrref, tiincset, tiequset,
      tineqset, tileqset, tigeqset, timltrel, tidivrel, tiaddrel, tisubrel, tiequrel,
      tineqrel, tileqrel, tigeqrel, tiltnrel, tigtnrel, tiequgst, tineqgst, tigeqgst,
      tiltngst, tigtngst, tiequtgp, tineqtgp, tiequint, tineqint, tileqint, tigeqint,
      tiltnint, tigtnint, tiequstr, tineqstr, tileqstr, tigeqstr, tiltnstr, 
      tigtnstr, tileqgst, tiaddintldi, timltintldi, tiandintldi, tiequintldi,
      tiequtgpldi, tineqintldi, tineqtgpldi, tiorintldi, tixorintldi, 
      tileqintldi, tigeqintldi, tiltnintldi, tigtnintldi, tisubintldi
: begin

         cpyint(sp^.left, dp^.left);
         cpyint(sp^.right, dp^.right)

      end;

      { trinary operators }

      tirngset: begin

         cpyint(sp^.left, dp^.left);
         cpyint(sp^.right, dp^.right);
         cpyint(sp^.xtra, dp^.xtra)

      end

      else error(esysflt72) { should not occur }

   end

end;

{******************************************************************************

Check block contains floating point operator

Checks if the given block contains a floating point operator. This is used to
perform prologs and epilogs for floating point units.

******************************************************************************}

function chkintflt(ip: intptr): boolean;

var fltfnd: boolean; { found flag }

{ create expression temps }

procedure chkintfltexp(ip: intptr);

begin

{ ;write('chkintflt: intermediate: '); prttic(ip^.i, 1); writeln; }

   case ip^.i of { intermediate }

      tifnccal, tifnccalo: begin

         fltfnd := fltfnd or chkintflt(ip^.flow2); { parameter list }
         { should have function base }
         if ip^.base^.t <> tfunc then error(esysflt13);
         { check if function returns float }
         fltfnd := fltfnd or realt(ip^.base^.fncr)

      end;

      tifnccali: begin

         chkintfltexp(ip^.left); { address of function }
         fltfnd := fltfnd or chkintflt(ip^.flow2); { parameter list }
         { should have function base }
         if ip^.base^.t <> tpfunc then error(esysflt14);
         { check if function returns float }
         fltfnd := fltfnd or realt(ip^.base^.pfnr)

      end;

      tilimrel, tilodrel, tilodsrl: fltfnd := true; { set floating point operation }

      tildirel, tildisrl, ticvtitr, ticvtrtsr, tinegrel, tiabsrel, tisqrrel, tiatnrel, 
      ticosrel, tiexprel, tilgnrel, tisinrel, tisqtrel, tirnd, titrc: begin

         chkintfltexp(ip^.left);
         fltfnd := true; { set floating point operation }

      end;

      timltrel, tidivrel, tiaddrel, tisubrel, tiequrel, tineqrel,
      tileqrel, tigeqrel, tiltnrel, tigtnrel: begin

         chkintfltexp(ip^.left); 
         chkintfltexp(ip^.right);
         fltfnd := true; { set floating point operation }

      end;

      tilodset, tilimns,
      tilodsrc, tilodadr, tilodint, tilodchr, 
      tilodbol, tilodptr, tilimint, tilodfadr, tilodtgp: ;

      tieolt, tieof, tiloc, tilodafbuf, tilodafbuft, tiexist, tildiset, tildisrc, 
      ticvtntg, tildiint, tildichr, tildibol, tildiptr, tinotint,
      tinotbol, tilodlen, ticvtgtf, tinegint, tiabsint, tisqrint, tiodd, tisucint, 
      tiprdint, tirngchk, tilditgp, ticvtftg, tirecoff, tilen, tiaddintimm, 
      timltintimm, tiandintimm, tiequintimm, tiequtgpimm, tineqintimm, 
      tineqtgpimm, tiorintimm, tixorintimm, tileqintimm, tigeqintimm, 
      tiltnintimm, tigtnintimm, tisubintimm, tiaddintlod, timltintlod, tiandintlod,
      tiequintlod, tiequtgplod, tineqintlod, tineqtgplod, tiorintlod, tixorintlod,
      tileqintlod, tigeqintlod, tiltnintlod, tigtnintlod, 
      tisubintlod: chkintfltexp(ip^.left);

      tidivint, timodint, tiarfgar, timltint, tiaddint, tisubint, tiandint, tiorint,
      tixorint, tiarrref, tiequgst, tineqgst, tigeqgst, tiltngst, tigtngst, tiequtgp,
      tineqtgp, tiequint, tineqint, tileqint, tigeqint, tiltnint, tigtnint, tiequstr,
      tineqstr, tileqstr, tigeqstr, tiltnstr, tigtnstr, tiintset, tiuniset, tidifset,
      tiequset, tineqset, tileqset, tigeqset, tisinset, tiincset, tileqgst,
      tiaddintldi, timltintldi, tiandintldi, tiequintldi, tiequtgpldi, tineqintldi,
      tineqtgpldi, tiorintldi, tixorintldi, tileqintldi, tigeqintldi,
      tiltnintldi, tigtnintldi, tisubintldi: begin

         chkintfltexp(ip^.left); 
         chkintfltexp(ip^.right) 

      end;

      tirngset: begin

         chkintfltexp(ip^.left); 
         chkintfltexp(ip^.right);
         chkintfltexp(ip^.xtra)

      end

      { trap other cases }
      else error(esysflt80) { should not occur }

   end

end;

{ check floats for single operand }

procedure chkintfltop(ip: intptr);

begin

{ ;write('chkintfltop: intermediate: '); prtic(ip^.i, 1); writeln; }

   case ip^.i of { intermediate }

      tigoto, tilabequ, tihalt: ; { no action }

      tiprccal, 
      tiprccalo: fltfnd := fltfnd or chkintflt(ip^.flow2); { parameter list }

      tiprccali: begin { procedure/function call }

         chkintfltexp(ip^.left); { address }
         fltfnd := fltfnd or chkintflt(ip^.flow2) { parameter list }

      end;

      tistosrl, tistorel, tistofsrl, tistofrel: begin

         chkintfltexp(ip^.left);
         fltfnd := true; { set floating point operation }

      end;
      tiwrtrelt, tistisrl, tistirel, tistifsrl, tistifrel, tiwrtsrl, tiwrtrel, 
      tiredrelt, tiredsrlt: begin

         chkintfltexp(ip^.left);
         chkintfltexp(ip^.right);
         fltfnd := true; { set floating point operation }

      end;
      tiwrtrelft: begin

         chkintfltexp(ip^.left);
         chkintfltexp(ip^.right);
         chkintfltexp(ip^.xtra);
         fltfnd := true; { set floating point operation }

      end;
      tiwrtrelfft: begin

         chkintfltexp(ip^.left); 
         chkintfltexp(ip^.right);
         chkintfltexp(ip^.xtra); 
         chkintfltexp(ip^.xtra2);
         fltfnd := true; { set floating point operation }

      end;

      tigotot, tigotof, tiwrteolt, tiredeolt, tiget, tigett, tiput, tireset, tirewrite,
      ticlose, tiupdate, tiappend, tipaget, tidel, tinew, tidisp, tistoint,
      tistochr, tistobol, tistosrc, tistofint, tistofchr, tistofbol, tidspgar,
      tistogar, tistotgp, tistoftgp, tistoset, ticalpar, tisignal, tisignalone, 
      tiwait: chkintfltexp(ip^.left);

      tiwrtsrc, tiwrtintt, tiwrtchrt, tiwrtbolt, tiwrtstrt,
      tistiint, tistichr, tistibol, tistisrc, 
      tistifint, tistifchr, tistifbol,
      tiwrtset, tiwrtbol, tiwrtchr, tiwrtint, tiredsrc, tiredintt,
      tiredchrt, tipos, tichg, tiwrtgstt, tistigar, tistitgp,
      tistiftgp, tiassign, tinewgar, tistiset, tiassert: begin

         chkintfltexp(ip^.left);
         chkintfltexp(ip^.right)

      end;
      tiwrtintft, tiwrtchrft, tiwrtbolft, tiwrtstrft, tipack,
      tiunpack, tiwrtgstft: begin

         chkintfltexp(ip^.left);
         chkintfltexp(ip^.right);
         chkintfltexp(ip^.xtra)

      end;

      { structured entries }

      tiifbgn: begin { if statement }

         chkintfltexp(ip^.left);
         fltfnd := fltfnd or chkintflt(ip^.flow2); { process true flow }
         fltfnd := fltfnd or chkintflt(ip^.flow3) { process false flow }

      end;

      tiwhlbgn, tirptbgn, ticasbgn: begin

         chkintfltexp(ip^.left);
         fltfnd := fltfnd or chkintflt(ip^.flow2) { process enclosed flow }

      end;

      tiwthbgn: begin

         chkintfltexp(ip^.left); { record address }
         fltfnd := fltfnd or chkintflt(ip^.flow2) { process enclosed flow }

      end;

      tifortint, tifortchr, tifortbol, tifordint, tifordchr,
      tifordbol: begin

         chkintfltexp(ip^.left); { start }
         chkintfltexp(ip^.right); { end }
         fltfnd := fltfnd or chkintflt(ip^.flow2) { for loop }

      end;

      ticasstb, ticasels: fltfnd := fltfnd or chkintflt(ip^.flow2); { case entry }

      titrybgn: begin

         fltfnd := fltfnd or chkintflt(ip^.flow2); { protected block }
         fltfnd := fltfnd or chkintflt(ip^.flow3) { exception clause list }

      end;

      titryexp: begin

         chkintfltexp(ip^.left); { exception variable }
         fltfnd := fltfnd or chkintflt(ip^.flow2) { exception statement block }

      end;

      titryels: fltfnd := fltfnd or chkintflt(ip^.flow2) { else statement block }

      { trap other cases }
      else error(esysflt83) { should not occur }

   end

end;

begin

   fltfnd := false; { set no floating point op found }
   while ip <> nil do begin { traverse this forward flow }

      chkintfltop(ip); { follow secondary flows single node }
      ip := ip^.flow { next in flow }

   end;
   chkintflt := fltfnd { return result }

end;

{******************************************************************************

Place result types

The result type gives the type of result for an operator, and is only present
on expression operators. In cases, the result type is obvious, such as a load.
In others, it is derived, for example, an add has integer result because
all operations take place in an integer domain.

The original intermediate only comes with types where required to make sense
of the operation. Placing the result type makes it possible to allways
determine the result type from an operator entry, and thus, also the leaves
of an operator.

Note: currently a lot of pointer types are generated to accurately reflect
the types of results. This could be kept down in size by introducing a system
to find previous coined pointers.

******************************************************************************}

procedure plcrestyp(ip: intptr);

var tp: typptr;

{ place expression result type }

procedure plcrestypexp(ip: intptr);

{ find result type for integer combination }

function intrestyp: typptr;

var tp, tpl, tpr: typptr;

{ convert acceptable integer alternatives.
  Because ord does not show up in trees, enumerations, booleans
  characters }

procedure cvtint(var tp: typptr);

begin

   if tp^.t in [tenum, tchar, tboolean] then tp := gblint

end; 

begin

   { get base type for both }
   tpl := baset(ip^.left^.rbase);
   tpr := baset(ip^.right^.rbase);
   cvtint(tpl); { convert operands to integer if applicable }
   cvtint(tpr);
   if not (tpl^.t in [tinteger, tlinteger, tcardinal, tlcardinal]) then
      error(esysflt94); { system check }
   if tpl^.t = tpr^.t then tp := tpl { types identical, use that }
   else begin

      { long integer overrides any other type }
      if (tpl^.t = tlinteger) or (tpr^.t = tlinteger) then tp := gbllint
      else begin

         { long cardinal with integer is long integer }
         if ((tpl^.t = tinteger) and (tpr^.t = tlcardinal)) or
            ((tpl^.t = tlcardinal) and (tpr^.t = tinteger)) then tp := gbllint
         else begin
         
            { integer overrides cardinal }
            if (tpl^.t = tinteger) or (tpr^.t = tinteger) then tp := gblint
            else begin

               { long cardinal overrides cardinal }
               if (tpl^.t = tlcardinal) or (tpr^.t = tlcardinal) then 
                  tp := gbllcard

            end

         end

      end

   end;

   intrestyp := tp { return result }

end;

begin

{ ;write('plcrestypexp: intermediate: '); prtic(ip^.i, 1); writeln; }
   case ip^.i of { intermediate }

      tifnccal, tifnccalo: begin

         plcrestyp(ip^.flow2); { parameter list }
         if ip^.base^.t <> tfunc then error(esysflt21);
         ip^.rbase := baset(ip^.base^.fncr) { get result type as operator type }

      end;

      tifnccali: begin

         plcrestypexp(ip^.left); { address of function }
         plcrestyp(ip^.flow2); { parameter list }
         if (ip^.base^.t <> tfunc) and (ip^.base^.t <> tpfunc) then 
            error(esysflt22);
         { get result type as operator type }
         if ip^.base^.t = tfunc then ip^.rbase := baset(ip^.base^.fncr)
         else ip^.rbase := baset(ip^.base^.pfnr)

      end;

      tilodset, tilimns: ip^.rbase := gblset;

      tilodint, tilimint: begin 

         if ip^.i = tilodint then 
            ip^.rbase := basest(ip^.base) { set result from base }
         else ip^.rbase := gblint; { set to standard integer }
         { A quirk of the intermediate format is that pointer variables can be
           loaded via integer load instructions. We recognize this case and
           convert back to a proper pointer. }
         if ip^.base^.t = tvpar then begin

            { is a var parameter, the resulting type is a pointer to the base
              type }
            gettypa(ip^.rbase, tptr); { get pointer }
            ip^.rbase^.ptrt := ip^.base^.vprt { set base }

         end else if ip^.base^.t = twpar then begin 

            { coin pointer for view parameter }
            if ip^.base^.wprt^.t in [trecord, tarray, tgarry] then begin

               { its a structure, will handle as pointer }
               gettyp(ip^.rbase, tptr); { make defacto pointer }
               ip^.rbase^.ptrt := ip^.base^.wprt { set to base type }

            end

         end else begin

            { conventional pointer }
            tp := baset(ip^.base); { check pointer base }
            if tp^.t = tptr then ip^.rbase := tp { set pointer result }

         end

      end;

      tilodrel, tilimrel: ip^.rbase := gblreal;
 
      tilodsrl: ip^.rbase := gblsreal;

      tilodchr: ip^.rbase := gblint; { is integer because it might be expanded }

      tilodbol: ip^.rbase := gblbool;

      tilodsrc: ip^.rbase := baset(ip^.base); { same as base }

      tilodptr, tilodtgp: begin

         if ip^.base^.t = tvpar then begin { coin pointer for var parameter }

            gettyp(ip^.rbase, tptr); { make defacto pointer }
            ip^.rbase^.ptrt := ip^.base^.vprt { set to base type }

         end else if ip^.base^.t = twpar then begin 

            { coin pointer for view parameter }
            if ip^.base^.wprt^.t in [trecord, tarray, tgarry] then begin

               { its a structure, will handle as pointer }
               gettyp(ip^.rbase, tptr); { make defacto pointer }
               ip^.rbase^.ptrt := ip^.base^.wprt { set to base type }

            end else ip^.rbase := baset(ip^.base); { same as base }

         end else ip^.rbase := baset(ip^.base); { same as base }

      end;

      tilodadr, tilodfadr: begin

         { Check var parameter, or view parameter to structured element.
           These will end up being pointers to pointers. }
         tp := baset(ip^.base); { set base type of operand }
         if ip^.base^.t = tvpar then begin { var } 
            
            gettyp(tp, tptr); { make defacto pointer }
            tp^.ptrt := ip^.base^.vprt { set type is general array }

         end else if ip^.base^.t = twpar then begin { view }

            if ip^.base^.wprt^.t in [tarray, tgarry, trecord, tset] then begin

               { structured type }
               gettyp(tp, tptr); { make defacto pointer }
               tp^.ptrt := ip^.base^.wprt { set type is general array }

            end

         end else if (ip^.base^.t = tpproc) or (ip^.base^.t = tpfunc) then begin

            { procedure/function parameter }
            gettyp(tp, tptr); { make defacto pointer }
            { There is no such thing as a procedure or function type, so it gets
              an anonymous pointer. }
            tp^.ptrt := gblnil 

         end;
         gettypa(ip^.rbase, tptr); { get pointer }
         ip^.rbase^.ptrt := tp { set base }

      end;

      tieolt, tieof, tildibol, tinotbol, tiodd, tiexist: begin

         plcrestypexp(ip^.left);
         ip^.rbase := gblint { is integer because it might be expanded }

      end;

      tildiint: begin

         plcrestypexp(ip^.left);
         ip^.rbase := basest(ip^.base)

      end;

      tinotint, tinegint, tiabsint, tisqrint, tiaddintimm, timltintimm, 
      tiandintimm, tiequintimm, tiequtgpimm, tineqintimm, tineqtgpimm, 
      tiorintimm, tixorintimm, tileqintimm, tigeqintimm, tiltnintimm,
      tigtnintimm, tisubintimm, tiaddintlod, timltintlod, tiandintlod,
      tiequintlod, tiequtgplod, tineqintlod, tineqtgplod, tiorintlod,
      tixorintlod, tileqintlod, tigeqintlod, tiltnintlod, tigtnintlod,
      tisubintlod: begin

         plcrestypexp(ip^.left);
         { type is same as source }
         ip^.rbase := baset(ip^.left^.rbase)

      end;

      tiloc, tilen, tilodlen, tirnd, 
      titrc: begin

         plcrestypexp(ip^.left);
         ip^.rbase := gblint

      end;

      tildirel, ticvtitr, tinegrel, tiabsrel, tisqrrel, tiatnrel, ticosrel, tiexprel,
      tilgnrel, tisinrel, tisqtrel: begin

         plcrestypexp(ip^.left);
         ip^.rbase := gblreal

      end;

      tildiset: begin

         plcrestypexp(ip^.left);
         ip^.rbase := gblset

      end;

      tildichr: begin

         plcrestypexp(ip^.left);
         ip^.rbase := gblint

      end;

      tildisrl: begin

         plcrestypexp(ip^.left);
         ip^.rbase := gblsreal

      end;

      tildisrc, tirngchk: begin

         plcrestypexp(ip^.left);
         ip^.rbase := ip^.base

      end;

      tilodafbuft: begin

         plcrestypexp(ip^.left);
         gettypa(ip^.rbase, tptr);
         ip^.rbase^.ptrt := gblchr { is integer because it might be expanded }

      end;

      tilodafbuf: begin

         plcrestypexp(ip^.left);
         { Will be a pointer to a file, we must get the file type from that. }
         tp := ip^.left^.rbase; { get pointer type }
         if tp^.t <> tptr then error(esysflt23);
         tp := tp^.ptrt;
         if tp^.t <> tfile then error(esysflt24);
         gettypa(ip^.rbase, tptr);
         ip^.rbase^.ptrt := tp^.filt { set base type }

      end;

      tirecoff: begin

         plcrestypexp(ip^.left);
         { make sure is a record field }
         if (ip^.base^.t <> tfield) and (ip^.base^.t <> tftag) then 
            error(esysflt25);
         gettypa(ip^.rbase, tptr);
         { set base type is field type }
         if ip^.base^.t = tfield then ip^.rbase^.ptrt := ip^.base^.fldt
         else ip^.rbase^.ptrt := ip^.base^.ftgt

      end;

      tisucint, tiprdint: begin

         plcrestypexp(ip^.left);
         ip^.rbase := gblint { is integer because it might be expanded }

      end;

      tildiptr: begin

         plcrestypexp(ip^.left);
         { Load indirect pointer implies that we have a pointer to another
           pointer. Both are verified to be true, then the base type becomes
           the pointer without one level of indirection. }
         if ip^.left^.rbase^.t <> tptr then error(esysflt26);
         ip^.rbase := baset(ip^.left^.rbase^.ptrt); { set base type }
         if ip^.rbase^.t <> tptr then error(esysflt27)

      end;

      tilditgp: begin

         plcrestypexp(ip^.left);
         { Load indirect tagged pointer implies that we have a pointer to 
           another pointer that is tagged. Both are verified to be true,
           then the base type becomes the pointer without one level of
           indirection. }
         if ip^.left^.rbase^.t <> tptr then error(esysflt28);
         ip^.rbase := ip^.left^.rbase^.ptrt; { set base type }
         if not tgpt(ip^.rbase) then error(esysflt29)

      end;

      ticvtgtf: begin

         plcrestypexp(ip^.left);
         ip^.rbase := ip^.base { same as fixed array base }

      end;

      ticvtftg: begin

         plcrestypexp(ip^.left);
         { There isn't any context for the general array pointer that must be
           derived from the fixed type provided, so we create a type on the
           spot for this. }
         if (ip^.base^.t <> tarray) and (ip^.base^.t <> tscst) then 
            error(esysflt30);
         gettypa(ip^.rbase, tptr);
         gettypa(tp, tgarry);
         if ip^.base^.t = tscst then tp^.gart := gblchr { string }
         else tp^.gart := ip^.base^.arrt; { set base type for general array }
         ip^.rbase^.ptrt := tp { place type for array }

      end;

      ticvtntg: begin

         plcrestypexp(ip^.left);
         ip^.rbase := gblnil { Type base as the nil pointer. }

      end;

      ticvtrtsr: begin

         plcrestypexp(ip^.left);
         ip^.rbase := gblsreal

      end;

      tidivint, timodint, timltint, tiaddint, tisubint, timltintldi,
      tiaddintldi, tisubintldi, tiandint, tiorint, tixorint, tiandintldi, 
      tiorintldi, tixorintldi: begin

         plcrestypexp(ip^.left); 
         plcrestypexp(ip^.right);
         ip^.rbase := intrestyp { find integer combination type }

      end;

      tiintset, tiuniset, tidifset: begin

         plcrestypexp(ip^.left); 
         plcrestypexp(ip^.right); 
         ip^.rbase := gblset

      end;

      tiequset, tineqset, tileqset, tigeqset, tiequrel, tineqrel, tileqrel, tigeqrel,
      tiltnrel, tigtnrel, tiequgst, tineqgst, tigeqgst, tiltngst, tigtngst, tiequtgp,
      tineqtgp, tiequint, tineqint, tileqint, tigeqint, tiltnint, tigtnint, tiequstr,
      tineqstr, tileqstr, tigeqstr, tiltnstr, tigtnstr, tiincset, tileqgst,
      tiequtgpldi, tineqtgpldi, tiequintldi, tineqintldi, tileqintldi, 
      tigeqintldi, tiltnintldi, tigtnintldi: begin

         plcrestypexp(ip^.left); 
         plcrestypexp(ip^.right); 
         ip^.rbase := gblint { is integer because it might be expanded }

      end;

      timltrel, tidivrel, tiaddrel, tisubrel: begin

         plcrestypexp(ip^.left); 
         plcrestypexp(ip^.right); 
         ip^.rbase := gblreal

      end;

      tisinset: begin

         plcrestypexp(ip^.left); 
         plcrestypexp(ip^.right);
         ip^.rbase := ip^.left^.rbase

      end;

      tiarrref: begin

         plcrestypexp(ip^.left); 
         plcrestypexp(ip^.right);
         if ip^.left^.rbase^.t <> tptr then error(esysflt19);
         tp := ip^.left^.rbase^.ptrt;
         if (tp^.t <> tarray) and 
            (tp^.t <> tscst) then error(esysflt31);
         gettypa(ip^.rbase, tptr);
         if tp^.t = tscst then ip^.rbase^.ptrt := gblchr { string }
         else ip^.rbase^.ptrt := tp^.arrt { set base }

      end;

      tiarfgar: begin

         plcrestypexp(ip^.left); 
         plcrestypexp(ip^.right);
         if ip^.left^.rbase^.t <> tptr then error(esysflt33);
         if ip^.left^.rbase^.ptrt^.t <> tgarry then error(esysflt32);
         gettypa(ip^.rbase, tptr);
         ip^.rbase^.ptrt := ip^.left^.rbase^.ptrt^.gart { set base }

      end;

      tirngset: begin

         plcrestypexp(ip^.left); 
         plcrestypexp(ip^.right);
         plcrestypexp(ip^.xtra);
         ip^.rbase := ip^.left^.rbase

      end

      { trap other cases }
      else error(esysflt73) { should not occur }

   end
{ ;write('plcrestypexp: intermediate: -'); prtic(ip^.i, 1); writeln; }

end;

{ place single operand result type }

procedure plcrestypop(ip: intptr);

begin

{ ;write('plcrestypop: intermediate: '); prtic(ip^.i, 1); writeln; }
   case ip^.i of { intermediate }

      tigoto, tilabequ, tihalt: ; { no action }

      tiprccal, tiprccalo: plcrestyp(ip^.flow2); { parameter list }

      tiprccali: begin { procedure/function call }

         plcrestypexp(ip^.left); { address }
         plcrestyp(ip^.flow2) { parameter list }

      end;

      tigotot, tigotof, tiwrteolt, tiredeolt, tiget, tigett, tiput, tireset, tirewrite,
      ticlose, tiupdate, tiappend, tipaget, tidel, tinew, tidisp, tistoint,
      tistosrl, tistorel, tistochr, tistobol, tistoset, tistosrc, tistofint,
      tistofsrl, tistofrel, tistofchr, tistofbol, tidspgar, tistogar, tistotgp,
      tistoftgp, ticalpar, tisignal, tisignalone, tiwait: plcrestypexp(ip^.left);

      tiwrtsrc, tiwrtintt, tiwrtchrt, tiwrtbolt, tiwrtrelt, tiwrtstrt,
      tistiint, tistisrl, tistirel, tistichr, tistibol, tistiset, tistisrc, 
      tistifint, tistifsrl, tistifrel, tistifchr, tistifbol, tiwrtsrl,
      tiwrtrel, tiwrtset, tiwrtbol, tiwrtchr, tiwrtint, tiredsrc, tiredintt,
      tiredchrt, tiredrelt, tiredsrlt, tipos, tichg, tiwrtgstt, tistigar, tistitgp,
      tistiftgp, tiassign, tinewgar, tiassert: begin

         plcrestypexp(ip^.left);
         plcrestypexp(ip^.right);

      end;
      tiwrtintft, tiwrtchrft, tiwrtbolft, tiwrtrelft, tiwrtstrft, tipack,
      tiunpack, tiwrtgstft: begin

         plcrestypexp(ip^.left);
         plcrestypexp(ip^.right);
         plcrestypexp(ip^.xtra);

      end;
      tiwrtrelfft: begin

         plcrestypexp(ip^.left); 
         plcrestypexp(ip^.right);
         plcrestypexp(ip^.xtra); 
         plcrestypexp(ip^.xtra2);

      end;

      { structured entries }

      tiifbgn: begin { if statement }

         plcrestypexp(ip^.left);
         plcrestyp(ip^.flow2); { process true flow }
         plcrestyp(ip^.flow3) { process false flow }

      end;

      tiwhlbgn, tirptbgn, ticasbgn: begin

         plcrestypexp(ip^.left);
         plcrestyp(ip^.flow2) { process enclosed flow }

      end;

      tiwthbgn: begin

         plcrestypexp(ip^.left); { record base address }
         plcrestyp(ip^.flow2) { process enclosed flow }

      end;

      tifortint, tifortchr, tifortbol, tifordint, tifordchr,
      tifordbol: begin

         plcrestypexp(ip^.left); { start }
         plcrestypexp(ip^.right); { end }
         plcrestyp(ip^.flow2) { for loop }

      end;

      ticasstb, ticasels: plcrestyp(ip^.flow2); { case entry }

      titrybgn: begin

         plcrestyp(ip^.flow2); { protected block }
         plcrestyp(ip^.flow3) { exception clause list }

      end;

      titryexp: begin

         plcrestypexp(ip^.left); { exception variable }
         plcrestyp(ip^.flow2) { exception statement block }

      end;

      titryels: plcrestyp(ip^.flow2) { else statement block }

      { trap other cases }
      else error(esysflt63) { should not occur }

   end
{ ;write('plcrestypop: intermediate: -'); prtic(ip^.i, 1); writeln; }

end;

begin

   while ip <> nil do begin { traverse this forward flow }

      plcrestypop(ip); { follow secondary flows single node }
      ip := ip^.flow { next in flow }

   end

end;

{******************************************************************************

Place type restrictions

Places type restrictions in the given intermediate graph. Type restrictions
are limits to the range of integer types that propagate outwards from one of
the following operations:

1. Store, direct or indirect.

2. Value or view parameters (which are essentially a store to the parameter).

3. Array indexes.

4. Built in function parameters.

5. "for" start and end expressions (which are ranged according to the index
type).

6. The range check operator.

A restriction point from the above list creates a point in the graph that any
excess precision will be discarded. This restriction can be propagated
downwards into the intermediate if the operand is terminal, that is, if it
is a simple load that does not change the value of the operand.

******************************************************************************}

procedure restrict(ip: intptr);

{ check operator entry is terminal, that is, has no branches, and integer
  result }

function chktrm(ip: intptr): boolean;

begin

   chktrm :=  (ip^.i = tilimint) or (ip^.i = tilodint) or (ip^.i = tilodchr) or
              (ip^.i = tilodbol) or (ip^.i = tildiint) or (ip^.i = tildichr) or
              (ip^.i = tildibol)    

end;

{ restrict subexpression to type }

procedure restrictto(ip: intptr;  { expression to restrict }
                     tp: typptr); { type to restrict to }


begin

   { if operator is terminal, place the restriction }
   if chktrm(ip) then ip^.rbase := tp

end;

{ search for restrictor candidates in expression }

procedure restrictexp(ip: intptr);

begin

{ ;write('restrictexp: intermediate: '); prtic(ip^.i, 1); writeln; }

   case ip^.i of { intermediate }

      tirngchk: begin

         restrictexp(ip^.left);
         restrictto(ip^.left, ip^.base) { restrict to specified range }

      end;

      tiarrref: begin

         restrictexp(ip^.left); 
         restrictexp(ip^.right);
         if ip^.base^.t <> tarray then error(einvfmt);
         restrictto(ip^.right, ip^.base^.arri) { restrict to index type }

      end;

      tifnccal, tifnccalo: restrict(ip^.flow2); { parameter list }

      tifnccali: begin

         restrictexp(ip^.left); { address of function }
         restrict(ip^.flow2) { parameter list }

      end;

      tilodadr, tilodfadr, tilodset, tilimns, tilodint, tilimint, tilodrel, tilimrel,
      tilodsrl, tilodchr, tilodbol, tilodsrc, tilodptr, tilodtgp: ; { no action }

      tieolt, tieof, tildibol, tinotbol, tiodd, tiexist, tiloc, tilen, tildiint, tinotint,
      tilodlen, tinegint, tiabsint, tisqrint, tirnd, titrc, tildirel, ticvtitr,
      tinegrel, tiabsrel, tisqrrel, tiatnrel, ticosrel, tiexprel, tilgnrel, tisinrel,
      tisqtrel, tildiset, tildichr, tildisrl, tildisrc, tilodafbuft, tilodafbuf,
      tirecoff, tisucint, tiprdint, tildiptr, tilditgp, ticvtgtf, ticvtftg, ticvtntg,
      ticvtrtsr, tiaddintimm, timltintimm, tiandintimm, tiequintimm, 
      tiequtgpimm, tineqintimm, tineqtgpimm, tiorintimm,  tixorintimm, 
      tileqintimm, tigeqintimm, tiltnintimm, tigtnintimm, 
      tisubintimm, tiaddintlod, timltintlod, tiandintlod, tiequintlod,
      tiequtgplod, tineqintlod, tineqtgplod, tiorintlod, tixorintlod, tileqintlod,
      tigeqintlod, tiltnintlod, tigtnintlod, tisubintlod: restrictexp(ip^.left);

      tidivint, timodint, timltint, tiaddint, tisubint, tiandint, tiorint, tixorint,
      tiintset, tiuniset, tidifset, tiequset, tineqset, tileqset, tigeqset, tiequrel,
      tineqrel, tileqrel, tigeqrel, tiltnrel, tigtnrel, tiequgst, tineqgst, tigeqgst,
      tiltngst, tigtngst, tiequtgp, tineqtgp, tiequint, tineqint, tileqint, tigeqint,
      tiltnint, tigtnint, tiequstr, tineqstr, tileqstr, tigeqstr, tiltnstr, tigtnstr,
      tiincset, timltrel, tidivrel, tiaddrel, tisubrel, tisinset, tileqgst,
      tiarfgar, tiaddintldi, timltintldi, tiandintldi, tiequintldi, tiequtgpldi,
      tineqintldi, tineqtgpldi, tiorintldi, tixorintldi, tileqintldi, 
      tigeqintldi, tiltnintldi, tigtnintldi, tisubintldi: begin

         restrictexp(ip^.left); 
         restrictexp(ip^.right);

      end;

      tirngset: begin

         restrictexp(ip^.left); 
         restrictexp(ip^.right);
         restrictexp(ip^.xtra);

      end

      { trap other cases }
      else error(esysflt74) { should not occur }

   end

{ ;write('restrictexp: intermediate: -'); prtic(ip^.i, 1); writeln; }

end;

{ Search for restrictor candidates }

procedure restrictop(ip: intptr);

{ find base of variable }

function basvar(tp: typptr): typptr;

begin

   if (tp^.t <> tvar) and (tp^.t <> tfix) and (tp^.t <> tfunc) and 
      (tp^.t <> tpar) and (tp^.t <> tvpar) and 
      (tp^.t <> twpar) and (tp^.t <> tfield) and
      (tp^.t <> tftag) then error(einvfmt); { bad format }
   case tp^.t of { type }

      tvar:     tp := tp^.vart; { link type }
      tfix:     tp := tp^.fixt; { link type }
      tfunc:    tp := tp^.fncr; { link return type for function }
      tpar:     tp := tp^.part; { link type }
      tvpar:    tp := tp^.vprt; { link type }
      twpar:    tp := tp^.wprt; { link type }
      tfield:   tp := tp^.fldt; { link type }
      tftag:    tp := tp^.ftgt  { link type }

   end;

   basvar := tp { return result }

end;

begin

{ ;write('restrictop: intermediate: '); prtic(ip^.i, 1); writeln; }

   case ip^.i of { intermediate }

      tigoto, tilabequ, tihalt: ; { no action }

      tiprccal, tiprccalo: restrict(ip^.flow2); { parameter list }

      tiprccali: begin { procedure/function call }

         restrictexp(ip^.left); { address }
         restrict(ip^.flow2) { parameter list }

      end;

      ticalpar: begin

         restrictexp(ip^.left);
         restrictto(ip^.left, ip^.base) { restrict to specified range }

      end;

      tigotot, tigotof: begin

         restrictexp(ip^.left); { process any subrestrictions }
         restrictto(ip^.left, gblbool) { restrict to boolean }

      end;

      tistoint, tistochr, tistobol, tistofint, tistofchr, tistofbol: begin

         restrictexp(ip^.left); { process any subrestrictions }
         restrictto(ip^.left, basvar(ip^.base)) { restrict to result type }

      end;

      tiwrtchrt: begin

         restrictexp(ip^.left);
         restrictexp(ip^.right);
         restrictto(ip^.right, gblchr) { restrict to char }

      end;

      tiwrtbolt: begin

         restrictexp(ip^.left);
         restrictexp(ip^.right);
         restrictto(ip^.right, gblbool) { restrict to boolean }

      end;

      tistiint, tistichr, tistibol, tistifint, tistifchr, tistifbol: begin

         restrictexp(ip^.left);
         restrictexp(ip^.right);
         if ip^.base^.t = tfunc then 
            restrictto(ip^.right, ip^.base^.fncr) { restrict to result type }
         else 
            restrictto(ip^.right, ip^.base) { restrict to result type }

      end;

      tiwrtchrft: begin

         restrictexp(ip^.left);
         restrictexp(ip^.right);
         restrictexp(ip^.xtra);
         restrictto(ip^.right, gblchr) { restrict to char }

      end;

      tiwrtbolft: begin

         restrictexp(ip^.left);
         restrictexp(ip^.right);
         restrictexp(ip^.xtra);
         restrictto(ip^.right, gblbool) { restrict to boolean }

      end;

      tiwrteolt, tiredeolt, tiget, tigett, tiput, tireset, tirewrite, ticlose,
      tiupdate, tiappend, tipaget, tidel, tinew, tidisp, tistosrl, tistorel,
      tistoset, tistosrc, tistofsrl, tistofrel, tidspgar, tistogar, tistotgp,
      tistoftgp, tisignal, tisignalone, tiwait: restrictexp(ip^.left);

      tiwrtsrc, tiwrtintt, tiwrtrelt, tiwrtstrt, tistisrl, tistirel, tistiset, tistisrc,
      tistifsrl, tistifrel, tiwrtsrl, tiwrtrel, tiwrtset, tiwrtbol, tiwrtchr, tiwrtint,
      tiredsrc, tiredintt, tiredchrt, tiredrelt, tiredsrlt, tipos, tichg, tiwrtgstt,
      tistigar, tistitgp, tistiftgp, tiassign, tinewgar, tiassert: begin

         restrictexp(ip^.left);
         restrictexp(ip^.right);

      end;
      tiwrtintft, tiwrtrelft, tiwrtstrft, tipack,
      tiunpack, tiwrtgstft: begin

         restrictexp(ip^.left);
         restrictexp(ip^.right);
         restrictexp(ip^.xtra);

      end;
      tiwrtrelfft: begin

         restrictexp(ip^.left); 
         restrictexp(ip^.right);
         restrictexp(ip^.xtra); 
         restrictexp(ip^.xtra2);

      end;

      { structured entries }

      tiifbgn: begin { if statement }

         restrictexp(ip^.left);
         restrict(ip^.flow2); { process true flow }
         restrict(ip^.flow3); { process false flow }
         restrictto(ip^.left, gblbool) { restrict to boolean }

      end;

      tiwhlbgn, tirptbgn, ticasbgn: begin

         restrictexp(ip^.left);
         restrict(ip^.flow2); { process enclosed flow }
         restrictto(ip^.left, gblbool) { restrict to boolean }

      end;

      tiwthbgn: begin

         restrictexp(ip^.left); { record base address }
         restrict(ip^.flow2); { process enclosed flow }
         restrictto(ip^.left, gblbool) { restrict to boolean }

      end;

      tifortint, tifortchr, tifortbol, tifordint, tifordchr,
      tifordbol: begin

         restrictexp(ip^.left); { start }
         restrictexp(ip^.right); { end }
         restrict(ip^.flow2); { for loop }
         restrictto(ip^.left, ip^.base); { restrict start to index type }
         restrictto(ip^.right, ip^.base) { restrict start to index type }

      end;

      ticasstb, ticasels: restrict(ip^.flow2); { case entry }

      titrybgn: begin

         restrict(ip^.flow2); { protected block }
         restrict(ip^.flow3) { exception clause list }

      end;

      titryexp: begin

         restrictexp(ip^.left); { exception variable }
         restrict(ip^.flow2) { exception statement block }

      end;

      titryels: restrict(ip^.flow2) { else statement block }

      { trap other cases }
      else error(esysflt64) { should not occur }

   end

{ ;write('restrictop: intermediate: -'); prtic(ip^.i, 1); writeln; }

end;

begin

   while ip <> nil do begin { traverse this forward flow }

      restrictop(ip); { follow secondary flows single node }
      ip := ip^.flow { next in flow }

   end

end;

{******************************************************************************

Simplify load/stores

Simplifies load from address and store to an address to direct loads and
direct stores. Accepts a basic intermediates terminal graph.

******************************************************************************}

procedure lodsto(var mip: intptr);

var ip, ip1: intptr;

{ load/store expression }

procedure lodstoexp(var ip: intptr);

var ip2, ip3: intptr;

begin

   case ip^.i of { intermediate }

      { no action required entries }
      tilodset, tilimns, tilodint, tilimint, tilodrel, tilimrel, tilodsrl, tilodchr, 
      tilodbol, tilodsrc, tilodptr, tilodtgp, tilodadr, tilodfadr: ;

      { unary }
      tieolt, tieof, tinotbol, tiodd, tiexist, tiloc, tilen, tinotint, tilodlen, tinegint,
      tiabsint, tisqrint, tirnd, titrc, ticvtitr, tinegrel, tiabsrel, tisqrrel, tiatnrel,
      ticosrel, tiexprel, tilgnrel, tisinrel, tisqtrel, tirngchk, tilodafbuft, 
      tilodafbuf, tirecoff, tisucint, tiprdint, ticvtgtf, ticvtftg, ticvtntg, 
      ticvtrtsr, tiaddintimm, timltintimm, tiandintimm, tiequintimm, 
      tiequtgpimm, tineqintimm, tineqtgpimm, tiorintimm, tixorintimm, 
      tileqintimm, tigeqintimm, tiltnintimm, tigtnintimm, 
      tisubintimm, tiaddintlod, timltintlod, tiandintlod, tiequintlod,
      tiequtgplod, tineqintlod, tineqtgplod, tiorintlod, tixorintlod, tileqintlod,
      tigeqintlod, tiltnintlod, tigtnintlod, tisubintlod: lodstoexp(ip^.left);

      { binary }
      tidivint, timodint, timltint, tiaddint, tisubint, tiandint, tiorint, 
      tixorint, tiintset, tiuniset, tidifset, tiequset, tineqset, tileqset, tigeqset,
      tiequrel, tineqrel, tileqrel, tigeqrel, tiltnrel, tigtnrel, tiequgst, tineqgst, 
      tigeqgst, tiltngst, tigtngst, tiequtgp, tineqtgp, tiequint, tineqint, tileqint,
      tigeqint, tiltnint, tigtnint, tiequstr, tineqstr, tileqstr, tigeqstr, tiltnstr,
      tigtnstr, tiincset, timltrel, tidivrel, tiaddrel, tisubrel, tisinset, tiarrref,
      tiarfgar, tileqgst, tiaddintldi, timltintldi, tiandintldi, tiequintldi,
      tiequtgpldi, tineqintldi, tineqtgpldi, tiorintldi, tixorintldi, tileqintldi,
      tigeqintldi, tiltnintldi, tigtnintldi, tisubintldi: begin

         lodstoexp(ip^.left); 
         lodstoexp(ip^.right);

      end;

      { trinary }
      tirngset: begin

         lodstoexp(ip^.left); 
         lodstoexp(ip^.right);
         lodstoexp(ip^.xtra)

      end;

      tifnccal, tifnccalo: lodsto(ip^.flow2); { parameter list }

      tifnccali: begin

         lodstoexp(ip^.left); { address of function }
         lodsto(ip^.flow2) { parameter list }

      end;

      { indirect load cases }
      tildiint, tildibol, tildirel, tildiset, tildichr, tildisrl, tildisrc, tildiptr,
      tilditgp: begin

         { check load address is constant }
         if (ip^.left^.i = tilodadr) or (ip^.left^.i = tilodfadr) then begin

            { we can simplify this load }
            if chkconsti(ip^.left^.base) then
               { Its a simple constant. We can reduce this to load immediate. }
               getint(ip2, tilimint) { get immediate entry }
            else begin { simplify to ilod }

               case ip^.i of { get a direct load entry by type }

                  tildiint: getint(ip2, tilodint);
                  tildibol: getint(ip2, tilodbol);
                  tildirel: getint(ip2, tilodrel);
                  tildiset: getint(ip2, tilodset);
                  tildichr: getint(ip2, tilodchr);
                  tildisrl: getint(ip2, tilodsrl);
                  tildisrc: getint(ip2, tilodsrc);
                  { Ldiptr was an alternative to the tagged ldiint, but there were
                    never store or direct loads for it. We go back to the integer
                    equals pointer method. }
                  tildiptr: getint(ip2, tilodint);
                  tilditgp: getint(ip2, tilodtgp)

               end;

            end;
            ip2^.base := ip^.left^.base; { set same base as lodadr }
            ip3 := ip; { exchange for old entry }
            ip := ip2; { set new entry }
            putint(ip3^.left); { free it }
            putint(ip3) { free it }

         end else lodstoexp(ip^.left) { simplify other }

      end

      { trap other cases }
      else error(esysflt75) { should not occur }

   end

end;

{ load/store operator }

procedure lodstoop(ip: intptr);

var ip2: intptr;

{ replace list entry }

procedure replace(oip, nip: intptr);

var p, lp: intptr;

begin

   p := mip; { index top of list }
   lp := nil; { set no last }
   while (p <> oip) and (p <> nil) do begin { traverse }

      lp := p; { set last }
      p := p^.flow { next entry }

   end;
   if p = nil then error(esysflt60); { not found, thats bad }
   if lp = nil then mip := nip { replace first entry }
   else lp^.flow := nip; { gap out entry }
   nip^.flow := oip^.flow { link to next }

end;

begin

   case ip^.i of { intermediate }

      tigoto, tilabequ, tihalt: ; { no action }

      tiprccal, tiprccalo: lodsto(ip^.flow2); { parameter list }

      tiprccali: begin { procedure/function call }

         lodstoexp(ip^.left); { address }
         lodsto(ip^.flow2) { parameter list }

      end;

      { unary }
      tigotot, tigotof, tiwrteolt, tiredeolt, tiget, tigett, tiput, tireset, tirewrite,
      ticlose, tiupdate, tiappend, tipaget, tidel, tinew, tidisp, tistoint,
      tistosrl, tistorel, tistochr, tistobol, tistoset, tistosrc, tistofint,
      tistofsrl, tistofrel, tistofchr, tistofbol, tidspgar, tistogar, tistotgp,
      tistoftgp, ticalpar, tisignal, tisignalone, tiwait: lodstoexp(ip^.left);

      { binary }
      tiwrtsrc, tiwrtintt, tiwrtchrt, tiwrtbolt, tiwrtrelt, tiwrtstrt,
      tiwrtsrl, tiwrtrel, tiwrtset, tiwrtbol, tiwrtchr, tiwrtint, tiredsrc, tiredintt,
      tiredchrt, tiredrelt, tiredsrlt, tipos, tichg, tiwrtgstt, tiassign, 
      tinewgar, tiassert: begin

         lodstoexp(ip^.left);
         lodstoexp(ip^.right);

      end;
   
      { trinary }
      tiwrtintft, tiwrtchrft, tiwrtbolft, tiwrtrelft, tiwrtstrft, tipack,
      tiunpack, tiwrtgstft: begin

         lodstoexp(ip^.left);
         lodstoexp(ip^.right);
         lodstoexp(ip^.xtra);

      end;

      { quad }
      tiwrtrelfft: begin

         lodstoexp(ip^.left); 
         lodstoexp(ip^.right);
         lodstoexp(ip^.xtra); 
         lodstoexp(ip^.xtra2);

      end;

      { structured entries }

      tiifbgn: begin { if statement }

         lodstoexp(ip^.left);
         lodsto(ip^.flow2); { process true flow }
         lodsto(ip^.flow3) { process false flow }

      end;

      tiwhlbgn, tirptbgn, ticasbgn: begin

         lodstoexp(ip^.left);
         lodsto(ip^.flow2) { process enclosed flow }

      end;

      tiwthbgn: begin

         lodstoexp(ip^.left); { record base address }
         lodsto(ip^.flow2) { process enclosed flow }

      end;

      tifortint, tifortchr, tifortbol, tifordint, tifordchr,
      tifordbol: begin

         lodstoexp(ip^.left); { start }
         lodstoexp(ip^.right); { end }
         lodsto(ip^.flow2) { for loop }

      end;

      ticasstb, ticasels: lodsto(ip^.flow2); { case entry }

      titrybgn: begin

         lodsto(ip^.flow2); { protected block }
         lodsto(ip^.flow3) { exception clause list }

      end;

      titryexp: begin

         lodstoexp(ip^.left); { exception variable }
         lodsto(ip^.flow2) { exception statement block }

      end;

      titryels: lodsto(ip^.flow2); { else statement block }

      { indirect store cases }
      tistiint, tistisrl, tistirel, tistichr, tistibol, tistiset, tistisrc, tistifint,
      tistifsrl, tistifrel, tistifchr, tistifbol, tistigar, tistitgp, tistiftgp: begin

         { check store address is constant }
         if (ip^.left^.i = tilodadr) or (ip^.left^.i = tilodfadr) then begin

            { we can simplify this store }
            case ip^.i of { get a direct load entry by type }

               tistiint: getint(ip2, tistoint);
               tistibol: getint(ip2, tistobol);
               tistirel: getint(ip2, tistorel);
               tistiset: getint(ip2, tistoset);
               tistichr: getint(ip2, tistochr);
               tistisrl: getint(ip2, tistosrl);
               tistisrc: getint(ip2, tistosrc);
               tistigar: getint(ip2, tistogar);
               tistitgp: getint(ip2, tistotgp);
               tistifint: getint(ip2, tistofint);
               tistifbol: getint(ip2, tistofbol);
               tistifrel: getint(ip2, tistofrel);
               tistifchr: getint(ip2, tistofchr);
               tistifsrl: getint(ip2, tistofsrl);
               tistiftgp: getint(ip2, tistoftgp)

            end;
            ip2^.base := ip^.left^.base; { set same base as lodadr }
            ip2^.left := ip^.right; { set operand as same }
            replace(ip, ip2); { replace old entry }
            putint(ip^.left); { free it }
            putint(ip); { free it }
            lodstoexp(ip2^.left) { now reduce the operand }

         end else begin { simplify other }

            lodstoexp(ip^.left); { store address }
            lodstoexp(ip^.right) { operand }

         end

      end

      { trap other cases }
      else error(esysflt65) { should not occur }

   end

end;

begin

   ip := mip; { index root }
   while ip <> nil do begin { traverse this forward flow }

      ip1 := ip^.flow; { save next in case this entry gets deleted }
      lodstoop(ip); { follow secondary flows single node }
      ip := ip1 { next in flow }

   end

end;

{******************************************************************************

Check variable reference

Checks if the given type is referenced by a load or load address. This is used
to tell if "for" loop variables are referenced within the loop.

******************************************************************************}

function chkvarref(ip: intptr; tp: typptr): boolean;

var varfnd: boolean; { found flag }

{ create expression temps }

procedure chkvarrefexp(ip: intptr);

begin

{ ;write('chkvarrefexp: intermediate: '); prttic(ip^.i, 1); writeln; }

   case ip^.i of { intermediate }

      tifnccal, 
      tifnccalo: varfnd := varfnd or chkvarref(ip^.flow2, tp); { parameter list }

      tifnccali: begin

         chkvarrefexp(ip^.left); { address of function }
         varfnd := varfnd or chkvarref(ip^.flow2, tp) { parameter list }

      end;

      tilimrel, tilodrel, tilodsrl, tilimns,
      tilimint: ;

      tildirel, tildisrl, ticvtitr, ticvtrtsr, tinegrel, tiabsrel, tisqrrel, tiatnrel, 
      ticosrel, tiexprel, tilgnrel, tisinrel, tisqtrel, tirnd, 
      titrc:  chkvarrefexp(ip^.left);

      timltrel, tidivrel, tiaddrel, tisubrel, tiequrel, tineqrel,
      tileqrel, tigeqrel, tiltnrel, tigtnrel: begin

         chkvarrefexp(ip^.left); 
         chkvarrefexp(ip^.right);

      end;

      tieolt, tieof, tiloc, tilodafbuf, tilodafbuft, tiexist, tildiset, tildisrc, 
      ticvtntg, tildiint, tildichr, tildibol, tildiptr, tinotint,
      tinotbol, tilodlen, ticvtgtf, tinegint, tiabsint, tisqrint, tiodd, tisucint, 
      tiprdint, tirngchk, tilditgp, ticvtftg, tirecoff, tilen, tiaddintimm, 
      timltintimm, tiandintimm, tiequintimm, tiequtgpimm, tineqintimm, 
      tineqtgpimm, tiorintimm, tixorintimm, tileqintimm, tigeqintimm, 
      tiltnintimm, tigtnintimm, tisubintimm, tiaddintlod, timltintlod,
      tiandintlod, tiequintlod, tiequtgplod, tineqintlod, tineqtgplod,
      tiorintlod, tixorintlod, tileqintlod, tigeqintlod, tiltnintlod,
      tigtnintlod, tisubintlod: chkvarrefexp(ip^.left);

      tidivint, timodint, tiarfgar, timltint, tiaddint, tisubint, tiandint, tiorint,
      tixorint, tiarrref, tiequgst, tineqgst, tigeqgst, tiltngst, tigtngst, tiequtgp,
      tineqtgp, tiequint, tineqint, tileqint, tigeqint, tiltnint, tigtnint, tiequstr,
      tineqstr, tileqstr, tigeqstr, tiltnstr, tigtnstr, tiintset, tiuniset, tidifset,
      tiequset, tineqset, tileqset, tigeqset, tisinset, tiincset, tileqgst,
      tiaddintldi, timltintldi, tiandintldi, tiequintldi, tiequtgpldi, 
      tineqintldi, tineqtgpldi, tiorintldi, tixorintldi, tileqintldi,
      tigeqintldi, tiltnintldi, tigtnintldi, tisubintldi: begin

         chkvarrefexp(ip^.left); 
         chkvarrefexp(ip^.right) 

      end;

      tirngset: begin

         chkvarrefexp(ip^.left); 
         chkvarrefexp(ip^.right);
         chkvarrefexp(ip^.xtra)

      end;

      tilodint, tilodchr, tilodbol, tilodptr, tilodsrc, tilodadr, tilodset, tilodfadr,
      tilodtgp: if ip^.base = tp then varfnd := true; { check var found }

      { trap other cases }
      else error(esysflt81) { should not occur }

   end

end;

{ check floats for single operand }

procedure chkvarrefop(ip: intptr);

begin

{ ;write('chkvarrefop: intermediate: '); prtic(ip^.i, 1); writeln; }

   case ip^.i of { intermediate }

      tigoto, tilabequ, tihalt: ; { no action }

      tiprccal, 
      tiprccalo: varfnd := varfnd or chkvarref(ip^.flow2, tp); { parameter list }

      tiprccali: begin { procedure/function call }

         chkvarrefexp(ip^.left); { address }
         varfnd := varfnd or chkvarref(ip^.flow2, tp) { parameter list }

      end;

      tistosrl, tistorel, tistofsrl, tistofrel, tigotot, tigotof, tiwrteolt, tiredeolt,
      tiget, tigett, tiput, tireset, tirewrite, ticlose, tiupdate, tiappend, 
      tipaget, tidel, tinew, tidisp, tistoint, tistochr, tistobol, tistosrc,
      tistofint, tistofchr, tistofbol, tidspgar, tistogar, tistotgp, tistoftgp,
      tistoset, ticalpar, tisignal, tisignalone, tiwait: chkvarrefexp(ip^.left);

      tiwrtrelt, tistisrl, tistirel, tistifsrl, tistifrel, tiwrtsrl, tiwrtrel,
      tiredrelt, tiredsrlt, tiwrtsrc, tiwrtintt, tiwrtchrt, tiwrtbolt, tiwrtstrt,
      tistiint, tistichr, tistibol, tistisrc, tistifint, tistifchr, tistifbol,
      tiwrtset, tiwrtbol, tiwrtchr, tiwrtint, tiredsrc, tiredintt, tiredchrt, tipos,
      tichg, tiwrtgstt, tistigar, tistitgp, tistiftgp, tiassign, tinewgar,
      tistiset, tiassert: begin

         chkvarrefexp(ip^.left);
         chkvarrefexp(ip^.right)

      end;
      tiwrtrelft, tiwrtintft, tiwrtchrft, tiwrtbolft, tiwrtstrft, tipack, tiunpack,
      tiwrtgstft: begin

         chkvarrefexp(ip^.left);
         chkvarrefexp(ip^.right);
         chkvarrefexp(ip^.xtra)

      end;
      tiwrtrelfft: begin

         chkvarrefexp(ip^.left); 
         chkvarrefexp(ip^.right);
         chkvarrefexp(ip^.xtra); 
         chkvarrefexp(ip^.xtra2);

      end;

      { structured entries }

      tiifbgn: begin { if statement }

         chkvarrefexp(ip^.left);
         varfnd := varfnd or chkvarref(ip^.flow2, tp); { process true flow }
         varfnd := varfnd or chkvarref(ip^.flow3, tp) { process false flow }

      end;

      tiwhlbgn, tirptbgn, ticasbgn: begin

         chkvarrefexp(ip^.left);
         varfnd := varfnd or chkvarref(ip^.flow2, tp) { process enclosed flow }

      end;

      tiwthbgn: begin

         chkvarrefexp(ip^.left); { record address }
         varfnd := varfnd or chkvarref(ip^.flow2, tp) { process enclosed flow }

      end;

      tifortint, tifortchr, tifortbol, tifordint, tifordchr,
      tifordbol: begin

         chkvarrefexp(ip^.left); { start }
         chkvarrefexp(ip^.right); { end }
         varfnd := varfnd or chkvarref(ip^.flow2, tp) { for loop }

      end;

      { case entry }
      ticasstb, ticasels: varfnd := varfnd or chkvarref(ip^.flow2, tp);

      titrybgn: begin

         varfnd := varfnd or chkvarref(ip^.flow2, tp); { protected block }
         varfnd := varfnd or chkvarref(ip^.flow3, tp) { exception clause list }

      end;

      titryexp: begin

         chkvarrefexp(ip^.left); { exception variable }
         varfnd := varfnd or chkvarref(ip^.flow2, tp) { exception statement block }

      end;

      titryels: varfnd := varfnd or chkvarref(ip^.flow2, tp) { else statement block }

      { trap other cases }
      else error(esysflt84) { should not occur }

   end

end;

begin

   varfnd := false; { set no floating point op found }
   while ip <> nil do begin { traverse this forward flow }

      chkvarrefop(ip); { follow secondary flows single node }
      ip := ip^.flow { next in flow }

   end;
   chkvarref := varfnd { return result }

end;

{******************************************************************************

Check case statement

Checks if the intermediate tree contains a case statement. This is used to
check if a 'for' loop has a case statement in its code. Case statements don't
like to be interated, so cannot be unrolled. This limitation will disappear
when for loop unrolls are handled at intermediate level.

******************************************************************************}

function chkcas(ip: intptr): boolean;

var casfnd: boolean; { found flag }

{ check case in expression }

procedure chkcasexp(ip: intptr);

begin

   case ip^.i of { intermediate }

      tifnccal, 
      tifnccalo: casfnd := casfnd or chkcas(ip^.flow2); { parameter list }

      tifnccali: begin

         chkcasexp(ip^.left); { address of function }
         casfnd := casfnd or chkcas(ip^.flow2) { parameter list }

      end;

      tilodint, tilodchr, tilodbol, tilodptr, tilodsrc, tilodadr, tilodset, tilodfadr,
      tilodtgp, tilimrel, tilodrel, tilodsrl, tilimns, tilimint: ;

      tildirel, tildisrl, ticvtitr, ticvtrtsr, tinegrel, tiabsrel, tisqrrel, tiatnrel, 
      ticosrel, tiexprel, tilgnrel, tisinrel, tisqtrel, tirnd, 
      titrc:  chkcasexp(ip^.left);

      timltrel, tidivrel, tiaddrel, tisubrel, tiequrel, tineqrel,
      tileqrel, tigeqrel, tiltnrel, tigtnrel: begin

         chkcasexp(ip^.left); 
         chkcasexp(ip^.right);

      end;

      tieolt, tieof, tiloc, tilodafbuf, tilodafbuft, tiexist, tildiset, tildisrc, 
      ticvtntg, tildiint, tildichr, tildibol, tildiptr, tinotint,
      tinotbol, tilodlen, ticvtgtf, tinegint, tiabsint, tisqrint, tiodd, tisucint, 
      tiprdint, tirngchk, tilditgp, ticvtftg, tirecoff, tilen, tiaddintimm,
      timltintimm, tiandintimm, tiequintimm, tiequtgpimm, tineqintimm, 
      tineqtgpimm, tiorintimm, tixorintimm, tileqintimm, tigeqintimm, 
      tiltnintimm, tigtnintimm, tisubintimm, tiaddintlod, timltintlod,
      tiandintlod, tiequintlod, tiequtgplod, tineqintlod, tineqtgplod,
      tiorintlod, tixorintlod, tileqintlod, tigeqintlod, tiltnintlod,
      tigtnintlod, tisubintlod: chkcasexp(ip^.left);

      tidivint, timodint, tiarfgar, timltint, tiaddint, tisubint, tiandint, tiorint,
      tixorint, tiarrref, tiequgst, tineqgst, tigeqgst, tiltngst, tigtngst, tiequtgp,
      tineqtgp, tiequint, tineqint, tileqint, tigeqint, tiltnint, tigtnint, tiequstr,
      tineqstr, tileqstr, tigeqstr, tiltnstr, tigtnstr, tiintset, tiuniset, tidifset,
      tiequset, tineqset, tileqset, tigeqset, tisinset, tiincset, tileqgst,
      tiaddintldi, timltintldi, tiandintldi, tiequintldi, tiequtgpldi, 
      tineqintldi, tineqtgpldi, tiorintldi, tixorintldi, tileqintldi, 
      tigeqintldi, tiltnintldi, tigtnintldi, tisubintldi: begin

         chkcasexp(ip^.left); 
         chkcasexp(ip^.right) 

      end;

      tirngset: begin

         chkcasexp(ip^.left); 
         chkcasexp(ip^.right);
         chkcasexp(ip^.xtra)

      end

      { trap other cases }
      else error(esysflt82) { should not occur }

   end

end;

{ check case in operator }

procedure chkcasop(ip: intptr);

begin

   case ip^.i of { intermediate }

      tigoto, tilabequ, tihalt: ; { no action }

      tiprccal, 
      tiprccalo: casfnd := casfnd or chkcas(ip^.flow2); { parameter list }

      tiprccali: begin { procedure/function call }

         chkcasexp(ip^.left); { address }
         casfnd := casfnd or chkcas(ip^.flow2) { parameter list }

      end;

      tistosrl, tistorel, tistofsrl, tistofrel, tigotot, tigotof, tiwrteolt, tiredeolt,
      tiget, tigett, tiput, tireset, tirewrite, ticlose, tiupdate, tiappend,
      tipaget, tidel, tinew, tidisp, tistoint, tistochr, tistobol, tistosrc,
      tistofint, tistofchr, tistofbol, tidspgar, tistogar, tistotgp, tistoftgp,
      tistoset, ticalpar, tisignal, tisignalone, tiwait: chkcasexp(ip^.left);

      tiwrtrelt, tistisrl, tistirel, tistifsrl, tistifrel, tiwrtsrl, tiwrtrel,
      tiredrelt, tiredsrlt, tiwrtsrc, tiwrtintt, tiwrtchrt, tiwrtbolt, tiwrtstrt,
      tistiint, tistichr, tistibol, tistisrc, tistifint, tistifchr, tistifbol,
      tiwrtset, tiwrtbol, tiwrtchr, tiwrtint, tiredsrc, tiredintt, tiredchrt, tipos,
      tichg, tiwrtgstt, tistigar, tistitgp, tistiftgp, tiassign, tinewgar,
      tistiset, tiassert: begin

         chkcasexp(ip^.left);
         chkcasexp(ip^.right)

      end;
      tiwrtrelft, tiwrtintft, tiwrtchrft, tiwrtbolft, tiwrtstrft, tipack, tiunpack,
      tiwrtgstft: begin

         chkcasexp(ip^.left);
         chkcasexp(ip^.right);
         chkcasexp(ip^.xtra)

      end;
      tiwrtrelfft: begin

         chkcasexp(ip^.left); 
         chkcasexp(ip^.right);
         chkcasexp(ip^.xtra); 
         chkcasexp(ip^.xtra2);

      end;

      { structured entries }

      tiifbgn: begin { if statement }

         chkcasexp(ip^.left);
         casfnd := casfnd or chkcas(ip^.flow2); { process true flow }
         casfnd := casfnd or chkcas(ip^.flow3) { process false flow }

      end;

      tiwhlbgn, tirptbgn, ticasbgn: begin

         if ip^.i = ticasbgn then casfnd := true; { set case found }
         chkcasexp(ip^.left);
         casfnd := casfnd or chkcas(ip^.flow2) { process enclosed flow }

      end;

      tiwthbgn: begin

         chkcasexp(ip^.left); { record address }
         casfnd := casfnd or chkcas(ip^.flow2) { process enclosed flow }

      end;

      tifortint, tifortchr, tifortbol, tifordint, tifordchr,
      tifordbol: begin

         chkcasexp(ip^.left); { start }
         chkcasexp(ip^.right); { end }
         casfnd := casfnd or chkcas(ip^.flow2) { for loop }

      end;

      ticasstb, ticasels: casfnd := casfnd or chkcas(ip^.flow2); { case entry }

      titrybgn: begin

         casfnd := casfnd or chkcas(ip^.flow2); { protected block }
         casfnd := casfnd or chkcas(ip^.flow3) { exception clause list }

      end;

      titryexp: begin

         chkcasexp(ip^.left); { exception variable }
         casfnd := casfnd or chkcas(ip^.flow2) { exception statement block }

      end;

      titryels: casfnd := casfnd or chkcas(ip^.flow2) { else statement block }

      { trap other cases }
      else error(esysflt85) { should not occur }

   end

end;

begin

   casfnd := false; { set no case found }
   while ip <> nil do begin { traverse this forward flow }

      chkcasop(ip); { follow secondary flows single node }
      ip := ip^.flow { next in flow }

   end;
   chkcas := casfnd { return result }

end;

{******************************************************************************

Check goto statement

Checks if the intermediate tree contains a goto statement. This is used to
check if a 'for' loop has a goto statement in its code. Because goto statements
can be used to break the logic of a 'for' (like jumping out of it), we
turn off optimizations on a for loop. Later, this could be changed to do
this only if the goto jumps out of the loop.

Note that we leave compiler construction gotot and gotof alone because these
jumps behave. However, this needs to be watched, since they also can come
from outside.

******************************************************************************}

function chkgto(ip: intptr): boolean;

var gtofnd: boolean; { found flag }

{ check case in expression }

procedure chkgtoexp(ip: intptr);

begin

   case ip^.i of { intermediate }

      tifnccal, 
      tifnccalo: gtofnd := gtofnd or chkgto(ip^.flow2); { parameter list }

      tifnccali: begin

         chkgtoexp(ip^.left); { address of function }
         gtofnd := gtofnd or chkgto(ip^.flow2) { parameter list }

      end;

      tilodint, tilodchr, tilodbol, tilodptr, tilodsrc, tilodadr, tilodset, tilodfadr,
      tilodtgp, tilimrel, tilodrel, tilodsrl, tilimns, tilimint: ;

      tildirel, tildisrl, ticvtitr, ticvtrtsr, tinegrel, tiabsrel, tisqrrel, tiatnrel, 
      ticosrel, tiexprel, tilgnrel, tisinrel, tisqtrel, tirnd, 
      titrc:  chkgtoexp(ip^.left);

      timltrel, tidivrel, tiaddrel, tisubrel, tiequrel, tineqrel,
      tileqrel, tigeqrel, tiltnrel, tigtnrel: begin

         chkgtoexp(ip^.left); 
         chkgtoexp(ip^.right);

      end;

      tieolt, tieof, tiloc, tilodafbuf, tilodafbuft, tiexist, tildiset, tildisrc, 
      ticvtntg, tildiint, tildichr, tildibol, tildiptr, tinotint,
      tinotbol, tilodlen, ticvtgtf, tinegint, tiabsint, tisqrint, tiodd, tisucint, 
      tiprdint, tirngchk, tilditgp, ticvtftg, tirecoff, tilen, tiaddintimm,
      timltintimm, tiandintimm, tiequintimm, tiequtgpimm, tineqintimm, 
      tineqtgpimm, tiorintimm, tixorintimm, tileqintimm, tigeqintimm,
      tiltnintimm, tigtnintimm, tisubintimm, tiaddintlod, timltintlod,
      tiandintlod, tiequintlod, tiequtgplod, tineqintlod, tineqtgplod,
      tiorintlod, tixorintlod, tileqintlod, tigeqintlod, tiltnintlod,
      tigtnintlod, tisubintlod: chkgtoexp(ip^.left);

      tidivint, timodint, tiarfgar, timltint, tiaddint, tisubint, tiandint, tiorint,
      tixorint, tiarrref, tiequgst, tineqgst, tigeqgst, tiltngst, tigtngst, tiequtgp,
      tineqtgp, tiequint, tineqint, tileqint, tigeqint, tiltnint, tigtnint, tiequstr,
      tineqstr, tileqstr, tigeqstr, tiltnstr, tigtnstr, tiintset, tiuniset, tidifset,
      tiequset, tineqset, tileqset, tigeqset, tisinset, tiincset, tileqgst,
      tiaddintldi, timltintldi, tiandintldi, tiequintldi, tiequtgpldi, 
      tineqintldi, tineqtgpldi, tiorintldi, tixorintldi, tileqintldi,
      tigeqintldi, tiltnintldi, tigtnintldi, tisubintldi: begin

         chkgtoexp(ip^.left); 
         chkgtoexp(ip^.right) 

      end;

      tirngset: begin

         chkgtoexp(ip^.left); 
         chkgtoexp(ip^.right);
         chkgtoexp(ip^.xtra)

      end

      { trap other cases }
      else error(esysflt12) { should not occur }

   end

end;

{ check goto in operator }

procedure chkgtoop(ip: intptr);

begin

   case ip^.i of { intermediate }

      tilabequ, tihalt: ; { no action }

      tigoto: gtofnd := true; { found goto }

      tiprccal,
      tiprccalo: gtofnd := gtofnd or chkgto(ip^.flow2); { parameter list }

      tiprccali: begin { procedure/function call }

         chkgtoexp(ip^.left); { address }
         gtofnd := gtofnd or chkgto(ip^.flow2) { parameter list }

      end;

      tistosrl, tistorel, tistofsrl, tistofrel, tigotot, tigotof, tiwrteolt, tiredeolt,
      tiget, tigett, tiput, tireset, tirewrite, ticlose, tiupdate, tiappend, 
      tipaget, tidel, tinew, tidisp, tistoint, tistochr, tistobol, tistosrc,
      tistofint, tistofchr, tistofbol, tidspgar, tistogar, tistotgp, tistoftgp,
      tistoset, ticalpar, tisignal, tisignalone, tiwait: chkgtoexp(ip^.left);

      tiwrtrelt, tistisrl, tistirel, tistifsrl, tistifrel, tiwrtsrl, tiwrtrel,
      tiredrelt, tiredsrlt, tiwrtsrc, tiwrtintt, tiwrtchrt, tiwrtbolt, tiwrtstrt,
      tistiint, tistichr, tistibol, tistisrc, tistifint, tistifchr, tistifbol,
      tiwrtset, tiwrtbol, tiwrtchr, tiwrtint, tiredsrc, tiredintt, tiredchrt, tipos,
      tichg, tiwrtgstt, tistigar, tistitgp, tistiftgp, tiassign, tinewgar,
      tistiset, tiassert: begin

         chkgtoexp(ip^.left);
         chkgtoexp(ip^.right)

      end;
      tiwrtrelft, tiwrtintft, tiwrtchrft, tiwrtbolft, tiwrtstrft, tipack, tiunpack,
      tiwrtgstft: begin

         chkgtoexp(ip^.left);
         chkgtoexp(ip^.right);
         chkgtoexp(ip^.xtra)

      end;
      tiwrtrelfft: begin

         chkgtoexp(ip^.left); 
         chkgtoexp(ip^.right);
         chkgtoexp(ip^.xtra); 
         chkgtoexp(ip^.xtra2);

      end;

      { structured entries }

      tiifbgn: begin { if statement }

         chkgtoexp(ip^.left);
         gtofnd := gtofnd or chkgto(ip^.flow2); { process true flow }
         gtofnd := gtofnd or chkgto(ip^.flow3) { process false flow }

      end;

      tiwhlbgn, tirptbgn, ticasbgn: begin

         chkgtoexp(ip^.left);
         gtofnd := gtofnd or chkgto(ip^.flow2) { process enclosed flow }

      end;

      tiwthbgn: begin

         chkgtoexp(ip^.left); { record address }
         gtofnd := gtofnd or chkgto(ip^.flow2) { process enclosed flow }

      end;

      tifortint, tifortchr, tifortbol, tifordint, tifordchr,
      tifordbol: begin

         chkgtoexp(ip^.left); { start }
         chkgtoexp(ip^.right); { end }
         gtofnd := gtofnd or chkgto(ip^.flow2) { for loop }

      end;

      ticasstb, ticasels: gtofnd := gtofnd or chkgto(ip^.flow2); { case entry }

      titrybgn: begin

         gtofnd := gtofnd or chkgto(ip^.flow2); { protected block }
         gtofnd := gtofnd or chkgto(ip^.flow3) { exception clause list }

      end;

      titryexp: begin

         chkgtoexp(ip^.left); { exception variable }
         gtofnd := gtofnd or chkgto(ip^.flow2) { exception statement block }

      end;

      titryels: gtofnd := gtofnd or chkgto(ip^.flow2) { else statement block }

      { trap other cases }
      else error(esysflt17) { should not occur }

   end

end;

begin

   gtofnd := false; { set no goto found }
   while ip <> nil do begin { traverse this forward flow }

      chkgtoop(ip); { follow secondary flows single node }
      ip := ip^.flow { next in flow }

   end;
   chkgto := gtofnd { return result }

end;

{******************************************************************************

Print set

A diagnostic, prints a constant set.

******************************************************************************}

procedure prtset(st: typptr);

var tp: typptr;

begin

   if st^.t <> tstcst then error(esysflt36);
   tp := st^.stcc;
   while tp <> nil do begin

      if tp^.t <> tstet then error(esysflt37);
      wrtssint(tp^.stes);
      if (tp^.stes.s <> tp^.stee.s) or (tp^.stes.v <> tp^.stee.v) then begin

         write('..');
         wrtssint(tp^.stee)

      end;
      if tp^.sten <> nil then write(',');
      tp := tp^.sten

   end;
   writeln

end;

{******************************************************************************

Check expression contains function

Checks if the given expression contains a function. This is necessary to find
out if an expression contains side effects, which a function can have. Of
course, the other way is to actually tour the function, if available, to find
any side effects.

******************************************************************************}

function chkfncexp(ip: intptr): boolean;

var fncfnd: boolean; { found flag }

begin

   fncfnd := false; { set not found }
   case ip^.i of { intermediate }

      tifnccal, tifnccalo, tifnccali: fncfnd := true; { found }

      tilodint, tilodchr, tilodbol, tilodptr, tilodsrc, tilodadr, tilodset, tilodfadr,
      tilodtgp, tilimrel, tilodrel, tilodsrl, tilimns, tilimint: ;

      tildirel, tildisrl, ticvtitr, ticvtrtsr, tinegrel, tiabsrel, tisqrrel, tiatnrel, 
      ticosrel, tiexprel, tilgnrel, tisinrel, tisqtrel, tirnd, 
      titrc:  if chkfncexp(ip^.left) then fncfnd := true;

      timltrel, tidivrel, tiaddrel, tisubrel, tiequrel, tineqrel,
      tileqrel, tigeqrel, tiltnrel, tigtnrel: begin

         if chkfncexp(ip^.left) then fncfnd := true; 
         if chkfncexp(ip^.right) then fncfnd := true;

      end;

      tieolt, tieof, tiloc, tilodafbuf, tilodafbuft, tiexist, tildiset, tildisrc, 
      ticvtntg, tildiint, tildichr, tildibol, tildiptr, tinotint,
      tinotbol, tilodlen, ticvtgtf, tinegint, tiabsint, tisqrint, tiodd, tisucint, 
      tiprdint, tirngchk, tilditgp, ticvtftg, tirecoff, tilen, tiaddintimm,
      timltintimm, tiandintimm, tiequintimm, tiequtgpimm, tineqintimm, 
      tineqtgpimm, tiorintimm, tixorintimm, tileqintimm, tigeqintimm, 
      tiltnintimm, tigtnintimm, tisubintimm, tiaddintlod, timltintlod,
      tiandintlod, tiequintlod, tiequtgplod, tineqintlod, tineqtgplod,
      tiorintlod, tixorintlod, tileqintlod, tigeqintlod, tiltnintlod,
      tigtnintlod, tisubintlod: if chkfncexp(ip^.left) then fncfnd := true;

      tidivint, timodint, tiarfgar, timltint, tiaddint, tisubint, tiandint, tiorint,
      tixorint, tiarrref, tiequgst, tineqgst, tigeqgst, tiltngst, tigtngst, tiequtgp,
      tineqtgp, tiequint, tineqint, tileqint, tigeqint, tiltnint, tigtnint, tiequstr,
      tineqstr, tileqstr, tigeqstr, tiltnstr, tigtnstr, tiintset, tiuniset, tidifset,
      tiequset, tineqset, tileqset, tigeqset, tisinset, tiincset, tileqgst,
      tiaddintldi, timltintldi, tiandintldi, tiequintldi, tiequtgpldi, 
      tineqintldi, tineqtgpldi, tiorintldi, tixorintldi, tileqintldi, 
      tigeqintldi, tiltnintldi, tigtnintldi, tisubintldi: begin

         if chkfncexp(ip^.left) then fncfnd := true; 
         if chkfncexp(ip^.right) then fncfnd := true 

      end;

      tirngset: begin

         if chkfncexp(ip^.left) then fncfnd := true; 
         if chkfncexp(ip^.right) then fncfnd := true;
         if chkfncexp(ip^.xtra) then fncfnd := true

      end

      { trap other cases }
      else error(esysflt50) { should not occur }

   end;

   chkfncexp := fncfnd { return flag }

end;

{******************************************************************************

Tally intermediate list

Counts the intermediates in a full tree. The number of intermediate entries in
a full tree are counted, including all branches. This can be applied to any
list.

The number of intermediates in a given tree is a metric used to determine
things such as inline routine inclusions and constant for loop unroll 
thresholds.

******************************************************************************}

function cntint(ip: intptr): integer;

var count: integer; { intermediate entry counter }

{ load/store expression }

procedure cntintexp(ip: intptr);

begin

   count := count+1; { count this entry }
   case ip^.i of { intermediate }

      { no action required entries }
      tilodset, tilimns, tilodint, tilimint, tilodrel, tilimrel, tilodsrl, tilodchr, 
      tilodbol, tilodsrc, tilodptr, tilodtgp, tilodadr, tilodfadr: ;

      { unary }
      tildiint, tildibol, tildirel, tildiset, tildichr, tildisrl, tildisrc, tildiptr,
      tilditgp, tieolt, tieof, tinotbol, tiodd, tiexist, tiloc, tilen, tinotint, tilodlen,
      tinegint, tiabsint, tisqrint, tirnd, titrc, ticvtitr, tinegrel, tiabsrel, tisqrrel,
      tiatnrel, ticosrel, tiexprel, tilgnrel, tisinrel, tisqtrel, tirngchk, tilodafbuft,
      tilodafbuf, tirecoff, tisucint, tiprdint, ticvtgtf, ticvtftg, ticvtntg, 
      ticvtrtsr, tiaddintimm, timltintimm, tiandintimm, tiequintimm, 
      tiequtgpimm, tineqintimm, tineqtgpimm, tiorintimm, tixorintimm, 
      tileqintimm, tigeqintimm, tiltnintimm, tigtnintimm, 
      tisubintimm, tiaddintlod, timltintlod, tiandintlod, tiequintlod,
      tiequtgplod, tineqintlod, tineqtgplod, tiorintlod, tixorintlod, tileqintlod,
      tigeqintlod, tiltnintlod, tigtnintlod, 
      tisubintlod: cntintexp(ip^.left);

      { binary }
      tidivint, timodint, timltint, tiaddint, tisubint, tiandint, tiorint, 
      tixorint, tiintset, tiuniset, tidifset, tiequset, tineqset, tileqset, tigeqset,
      tiequrel, tineqrel, tileqrel, tigeqrel, tiltnrel, tigtnrel, tiequgst, tineqgst, 
      tigeqgst, tiltngst, tigtngst, tiequtgp, tineqtgp, tiequint, tineqint, tileqint,
      tigeqint, tiltnint, tigtnint, tiequstr, tineqstr, tileqstr, tigeqstr, tiltnstr,
      tigtnstr, tiincset, timltrel, tidivrel, tiaddrel, tisubrel, tisinset, tiarrref,
      tiarfgar, tileqgst, tiaddintldi, timltintldi, tiandintldi, tiequintldi,
      tiequtgpldi, tineqintldi, tineqtgpldi, tiorintldi, tixorintldi, tileqintldi,
      tigeqintldi, tiltnintldi, tigtnintldi, tisubintldi: begin

         cntintexp(ip^.left); 
         cntintexp(ip^.right);

      end;

      { trinary }
      tirngset: begin

         cntintexp(ip^.left); 
         cntintexp(ip^.right);
         cntintexp(ip^.xtra)

      end;

      tifnccal, tifnccalo: count := count+cntint(ip^.flow2); { parameter list }

      tifnccali: begin

         cntintexp(ip^.left); { address of function }
         count := count+cntint(ip^.flow2) { parameter list }

      end

      { trap other cases }
      else error(esysflt79) { should not occur }

   end

end;

{ load/store operator }

procedure cntintop(ip: intptr);

begin

   count := count+1; { count this entry }
   case ip^.i of { intermediate }

      tigoto, tilabequ, tihalt: ; { no action }

      tiprccal, 
      tiprccalo: count := count+cntint(ip^.flow2); { parameter list }

      tiprccali: begin { procedure/function call }

         cntintexp(ip^.left); { address }
         count := count+cntint(ip^.flow2) { parameter list }

      end;

      { unary }
      tigotot, tigotof, tiwrteolt, tiredeolt, tiget, tigett, tiput, tireset, tirewrite,
      ticlose, tiupdate, tiappend, tipaget, tidel, tinew, tidisp, tistoint,
      tistosrl, tistorel, tistochr, tistobol, tistoset, tistosrc, tistofint,
      tistofsrl, tistofrel, tistofchr, tistofbol, tidspgar, tistogar, tistotgp,
      tistoftgp, ticalpar, tisignal, tisignalone, tiwait: cntintexp(ip^.left);

      { binary }
      tistiint, tistisrl, tistirel, tistichr, tistibol, tistiset, tistisrc, tistifint,
      tistifsrl, tistifrel, tistifchr, tistifbol, tistigar, tistitgp, tistiftgp,
      tiwrtsrc, tiwrtintt, tiwrtchrt, tiwrtbolt, tiwrtrelt, tiwrtstrt,
      tiwrtsrl, tiwrtrel, tiwrtset, tiwrtbol, tiwrtchr, tiwrtint, tiredsrc, tiredintt,
      tiredchrt, tiredrelt, tiredsrlt, tipos, tichg, tiwrtgstt, tiassign, 
      tinewgar, tiassert: begin

         cntintexp(ip^.left);
         cntintexp(ip^.right);

      end;
   
      { trinary }
      tiwrtintft, tiwrtchrft, tiwrtbolft, tiwrtrelft, tiwrtstrft, tipack,
      tiunpack, tiwrtgstft: begin

         cntintexp(ip^.left);
         cntintexp(ip^.right);
         cntintexp(ip^.xtra);

      end;

      { quad }
      tiwrtrelfft: begin

         cntintexp(ip^.left); 
         cntintexp(ip^.right);
         cntintexp(ip^.xtra); 
         cntintexp(ip^.xtra2);

      end;

      { structured entries }

      tiifbgn: begin { if statement }

         cntintexp(ip^.left);
         count := count+cntint(ip^.flow2); { process true flow }
         count := count+cntint(ip^.flow3) { process false flow }

      end;

      tiwhlbgn, tirptbgn, ticasbgn: begin

         cntintexp(ip^.left);
         count := count+cntint(ip^.flow2) { process enclosed flow }

      end;

      tiwthbgn: begin

         cntintexp(ip^.left); { record base address }
         count := count+cntint(ip^.flow2) { process enclosed flow }

      end;

      tifortint, tifortchr, tifortbol, tifordint, tifordchr,
      tifordbol: begin

         cntintexp(ip^.left); { start }
         cntintexp(ip^.right); { end }
         count := count+cntint(ip^.flow2) { for loop }

      end;

      ticasstb, ticasels: count := count+cntint(ip^.flow2); { case entry }

      titrybgn: begin

         count := count+cntint(ip^.flow2); { protected block }
         count := count+cntint(ip^.flow3) { exception clause list }

      end;

      titryexp: begin

         cntintexp(ip^.left); { exception variable }
         count := count+cntint(ip^.flow2) { exception statement block }

      end;

      titryels: count := count+cntint(ip^.flow2) { else statement block }

      { trap other cases }
      else error(esysflt70) { should not occur }

   end

end;

begin

   count := 0; { clear intermediate counter }
   while ip <> nil do begin { traverse this forward flow }

      cntintop(ip); { follow secondary flows single node }
      ip := ip^.flow  { next in flow }

   end;

   cntint := count { return result }

end;

{******************************************************************************

Check goto label in tree

Checks if the given tree contains a goto target. Returns true if so. This is
used to see if code can be duplicated, as in a unrolled loop, without creating
aliasing problems.

******************************************************************************}

function labeled(ip: intptr): boolean;

var islab: boolean; { label found }

{ load/store expression }

procedure labeledexp(var ip: intptr);

begin

   if ip^.i = tilabequ then islab := true; { set label found }
   case ip^.i of { intermediate }

      { no action required entries }
      tilodset, tilimns, tilodint, tilimint, tilodrel, tilimrel, tilodsrl, tilodchr, 
      tilodbol, tilodsrc, tilodptr, tilodtgp, tilodadr, tilodfadr: ;

      { unary }
      tildiint, tildibol, tildirel, tildiset, tildichr, tildisrl, tildisrc, tildiptr,
      tilditgp, tieolt, tieof, tinotbol, tiodd, tiexist, tiloc, tilen, tinotint, tilodlen,
      tinegint, tiabsint, tisqrint, tirnd, titrc, ticvtitr, tinegrel, tiabsrel, tisqrrel,
      tiatnrel, ticosrel, tiexprel, tilgnrel, tisinrel, tisqtrel, tirngchk, tilodafbuft,
      tilodafbuf, tirecoff, tisucint, tiprdint, ticvtgtf, ticvtftg, ticvtntg, 
      ticvtrtsr, tiaddintimm, timltintimm, tiandintimm, tiequintimm, 
      tiequtgpimm, tineqintimm, tineqtgpimm, tiorintimm,  tixorintimm, 
      tileqintimm, tigeqintimm, tiltnintimm, tigtnintimm, 
      tisubintimm, tiaddintlod, timltintlod, tiandintlod, tiequintlod,
      tiequtgplod, tineqintlod, tineqtgplod, tiorintlod, tixorintlod, tileqintlod,
      tigeqintlod, tiltnintlod, tigtnintlod, 
      tisubintlod: labeledexp(ip^.left);

      { binary }
      tidivint, timodint, timltint, tiaddint, tisubint, tiandint, tiorint, 
      tixorint, tiintset, tiuniset, tidifset, tiequset, tineqset, tileqset, tigeqset,
      tiequrel, tineqrel, tileqrel, tigeqrel, tiltnrel, tigtnrel, tiequgst, tineqgst, 
      tigeqgst, tiltngst, tigtngst, tiequtgp, tineqtgp, tiequint, tineqint, tileqint,
      tigeqint, tiltnint, tigtnint, tiequstr, tineqstr, tileqstr, tigeqstr, tiltnstr,
      tigtnstr, tiincset, timltrel, tidivrel, tiaddrel, tisubrel, tisinset, tiarrref,
      tiarfgar, tileqgst, tiaddintldi, timltintldi, tiandintldi, tiequintldi,
      tiequtgpldi, tineqintldi, tineqtgpldi, tiorintldi, tixorintldi, 
      tileqintldi, tigeqintldi, tiltnintldi, tigtnintldi, tisubintldi: begin

         labeledexp(ip^.left); 
         labeledexp(ip^.right);

      end;

      { trinary }
      tirngset: begin

         labeledexp(ip^.left); 
         labeledexp(ip^.right);
         labeledexp(ip^.xtra)

      end;

      tifnccal, tifnccalo: islab := islab or labeled(ip^.flow2); { parameter list }

      tifnccali: begin

         labeledexp(ip^.left); { address of function }
         islab := islab or labeled(ip^.flow2) { parameter list }

      end

      { trap other cases }
      else error(esysflt7) { should not occur }

   end

end;

{ load/store operator }

procedure labeledop(ip: intptr);

begin

   if ip^.i = tilabequ then islab := true; { set label found }
   case ip^.i of { intermediate }

      tigoto, tilabequ, tihalt: ; { no action }

      tiprccal,
      tiprccalo: islab := islab or labeled(ip^.flow2); { parameter list }

      tiprccali: begin { procedure/function call }

         labeledexp(ip^.left); { address }
         islab := islab or labeled(ip^.flow2) { parameter list }

      end;

      { unary }
      tigotot, tigotof, tiwrteolt, tiredeolt, tiget, tigett, tiput, tireset, tirewrite,
      ticlose, tiupdate, tiappend, tipaget, tidel, tinew, tidisp, tistoint,
      tistosrl, tistorel, tistochr, tistobol, tistoset, tistosrc, tistofint,
      tistofsrl, tistofrel, tistofchr, tistofbol, tidspgar, tistogar, tistotgp,
      tistoftgp, ticalpar, tisignal, tisignalone, tiwait: labeledexp(ip^.left);

      { binary }
      tistiint, tistisrl, tistirel, tistichr, tistibol, tistiset, tistisrc, tistifint,
      tistifsrl, tistifrel, tistifchr, tistifbol, tistigar, tistitgp, tistiftgp,
      tiwrtsrc, tiwrtintt, tiwrtchrt, tiwrtbolt, tiwrtrelt, tiwrtstrt,
      tiwrtsrl, tiwrtrel, tiwrtset, tiwrtbol, tiwrtchr, tiwrtint, tiredsrc, tiredintt,
      tiredchrt, tiredrelt, tiredsrlt, tipos, tichg, tiwrtgstt, tiassign, 
      tinewgar, tiassert: begin

         labeledexp(ip^.left);
         labeledexp(ip^.right);

      end;
   
      { trinary }
      tiwrtintft, tiwrtchrft, tiwrtbolft, tiwrtrelft, tiwrtstrft, tipack,
      tiunpack, tiwrtgstft: begin

         labeledexp(ip^.left);
         labeledexp(ip^.right);
         labeledexp(ip^.xtra);

      end;

      { quad }
      tiwrtrelfft: begin

         labeledexp(ip^.left); 
         labeledexp(ip^.right);
         labeledexp(ip^.xtra); 
         labeledexp(ip^.xtra2);

      end;

      { structured entries }

      tiifbgn: begin { if statement }

         labeledexp(ip^.left);
         islab := islab or labeled(ip^.flow2); { process true flow }
         islab := islab or labeled(ip^.flow3) { process false flow }

      end;

      tiwhlbgn, tirptbgn, ticasbgn: begin

         labeledexp(ip^.left);
         islab := islab or labeled(ip^.flow2) { process enclosed flow }

      end;

      tiwthbgn: begin

         labeledexp(ip^.left); { record base address }
         islab := islab or labeled(ip^.flow2) { process enclosed flow }

      end;

      tifortint, tifortchr, tifortbol, tifordint, tifordchr,
      tifordbol: begin

         labeledexp(ip^.left); { start }
         labeledexp(ip^.right); { end }
         islab := islab or labeled(ip^.flow2) { for loop }

      end;

      ticasstb, ticasels: islab := islab or labeled(ip^.flow2); { case entry }

      titrybgn: begin

         islab := islab or labeled(ip^.flow2); { protected block }
         islab := islab or labeled(ip^.flow3) { exception clause list }

      end;

      titryexp: begin

         labeledexp(ip^.left, ip); { exception variable }
         islab := islab or labeled(ip^.flow2) { exception statement block }

      end;

      titryels: islab := islab or labeled(ip^.flow2) { else statement block }

      { trap other cases }
      else error(esysflt6) { should not occur }

   end

end;

begin

   islab := false; { set not found }
   while ip <> nil do begin { traverse this forward flow }

      labeledop(ip); { follow secondary flows single node }
      ip := ip^.flow  { next in flow }

   end;

   labeled := islab { return result }

end;

{******************************************************************************

Set record offsets

Sets record offsets for the current block. The block must have been previously
sized.

******************************************************************************}

procedure setrecoff;

{ allocate record entry }

procedure recoff(tp: typptr;   { record field list }
                 ba: integer); { base address }

var af: boolean; { allocate/don't allocate flag }

begin

   while tp <> nil do begin { traverse fields }

      { perform any required type alignment first }
      if frecaln then alnadr(ba, tp);
      tp^.addr := ba; { set base address of entry }
      af := true; { set allocation on }
      { check tag entry does not exist }
      if tp^.t = tftag then if not tp^.ftge then af := false;
      if af then ba := ba+tp^.size; { find next base address }
      if tp^.t = tfield then tp := tp^.fldn { go next field }
      else begin { process variant }

         if tp^.t <> tftag then error(einvfmt); { bad format }
         tp := tp^.ftgc; { index case list }
         while tp <> nil do begin { process variants }

            if tp^.t <> tfcas then error(einvfmt); { bad format }
            recoff(tp^.fcsf, ba); { allocate this variant }
            tp := tp^.fcsn { next case }

         end;
         tp := nil { flag end of field list }

      end

   end

end;

{ allocate record fields in list }

procedure recofflst(tp: typptr);

begin

   { process list }
   while tp <> nil do begin { traverse list }

      if tp^.t = trecord then recoff(tp^.recf, 0); { allocate entry }
      tp := tp^.next { next type entry }

   end

end;

begin

   recofflst(blkstk^.res); { resolve standard list }
   recofflst(blkstk^.resa) { resolve alternate list }

end;

{******************************************************************************

Translate character set constants

Translates the internal representation of character set constants to encoded
mode if the fxltchr flag is on. We use a "wet" method to handle character
set encoding. This means that all internal character values that participate
in computation processing are encoded. This means that constant folding and
other operations that take place here at compile time use the same character
set as the runtime. Most constants are converted on input. Set constants are
converted after the entire block is read, because they are represented as
integer values, and are thus somewhat ambigous. This is resolved by consulting
their base types, which is only possible by processing the entire set constant
from the head down.

******************************************************************************}

procedure xltchrset;

{ process character set list }

procedure xltchrety(tp: typptr);

begin

   while tp <> nil do begin { process set constant entries }

      if tp^.t <> tstet then error(esysflt53); { bad entry }
      tp^.stes.v := ord(chrtrn[tp^.stes.v]); { translate start }
      tp^.stes.s := false;
      tp^.stee.v := ord(chrtrn[tp^.stee.v]); { translate end }
      tp^.stes.s := false;
      tp := tp^.sten { link next list entry }

   end

end;

{ process list }

procedure xltchrlst(tp: typptr);

begin

   { process list }
   while tp <> nil do begin { traverse list }

      if tp^.t = tstcst then { possible character set }
         if chart(tp^.stct) then xltchrety(tp^.stcc); { it's a character set }
      tp := tp^.next { next type entry }

   end

end;

begin

   if fxltchr then { translate characters is enabled }
      xltchrlst(blkstk^.res) { convert standard list }

end;

{******************************************************************************

Get next intermediate

Recovers the next head tolken for the next intermediate. This is converted
to internal code, and the intermediate counter is advanced.

******************************************************************************}

procedure getcod(var ic: intcod);

var b:  byte;    { next intermediate byte read holder }
    ib: integer; { full intermediate code holder }

begin

   read(intfil, b); { get next code high }
   ib := b*256; { set intermediate code byte high }
   read(intfil, b); { get next code low }
   ib := ib+b;
   if ib >= ord(iendcod) then error(einvitc); { invalid code number }
   intcnt := intcnt+1; { count tolken }
   ic := intcod(ib); { convert to intermediate code }
   if fcodel then begin { list intermediate code }

      write(intcnt:6, ': ');
      if fstklvl then write(stklvl:4, ': ');
      prtic(ic, 10); 
      writeln

   end

end;

{******************************************************************************

Read intermediate code

Reads in the next intermediate tolken, and processes that into types or
intermediate structure.

The head of the tolken is processed before this routine, which allows
lookahead.

A full filo list spec is accepted, which can be an empty list or contain an
existing list.

Note that the last element returned can be nil, which happens if the end
of a block was encountered. This is correct, because it is possible for there
to be no single end to the intermediate terminal structure. For example, we
might have a dangling 'if' at the end of the block.

******************************************************************************}

procedure rdint(    ic:  intcod;  { intermediate tolken head }
                var rtp: intptr;  { root pointer }
                var lsp: intptr); { last entry pointer }
   
var b, b2:              byte;    { file byte holders }
    v:                  ssint;   { integer parameter }
    tp, tp1, tp2:       typptr;  { type pointers }
    lp:                 labptr;  { label entry pointer }
    ip, ip1, ip2, ip3:  intptr;  { tolken pointers }
    l, h:               ssint;   { case select low/high }
    mp:                 modptr;  { module tracking entry pointer }
    i:                  integer;

{ insert tolken to current flow }

procedure insert(ip: intptr); { entry to insert }

begin

   if rtp = nil then rtp := ip { insert first in list }
   else lsp^.flow := ip; { insert new last }
   lsp := ip { set new last }

end;

{ place parameter from pseudostack }

procedure plcpar(ip: intptr);

begin

   if ip <> nil then begin { there are parameters }

      { because parameters are on the pseudomachine stack backwards, we must place
        them to parameters back to front to correct }
      if ip^.flow <> nil then plcpar(ip^.flow); { go to depth first }
      popint(ip^.left) { place contents of parameter }

   end

end;

{ skip source code markers }

procedure getcodnsrc(var ic: intcod);

begin

   repeat 

      getcod(ic);
      if (ic = isetlin) or (ic = isetsrc) then rdint(ic, rtp, lsp)

   until (ic <> isetlin) and (ic <> isetsrc);

end;

{ set mark label }

procedure marksym;

var bp: blkptr; { pointer to block entries }
    lp: labptr; { pointer to symbol }

begin

   if blkstk^.marks = nil then begin { mark symbol not defined, find it }

      { if the mark is an overload, link back to the prime symbol }
      if blkstk^.mark^.t = tproc then begin { its a procedure }

         if blkstk^.mark^.prch <> nil then { its an overload }
            blkstk^.marks := fndsym(blkstk, blkstk^.mark^.prch)
         else blkstk^.marks := fndsym(blkstk, blkstk^.mark)

      end else if blkstk^.mark^.t = tfunc then begin { its a function }

         if blkstk^.mark^.fnch <> nil then { its an overload }
            blkstk^.marks := fndsym(blkstk, blkstk^.mark^.fnch)
         else blkstk^.marks := fndsym(blkstk, blkstk^.mark)

      end else begin

         { We search from this block down in the block stack. This is required,
           since block symbols are left in the surrounding block to avoid
           naming conflicts. }
         bp := blkstk; { index this entry }
         while bp <> nil do begin { traverse }

            lp := fndsym(bp, blkstk^.mark);
            if lp <> nil then blkstk^.marks := lp; { found, set that }
            bp := bp^.next { next entry in stack }

         end

      end

   end
   
end;

begin

   case ic of { intermediate code }

      { *** TYPES AND CONTROLS SECTION *** }

      ibgnlvl: begin 

         if blkstk <> nil then begin { there are levels present }

            { because objects defined in this block can be referenced in
              nested blocks, we must define all that have appeared }
            resblk; { resolve forward references }
            setgbl; { move global status to procedures and functions }
            makvv; { create virtual vectors needed }
            sizblk; { size entries in block }
            setrecoff; { set record offsets }
            xltchrset; { translate character sets if enabled }
            blkstk^.res := nil; { clear resolvables }
            blkstk^.resa := nil;
            marksym; { make sure mark symbol is defined }
            if blkstk^.lvl >= 3 then begin { not system or module block }
   
               { locals not allocated }
               adjpar; { adjust parameter levels }
               allloc { allocate previous block locals }

            end

         end;
         blkcnt := blkcnt+1; { increment block counter }
         if blkcnt > 31 then error(elvlovf); { too many levels }
         pshblk; { allocate new block level }
         getlnk(blkstk^.mark); { get the block mark linkage }
         if blkstk^.mark^.t = tglbl then begin

            { Allocate exception variable. For all but process, the global 
              default exception exists in the support library. For process,
              each one owns its own exception variable. }
            if blkstk^.mark^.mrkt = mtprocess then begin

               { allocate private exception variable }
               gettypa(gblexc, tvar); { get type entry }
               gettypa(gblexc^.vart, texception); { get base type }
               gblexc^.vare := false; { set not external }
               { set local status (never true) }
               gblexc^.local := blkstk^.lvl >= 3;
               lstsym(lp); { get a symbol }
               { the exception variable is "<process name>.exception.". The 
                 trailing '.' effectively denies it from being aliased in the
                 program, since '.' will never be created alone }
               strplc(lp^.lab,  '.exception.'); { place label }
               lp^.typ := gblexc { place type linkage }

            end else begin

               { create reference to global exception variable }
               gettypa(gblexc, tvar); { get type entry }
               gettypa(gblexc^.vart, texception); { get base type }
               gblexc^.vare := true; { set external }
               { set local status (never true) }
               gblexc^.local := blkstk^.lvl >= 3;
               lstsym(lp); { get a symbol }
               strplc(lp^.lab,  'wrapper.exception'); { place label }
               lp^.typ := gblexc { place type linkage }

            end

         end

      end;
      iendlvl: begin

        marksym; { make sure mark symbol is defined }
        { perform code changing optimizations }
        if fsmplsi then begin { check load/store indirect simplfy }

           lodsto(blkstk^.entry); { entry }
           lodsto(blkstk^.exit) { exit }

        end;
        if ffldcst then begin { fold constants }

           cstopr(blkstk^.entry); { entry }
           cstopr(blkstk^.exit) { exit }

        end;
        if fdeadce then begin

           { dead code eliminate, must be after constant fold }
           remdead(blkstk^.entry); { entry }
           remdead(blkstk^.exit) { exit }

        end;
        if fbol2jmp then begin

           { change boolean operations to jumps, should be after constant fold
             and dead code }
           bol2jmp(blkstk^.entry); { entry }
           bol2jmp(blkstk^.exit) { exit }

        end;
        { set flag to indicate if variables for block contain a file }
        blkstk^.fvar := chkconfillst(blkstk^.typ);
        blkstk^.fvar := blkstk^.fvar or chkconfillst(blkstk^.typa);
        { check block contains floating point operations }
        blkstk^.rlop := chkintflt(blkstk^.entry);
        plcup(blkstk^.entry); { place up linkages }
        plcrestyp(blkstk^.entry); { place operator result types }
        { restriction mode needs work to deal with signed/unsigned loads }
        { if fresexp then restrict(blkstk^.entry); } { restrict operand ranges }
        { check block contains floating point operations }
        blkstk^.rlop := blkstk^.rlop or chkintflt(blkstk^.exit);
        plcup(blkstk^.exit); { place up linkages }
        plcrestyp(blkstk^.exit); { place operator result types }
        { restriction mode needs work to deal with signed/unsigned loads }
        { if fresexp then restrict(blkstk^.exit); } { restrict operand ranges }
        resblk; { resolve forward references }
        setgbl; { move global status to procedures and functions }
        makvv; { create virtual vectors needed }
        sizblk; { size entries in block }
        setrecoff; { set record offsets }
        xltchrset; { translate character sets if enabled }
        blkstk^.res := nil; { clear resolvables }
        blkstk^.resa := nil;
        if blkcnt > 1 then genblk; { generate the block code for non-system }
        if ftypl then lsttyp; { list types in block }
        if fsyml then dmpsym; { list symbols in block }
        if fintlf then lstint; { list intermediates in flow format }
        blkcnt := blkcnt-1; { decrement block counter }
        if blkcnt < 0 then error(einvfmt); { bad format }
        popblk { remove block level }

      end;
      iusefil: ; { this is unimplemented anywhere }
      isetlin: begin

         rdvar(v); { get line number }
         if fprtlin then begin

            write(csrc^, ':'); 
            wrtssint(v);
            writeln

         end

      end;
      isetsrc: getstr(csrc); { get and set source name }
      iextmod: begin { get module name }

         modcnt := modcnt+1; { count modules }
         getmod(mp); { add new module to list }
         mp^.next := modlst; { push to list }
         modlst := mp;
         getstr(mp^.modn); { get the module name }
         getstr(mp^.modf); { get the file name }
         mp^.inx := modcnt { place ordinal value }

      end;
      inil: gettyp(tp, tnil); { nil type }
      ilab: begin

         gettyp(tp, tlab); { get the type entry }
         tp^.lmrk := blkstk^.mark; { place mark }
         rdtyp := tp { set read type }

      end;
      iicst: begin

         if gblint = nil then error(einvfmt); { must have an integer base }
         gettyp(tp, ticst); { get the type entry }
         rdvar(tp^.ival); { get value }
         rdtyp := tp { set read type }

      end;
      iscst: begin

         gettyp(tp, tscst); { get the type entry }
         getstr(tp^.sval); { get string }
         { if translate character values is set, process string }
         if fxltchr then for i := 1 to max(tp^.sval^) do 
            tp^.sval^[i] := chrtrn[ord(tp^.sval^[i])];
         rdtyp := tp { set read type }

      end;         
      iccst: begin

         gettyp(tp, tccst); { get the type entry }
         read(intfil, b); { get the character constant }
         read(intfil, b2);
         if b > 255 then error(eunimp); { flag > 255 as unimplemented unicode }
         if fxltchr then tp^.cval := chrtrn[b2] { place encoded value }
         else tp^.cval := chr(b2); { place value }
         rdtyp := tp { set read type }

      end;
      ircst: begin

         if gblreal = nil then error(einvfmt); { must have a real base }
         gettyp(tp, trcst); { get the type entry }
         rdreal(tp^.rval); { get value }
         rdtyp := tp { set read type }

      end;
      istcst: begin

         gettyp(tp, tstcst); { get the type entry }
         getlnk(tp^.stct); { get the base type }
         getlnk(tp^.stcc); { get the constant list start }
         rdtyp := tp { set read type }

      end;
      istet: begin

         gettyp(tp, tstet); { get the type entry }
         getlnk(tp^.sten); { get next linkage }
         rdvar(tp^.stes); { get starting value }
         rdvar(tp^.stee); { get ending value }
         getlnk(tp^.steh); { get head linkage }
         rdtyp := tp { set read type }
      
      end;
      iarrcst: begin

         gettyp(tp, tarrcst); { get the type entry }
         getlnk(tp^.arcn); { get the list linkage }
         rdtyp := tp { set read type }

      end;
      iarrcel: begin

         gettyp(tp, tarrcel); { get the type entry }
         getlnk(tp^.aren); { get the next entry link }
         getlnk(tp^.arec); { get the constant link }
         rdtyp := tp { set read type }

      end;
      ireccst: begin

         gettyp(tp, treccst); { get the type entry }
         getlnk(tp^.recn); { get the list linkage }
         rdtyp := tp { set read type }

      end;
      ireccel: begin

         gettyp(tp, treccel); { get the type entry }
         getlnk(tp^.reen); { get the next entry link }
         getlnk(tp^.reec); { get the constant link }
         rdtyp := tp { set read type }

      end;
      ienum: begin

         gettyp(tp, tenum); { get the type entry }
         getlnk(tp^.enc); { link to start of enumerator list }
         rdtyp := tp { set read type }

      end;
      ienme: begin
     
         gettyp(tp, tenme); { get the type entry }
         getlnk(tp^.enx); { get next enumerator link }
         getlnk(tp^.enh); { get head link }
         rdvar(v); { get value }
         { should not be negative }
         if v.s then error(esysflt55); { should not occur }
         tp^.env := v.v; { use positive value only }
         rdtyp := tp { set read type }

      end;
      isub: begin
     
         gettyp(tp, tsub); { get the type entry }
         getlnk(tp^.subt); { get base type link }
         rdvar(tp^.subl); { get lower bound }
         rdvar(tp^.subu); { get upper bound }
         rdtyp := tp { set read type }

      end;
      iptr: begin

         gettyp(tp, tptr); { get the type entry }
         getlnk(tp^.ptrt); { get base type link }
         rdtyp := tp { set read type }

      end;
      iarray: begin

         gettyp(tp, tarray); { get the type entry }
         getlnk(tp^.arrt); { get the base type }
         getlnk(tp^.arri); { get the index type }
         rdtyp := tp { set read type }

      end;
      igarry: begin

         gettyp(tp, tgarry); { get the type entry }
         getlnk(tp^.gart); { get the base type }
         rdtyp := tp { set read type }

      end;
      ifile: begin

         gettyp(tp, tfile); { get the type entry }
         getlnk(tp^.filt); { get base type }
         rdtyp := tp { set read type }

      end;
      iset: begin

         gettyp(tp, tset); { get the type entry }
         getlnk(tp^.sett); { get base type }
         rdtyp := tp { set read type }

      end;
      irecord: begin

         gettyp(tp, trecord); { get the type entry }
         getlnk(tp^.recf); { get field list link }
         tp^.recs := nil; { clear field symbols list }
         tp^.recl := nil;
         rdtyp := tp { set read type }

      end;
      ifield: begin

         gettyp(tp, tfield); { get the type entry }
         getlnk(tp^.fldn); { get next field link }
         getlnk(tp^.fldh); { get head link }
         getlnk(tp^.fldt); { get base link }
         rdtyp := tp { set read type }

      end;
      iftag: begin

         gettyp(tp, tftag); { get the type entry }
         getlnk(tp^.ftgc); { get case list link }
         getlnk(tp^.ftgh); { get head }
         getlnk(tp^.ftgt); { get base }
         read(intfil, b); { get exists flag }
         tp^.ftge := b <> 0; { place }
         rdtyp := tp { set read type }

      end;
      ifcas: begin

         gettyp(tp, tfcas); { get the type entry }
         getlnk(tp^.fcsn); { get next case }
         getlnk(tp^.fcsf); { get field list }
         rdvar(tp^.fcss); { get case constant start }
         rdvar(tp^.fcse); { get case constant end }
         rdtyp := tp { set read type }

      end;
      ivar: begin

         gettyp(tp, tvar); { get the type entry }
         getlnk(tp^.vart); { get base }
         tp^.local := blkstk^.lvl >= 3;
         read(intfil, b); { get external flag }
         tp^.vare := b <> 0; { set }
         rdvar(v); { get module ordinal }
         if v.s then error(einvfmt); { should not be negative }
         tp^.varmd := fndmod(v.v); { set module }
         tp^.varr := false; { set no references }
         getlnk(tp^.classt); { get class entry }
         rdtyp := tp { set read type }

      end;
      ifix: begin

         gettyp(tp, tfix); { get the type entry }
         getlnk(tp^.fixt); { get base type link }
         getlnk(tp^.fixc); { get constant link }
         read(intfil, b); { get external flag }
         tp^.fixe := b <> 0; { set }
         rdvar(v); { get module ordinal }
         if v.s then error(einvfmt); { should not be negative }
         tp^.fixmd := fndmod(v.v); { set module }
         tp^.fixr := false; { set no references }
         rdtyp := tp { set read type }

      end;
      iproc: begin

         gettyp(tp, tproc); { get the type entry }
         getlnk(tp^.prcp); { get parameter list }
         read(intfil, b); { get external flag }
         tp^.prce := b <> 0; { set }
         rdvar(v); { get module ordinal }
         if v.s then error(einvfmt); { should not be negative }
         tp^.prcmd := fndmod(v.v); { set module }
         read(intfil, b); { get assembly flag }
         tp^.prcas := b <> 0; { set }
         tp^.prcr := false; { set no references }
         getlnk(tp^.prch); { get overload head }
         tp^.prcx := false; { set not global }
         read(intfil, b); { get static flag }
         tp^.prcst := b <> 0; { set }
         read(intfil, b); { get virtual flag }
         tp^.prcvt := b <> 0; { set }
         getlnk(tp^.prcol); { get overrider link }
         getlnk(tp^.prcoh); { get override head link }
         getlnk(tp^.prccl); { get class type link }
         tp^.prcvv := nil; { clear virtual vector }
         rdtyp := tp { set read type }

      end;
      ifunc: begin

         gettyp(tp, tfunc); { get the type entry }
         getlnk(tp^.fncp); { get parameter list }
         getlnk(tp^.fncr); { get function result }
         { replace function result type with a placeholder, so that it can hold
           a program address }
         gettypa(tp1, tfuncr); { get a function result type entry }
         tp1^.fnrt := tp^.fncr; { place type }
         tp^.fncr := tp1; { place that as function result }
         tp^.fncr^.local := true; { set that local }
         read(intfil, b); { get external flag }
         tp^.fnce := b <> 0; { set }
         rdvar(v); { get module ordinal }
         if v.s then error(einvfmt); { should not be negative }
         tp^.fncmd := fndmod(v.v); { set module }
         read(intfil, b); { get assembly flag }
         tp^.fncas := b <> 0; { set }
         tp^.fnct := false; { set no references }
         getlnk(tp^.fnch); { get overload head }
         tp^.fncx := false; { set not global }
         read(intfil, b); { get static flag }
         tp^.fncst := b <> 0; { set }
         read(intfil, b); { get virtual flag }
         tp^.fncvt := b <> 0; { set }
         getlnk(tp^.fncol); { clear overrider link }
         getlnk(tp^.fncoh); { get override head link }
         getlnk(tp^.fnccl); { get class type link }
         tp^.fncvv := nil; { clear virtual vector }
         rdtyp := tp { set read type }

      end;
      ipar: begin

         gettyp(tp, tpar); { get the type entry }
         tp^.local := true; { set local }
         getlnk(tp^.parn); { get next parameter }
         getlnk(tp^.part); { get base }
         getlnk(tp^.parh); { get head }
         rdtyp := tp { set read type }

      end;
      ivpar: begin

         gettyp(tp, tvpar); { get the type entry }
         tp^.local := true; { set local }
         getlnk(tp^.vprn); { get next parameter }
         getlnk(tp^.vprt); { get base }
         getlnk(tp^.vprh); { get head }
         rdtyp := tp { set read type }

      end;
      iwpar: begin

         gettyp(tp, twpar); { get the type entry }
         tp^.local := true; { set local }
         getlnk(tp^.wprn); { get next parameter }
         getlnk(tp^.wprt); { get base }
         getlnk(tp^.wprh); { get head }
         rdtyp := tp { set read type }

      end;
      ipproc: begin

         gettyp(tp, tpproc); { get the type entry }
         tp^.local := true; { set local }
         getlnk(tp^.pprp); { get parameter list }
         getlnk(tp^.pprn); { get next parameter }
         rdtyp := tp { set read type }

      end;
      ipfunc: begin

         gettyp(tp, tpfunc); { get the type entry }
         tp^.local := true; { set local }
         getlnk(tp^.pfnp); { get parameter list }
         getlnk(tp^.pfnr); { get function result }
         { replace function result type with a placeholder, so that it can hold
           a program address }
         gettypa(tp1, tfuncr); { get a function result type entry }
         tp1^.fnrt := tp^.pfnr; { place type }
         tp^.pfnr := tp1; { place that as function result }
         tp^.pfnr^.local := true; { set that local }
         getlnk(tp^.pfnn); { get next parameter }
         rdtyp := tp { set read type }

      end;
      iint: begin { integer type }

         gettyp(tp, tinteger); { get the type entry }
         gblint := tp; { place global integer type }
         rdtyp := tp { set read type }

      end;
      ilint: begin { long integer type }

         gettyp(tp, tlinteger); { get the type entry }
         gbllint := tp; { place global long integer type }
         rdtyp := tp { set read type }

      end;
      icard: begin { cardinal type }

         gettyp(tp, tcardinal); { get the type entry }
         gblcard := tp; { place global cardinal type }
         rdtyp := tp { set read type }

      end;
      ilcard: begin { long integer type }

         gettyp(tp, tlcardinal); { get the type entry }
         gbllcard := tp; { place global long cardinal type }
         rdtyp := tp { set read type }

      end;
      ichar: begin { character type }

         gettyp(tp, tchar); { get the type entry }
         gblchr := tp; { place global character type }
         rdtyp := tp { set read type }

      end;
      iboolean: begin { boolean type }

         gettyp(tp, tboolean); { get the type entry }
         gblbool := tp; { place global boolean type }
         getlnk(tp^.bnc); { get enumerated constants }
         rdtyp := tp { set read type }

      end;
      ireal: begin { real type }

         gettyp(tp, treal); { get the type entry }
         gblreal := tp; { place global real type }
         rdtyp := tp { set read type }

      end;
      isreal:  begin

         gettyp(tp, tsreal); { short real type }
         gblsreal := tp; { place global short real type }
         rdtyp := tp { set read type }

      end;
      itext: begin

         gettyp(tp, ttext); { text file entry }
         gbltext := tp; { place global text type }
         rdtyp := tp { set read type }

      end;
      ieset: begin

         gettyp(tp, teset); { empty set }
         rdtyp := tp { set read type }

      end;
      iglbl: begin

         gettyp(tp, tglbl); { get the type entry }
         read(intfil, b); { get module type }
         if b > 5 then error(einvfmt); { invalid format }
         tp^.mrkt := mrktyp(b); { place type }
         gettypa(tp^.ds, tvar); { make a display save for this block }
         tp^.ds^.local := false; { set not a local }
         tp^.ds^.vare := false; { set not external }
         gettypa(tp^.ds^.vart, tnil); { set base type pointer }
         rdtyp := tp { set read type }

      end;
      isemaphore: begin

         gettyp(tp, tsemaphore); { semaphore entry }
         rdtyp := tp { set read type }

      end;
      iclass:     error(eunimp); { not implemented }
      iatom:      error(eunimp); { not implemented }
      ithread:    error(eunimp); { not implemented }
      ireference: error(eunimp); { not implemented }
      iexception: begin

         gettyp(tp, texception); { exception entry }
         rdtyp := tp { set read type }

      end;
      inull: begin

         gettyp(tp, tnull); { get the type entry }
         rdtyp := tp { set read type }

      end;
      isym: begin { symbol }

         lstsym(lp); { get a new symbol entry }
         getstr(lp^.lab); { read in symbol }
         getlnk(lp^.typ); { get the type linkage }
         read(intfil, b); { get exportable flag }
         lp^.exp := b <> 0 { set flag }

      end;
      issym: begin { simple symbol }

         { simple symbols get attached to the last type entry }
         if rdtyp = nil then error(einvfmt); { invalid format }
         getsym(lp); { get a new symbol entry }
         getstr(lp^.lab); { read in symbol }
         if rdtyp^.t <> trecord then error(einvfmt); { invalid format }
         { place at end of record field symbol list }
         if rdtyp^.recl = nil then { first symbol in list }
            rdtyp^.recs := lp { place at top }
         else rdtyp^.recl^.next := lp; { place after last }
         rdtyp^.recl := lp { set new last }

      end;

      { *** OBJECT CODE SECTION *** }

      ibgnpgm: begin { main section start }

         resblk; { resolve forward references }
         setgbl; { move global status to procedures and functions }
         sizblk; { size entries in block }
         setrecoff; { set record offsets }
         xltchrset; { translate character sets if enabled }
         blkstk^.res := nil; { clear resolvables }
         blkstk^.resa := nil;
         if blkstk^.lvl >= 3 then begin { not system or module block }
   
            { locals not allocated }
            adjpar; { adjust parameter levels }
            allloc { allocate previous block locals }

         end;
         { collect a complete block for this section }
         ip1 := nil; { clear next }
         repeat { collect intermediates }

            getcod(ic); { get the next tolken head }
            if ic <> iendpgm then { not the end tolken }
               rdint(ic, blkstk^.entry, ip1) { process }

         until ic = iendpgm { until end of this section }
         
      end;
      iendpgm:  error(einvfmt); { should not occur alone }
      ibgnext: begin { start finalizer section }

         { collect a complete block for this section }
         ip1 := nil; { clear next } 
         repeat { collect intermediates }

            getcod(ic); { get the next tolken head }
            if ic <> iendext then { not the end tolken }
               rdint(ic, blkstk^.exit, ip1) { process }

         until ic = iendext { until end of this section }

      end;
      iendext:  error(einvfmt); { should not occur alone }
      ilimint: begin
 
         gettypa(tp, ticst); { get type entry }
         rdvar(tp^.ival); { get value }
         getint(ip, tilimint); { get intermediate entry }
         ip^.base := tp; { place value }
         pshint(ip) { push result onto the stack }

      end;
      ilimrel: begin

         gettypa(tp, trcst); { get the type entry }
         rdreal(tp^.rval); { get value }
         getint(ip, tilimrel); { get intermediate entry }
         ip^.base := tp; { place value }
         pshint(ip) { push result onto the stack }

      end;
      ilimns: begin

         getint(ip, tilimns); { get intermediate entry }
         pshint(ip) { push result onto the stack }

      end;
      irngset: begin

         getint(ip, tirngset); { get intermediate entry }
         popint(ip^.xtra); { get top element }
         popint(ip^.right); { get bottom element }
         popint(ip^.left); { get set base }
         pshint(ip) { push result onto the stack }

      end;
      iswptop: begin

         getlnk(tp); { get source }
         getlnk(tp1); { get destination }
         popint(ip1); { actually perform the swap }
         popint(ip2);
         pshint(ip1);
         pshint(ip2)
         
      end;
      { no operand operators with helper type }
      ilodadr, ilodfadr: begin

         getlnk(tp); { get type }
         { get intermediate entry }
         if ic = ilodadr then getint(ip, tilodadr) else getint(ip, tilodfadr);
         ip^.base := tp; { place type }
         pshint(ip) { push result onto the stack }

      end;
      { unary operators }
      icvtntg, icvtitr, inotbol, inotint, ilditgp, ildiptr, ildibol,
      ildichr, ildiset, ildisrl, ildirel, inegint, inegrel, iabsrel, iabsint,
      isqrrel, isqrint, iatnrel, icosrel, iexprel, ilgnrel, isinrel, isqtrel, ieolt,
      iodd, isucint, iprdint, irnd, itrc, iexist, ilen, iloc, ilodafbuf,
      ilodafbuft, icvtrtsr: begin

         { get intermediate entry }
         case ic of

            icvtntg:    getint(ip, ticvtntg); 
            icvtitr:    getint(ip, ticvtitr); 
            inotbol:    getint(ip, tinotbol); 
            inotint:    getint(ip, tinotint); 
            ilditgp:    getint(ip, tilditgp); 
            ildiptr:    getint(ip, tildiptr); 
            ildibol:    getint(ip, tildibol);
            ildichr:    getint(ip, tildichr); 
            ildiset:    getint(ip, tildiset); 
            ildisrl:    getint(ip, tildisrl); 
            ildirel:    getint(ip, tildirel); 
            inegint:    getint(ip, tinegint); 
            inegrel:    getint(ip, tinegrel); 
            iabsrel:    getint(ip, tiabsrel); 
            iabsint:    getint(ip, tiabsint);
            isqrrel:    getint(ip, tisqrrel); 
            isqrint:    getint(ip, tisqrint); 
            iatnrel:    getint(ip, tiatnrel); 
            icosrel:    getint(ip, ticosrel); 
            iexprel:    getint(ip, tiexprel); 
            ilgnrel:    getint(ip, tilgnrel); 
            isinrel:    getint(ip, tisinrel); 
            isqtrel:    getint(ip, tisqtrel); 
            ieolt:      getint(ip, tieolt);
            iodd:       getint(ip, tiodd); 
            isucint:    getint(ip, tisucint); 
            iprdint:    getint(ip, tiprdint); 
            irnd:       getint(ip, tirnd);
            itrc:       getint(ip, titrc);
            iexist:     getint(ip, tiexist);
            ilen:       getint(ip, tilen);
            iloc:       getint(ip, tiloc);
            ilodafbuf:  getint(ip, tilodafbuf);
            ilodafbuft: getint(ip, tilodafbuft);
            icvtrtsr:   getint(ip, ticvtrtsr);

         end;
         popint(ip^.left); { get operand }
         pshint(ip) { push result onto the stack }

      end;
      { binary operators }
      iintset, imltrel, imltint, idivrel, idivint, imodint, iandint, isinset,
      iuniset, iaddrel, iaddint, idifset, isubrel, isubint, iorint, ixorint,
      iincset, iequset, iequrel, iequgst, iequint, iequtgp, ineqset, ineqrel,
      ineqgst, ineqint, ineqtgp, ileqset, ileqrel, ileqgst, ileqint, igeqset,
      igeqrel, igeqgst, igeqint, iltnrel, iltngst, iltnint, igtnrel, igtngst,
      igtnint: begin

         { get intermediate entry }
         case ic of

            iintset: getint(ip, tiintset);
            imltrel: getint(ip, timltrel);
            imltint: getint(ip, timltint);
            idivrel: getint(ip, tidivrel);
            idivint: getint(ip, tidivint);
            imodint: getint(ip, timodint);
            iandint: getint(ip, tiandint);
            isinset: getint(ip, tisinset);
            iuniset: getint(ip, tiuniset);
            iaddrel: getint(ip, tiaddrel);
            iaddint: getint(ip, tiaddint);
            idifset: getint(ip, tidifset);
            isubrel: getint(ip, tisubrel);
            isubint: getint(ip, tisubint);
            iorint:  getint(ip, tiorint); 
            ixorint: getint(ip, tixorint);
            iincset: getint(ip, tiincset);
            iequset: getint(ip, tiequset);
            iequrel: getint(ip, tiequrel);
            iequgst: getint(ip, tiequgst);
            iequint: getint(ip, tiequint);
            iequtgp: getint(ip, tiequtgp);
            ineqset: getint(ip, tineqset);
            ineqrel: getint(ip, tineqrel);
            ineqgst: getint(ip, tineqgst);
            ineqint: getint(ip, tineqint);
            ineqtgp: getint(ip, tineqtgp);
            ileqset: getint(ip, tileqset);
            ileqrel: getint(ip, tileqrel);
            ileqgst: getint(ip, tileqgst);
            ileqint: getint(ip, tileqint);
            igeqset: getint(ip, tigeqset);
            igeqrel: getint(ip, tigeqrel);
            igeqgst: getint(ip, tigeqgst);
            igeqint: getint(ip, tigeqint);
            iltnrel: getint(ip, tiltnrel);
            iltngst: getint(ip, tiltngst);
            iltnint: getint(ip, tiltnint);
            igtnrel: getint(ip, tigtnrel);
            igtngst: getint(ip, tigtngst);
            igtnint: getint(ip, tigtnint)

         end;
         popint(ip^.right); { get operands }
         popint(ip^.left);
         pshint(ip) { push result onto the stack }

      end;
      { unary operators with helper type }
      icvtftg, icvtgtf, ilodlen, ildisrc, ildiint, irecoff, ieof,
      irngchk: begin

         getlnk(tp); { get type }
         { get intermediate entry }
         case ic of

            icvtftg: getint(ip, ticvtftg);
            icvtgtf: getint(ip, ticvtgtf);
            ilodlen: getint(ip, tilodlen);
            ildisrc: getint(ip, tildisrc);
            ildiint: getint(ip, tildiint);
            irecoff: getint(ip, tirecoff);
            ieof:    getint(ip, tieof);
            irngchk: getint(ip, tirngchk)

         end;
         ip^.base := tp; { place string type }
         popint(ip^.left); { get operand }
         pshint(ip) { push result onto the stack }

      end;
      { binary operators with helper type }
      iequstr, ineqstr, ileqstr, igeqstr, iltnstr, igtnstr, iarfgar,
      iarrref: begin

         getlnk(tp); { get type }
         { get intermediate entry }
         case ic of

            iequstr: getint(ip, tiequstr);
            ineqstr: getint(ip, tineqstr);
            ileqstr: getint(ip, tileqstr);
            igeqstr: getint(ip, tigeqstr);
            iltnstr: getint(ip, tiltnstr);
            igtnstr: getint(ip, tigtnstr);
            iarfgar: getint(ip, tiarfgar);
            iarrref: getint(ip, tiarrref)

         end;
         ip^.base := tp; { place type }
         popint(ip^.right); { get operands }
         popint(ip^.left);
         pshint(ip) { push result onto the stack }

      end;
      { unary terminals }
      iget, igett, iput, iclose, ipaget, idel, isignal, isignalone, iwait: begin

         { get intermediate entry }
         case ic of

            iget:       getint(ip, tiget); 
            igett:      getint(ip, tigett); 
            iput:       getint(ip, tiput); 
            iclose:     getint(ip, ticlose);
            ipaget:     getint(ip, tipaget);
            idel:       getint(ip, tidel);
            isignal:    getint(ip, tisignal);
            isignalone: getint(ip, tisignalone);
            iwait:      getint(ip, tiwait)

         end;
         popint(ip^.left); { place operand }
         insert(ip) { place in flow }

      end;
      { binary terminals }
      iassign, ipos, ichg, iassert: begin

         { get intermediate entry }
         case ic of

            iassign: getint(ip, tiassign);
            ipos:    getint(ip, tipos); 
            ichg:    getint(ip, tichg);
            iassert: getint(ip, tiassert)

         end;
         popint(ip^.right); { place right operand }
         popint(ip^.left); { place left operand }
         insert(ip) { place in flow }

      end;
      { trinary file terminals }
      iwrtintft, iwrtchrft, iwrtbolft, iwrtrelft, iwrtgstft: begin

         { get intermediate entry }
         case ic of

            iwrtintft: getint(ip, tiwrtintft);
            iwrtchrft: getint(ip, tiwrtchrft);
            iwrtbolft: getint(ip, tiwrtbolft);
            iwrtrelft: getint(ip, tiwrtrelft);
            iwrtgstft: getint(ip, tiwrtgstft)

         end;
         popint(ip^.xtra); { place xtra operand }
         popint(ip^.right); { place right operand }
         popint(ip1); { get left (file) operand }
         pshint(ip1); { replace onto stack }
         cpyint(ip1, ip^.left); { create copy for tree }
         insert(ip) { place in flow }

      end;
      { quad file terminals }
      iwrtrelfft: begin

         getint(ip, tiwrtrelfft); { get intermediate entry }
         popint(ip^.xtra2); { place second xtra operand }
         popint(ip^.xtra); { place xtra operand }
         popint(ip^.right); { place right operand }
         popint(ip1); { get left (file) operand }
         pshint(ip1); { replace onto stack }
         cpyint(ip1, ip^.left); { create copy for tree }
         insert(ip) { place in flow }

      end;
      { unary terminals with helper type }
      idspgar, ireset, irewrite, iupdate, iappend: begin

         getlnk(tp); { get type }
         { get intermediate entry }
         case ic of

            idspgar:  getint(ip, tidspgar); 
            ireset:   getint(ip, tireset); 
            irewrite: getint(ip, tirewrite);
            iupdate:  getint(ip, tiupdate);
            iappend:  getint(ip, tiappend);

         end;
         ip^.base := tp; { place helper type }
         popint(ip^.left); { place operand }
         insert(ip) { place in flow }

      end;
      { binary terminals with helper type }
      istisrl, istirel, istiint, istichr, istibol, istiset, istisrc, istigar,
      istitgp, istifsrl, istifrel, istiftgp, istifint, istifchr, istifbol,
      inewgar: begin

         getlnk(tp); { get type }
         { get intermediate entry }
         case ic of

            istisrl:  getint(ip, tistisrl); 
            istirel:  getint(ip, tistirel); 
            istiint:  getint(ip, tistiint); 
            istichr:  getint(ip, tistichr); 
            istibol:  getint(ip, tistibol); 
            istiset:  getint(ip, tistiset); 
            istisrc:  getint(ip, tistisrc); 
            istigar:  getint(ip, tistigar); 
            istitgp:  getint(ip, tistitgp); 
            istifsrl: getint(ip, tistifsrl);
            istifrel: getint(ip, tistifrel);
            istiftgp: getint(ip, tistiftgp);
            istifint: getint(ip, tistifint);
            istifchr: getint(ip, tistifchr);
            istifbol: getint(ip, tistifbol);
            inewgar:  getint(ip, tinewgar) 

         end;
         ip^.base := tp; { place helper type }
         popint(ip^.right); { place right operand }
         popint(ip^.left); { place left operand }
         insert(ip) { place in flow }

      end;
      { trinary terminals with double helper type }
      ipack, iunpack: begin

         { get intermediate entry }
         if ic = ipack then getint(ip, tipack) else getint(ip, tiunpack);
         getlnk(tp); { get type }
         ip^.base := tp; { place helper type }
         getlnk(tp); { get type }
         ip^.base2 := tp; { place helper type }
         popint(ip^.xtra); { place xtra operand }
         popint(ip^.right); { place right operand }
         popint(ip^.left); { place left operand }
         insert(ip) { place in flow }

      end;
      { file unary terminals }
      iwrteolt, iredeolt: begin

         { get intermediate entry }
         if ic = iwrteolt then getint(ip, tiwrteolt) else getint(ip, tiredeolt);
         popint(ip1); { get left (file) operand }
         pshint(ip1); { replace onto stack }
         cpyint(ip1, ip^.left); { create copy for tree }
         insert(ip) { place in flow }

      end;
      { file binary terminals }
      iwrtintt, iwrtchrt, iwrtbolt, iwrtrelt, iwrtgstt,
      iwrtsrl, iwrtrel, iwrtset, iwrtchr, iwrtbol, iredchrt, 
      iredsrlt, iredrelt: begin

         { get intermediate entry }
         case ic of

            iwrtintt: getint(ip, tiwrtintt);
            iwrtchrt: getint(ip, tiwrtchrt);
            iwrtbolt: getint(ip, tiwrtbolt);
            iwrtrelt: getint(ip, tiwrtrelt);
            iwrtgstt: getint(ip, tiwrtgstt);
            iwrtsrl:  getint(ip, tiwrtsrl); 
            iwrtrel:  getint(ip, tiwrtrel); 
            iwrtset:  getint(ip, tiwrtset); 
            iwrtchr:  getint(ip, tiwrtchr); 
            iwrtbol:  getint(ip, tiwrtbol); 
            iredchrt: getint(ip, tiredchrt);
            iredsrlt: getint(ip, tiredsrlt);
            iredrelt: getint(ip, tiredrelt)

         end;
         popint(ip^.right); { place right operand }
         popint(ip1); { get left (file) operand }
         pshint(ip1); { replace onto stack }
         cpyint(ip1, ip^.left); { create copy for tree }
         insert(ip) { place in flow }

      end;
      { file binary terminals with helper type }
      iwrtsrc, iwrtstrt, iwrtint, iredsrc, iredintt: begin

         getlnk(tp); { get type }
         { get intermediate entry }
         case ic of

            iwrtsrc:  getint(ip, tiwrtsrc); 
            iwrtstrt: getint(ip, tiwrtstrt);
            iwrtint:  getint(ip, tiwrtint); 
            iredsrc:  getint(ip, tiredsrc); 
            iredintt: getint(ip, tiredintt)

         end;
         ip^.base := tp; { place helper type }
         popint(ip^.right); { place right operand }
         popint(ip1); { get left (file) operand }
         pshint(ip1); { replace onto stack }
         cpyint(ip1, ip^.left); { create copy for tree }
         insert(ip) { place in flow }

      end;
      { file trinary terminals with helper type }
      iwrtstrft: begin

         getlnk(tp); { get type }
         getint(ip, tiwrtstrft); { get intermediate entry }
         ip^.base := tp; { place helper type }
         popint(ip^.xtra); { place xtra operand }
         popint(ip^.right); { place right operand }
         popint(ip1); { get left (file) operand }
         pshint(ip1); { replace onto stack }
         cpyint(ip1, ip^.left); { create copy for tree }
         insert(ip) { place in flow }

      end;
      ibgnblk:  ; { begin statement block. not used }
      iendblk:  ; { end statement block. not used }
      iifbgn: begin { if }

         { If becomes a fork structure, with flow2 being the true chain, flow3
           being the false chain, and flow being the next of both. An if
           without an else just has a null flow3. }
         getint(ip, tiifbgn); { get an intermediate for if }
         popint(ip^.left); { get if condition }
         { construct true conditional section }
         ip1 := nil; { clear next entry }
         repeat

            getcod(ic); { get next code }
            if (ic <> ielse) and (ic <> iifend) then
               { not end of 'if' or 'else' }
               rdint(ic, ip^.flow2, ip1) { process tolkens }

         until (ic = ielse) or (ic = iifend); { end of 'if' or 'else' }
         if ic = ielse then begin { 'else' exists }

            { construct false conditional section }
            ip1 := nil; { clear next entry }
            repeat

               getcod(ic); { get next code }
               if ic <> iifend then { not end of 'if' }
                  rdint(ic, ip^.flow3, ip1) { process tolkens }

            until ic = iifend; { end of 'if' }

         end;
         insert(ip) { insert if tolken }

      end;
      ielse: error(einvfmt); { should not occur alone }
      iifend: error(einvfmt); { should not occur alone }
      icasbgn: begin { case begin }

         { Cases are a complex structure. Flow2 contains a list of icasstb
           entries, linked with flow, each representing a case statement,
           which could be empty. The base contains a case select table
           structure, which will end up in the constants area. The case table
           is a list of case constants, each referencing the statement it will
           select. The base of each icasstb entry points to a case selector
           somewhere in the list, and all the original cases matched to that
           statement are chained. In this way, the addresses for each case can
           be assigned at build time. There are two kinds of case tables, jump
           and hash. After we read the entire statement in, we decide what the
           final form is. }
         getint(ip, ticasbgn); { get intermediate for case }
         popint(ip^.left); { get case selector value }
         getcodnsrc(ic); { get next code with source marker skipping }
         ip1 := nil; { set no next statement } 
         tp1 := nil; { set no next selector }
         repeat { process case statements }

            if (ic <> icasend) and (ic <> icasels) then begin 

               { there are statements }
               getint(ip2, ticasstb); { get the statement begin node }
               { insert to flow2 list }
               if ip1 = nil then ip^.flow2 := ip2 { insert as first entry }
               else ip1^.flow := ip2; { insert as last }
               ip1 := ip2; { set new last }
               tp2 := nil; { set no last case }
               repeat { process case values }

                  if (ic <> icassint) and (ic <> icassrng) then 
                     error(einvfmt); { bad file }
                  rdvar(l); { get low value }
                  h := l; { set high value to same for single }
                  if ic = icassrng then rdvar(h); { get high value }
                  { check start > end }
                  if ssgtn(l, h) then error(ecasrng);
                  { generate all the cases as individual entries }
                  while ssleq(l, h) do begin

                     gettypa(tp, tcassel); { get selector entry }
                     tp^.csv := l; { place value }
                     tp^.csn := nil; { clear next case link }
                     tp^.csm := nil; { clear missed hash chain }
                     tp^.csp := false; { set not padding }
                     tp^.css := nil; { clear next statement chain }
                     { insert to case list }
                     if tp1 = nil then ip^.base := tp { insert as first entry }
                     else tp1^.csn := tp; { insert as last entry }
                     tp1 := tp; { set new last }
                     { insert to statement case list }
                     if tp2 = nil then ip2^.base := tp { set as first entry }
                     else tp2^.css := tp; { set as next entry }
                     tp2 := tp; { set new last }
                     l.v := ssadd(l, false, 1); { increment low value }
                     l.s := ssadds(l, false, 1)

                  end;
                  getcodnsrc(ic) { get next code with source mark skipping }

               until (ic <> icassint) and (ic <> icassrng); { no more selectors }
               if ic <> icasstb then error(einvfmt); { bad file }
               ip3 := nil; { clear next entry }
               repeat

                  getcod(ic); { get next code }
                  if ic <> icasste then { not end of case statement }
                     rdint(ic, ip2^.flow2, ip3) { process tolkens }

               until ic = icasste; { end of case statement }
               getcodnsrc(ic) { get next code with source mark skipping }

            end

         until (ic = icasend) or (ic = icasels); { end of case }
         if ic = icasels then begin { there is an else clause }

            getint(ip2, ticasels); { get the statement begin node }
            { insert to flow2 list }
            if ip1 = nil then ip^.flow2 := ip2 { insert as first entry }
            else ip1^.flow := ip2; { insert as last }
            { process statement }
            ip3 := nil; { clear next entry }
            repeat

               getcod(ic); { get next code }
               if ic <> icasend then { not end of case statement }
                  rdint(ic, ip2^.flow2, ip3) { process tolkens }

            until ic = icasend { end of case statement }

         end;
         insert(ip); { insert case tolken }
         { to prepare a case for coding, we sort it for order, then check its
           "occupancy", or number of dead entries in the sequence of its
           selectors. If this is less than the occupancy value, we set up the
           table as a hash value table, otherwise, a standard jump table is
           used. }
         srtcas(ip^.base); { sort the case entries }
         chkcasdup(ip^.base); { check for duplicates }
         if occupancy(ip^.base) < minocc then begin { hash table }

            { Case occupancy is below the minimum }
            gettypa(tp, thshtbl); { get the proper head entry }
            tp^.htn := ip^.base; { set head }
            ip^.base := tp;
            { set case statistics }
            cassts(tp^.htn, tp^.htc, tp^.htl, tp^.hth)
            { Thats all we can do here, because the hash function is cpu
              dependent. The rest of the table layout work is done at build
              time. }

         end else begin { jump table }

            gettypa(tp, tcastbl); { get the proper head entry }
            tp^.ctn := ip^.base; { set head }
            ip^.base := tp;
            makjpt(ip^.base); { make into jump table }
            { set case statistics }
            cassts(tp^.ctn, tp^.ctc, tp^.ctl, tp^.cth)

         end
        
      end;
      icassint: error(einvfmt); { should not occur alone }
      icassrng: error(einvfmt); { should not occur alone }
      icasstb: error(einvfmt); { should not occur alone }
      icasels: error(einvfmt); { should not occur alone }
      icasste: error(einvfmt); { should not occur alone }
      icasend: error(einvfmt); { should not occur alone }
      iwhlexp: ; { we don't use this tolken }
      iwhlbgn: begin { While begin }

         { While becomes a single fork structure. The contents of the loop
           becomes flow2. }
         getint(ip, tiwhlbgn); { get intermediate for while }
         popint(ip^.left); { get condition }
         { construct loop section }
         ip1 := nil; { clear next entry }
         repeat

            getcod(ic); { get next code }
            if ic <> iwhlend then { not end of while }
               rdint(ic, ip^.flow2, ip1) { process tolkens }

         until ic = iwhlend; { end of while }
         insert(ip) { insert whole tolken string }

      end;
      iwhlend: error(einvfmt); { should not occur alone }
      irptbgn: begin { repeat }

         { Repeat looks just like a while, but the condition refers to the end,
           not the beginning, of the loop section. }
         getint(ip, tirptbgn); { get intermediate for repeat }
         { construct the list of fallthrough codes }
         ip1 := nil; { clear next entry }
         repeat

            getcod(ic); { get next code }
            if ic <> irptend then { not end of repeat }
               rdint(ic, ip^.flow2, ip1) { process tolkens }

         until ic = irptend; { end of repeat }
         { The condition for the until occurs at the end of the loop, and the
           demarcation between statement code and until condition is not marked.
           However, after the flow is gathered, it will be sitting on the stack,
           because non-terminals stack, not flow. }
         popint(ip^.left); { get selector }
         insert(ip) { insert whole tolken string }
         
      end;
      irptend: error(einvfmt); { should not occur alone }
      ifortint, ifortchr, ifortbol, ifordint, ifordchr,
      ifordbol: begin { for loop }

         { For has the loop code on flow2, the starting condition as
           expression left, and the ending condition as expression right. }
         getlnk(tp); { get type }
         { get intermediate entry }
         case ic of

            ifortint: getint(ip, tifortint); 
            ifortchr: getint(ip, tifortchr); 
            ifortbol: getint(ip, tifortbol); 
            ifordint: getint(ip, tifordint); 
            ifordchr: getint(ip, tifordchr); 
            ifordbol: getint(ip, tifordbol) 

         end;
         ip^.base := tp; { place control variable type }
         popint(ip^.right); { get the end value }
         popint(ip^.left); { get the start value }
         ip1 := nil; { clear next entry }
         repeat

            getcod(ic); { get next code }
            if ic <> iforend then { not end of repeat }
               rdint(ic, ip^.flow2, ip1) { process tolkens }

         until ic = iforend; { end of repeat }
         insert(ip) { insert whole tolken string }

      end;
      iforend: error(einvfmt); { should not occur alone }
      iwthbgn: begin { 'with' begin }

         getlnk(tp); { get record type }
         getint(ip, tiwthbgn); { get the master entry }
         ip^.base := tp; { set base is record type } 
         { get a temp to store 'with' base address }
         gettypa(tp, tvar); { get the type entry }
         tp^.vart := gblnil; { set base type }
         tp^.vare := false; { set not external }
         tp^.local := blkstk^.lvl >= 3;
         ip^.base2 := tp; { place }
         popint(ip^.left); { get selector }
         { with statements become a side chain linked to the master
           entry }
         ip1 := nil; { clear next entry }
         repeat

            getcod(ic); { get next code }
            if ic <> iwthend then { not end of repeat }
               rdint(ic, ip^.flow2, ip1) { process tolkens }

         until ic = iwthend; { end of with }
         insert(ip) { place in flow }

      end;
      iwthend:  error(einvfmt); { should not occur alone }
      itrybgn: begin { try statement }

         { Try is a block followed by a series of clauses.
           The protected block is contained in flow2, and flow3 contains the
           list of clauses, which can be both specific exceptions and an else
           clause. The unspecific exception is turned into a specific
           exception that references the global master exception. }   
         getint(ip, titrybgn); { get intermediate for try }
         { construct protected block }
         ip1 := nil; { clear next entry }
         repeat

            getcod(ic); { get next code }
            if (ic <> itryexp) and (ic <> itryexpspc) and (ic <> itryend) and 
               (ic <> ielse) then { not end of try }
               rdint(ic, ip^.flow2, ip1) { process tolkens }

         until (ic = itryexp) or (ic = itryexpspc) or (ic = itryend) or 
               (ic = ielse); { end tolken found }
         ip1 := nil; { set no exception clauses in list } 
         { process try clauses }
         while ic <> itryend do begin

            if ic = itryexpspc then begin { exception with qualifier variable }

               getint(ip2, titryexp); { construct exception entry }
               popint(ip2^.left); { get address of exception }
               { insert to flow3 list }
               if ip1 = nil then ip^.flow3 := ip2 { insert as first entry }
               else ip1^.flow := ip2; { insert as last }
               { construct exception block }
               ip3 := nil; { clear next entry }
               repeat
               
                  getcod(ic); { get next code }
                  if (ic <> itryexp) and (ic <> itryexpspc) and (ic <> itryend) and
                     (ic <> ielse) then { no end tolken found }
                     rdint(ic, ip1^.flow2, ip3) { process tolkens }
               
               until (ic = itryexp) or (ic = itryexpspc) or (ic = itryend) or 
                     (ic = ielse) { end tolken found }

            end else if ic = itryexp then begin { unqualified exception }
               
               getint(ip2, titryexp); { construct exception entry }
               getint(ip2^.left, tilodadr); { construct load address entry }
               ip2^.left^.base := gblexc; { index global exception }  
               { insert to flow3 list }
               if ip1 = nil then ip^.flow3 := ip2 { insert as first entry }
               else ip1^.flow := ip2; { insert as last }
               { construct exception block }
               ip3 := nil; { clear next entry }
               repeat
               
                  getcod(ic); { get next code }
                  if (ic <> itryexp) and (ic <> itryexpspc) and (ic <> itryend) and
                     (ic <> ielse) then { no end tolken found }
                     rdint(ic, ip1^.flow2, ip3) { process tolkens }
               
               until (ic = itryexp) or (ic = itryexpspc) or (ic = itryend) or 
                     (ic = ielse) { end tolken found }
       
            end else if ic = ielse then begin { no exception taken }

               { construct no exception branch }
               getint(ip2, titryels); { construct else entry }
               { insert to flow3 list }
               if ip1 = nil then ip^.flow3 := ip2 { insert as first entry }
               else ip1^.flow := ip2; { insert as last }
               ip3 := nil; { clear next entry }
               repeat
               
                  getcod(ic); { get next code }
                  if (ic <> itryexp) and (ic <> itryexpspc) and (ic <> itryend) and
                     (ic <> ielse) then { no end tolken found }
                     rdint(ic, ip^.flow2, ip3) { process tolkens }
               
               until (ic = itryexp) or (ic = itryexpspc) or (ic = itryend) or 
                     (ic = ielse) { end tolken found }

            end else error(einvfmt) { bad format }

         end;
         insert(ip); { insert whole tolken string }

      end;
      itryexp, itryexpspc, itryend: error(eunimp); { should not occur alone }
      igoto: begin { goto }

         getlnk(tp); { get target label }
         getint(ip, tigoto); { get entry }
         ip^.base := tp; { place base type }
         insert(ip) { insert in flow }

      end;
      iprcbgn: ; { unused }
      iprccal, iprccalo: begin

         getlnk(tp); { get procedure entry }
         if tp^.t <> tproc then error(einvfmt); { must be procedure }
         { get a procedure call entry }
         if ic = iprccal then getint(ip, tiprccal) { standard }
         else getint(ip, tiprccalo); { override }
         insert(ip); { place in flow }
         ip^.base := tp; { place base }
         { parameters will be built on the left branch }
         tp1 := tp^.prcp; { index head parameter }
         ip1 := nil; { clear last entry }
         while tp1 <> nil do begin { process parameters }

            if not (tp1^.t in [tpar, tvpar, twpar, tpproc, tpfunc]) then
               error(einvfmt); { must be valid parameter }
            getint(ip2, ticalpar); { get a call parameter entry }
            if ip1 = nil then ip^.flow2 := ip2 { place root }
            else ip1^.flow := ip2; { place next }
            ip1 := ip2; { set new last }
            ip2^.base := tp1; { place base type }
            case tp1^.t of { next entry }

               tpar: tp1 := tp1^.parn;
               tvpar: tp1 := tp1^.vprn;
               twpar: tp1 := tp1^.wprn;
               tpproc: tp1 := tp1^.pprn;
               tpfunc: tp1 := tp1^.pfnn

            end

         end;
         plcpar(ip^.flow2) { place parameters to list back to front }

      end;
      iprccali: begin

         getlnk(tp); { get procedure entry }
         if tp^.t <> tpproc then error(einvfmt); { must be procedure }
         getint(ip, tiprccali); { get a procedure call entry }
         insert(ip); { place in flow }
         ip^.base := tp; { place base }
         { parameters will be built on the right branch, with the procedure
           address on the left }
         popint(ip^.left); { get procedure address }
         tp1 := tp^.pprp; { index head parameter }
         ip1 := nil; { clear last entry }
         while tp1 <> nil do begin { process parameters }

            if not (tp1^.t in [tpar, tvpar, twpar, tpproc, tpfunc]) then
               error(einvfmt); { must be valid parameter }
            getint(ip2, ticalpar); { get a call parameter entry }
            if ip1 = nil then ip^.flow2 := ip2 { place root }
            else ip1^.flow := ip2; { place next }
            ip1 := ip2; { set new last }
            ip2^.base := tp1; { place base type }
            case tp1^.t of { next entry }

               tpar: tp1 := tp1^.parn;
               tvpar: tp1 := tp1^.vprn;
               twpar: tp1 := tp1^.wprn;
               tpproc: tp1 := tp1^.pprn;
               tpfunc: tp1 := tp1^.pfnn

            end

         end;
         plcpar(ip^.flow2) { place parameters to list back to front }

      end;
      ifncbgn: ; { unused }
      ifnccal, ifnccalo: begin

         getlnk(tp); { get function entry }
         if tp^.t <> tfunc then error(einvfmt); { must be function }
         { get a function call entry }
         if ic = ifnccal then getint(ip, tifnccal) { standard }
         else getint(ip, tifnccalo); { override }
         ip^.base := tp; { place base }
         { parameters will be built on the flow branch }
         tp1 := tp^.fncp; { index head parameter }
         ip1 := nil; { clear last entry }
         while tp1 <> nil do begin { process parameters }

            if not (tp1^.t in [tpar, tvpar, twpar, tpproc, tpfunc]) then
               error(einvfmt); { must be valid parameter }
            getint(ip2, ticalpar); { get a call parameter entry }
            if ip1 = nil then ip^.flow2 := ip2 { place root }
            else ip1^.flow := ip2; { place next }
            ip1 := ip2; { set new last }
            ip2^.base := tp1; { place base type }
            case tp1^.t of { next entry }

               tpar: tp1 := tp1^.parn;
               tvpar: tp1 := tp1^.vprn;
               twpar: tp1 := tp1^.wprn;
               tpproc: tp1 := tp1^.pprn;
               tpfunc: tp1 := tp1^.pfnn

            end

         end;
         plcpar(ip^.flow2); { place parameters to list back to front }
         pshint(ip) { place function on stack }

      end;
      ifnccali: begin

         getlnk(tp); { get function entry }
         if tp^.t <> tpfunc then error(einvfmt); { must be function }
         getint(ip, tifnccali); { get a function call entry }
         ip^.base := tp; { place base }
         { parameters will be built on the right branch, with the procedure
           address on the left }
         popint(ip^.left); { get procedure address }
         tp1 := tp^.pfnp; { index head parameter }
         ip1 := nil; { clear last entry }
         while tp1 <> nil do begin { process parameters }

            if not (tp1^.t in [tpar, tvpar, twpar, tpproc, tpfunc]) then
               error(einvfmt); { must be valid parameter }
            getint(ip2, ticalpar); { get a call parameter entry }
            if ip1 = nil then ip^.flow2 := ip2 { place root }
            else ip1^.flow := ip2; { place next }
            ip1 := ip2; { set new last }
            ip2^.base := tp1; { place base type }
            case tp1^.t of { next entry }

               tpar: tp1 := tp1^.parn;
               tvpar: tp1 := tp1^.vprn;
               twpar: tp1 := tp1^.wprn;
               tpproc: tp1 := tp1^.pprn;
               tpfunc: tp1 := tp1^.pfnn

            end

         end;
         plcpar(ip^.flow2); { place parameters to list back to front }
         pshint(ip) { place function on stack }

      end;
      inew, idisp: begin { new, dispose }

         getlnk(tp); { get type }
         { get intermediate entry }
         if ic = inew then getint(ip, tinew) else getint(ip, tidisp);
         ip^.base := tp; { place helper type }
         popint(ip^.left); { place operand }
         insert(ip); { place in flow }
         { we'll validate this list while reading it }
         if tp^.t <> tptr then error(einvfmt); { must be pointer }
         tp := tp^.ptrt; { link base type }
         ip1 := nil; { clear last pointer }
         getcodnsrc(ic); { read the next tag with source mark skipping }
         { the tag list is built on the right }
         if tp^.t = trecord then begin { it's a record, process tagging }

            tp := tp^.recf; { index field list }
            while ic = itag do begin { read tags }

               { a more compact form was specified than the whole type,
                 so we find the new minimum size by finding
                 all the fixed elements, adding that to the total, and
                 then finding a new minimum }
               rdvar(v); { get case constant }
               getint(ip2, titag); { get an entry for that }
               gettypa(tp2, ticst); { get type entry }
               tp2^.ival := v; { set value }
               ip2^.base := tp2; { place that as base }
               if ip1 = nil then ip^.right := ip2 { place as first }
               else ip1^.flow := ip2; { place as last }
               ip1 := ip2; { set new last }
               while tp^.t = tfield do begin { add fixed fields }

                  tp := tp^.next; { next entry }
                  if tp = nil then error(einvfmt); { invalid format }

               end;
               { now we should be pointing at the tag }
               if tp^.t <> tftag then error(einvfmt); { invalid format }
               tp := tp^.ftgc; { index case list }
               { find matching case }
               while ssgtn(tp^.fcss, v) or ssltn(tp^.fcse, v) do begin

                  tp := tp^.fcsn;
                  if tp = nil then error(einvfmt) { invalid format }

               end;
               tp1 := tp; { save case entry as mark }
               tp := tp^.fcsf; { index that case list }
               getcodnsrc(ic) { read the next tag with source mark skipping }

            end;
            if ic <> iendtag then error(einvfmt) { should be terminated }

         end

      end;
      itag: error(einvfmt); { should not occur alone }
      iendtag: error(einvfmt); { should not occur alone }
      ipoptop: begin

         getlnk(tp); { get operand type }
         popint(ip) { remove and discard top stack entry }

      end;
      ilabequ: begin

         getlnk(tp); { get label type }
         { an equate is much as a no-op }
         getint(ip, tilabequ); { get an entry }
         ip^.base := tp; { set the base }
         insert(ip) { place in flow }

      end;
      ihalt: begin { halt program }

         getint(ip, tihalt); { get intermediate entry }
         insert(ip) { place in flow }

      end;
      ilodasr:    error(eunimp); { not implemented }
      ilodawc:    error(eunimp); { not implemented }
      ildimgp:    error(eunimp); { not implemented }
      iequref:    error(eunimp); { not implemented }
      ineqref:    error(eunimp); { not implemented }
      iarfmar:    error(eunimp); { not implemented }
      iobjmem:    error(eunimp); { not implemented }
      inewobj:    error(eunimp); { not implemented }
      idspobj:    error(eunimp); { not implemented }
      icvtmtg:    error(eunimp); { not implemented }
      icpymgp:    error(eunimp); { not implemented }
      icpytgp:    error(eunimp); { not implemented }
      iis:        error(eunimp); { not implemented }
      ithrow:     error(eunimp); { not implemented }
      iendfil:   { do nothing }

   end

end;

{******************************************************************************

Process intermediate file

Processes a complete intermediate file, including types and object code. The
incoming intermediate is converted to internal object code in acyclic graph
form. The principal of a stack to graph converter is that we keep a "stack" of
incoming "constructions" which are the expression trees. As each "consumer"
entry appears, it is linked to the stack entries it uses, then is itself
stacked, etc. When the terminal consumer is encountered, it empties the stack,
and that is linked by the flow structure of the program. The result is a tree
structure representing expressions.
The structures (if, repeat, while, case, etc) are converted to a form known
as an "acyclic graph". In this form, all of the terminals (roots of expression
trees) are linked together as a thread in the graph. The structures are
represented by side branches to that thread, which terminate in space.
For example, and if statement can have up to two branching threads that branch
from the "if" intermediate entry and then simply terminate. Each of these
threads is understood by context to "flow" into the intermediate following
the "if".
This even applies to loops like repeat and while. A single thread from the
entry represents the repeated code in the loop, which continues after the
loop intermediate.
An acyclic graph is used because it is far easier to create and use than a
graph with loops in it (cycles).
The jumps that actually form structures are all implied, and are inserted
during the coding phase.
When the intermediate is read, a lot of information will seem to be discarded.
These are the "helper" type links that tell what type "form" to use for a
particular operator. This is actually redundant, since we can find this out
by following along with the loads and types just as the original parser did
when creating the intermediate. The helper types are used in simulators and
simple translators that don't keep an internal form of the code.

******************************************************************************}

procedure prcint;
   
var ic:             intcod; { intermediate code holders }
    b1, b2, b3, b4: byte;   { signature bytes }
    ip1, ip2:       intptr; { intermediate pointers }

begin

   blkcnt := 0; { clear block counter }
   rdtyp := nil; { clear last type }
   istack := nil; { clear construction stack }
   { note that since the real stack is unknown, we should only use the pseudo
     stack for relative calculations }
   assign(intfil, intnam); { open input file }
   reset(intfil);
   { Check 'SPKA' signature exists on file. Signatures are 32 bits, up from
     the old 24 bit standard. SPK was the old 3 byte sig incremented, and we
     started with A at the end. The signature is incremented through the
     characters A-Z, and carries to the next character. }
   read(intfil, b1);
   read(intfil, b2);
   read(intfil, b3);
   read(intfil, b4);
   if (ascii2chr(b1) <> 'S') or (ascii2chr(b2) <> 'P') or 
      (ascii2chr(b3) <> 'K') or (ascii2chr(b4) <> 'A') then
      error(einvfmt); { invalid file signature }
   ip1 := nil; { clear list }
   ip2 := nil;
   repeat { read file tolkens }

      getcod(ic); { get next code }
      { the list will not be used at this level, but we need to pass dummies }
      rdint(ic, ip1, ip2) { read the rest of the tolken }

   until ic = iendfil; { end of file tolken }
   { there should be no intermediates in the enveloping list }
   if ip1 <> nil then error(einvfmt);
   if istack <> nil then error(einvfmt); { flag invalid format }
   close(intfil) { close intermediate file }

end;

{******************************************************************************

Place integer constant value

Given a constant value and size, validates that the given constant will
actually fit in the required size, then outputs it in the proper size.
Supports bytes, words, and double words in intel format.

Note that the original constant should have been checked against the
original type, but we check it again here for safety.

******************************************************************************}

procedure plcint(s: integer; { size of constant, 1, 2 or 4 }
                 i: ssint);  { value to output }

begin

   if s = 1 then begin { evaluate byte }

      if ssltn(i, true, 128) or ssgtn(i, false, 255) then 
         error(ecstrng); { constant out of range }
      { output the byte }
      if i.s then emitbyt(-i.v) { negative }
      else emitbyt(i.v) { positive } 

   end else if s = 2 then begin { evaluate word }

      if ssltn(i,  true, 36768) or ssgtn(i, false, 65535) then
         error(ecstrng); { constant out of range }
      { output the word }
      if i.s then emitwrd(-i.v) { negative }
      else emitwrd(i.v) { positive }

   end else begin { evaluate double word }

      { output the double word }
      if i.s then emitint(-i.v) { negative }
      else emitint(i.v) { positive }

   end

end;

{******************************************************************************

Place constant

Outputs a constant entry to the current pgmcnt location, and advances pgmcnt
to after the constant. Assigns the base address of the constant to the location
where the constant was output.

******************************************************************************}

procedure plccst(ft: typptr;  { 'form' type }
                 tp: typptr); { constant to place }

var i:      1..setsiz; { index for set bytes }
    setbuf: packed array [1..setsiz] of byte; { set holder }
    v:      ssint; { set value }
    ea:     integer; { ending address }
    ct:     boolean; { character base type }
    t:      ssint;

begin

   if tp^.t = ticst then begin { integer }

      tp^.addr := pgmcnt; { assign base address }
      plcint(ft^.size, tp^.ival) { place integer }

   end else if tp^.t = trcst then begin { real }

      tp^.addr := pgmcnt; { assign base address }
      if ft = nil then emitrl(tp^.rval) { place real }
      else if ft^.t = treal then emitrl(tp^.rval) { place real }
      else if ft^.t = tsreal then emitsrl(tp^.rval) { place short real }
      else error(einvfmt) { invalid format }

   end else if tp^.t = tscst then begin { found a string entry }

      tp^.addr := pgmcnt; { assign base address }
      emitstr(tp^.sval^) { transfer to storage }

   end else if tp^.t = tccst then begin { found a character entry }

      tp^.addr := pgmcnt; { assign base address }
      { transfer to storage }
      if funicode then emitwrd(ord(tp^.cval)) { unicode }
      else emitbyt(ord(tp^.cval)) { ISO 8859-1 }

   end else if tp^.t = tstcst then begin { found a set constant }

      tp^.addr := pgmcnt; { assign base address }
      { clear a buffer for the set, then set each specified element of the
        set in the buffer }
      for i := 1 to setsiz do setbuf[i] := 0; { clear buffer }
      ct := chart(tp^.stct); { find if base type is character }
      tp := tp^.stcc; { index 1st constant }
      while tp <> nil do begin { traverse and set elements }

         if tp^.t <> tstet then error(einvfmt); { invalid format }
         v := tp^.stes; { place first set value }
         while not ssltn(tp^.stee, v) do begin 

            { until past end }
            i := v.v div 8+1; { find proper byte address }
            if i > setsiz then error(einvelm); { invalid set element }
            case v.v mod 8 of { set the bit }

               0: setbuf[i] := setbuf[i] or $01;
               1: setbuf[i] := setbuf[i] or $02;
               2: setbuf[i] := setbuf[i] or $04;
               3: setbuf[i] := setbuf[i] or $08;
               4: setbuf[i] := setbuf[i] or $10;
               5: setbuf[i] := setbuf[i] or $20;
               6: setbuf[i] := setbuf[i] or $40;
               7: setbuf[i] := setbuf[i] or $80

            end;
            { advance to next value }
            t.v := ssadd(v, false, 1);
            t.s := ssadds(v, false, 1);
            v := t

         end;
         tp := tp^.sten { index next element }

      end;
      for i := 1 to setsiz do emitbyt(setbuf[i]) { output set bytes }
   
   end else if tp^.t = tarrcst then begin { array constant }

      if ft^.t <> tarray then error(einvfmt); { format error }
      ft := ft^.arrt; { index base type }
      tp := tp^.arcn; { index 1st entry }
      while tp <> nil do begin { allocate subconstants }

         if tp^.t <> tarrcel then error(einvfmt); { invalid format }
         plccst(ft, tp^.arec); { place constant }
         tp := tp^.aren { link next }

      end

   end else if tp^.t = treccst then begin { record constant }

      ea := pgmcnt+ft^.size; { set ending address }
      if ft^.t <> trecord then error(einvfmt); { format error }
      ft := ft^.recf; { index field list }
      tp := tp^.recn; { index 1st entry }
      while tp <> nil do begin { allocate subconstants }

         if tp^.t <> treccel then error(einvfmt); { invalid format }
         if ft^.t = tfield then begin { standard field }

            plccst(ft^.fldt, tp^.reec); { place constant }
            ft := ft^.fldn { index next field }

         end else if ft^.t = tftag then begin { tagfield }

            if ft^.ftge then { tagfield exists }
               plccst(ft^.ftgt, tp^.reec); { place constant }
            { find case field list by tagfield }
            ft := ft^.ftgc; { index 1st case list }
            v.v := consti(tp^.reec); { find tagfield value }
            v.s := constis(tp^.reec);
            { find case }
            while ssgtn(ft^.fcss, v) or ssltn(ft^.fcse, v) do begin

               ft := ft^.fcsn; { index next }
               if ft = nil then error(einvfmt) { invalid format }

            end;
            ft := ft^.fcsf { index that field list }

         end else error(einvfmt); { invalid format }
         tp := tp^.reen { link next }

      end;
      { we allocated the requested data, but depending on variants, that may
        not make a full record. so we must finish it if required }
      while pgmcnt < ea do emitbyt(0) { pad to the proper address }

   end else if tp^.t = tenme then begin { enumerated constant }

      tp^.addr := pgmcnt; { assign base address }
      v.v := tp^.env; { place unsigned value }
      v.s := false;
      plcint(ft^.size, v)

   end else if tp^.t = teset then { empty set }
      for i := 1 to setsiz do emitbyt(0) { output set bytes }

end;

{******************************************************************************

Place standard case jump table

Places a standard case jump table in the constants gallery. A standard jump
table is a table of addresses of case statement blocks that are indexed by
a selector.

******************************************************************************}

procedure plccjtab(tp: typptr);

var tp1: typptr; { index for case selectors }

begin

   tp^.addr := pgmcnt; { assign base address for table }
   tp1 := tp^.ctn; { index selector list }
   while tp1 <> nil do begin { allocate selectors }

      if tp1^.t <> tcassel then error(esysflt86); { should be selector }
      emitadr(tp1, itadr); { output address }
      tp1 := tp1^.csn { link next selector }

   end

end; 

{******************************************************************************

Place hash case jump table

Places a hash case table in the constants gallery. The hash table is three
successive arrays, each the total size of the number of case constants:

Array 1: Contains the values to be searched for.
Array 2: Contains a chain to next entry for misses, or zero for chain end.
Array 3: The jump table.

******************************************************************************}

procedure plchjtab(tp: typptr);

var tp1: typptr; { index for case selectors }

begin

   tp^.addr := pgmcnt; { assign base address for table }
   { place values array }
   tp1 := tp^.ctn; { index selector list }
   while tp1 <> nil do begin { allocate selectors }

      if tp1^.t <> tcassel then error(esysflt87); { should be selector }
      { output value }
      if tp1^.csv.s then emitint(-tp1^.csv.v) { negative }
      else emitint(tp1^.csv.v); { positive }
      tp1 := tp1^.csn { link next selector }

   end;
   { place chain array }
   tp1 := tp^.ctn; { index selector list }
   while tp1 <> nil do begin { allocate selectors }

      if tp1^.t <> tcassel then error(esysflt88); { should be selector }
      emitint(tp1^.csi); { output chain }
      tp1 := tp1^.csn { link next selector }

   end;
   { place jump array }
   tp1 := tp^.ctn; { index selector list }
   while tp1 <> nil do begin { allocate selectors }

      if tp1^.t <> tcassel then error(esysflt20); { should be selector }
      emitadr(tp1, itadr); { output address }
      tp1 := tp1^.csn { link next selector }

   end

end; 

{******************************************************************************

Set constant addresses

First allocates all the fixed objects, then Traverses the entire types
database, and sets the base address of all string and set constants. String,
set and real constants are unusual in that they are not contained in inline
code.

Therefore a table is made of them in program storage, appearing after the main
code. 

******************************************************************************}

procedure setconst;

var sp: blkptr; { type stack pointer }

{ process fixed object list }

procedure flist(tp: typptr); { list to process }

begin

   while tp <> nil do begin { traverse list }

      if tp^.t = tfix then begin 

         tp^.addr := pgmcnt; { place fixed object }
         plccst(tp^.fixt, tp^.fixc) { allocate fixed }

      end;
      tp := tp^.next { next type entry }

   end

end;

{ process string/set/real list }

procedure sslist(tp: typptr); { list to process }

begin

   while tp <> nil do begin { traverse list }

      { must be string or set constant, and must not already have an address.
        if there is an address, it has already been allocated as part of a
        fixed object. this is ok }
      if (tp^.addr = 0) and (tp^.t in [tscst, tccst, tstcst, trcst]) then
         { well, this is not pretty, but strings and constants have no set base
           type, and don't require one. they also have no substructure }
         plccst(nil, tp); { allocate possible constant }
      tp := tp^.next { next type entry }

   end

end;

{ process case table list }

procedure ctlist(tp: typptr); { list to process }

begin

   while tp <> nil do begin { traverse list }

      if tp^.t = tcastbl then plccjtab(tp) { place standard case jump table }
      else if tp^.t = thshtbl then plchjtab(tp); { place hash case jump table }
      tp := tp^.next { next type entry }

   end

end;

begin

   { allocate fixed objects }
   sp := blklst; { index 1st list entry }
   while sp <> nil do begin { traverse blocks }

      flist(sp^.typ); { process standard list }
      flist(sp^.typa); { process alternate list }
      sp := sp^.next { next block }

   end;
   { allocate loose constants }
   sp := blklst; { index 1st list entry }
   while sp <> nil do begin { traverse blocks }

      sslist(sp^.typ); { process standard list }
      sslist(sp^.typa); { process alternate list }
      sp := sp^.next { next block }

   end;
   { allocate case jump and hash tables }
   sp := blklst; { index 1st list entry }
   while sp <> nil do begin { traverse blocks }

      ctlist(sp^.typ); { process standard list }
      ctlist(sp^.typa); { process alternate list }
      sp := sp^.next { next block }

   end

end;

{******************************************************************************

Set type (variable) global addresses

Traverses the entire types database, and sets the base address of all global
types. This could actually be done at the same time as the size set, but we 
break it out into a separate function.

The addresses are based on the entry size, with a running count made of address
space taken. Types are placed according to whether they are global or local.
The 1st and 2nd block levels are allocated as global, and are laid into program
storage like constants and code.

Other levels are treated as relative addresses. A separate counter is created,
starting at zero, and types are allocated logically to that.

******************************************************************************}

procedure setaddr;

var sp: blkptr; { type stack pointer }
    tp: typptr; { type entry pointer }
    lvl: integer; { level counter }

begin

   sp := blklst; { index 1st list entry }
   lvl := 1; { set 1st level }
   while sp <> nil do begin { traverse blocks }

      if sp^.lvl <= 2 then begin { block 1 and 2 are global }

         { process standard list }
         tp := sp^.typ; { index 1st type entry }
         while tp <> nil do begin { traverse list }

            if tp^.t = tvar then if not tp^.vare then begin

               { found a variable entry }

               { perform any required type alignment first }
               if fgblaln then alnadr(pgmcnt, tp);
               tp^.addr := pgmcnt; { assign base address }
               pgmcnt := pgmcnt+tp^.size { allocate variable }

            end;
            tp := tp^.next { next type entry }

         end;
         { process alternate list }
         tp := sp^.typa; { index 1st type entry }
         while tp <> nil do begin { traverse list }

            if tp^.t = tvar then if not tp^.vare then begin
               
               { found a variable entry }

               { perform any required type alignment first }
               if fgblaln then alnadr(pgmcnt, tp);
               tp^.addr := pgmcnt; { assign base address }
               pgmcnt := pgmcnt+tp^.size { allocate variable }

            end;
            tp := tp^.next { next type entry }

         end

      end;
      sp := sp^.next { next block }

   end

end;

{******************************************************************************

Output variger

Outputs the given integer to the byte file as a variger.
Varigers are of the following format:

   1. (byte) the tag byte.
   2-N. The variger value.

The tag byte values are:

   bit 7 - Low for integer number, high for float.
   bit 6 - Contains the sign of the integer. 
   bit 5 - Unused.
   bit 4 - Length of integer in bytes, 1-32, in -1 format.
   bit 3 -      ""              ""
   bit 2 -      ""              ""
   bit 1 -      ""              ""
   bit 0 -      ""              ""

The integer is converted by removing the sign bit and converting
to signed magnitude, then determining the byte size, then
outputting the tag and number.

******************************************************************************}

procedure wrtvar(var f: bytfil; n: integer); { integer to output}

var t: integer; { tag byte }
    p: integer; { power holder }

begin

   { handle 0 as special case }
   if n = 0 then begin write(f, 0); write(f, 0) end else begin

      { value is non-zero }
      t := bytes-1; { initalize tag field to max bytes }
      if n < 0 then begin { remove sign and convert to signed magnitude }
      
         t := t + $40; { place sign in tag }
         n := abs(n) { find absolute value of integer }
      
      end;
      p := toppow; { get top power }
      { find 1st non-zero digit in integer }
      while (n div p) = 0 do begin p := p div 256; t := t - 1 end;
      write(f, t); { output finalized tagfield }
      while p <> 0 do begin { output bytes }
      
         write(f, n div p); { output that byte }
         n := n mod p; { remove the byte }
         p := p div 256 { next lower power }      
      
      end

   end

end;

{******************************************************************************

Output symbol

Outputs a symbol with length. The length is output first, in -1 format.
Processes coining, which means to place all of the encompassing block labels
before the output label.

Coining stops at the program/module level, and does not include the
system block, simply because every block belongs to that. As a practical matter,
everything but "external" routines are coined, and even that is locked off in
the current revision.

Has a slot for a postfix string. This is used to coin overloads.

A module entry pointer was added. If the module is not nil, then it overrides
the block for coining. This is because the symbol is external, and the block
which it is found under is not the block of residence in any case, but the
user/joiner block. External symbols will never be more than a level deep, so
all that is needed is the module name.

******************************************************************************}

procedure outsym(view l:    string;  { label to output }
                      coin: boolean; { label is to be coined }
                      blk:  blkptr;  { block to use for coining }
                 view ps:   string;  { postfix string }
                      mp:   modptr); { module pointer }

var i:   integer; { index for label }
    llen: integer; { length of label }
    p:   blkptr;  { pointer to blocks }
    pb:  linbuf;  { buffer for coin string }

procedure outmarks(p: blkptr); { block pointer }

var i: integer; { index for label }

begin

   if p <> nil then begin { not end }

      outmarks(p^.prnt); { output mark below us }
      if p^.marks = nil then error(esysflt51); { should a block symbol }
      if (p^.lvl >= 2) and (p^.marks <> nil) then begin

         { level is 2 or more, and label exists }
         for i := 1 to max(p^.marks^.lab^) do { add in label }
            write(symfil, chr2ascii(p^.marks^.lab^[i]));
         if chkovl(p^.mark) then begin { is an overload }

            coinovl(blklst, pb, p^.mark); { get coin string }
            for i := 1 to len(pb) do { output }
               write(symfil, chr2ascii(pb[i])) { output }

         end;
         write(symfil, chr2ascii('.')) { output separator }

      end

   end

end;

begin

   { determine total length of label }
   llen := max(l); { place length of tail }
   if coin then begin { label is to be coined }

      { process coining }
      if mp <> nil then { coin with module }
         { add in the module label with separator }
         llen := llen+len(mp^.modn^)+1
      else begin { coin with block }

         p := blk; { index block head }
         { add in all the block coins }
         while p <> nil do begin

            if (p^.lvl >= 2) and (p^.marks <> nil) then 
               begin { level is 2 or more, and label exists }

               { add in the label with separator }
               llen := llen+max(p^.marks^.lab^)+1;
               if chkovl(p^.mark) then begin { is an overload }
               
                  coinovl(blklst, pb, p^.mark); { get coin string }
                  llen := llen+len(pb) { add in }
               
               end

            end;
            p := p^.prnt { up to parent block }

         end

      end

   end;
   llen := llen+len(ps); { add in postfix string }
   if llen > 256 then error(elabovf); { label too long to output }
   write(symfil, llen-1); { output length in -1 format }
   if coin then { label is to be coined }
      if mp <> nil then begin { coin to the module }

         for i := 1 to max(mp^.modn^) do { add in label }
            write(symfil, chr2ascii(mp^.modn^[i]));
         write(symfil, chr2ascii('.')) { output separator }

      end else outmarks(blk); { traverse all of the output sections }
   { output symbol string }
   for i := 1 to max(l) do write(symfil, chr2ascii(l[i]));
   { output postfix string }
   for i := 1 to len(ps) do write(symfil, chr2ascii(ps[i]))

end;

{******************************************************************************

Output symbol offset rlds

Outputs symbols which use an offset, and reference a symbol. In the symbols
output phase, the rlds that reference a symbol with no offset are output.
In the standalone rld output phase, the rlds which reference anonymous
entries are output. That leaves offset entries to symbols, which in the case
of external symbols, cannot be resolved until the file is linked. We output
a formula to process the offset. As with the symbol phase, entries which don't
qualify as offsets are left to be performed by the standalone rld phase.

******************************************************************************}

procedure outrldsyms;

var bsp: blkptr;  { type stack pointer }
    sp:  labptr;  { symbol pointer }
    ext: boolean; { external flag }
    asm: boolean; { assembly flag }
    ref: boolean; { references exist }
    mp:  modptr;  { module pointer }

procedure chkoffrlds; { type to output rlds for }

var rp: rldptr; { relocation pointer }

begin

   rp := rldlst; { index 1st rld }
   while rp <> nil do begin { traverse list }

      if (rp^.lab = sp^.typ) and (rp^.off <> 0) and
         (rp^.it in [itadr, itradr, itbradr]) then begin { its a candidate }

         { output adder entry }
         write(symfil, 2); { output type code, anonymous entry }
         write(symfil, 1); { output operation, add }
         write(symfil, 0); { no flags }

         { output relocation for that }
         write(symfil, 3); { output type code, output attached rld }
         if rp^.it = itadr then
            { for straight address, little endian, normal insert }
            write(symfil, $00)
         else 
            { for relative address, little endian, offset insert }
            write(symfil, $08);
         { output insert length }
         if rp^.it = itbradr then write(symfil, 7) { 8 bits (-1) }
         else write(symfil, 31); { 32 bits (-1) }
         wrtvar(symfil, rp^.addr); { output patch address }
         rp^.out := true; { set this rld is output }

         { output symbol "marker" entry }
         write(symfil, 1); { output entry type symbol }
         write(symfil, 0); { output operation, none }
         { output the label }
         outsym(sp^.lab^, not asm, bsp, '', mp);
         write(symfil, 0); { no flags }

         { output offset constant }
         write(symfil, 2); { output type code, anonymous entry }
         write(symfil, 0); { output operation, none }
         write(symfil, $01); { flag defined }
         wrtvar(symfil, rp^.off) { output offset constant }

      end;
      rp := rp^.next { next rld entry }

   end

end;

begin

   bsp := blklst; { index 1st list entry }
   while bsp <> nil do begin { traverse blocks }

      { process standard list }
      sp := bsp^.sym; { index 1st symbol entry }
      while sp <> nil do begin { traverse list }

         if sp^.typ^.t in [tvar, tfix, tproc, tfunc, trot, tpgm, tvrs] then
            begin
            { determine if it's an external, and load reference flag }
            with sp^.typ^ do
               case t of { type, get external status from entry }

               tvar:  begin ext := vare;  ref := varr;  asm := false; 
                            mp := varmd end;
               tfix:  begin ext := fixe;  ref := fixr;  asm := false; 
                            mp := fixmd end;
               tproc: begin ext := prce;  ref := prcr;  asm := prcas;
                            mp := prcmd end;
               tfunc: begin ext := fnce;  ref := fnct;  asm := fncas; 
                            mp := fncmd end;
               trot:  begin ext := true;  ref := rotr;  asm := false; 
                            mp := nil end;
               tpgm:  begin ext := false; ref := false; asm := false; 
                            mp := nil end;
               tvrs:  begin ext := false; ref := false; asm := false; 
                            mp := nil end

            end;
            { Qualify as not an unreferenced external, then check for offset
              rlds indexing this symbol. }
            if not (ext and not ref) then chkoffrlds

         end;
         sp := sp^.next { next type entry }

      end;
      bsp := bsp^.next { next block }

   end

end;

{******************************************************************************

Output unattached rlds

Outputs all rld entries unattached to symbols.

******************************************************************************}

procedure outrlds;

var rp: rldptr; { relocation pointer }
    b:  byte;   { output byte holder }

begin

   rp := rldlst; { index 1st rld }
   while rp <> nil do begin { traverse list }

      if not rp^.out then begin { not already output }

         write(symfil, 4); { output type code, output stand alone rld }
         if rp^.it in [itadr, itgto] then
            { for straight address, little endian, normal insert }
            write(symfil, $00)
         else 
            { for relative address, little endian, offset insert }
            write(symfil, $08);
         { output insert length }
         if rp^.it = itbradr then write(symfil, 7) { 8 bits (-1) }
         else write(symfil, 31); { 32 bits (-1) }
         wrtvar(symfil, rp^.addr); { output patch address }
         b := $01; { set flags: defined }
         { set program variable space by type. check all program space 
           entries }
         if (rp^.lab^.t in [tfix, tproc, tfunc, trot, tpgm, tscst, tccst, trcst,
                            tlab, tstcst, tcastbl, thshtbl, tcassel]) and
            (rp^.it <> itgto) then
            b := b+$02 { set program space flag }
         { check all variable space entries }
         else if (rp^.lab^.t in [tvar, tvrs]) and not rp^.lab^.local then
            b := b+$10; { set variable space flag }
         write(symfil, b); { output flag byte }
         { check its a goto offset entry }
         if rp^.it = itgto then begin

            { check what type, procedure or function }
            if rp^.lab^.t = tproc then wrtvar(symfil, rp^.lab^.prcg)
            else wrtvar(symfil, rp^.lab^.fncg)

         end else { Output target address. }
            wrtvar(symfil, rp^.lab^.addr+rp^.off);
         rp^.out := true { set this rld is output }

      end;
      rp := rp^.next { next rld entry }

   end

end;

{******************************************************************************

Output rlds attached to type

Outputs all rld entries referencing the given symbol. In order for this to
happen, the rld must be derived from the address of the symbol. If it
references another type (display), it must remain to be output in the general
rlds later.

******************************************************************************}

procedure wrtrlds(tp: typptr); { type to output rlds for }

var rp: rldptr; { relocation pointer }

begin

   rp := rldlst; { index 1st rld }
   while rp <> nil do begin { traverse list }

      if (rp^.lab = tp) and (rp^.off = 0) and
         (rp^.it in [itadr, itradr, itbradr]) then begin { its a candidate }

         write(symfil, 3); { output type code, output attached rld }
         if rp^.it = itadr then
            { for straight address, little endian, normal insert }
            write(symfil, $00)
         else 
            { for relative address, little endian, offset insert }
            write(symfil, $08);
         { output insert length }
         if rp^.it = itbradr then write(symfil, 7) { 8 bits (-1) }
         else write(symfil, 31); { 32 bits (-1) }
         wrtvar(symfil, rp^.addr); { output patch address }
         rp^.out := true { set this rld is output }

      end;
      rp := rp^.next { next rld entry }

   end

end;

{******************************************************************************

Write symbol

Writes the given symbol to the linker file. Since this is only done after
the module is completely processed, all symbols should be resolved. The
program/variable status of the symbol is given. After the symbol, any rlds
referencing the symbol are output, and flagged as output in the rld list.
For the purposes of this routine, the symbol and the type it points to are
considered one. It is, of course, possible for more than one symbol to
reference a single type entry, but this only happens with logical references,
such as constants, types, etc. Each physical object is allways unique.
The automatic attachment of rlds to symbols serves two purposes. First, it
produces a simpler symbols deck. Second, it coordinates external references.

******************************************************************************}

procedure wrtsym(     s:    labptr;  { symbol to output }
                      tp:   typptr;  { type assocated with that }
                      p:    boolean; { program/variable status }
                      ext:  boolean; { external status }
                      coin: boolean; { label is to be coined }
                      blk:  blkptr;  { block to use for coining }
                 view ps:   string;  { postfix string }
                      mp:   modptr); { module pointer }

var b: byte; { output byte holder }

begin

   write(symfil, 1); { output entry type symbol }
   write(symfil, 0); { output operation, none }
   outsym(s^.lab^, coin, blk, ps, mp); { output the label }
   b := $01; { set defined flag }
   if ext then b := $08; { external, set external }
   { if exportable, but not external, set global }
   if s^.exp  and not ext then b := b+$04;
   if p then b := b+$02 { set program space flag }
   { else if the variable lives in the main block, set variable space.
     If at a higher level, it is a local, and has meaning only as a constant }
   else if blk^.lvl <= 2 then b := b+$10; { set variable space flag }
   write(symfil, b); { output flags }
   { check entry is defined }
   if (b and $01) <> 0 then wrtvar(symfil, tp^.addr); { output address }
   wrtrlds(tp) { output related rlds }

end;

{******************************************************************************

Write global symbols


All the symbols eligible for export in the following blocks are output
without coining:

   0: Our link layer support symbols.
   1: The system level (which probally does not contain any objects).
   2: the global block (outer block of the program).

Not everything is elegible for output. The following types are:

   1. Procedures.
   2. Functions.
   3. Variables (simple).
   4. Fixed objects.
   5. Routines.
   6. program/variable space markers.

If the object is global or external, it is output plain. If not, the object
is coined and output.

******************************************************************************}

procedure wrtsyms;

var bsp: blkptr;  { type stack pointer }
    sp:  labptr;  { symbol pointer }
    ext: boolean; { external flag }
    asm: boolean; { assembly flag }
    ref: boolean; { references exist }
    mp:  modptr;  { module pointer }

begin

   bsp := blklst; { index 1st list entry }
   while bsp <> nil do begin { traverse blocks }

      { process standard list }
      sp := bsp^.sym; { index 1st symbol entry }
      while sp <> nil do begin { traverse list }

         if sp^.typ^.t in [tvar, tfix, tproc, tfunc, trot, tpgm, tvrs] then
            begin
            { determine if it's an external, and load reference flag }
            with sp^.typ^ do
               case t of { type, get external status from entry }

               tvar:  begin ext := vare;  ref := varr;  asm := false; 
                            mp := varmd end;
               tfix:  begin ext := fixe;  ref := fixr;  asm := false; 
                            mp := fixmd end;
               tproc: begin ext := prce;  ref := prcr;  asm := prcas;
                            mp := prcmd end;
               tfunc: begin ext := fnce;  ref := fnct;  asm := fncas; 
                            mp := fncmd end;
               trot:  begin ext := true;  ref := rotr;  asm := false; 
                            mp := nil end;
               tpgm:  begin ext := false; ref := false; asm := false; 
                            mp := nil end;
               tvrs:  begin ext := false; ref := false; asm := false; 
                            mp := nil end

            end;
            { if unreferenced external, it can be output. The idea of 
              rejecting unreferenced externals is to prevent pulling in
              library code that is referenced but not used. }
            if not (ext and not ref) then
               { supress coining on assembly routines }
               wrtsym(sp, sp^.typ, 
                      sp^.typ^.t in [tfix, tproc, tfunc, trot, tpgm], ext, 
                      not asm, bsp, '', mp)

         end;
         sp := sp^.next { next type entry }

      end;
      bsp := bsp^.next { next block }

   end

end;

{******************************************************************************

Write overload symbols

Outputs all procedure and function overloads as specially coined symbols. The
coining will be of the format:

myfunc.procedure.paramtype1.paramtype2...
myfunc.function.paramtype1.paramtype2...

The first word will be the function or procedure name, which is the same as the
prime function or procedure. The next word will be "procedure" or "function",
after the type of routine. Next, each parameter of the routine will be output
as its type name. This is possible because every procedure or function
parameter must have a type name.

******************************************************************************}

procedure wrtovl;

var bsp: blkptr;  { type stack pointer }
    tp:  typptr;  { type pointer }
    sp:  labptr;  { head symbol }
    ext: boolean; { external flag }
    asm: boolean; { assembly flag }
    ref: boolean; { references exist }
    pb:  linbuf;  { postfix assembly buffer }
    mp:  modptr;  { module pointer }

begin

   bsp := blklst; { index 1st list entry }
   while bsp <> nil do begin { traverse blocks }

      { process standard list }
      tp := bsp^.typ; { index 1st type entry }
      while tp <> nil do begin { traverse list }

         if chkovl(tp) then begin { its an overload }

            { get head symbol }
            if tp^.t = tproc then sp := fndsym(blklst, tp^.prch)
            else sp := fndsym(blklst, tp^.fnch);
            if sp = nil then error(esysflt59); { should have found it }
            { determine if it's an external, and load reference flag }
            with tp^ do
               case t of { get external status from entry }

               tvar:  begin ext := vare;  ref := varr;  asm := false; 
                            mp := varmd end;
               tfix:  begin ext := fixe;  ref := fixr;  asm := false; 
                            mp := fixmd end;
               tproc: begin ext := prce;  ref := prcr;  asm := prcas;
                            mp := prcmd end;
               tfunc: begin ext := fnce;  ref := fnct;  asm := fncas; 
                            mp := fncmd end;
               trot:  begin ext := true;  ref := rotr;  asm := false; 
                            mp := nil end;
               tpgm:  begin ext := false; ref := false; asm := false; 
                            mp := nil end;
               tvrs:  begin ext := false; ref := false; asm := false; 
                            mp := nil end

            end;
            coinovl(blklst, pb, tp); { construct postfix for overload }
            { if unreferenced external, it can be output. The idea of 
              rejecting unreferenced externals is to prevent pulling in
              library code that is referenced but not used. }
            if not (ext and not ref) then
               { supress coining on assembly routines }
               wrtsym(sp, tp, true, ext, not asm, bsp, pb, mp)

         end;
         tp := tp^.next { next type entry }

      end;
      bsp := bsp^.next { next block }

   end

end;   

{******************************************************************************

Make system symbols

Places the _pstr, _pend, vstr and vend symbols into the current (0) block.

******************************************************************************}

procedure maksys;

var lp: labptr; { label pointer }

begin

   { place _pstr symbol }
   gettyp(pgmstr, tpgm); { get a program index entry }
   lstsym(lp); { get the symbol }
   strplc(lp^.lab, '_pstr'); { place label }
   lp^.typ := pgmstr; { place type linkage }
   lp^.exp := true; { set exportable }

   { place _pend symbol }
   gettyp(pgsend, tpgm); { get a program index entry }
   lstsym(lp); { get the symbol }
   strplc(lp^.lab, '_pend'); { place label }
   lp^.typ := pgsend; { place type linkage }
   lp^.exp := true; { set exportable }

   { place _vstr symbol }
   gettyp(varstr, tvrs); { get a variable index entry }
   lstsym(lp); { get the symbol }
   strplc(lp^.lab, '_vstr'); { place label }
   lp^.typ := varstr; { place type linkage }
   lp^.exp := true; { set exportable }

   { place _vend symbol }
   gettyp(varend, tvrs); { get a variable index entry }
   lstsym(lp); { get the symbol }
   strplc(lp^.lab, '_vend'); { place label }
   lp^.typ := varend; { place type linkage }
   lp^.exp := true; { set exportable }

end;

{******************************************************************************

Make support routine symbols

Places the symbols for the support routines in the current block (0).

******************************************************************************}

procedure makrot;

{ create routine entry }

procedure defrot(var tp: typptr;  { type }
                 var lp: labptr;  { label }
                 view n: string); { name }

begin

   gettyp(tp, trot); { get a routine entry }
   tp^.rotr := false; { set not referenced }
   lstsym(lp); { get the symbol }
   strplc(lp^.lab,  n); { place label }
   lp^.typ := tp; { place type linkage }

end;

begin

   { paslib routine calls }
   defrot(paslib_abort,   paslib_aborts,   'paslib.abort');
   defrot(paslib_error,   paslib_errors,   'paslib.error');
   defrot(paslib_wrtfil,  paslib_wrtfils,  'paslib.wrtfil');
   defrot(paslib_wrtint,  paslib_wrtints,  'paslib.wrtint');
   defrot(paslib_wrtchr,  paslib_wrtchrs,  'paslib.wrtchr');
   defrot(paslib_wrtbol,  paslib_wrtbols,  'paslib.wrtbol');
   defrot(paslib_wrtblf,  paslib_wrtblfs,  'paslib.wrtblf');
   defrot(paslib_wrtreal, paslib_wrtreals, 'paslib.wrtreal');
   defrot(paslib_wrtrlf,  paslib_wrtrlfs,  'paslib.wrtrlf');
   defrot(paslib_wrtstr,  paslib_wrtstrs,  'paslib.wrtstr');
   defrot(paslib_wrtstrf, paslib_wrtstrfs, 'paslib.wrtstrf');
   defrot(paslib_wrteol,  paslib_wrteols,  'paslib.wrteol');
   defrot(paslib_pagtxt,  paslib_pagtxts,  'paslib.pagtxt');
   defrot(paslib_rdfil,   paslib_rdfils,   'paslib.rdfil');
   defrot(paslib_rdint,   paslib_rdints,   'paslib.rdint');
   defrot(paslib_rdchr,   paslib_rdchrs,   'paslib.rdchr');
   defrot(paslib_rdreal,  paslib_rdreals,  'paslib.rdreal');
   defrot(paslib_rdeol,   paslib_rdeols,   'paslib.rdeol');
   defrot(paslib_eoftxt,  paslib_eoftxts,  'paslib.eoftxt');
   defrot(paslib_chkeol,  paslib_chkeols,  'paslib.chkeol');
   defrot(paslib_eoffil,  paslib_eoffils,  'paslib.eoffil');
   defrot(paslib_fillen,  paslib_fillens,  'paslib.fillen');
   defrot(paslib_filloc,  paslib_fillocs,  'paslib.filloc');
   defrot(paslib_getfil,  paslib_getfils,  'paslib.getfil');
   defrot(paslib_gettxt,  paslib_gettxts,  'paslib.gettxt');
   defrot(paslib_putfil,  paslib_putfils,  'paslib.putfil');
   defrot(paslib_lbafil,  paslib_lbafils,  'paslib.lbafil');
   defrot(paslib_lbatxt,  paslib_lbatxts,  'paslib.lbatxt');
   defrot(paslib_restxt,  paslib_restxts,  'paslib.restxt');
   defrot(paslib_resfil,  paslib_resfils,  'paslib.resfil');
   defrot(paslib_rwttxt,  paslib_rwttxts,  'paslib.rwttxt');
   defrot(paslib_rwtfil,  paslib_rwtfils,  'paslib.rwtfil');
   defrot(paslib_update,  paslib_updates,  'paslib.update');
   defrot(paslib_apptxt,  paslib_apptxts,  'paslib.apptxt');
   defrot(paslib_appfil,  paslib_appfils,  'paslib.appfil');
   defrot(paslib_close,   paslib_closes,   'paslib.close');
   defrot(paslib_assign,  paslib_assigns,  'paslib.assign');
   defrot(paslib_posfil,  paslib_posfils,  'paslib.posfil');
   defrot(paslib_assert,  paslib_asserts,  'paslib.assert');
  
   { syslib routine calls }
   defrot(syslib_delete,     syslib_deletes,     'syslib.delete');
   defrot(syslib_change,     syslib_changes,     'syslib.change');
   defrot(syslib_exists,     syslib_existss,     'syslib.exists');
   defrot(syslib_getspace,   syslib_getspaces,   'syslib.getspace');
   defrot(syslib_putspace,   syslib_putspaces,   'syslib.putspace');
   defrot(syslib_newthread,  syslib_newthreads,  'syslib.newthread');
   defrot(syslib_killthread, syslib_killthreads, 'syslib.killthread');
   defrot(syslib_newlock,    syslib_newlocks,    'syslib.newlock');
   defrot(syslib_displock,   syslib_displocks,   'syslib.displock');
   defrot(syslib_lock,       syslib_locks,       'syslib.lock');
   defrot(syslib_unlock,     syslib_unlocks,     'syslib.unlock');
   defrot(syslib_signal,     syslib_signals,     'syslib.signal');
   defrot(syslib_signalone,  syslib_signalones,  'syslib.signalone');
   defrot(syslib_wait,       syslib_waits,       'syslib.wait');

   { maclib routine calls }
   defrot(maclib_multu64, maclib_multu64s, 'maclib.multu64');
   defrot(maclib_mults64, maclib_mults64s, 'maclib.mults64');
   defrot(maclib_divu64,  maclib_divu64s,  'maclib.divu64');
   defrot(maclib_divs64,  maclib_divs64s,  'maclib.divs64');
   defrot(maclib_modu64,  maclib_modu64s,  'maclib.modu64');
   defrot(maclib_mods64,  maclib_mods64s,  'maclib.mods64');
   defrot(maclib_fpuerr,  maclib_fpuerrs,  'maclib.fpuerr');

   { wrapper routine calls }
   defrot(wrplib_threadinit, wrplib_threadinits, 'wrapper.ip_threadinit');

end;

{******************************************************************************

Load transliteration file

Loads the given transliteration file.

******************************************************************************}

procedure loadxlt(view f: string);

var xltfil: text;   { character translator file }
    c:      char;   { character buffer }
    ci:     0..255; { character transliteration index }

begin

   if frevengcm then begin { activate reverse engineering counter-measures }

      if fxltchr then begin 

         { load up a character transliteration file }
         if not exists(f) then error(echtnf); { no file found }
         assign(xltfil, f); { open it }
         reset(xltfil);
         while not eof (xltfil) do begin { read transliteration entries }

            read(xltfil, c); { get 1st character }
            ci := ord(c); { set index }
            read(xltfil, c); { get translate to character }
            chrtrn[ci] := c; { set that transliteration }
            readln(xltfil) { discard rest of line }

         end;
         close(xltfil); { close that }
         { form reverse translation table from that }
         for ci := 1 to 255 do chrnrm[ord(chrtrn[ci])] := chr(ci)

      end

   end

end;  

begin

   { clear free types list }
   for fti := tudf to tcassel do fretyp[fti] := nil;
   freint  := nil; { clear free intermediates list }
   blkstk  := nil; { clear blocks stack }
   blklst  := nil; { clear blocks list }
   istack  := nil; { clear construction stack }
   stklvl  := 0; { clear stack level }
   freist  := nil; { clear free stack entries list }
   frelab  := nil; { clear free labels list }
   intcnt  := 0; { clear tolken counter }
   fcodel  := false; { don't list intermediate code }
   fstklvl := false; { don't list stack levels }
   modlst  := nil; { clear module tracking list }
   modcnt  := 0; { clear module ordinal count }

   { Initialize option flags }

   fverb    := true;  { list code statistics }
   fintlf   := false; { don't list internal intermediate flow }
   ftypl    := false; { don't list types }
   fsyml    := false; { don't list symbols }
   foutlst  := false; { don't list output codes }
   fsmplsi  := true;  { simplify load/store indirects }
   ffldcst  := true;  { fold constant operators }
   fchkcst  := true;  { check folded constant operators }
   fdeadce  := true;  { eliminate dead code }
   fbol2jmp := true;  { change boolean operations to jumps }
   fresexp  := true;  { restrict ranges of integers in expressions }
   fsupout  := true;  { supress output files }
   fxltchr  := false; { do not translate single characters }
   fopnout  := false; { set output files not open }
   frecaln  := true;  { align unpacked record variables }
   flocaln  := true;  { align local variables }
   fgblaln  := true;  { align global variables }
   funicode := false; { set ISO 8859-1 characters }
   fprtlin  := false; { do not do input source line diagnostics }
   fincast  := true;  { include assert checks }

   minocc   := 75; { minimum case occupancy is %75 }
   rldlst   := nil; { clear relocation entries list }
   gblint   := nil; { global integer entry }
   gbllint  := nil; { global long integer entry }
   gblcard  := nil; { global cardinal entry }
   gbllcard := nil; { global long cardinal entry }
   gblreal  := nil; { global real entry }
   gblsreal := nil; { global short real entry }
   gblchr   := nil; { global character entry }
   gblbool  := nil; { global boolean entry }
   gbltrue  := nil; { global boolean 'true' entry }
   gblfalse := nil; { global boolean 'false' entry }
   gblset   := nil; { global set }
   gblsbs   := nil; { global set base }
   gbltext  := nil; { global text entry }
   gblstr   := nil; { global string entry }
   gblexc   := nil; { global exception entry }
   wthstk   := nil; { clear 'with' scoping stack }
   wthfre   := nil; { clear 'with' free scoping entries }
   csrc     := nil; { clear current source file }
   { set the character transliteration tables to 1:1 translation }
   for ci := 0 to 255 do begin

      chrtrn[ci] := chr(ci);
      chrnrm[ci] := chr(ci)

   end;
   if frevengcm then begin { enable reverse engineering countermeasures }

      copy(chxtfl, 'chrtrn.xlt'); { set character transliteration filename }

   end;
   { Form character to ASCII value translation array from ASCII value to 
     character translation array. }
   for i := 1 to 255 do chrasc[chr(i)] := i; { set array to identity }
   for i := 1 to 127 do chrasc[ascchr[i]] := i; { form translation }

   openpar(cmdhan); { open parser }
   openfil(cmdhan, '_command', cmdmax); { open command line level }
   filchr(valfch); { get the filename valid characters }
   valfch := valfch-['=']; { remove parsing characters }
   setfch(cmdhan, valfch); { set that for active parsing }
   paropt; { parse any options }
   skpspc(cmdhan); { skip spaces }
   if chkchr(cmdhan) = '"' then { parse string }
      parstr(cmdhan, outnam, err) { get string parameter }
   else
      parfil(cmdhan, outnam, false, err); { parse filename }
   if err then error(einvfnm); { invalid filename }
   skpspc(cmdhan); { skip spaces }
   intnam := outnam; { set same name }
   if chkchr(cmdhan) = '=' then begin { there is an output file }

      getchr(cmdhan); { skip '=' }
      skpspc(cmdhan); { skip spaces }
      if chkchr(cmdhan) = '"' then { parse string }
         parstr(cmdhan, outnam, err) { get string parameter }
      else
         parfil(cmdhan, intnam, false, err); { parse filename }
      fsupout := false { set output file exists }

   end;
   paropt; { parse any options }
   skpspc(cmdhan); { skip spaces }
   if not endlin(cmdhan) then error(einvcmd); { more remains on line }
   if frevengcm then begin { enable reverse engineering countermeasures }

      loadxlt(chxtfl) { load character transliteration file }

   end;
   brknam(intnam, p, n, e); { break down filename }
   if len(e) > 0 then begin { extention exists }

      if not exists(intnam) then error(efilnf) { no file }

   end else begin { no extention, try our own }

      copy(e, 'int'); { search for file.int }
      maknam(intnam, p, n, e);
      if not exists(intnam) then error(efilnf) { no such file }

   end;
   write('Processing ');
   write(output, intnam:0);
   writeln;
   if not fsupout then begin { output is not suppressed }

      brknam(outnam, p, n, e); { break down filename }
      copy(e, 'obj'); { set object extention }
      maknam(outnam, p, n, e);
      assign(objfil, outnam); { open object file }
      rewrite(objfil);
      copy(e, 'sym'); { set object extention }
      maknam(outnam, p, n, e);
      assign(symfil, outnam); { open symbol file }
      rewrite(symfil);
      fopnout := true { set output files open }

   end;

   { create the "zero" block. we use a single block just to place various
     system definitions into. these include the linker control symbols,
     and the support routine symbols }
   pshblk; { allocate 0 block level }
   gettyp(tp, tglbl); { since all blocks must have marks, create one }
   blkstk^.mark := tp; { place linkage }
   lstsym(lp); { get a new symbol entry }
   lp^.lab := copy('encoder'); { place name }
   lp^.typ := tp; { index block }
   blkstk^.marks := lp; { link block to symbol }
   gettyp(gblnil, tnil); { create universal pointer type }
   gettyp(tp, tinteger); { create basis for temp sets }
   gettyp(gblsbs, tsub);
   gblsbs^.subt := tp;
   gblsbs^.subl.v := 0;
   gblsbs^.subl.s := false;
   gblsbs^.subu.v := 255;
   gblsbs^.subu.s := false;
   gettyp(gblset, tset);
   gblset^.sett := gblsbs;  
   gettyp(gblstr, tgarry); { create global string type }
   gblstr^.gart := gblchr;
   maksys; { make system symbols }
   makrot; { make support routines }
   { create the module block markers }
   gettyp(iniblk, tpgm); { get a marker entry }
   gettyp(modend, tpgm); { get a marker entry }

   sysblk; { let machine module place global definitions }

   { jump to main entry }
   emitbyt($e9); { jmp init }
   emitadr(iniblk, itradr); { output address }
   prcint; { process intermediate file }
   if ftypl then lsttyp; { list types in block }
   popblk; { remove the 0 block level }
   pgmstr^.addr := 0; { set beginning of program }
   pgmend := pgmcnt-1; { set end of program code }
   setconst; { place constants to memory }
   conend := pgmcnt-1; { set end of constants }
   pgsend^.addr := pgmcnt; { set end of program area }
   modend^.addr := pgmcnt; { set end of module }
   varstr^.addr := pgmcnt; { set start of variable area }
   setaddr; { locate variable types }
   gblend := pgmcnt-1; { set end of globals }
   varend^.addr := pgmcnt; { set end of variable area }

   if not fsupout then begin { output not suppressed }

      wrtsyms; { output symbols deck }
      wrtovl; { output overload symbols }
      outrldsyms; { output offset symbol rlds }
      outrlds; { output unattached rlds }
      write(symfil, 0) { output symbol file termination }

   end;

   if fopnout then begin { close output files }

      close(objfil);
      close(symfil)

   end;

   if fverb then begin

      writeln;
      write('Program:   $'); prthex(8, 0); write('..'); prthex(8, pgmend);
      write(' '); prthex(8, pgmend+1); writeln(' (', pgmend+1:1, ')');
      write('Constants: $'); prthex(8, pgmend+1); write('..');
      prthex(8, conend); write(' '); prthex(8, conend-pgmend);
      writeln(' (', conend-pgmend:1, ')');
      write('Globals:   $'); prthex(8, conend+1); write('..');
      prthex(8, gblend); write(' '); prthex(8, gblend-conend); 
      writeln(' (', gblend-conend:1, ')');

      if fsupout then begin { no output file }

         writeln;
         writeln('No output file was generated')

      end

   end;

   99: { terminate program }

   writeln;
   writeln('Function complete');

end.
