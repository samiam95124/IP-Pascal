{******************************************************************************

Print hexadecimal

Print a hexadecimal number with field width. Prints right justified with left
hand zeros filling the field. Also allows for the fact that an unsigned 32 bit
number can be read into a 32 bit signed number.
One remaining problem is how to detect and convert the invalid value $80000000.

******************************************************************************}

procedure prthex(f: byte; w: integer);
 
var buff: packed array [1..10] of char; { buffer for number in ascii }
    i:    integer; { index for same }
    t:    integer; { holding }
 
begin

   { set sign of number and convert }
   if w < 0 then begin

      w := w+1+maxint; { convert number to 31 bit unsigned }
      t := w div $10000000 + 8; { extract high digit }
      writeh(output, t); { ouput that }
	   w := w mod $10000000; { remove that digit }
      f := 7 { force field to full }     

   end;
   hexs(buff, w); { convert the integer }
   for i := 1 to f-len(buff) do write('0'); { pad with leading zeros }
   write(output, buff:0) { output number }

end;

{******************************************************************************

Coin overload identification string

Creates an overload identification string. Expects a procedure or function
entry, and a buffer to place the string. The string created will be one of the
formats:

.procedure.paramtype1.paramtype2...
.function.paramtype1.paramtype2...resulttype

The first word will be the function or procedure name, which is the same as the
prime function or procedure. The next word will be "procedure" or "function",
after the type of routine. Next, each parameter of the routine will be output
as its type name. This is possible because every procedure or function
parameter must have a type name.

******************************************************************************}

procedure coinovl(    bsp: blkptr;  { which block stack to look in }
                  var pb:  linbuf;  { buffer to return coin string in }
                      tp:  typptr); { overload procedure/function }

var ps: labptr;  { parameter type name }

{ output coining for procedure/function parameter list }

procedure wrtpar(var pb: linbuf; pp: typptr); { parameter list start }

var ps: labptr; { parameter type name }

begin

   while pp <> nil do begin { append parameter type names }

      { check valid }
      if not (pp^.t in [tpar, tvpar, twpar, tpproc,tpfunc]) then
         error(esysflt58);
      case pp^.t of { parameter type }

         tpar: begin

            ps := fndsym(bsp, pp^.part); { find type symbol }
            if ps = nil then error(esysflt54); { not found }
            cat(pb, '.'); { append separator }
            cat(pb, ps^.lab^); { append type name }
            pp := pp^.parn { next parameter }

         end;
         tvpar: begin

            ps := fndsym(bsp, pp^.vprt); { find type symbol }
            if ps = nil then error(esysflt56); { not found }
            cat(pb, '.'); { append separator }
            cat(pb, ps^.lab^); { append type name }
            pp := pp^.vprn { next parameter }

         end;
         twpar: begin

            ps := fndsym(bsp, pp^.wprt); { find type symbol }
            if ps = nil then error(esysflt57); { not found }
            cat(pb, '.'); { append separator }
            cat(pb, ps^.lab^); { append type name }
            pp := pp^.wprn { next parameter }

         end;
         tpproc: begin

            cat(pb, '.procbegin'); { append procedure start }
            wrtpar(pb, pp^.pprp); { output parameter list }
            cat(pb, '.procend'); { append procedure end }
            pp := pp^.pprn { next parameter }

         end;
         tpfunc: begin

            cat(pb, '.funcbegin'); { append function start }
            wrtpar(pb, pp^.pprp); { output parameter list }
            if pp^.pfnr^.t <> tfuncr then error(esysflt16);
            ps := fndsym(bsp, pp^.pfnr^.fnrt); { find symbol for result }
            if ps = nil then error(esysflt38); { not found }
            cat(pb, '.'); { append separator }
            cat(pb, ps^.lab^); { append type name }
            cat(pb, '.funcend'); { append function end }
            pp := pp^.pfnn { next parameter }

         end;

      end
   
   end

end;

begin

   if tp^.t = tproc then begin

      copy(pb, '.procedure');
      wrtpar(pb, tp^.prcp) 

   end else if tp^.t = tfunc then begin

      copy(pb, '.function');
      wrtpar(pb, tp^.fncp);
      if tp^.fncr^.t <> tfuncr then error(esysflt15);
      ps := fndsym(bsp, tp^.fncr^.fnrt); { find symbol for result }
      if ps = nil then error(esysflt39); { not found }
      cat(pb, '.'); { append separator }
      cat(pb, ps^.lab^) { append type name }

   end else error(esysflt2) { should be procedure or function }

end;

{******************************************************************************

Write block name

Writes the name of the given block to output. The type of block is output,
followed by its name, followed by a coin if it is an overloaded procedure or
function. If it is not currently defined, that is indicated.

******************************************************************************}

procedure blknam(blk: blkptr);

var pb: linbuf; { buffer for coining name }

begin

   { if its a global mark, output its type }
   { global marks don't have names, so we substitute a name according
     to its type. in the future, names will be carried from the parser }
   if blk^.mark^.t = tglbl then { global }
      case blk^.mark^.mrkt of { mark type }

      mtsystem:  write('system module ');
      mtprogram: write('program ');
      mtmodule:  write('module ');
      mtprocess: write('process ');
      mtmonitor: write('monitor ');
      mtshare:   write('share ')
      
   end else if blk^.mark^.t = tproc then write('procedure ')
   else if blk^.mark^.t = tfunc then write('function ')
   else error(esysflt52); { bad }
   { at this point, the block label should really be defined, but we
     fall back if it is not }
   if blk^.marks = nil then write('<undefined>')
   else write(blk^.marks^.lab^);
   { check its an overload }
   if blk^.mark^.t = tproc then begin

      if blk^.mark^.prch <> nil then begin { yes, output postfix }

         coinovl(blkstk, pb, blk^.mark); { coin overload name }
         write(pb:0) { output }

      end

   end else if blk^.mark^.t = tfunc then begin

      if blk^.mark^.fnch <> nil then begin { yes, output postfix }

         coinovl(blkstk, pb, blk^.mark); { coin overload name }
         write(pb:0) { output }

      end

   end

end;

{******************************************************************************

Write block name list

Writes all of the block names in the given list to the output.

******************************************************************************}

procedure blknamlst(blk: blkptr);

begin

   while blk <> nil do begin { traverse list }

      blknam(blk); { print this block }
      writeln; { terminate }
      blk := blk^.next { next block }

   end

end;

{******************************************************************************

Find type

Finds the given type in a list. Returns the sequence number of the type in the
list.

******************************************************************************}

function fndtyp(tp: typptr; { type to find }
                lp: typptr) { list of types }
                :integer;   { sequence number }

var ic: integer; { sequence count }

begin

   ic := 0; { set no entry }
   while lp <> nil do begin { search }

      ic := ic+1; { count entries }
      if tp = lp then lp := nil { found the entry }
      else begin { advance to next entry }

         lp := lp^.next; { next entry }
         if lp = nil then ic := 0 { set no entry }

      end

   end;
   fndtyp := ic { return count }

end;

{******************************************************************************

Find type information

Given a type entry, finds the type entry, then returns the block level,
sequence number of the type, and which list, normal or alternate, that it
belongs to.

******************************************************************************}

procedure fndtin(    tp: typptr; { type to find }
                 var l:  integer;  { block level of type }
                 var s:  integer;  { sequence number of type }
                 var a:  boolean); { type is from alternate/normal list }

var tps: blkptr; { type stack pointer }

begin

   tps := blkstk; { set 1st level }
   s := 0; { set no entry found }
   while tps <> nil do begin { traverse block list }

      l := tps^.lvl; { set level we are searching }
      a := false; { set normal list }                                                    
      s := fndtyp(tp, tps^.typ); { search normal list }
      if s = 0 then begin { not found in normal list }

         a := true; { set alternate list }
         s := fndtyp(tp, tps^.typa); { search alternate list }
         if s <> 0 then tps := nil { terminate search }
         else tps := tps^.next { else next entry }

      end else tps := nil { terminate search }

   end;
{   if s = 0 then error(esysflt1)} { should have found entry }

end;

{******************************************************************************

Find symbol for type

Given a type pointer, finds the symbol referencing that. If no symbol is found,
then nil is returned.

******************************************************************************}

function fndsym(bsp: blkptr; { which block stack to look in }
                tp:  typptr) { type entry to reference }
                : labptr;   { symbol pointer }

var sp, fsp: labptr; { symbol pointers }

begin

   fsp := nil; { clear found pointer }
   while bsp <> nil do begin { search blocks }

      sp := bsp^.sym; { index top of symbols }
      while sp <> nil do begin { traverse symbols }

         if sp^.typ = tp then begin { found the symbol }

            fsp := sp; { place found symbol }
            sp := nil; { stop search }
            bsp := nil

         end else sp := sp^.next { next symbol }

      end;
      if bsp <> nil then bsp := bsp^.next { next level }

   end;
   fndsym := fsp { return found symbol or nil }

end;      

{******************************************************************************

Print linkage

Prints the linkage specification of a type. The type is printed in the
form:

   (level,sequence)

Right justifies the output in a given field.

******************************************************************************}

procedure prtlnk(tp: typptr; { entry to write }
                 fl: integer); { field to write to }

var s: integer; { sequence count }
    l: integer; { block level }
    a: boolean; { type from alternate list }
    c: integer; { number of characters in output }

begin

   if tp = nil then begin { nil pointer }

      write('<nil>');
      c := 5 { set length }

   end else begin { print as address }

      fndtin(tp, l, s, a); { get entry information }
if s = 0 then begin c := 5; write('(???)') end else begin
      c := 1+fnddig(l)+1+fnddig(s)+1; { set length of output }
      write('(', l:1, ',', s:1, ')'); { output }
      if a then begin { from alternate list }

         write('*'); { output alternate list marker }
         c := c+1 { count }

      end
end

   end;
   { pad to field length with blanks }
   while c < fl do begin write(' '); c := c+1 end

end;

{******************************************************************************

Print type

Prints the type and fields of the given type, on a single line without eoln.

******************************************************************************}

procedure lsttypety(tp: typptr);

var i: integer;

begin

   write('addr: $'); prthex(8, tp^.addr); write(' ');
   write('size: $'); prthex(8, tp^.size); write(' (', tp^.size:1, ') ');
   write('lcl: ', tp^.local, ' ');
   case tp^.t of

      tudf:      write('tudf: undefined');     
      tnil:      write('tnil: NIL pointer'); 
      tlab:      begin

         write('tlab: GOTO label: Mark: '); 
         prtlnk(tp^.lmrk, 1)

      end;
      ticst:     begin

         write('ticst: integer constant: Value: ');
         wrtssint(tp^.ival)

      end;
      tscst:     begin

         write('tscst: string constant: Value: ''');
         if fxltchr then 
            for i := 1 to max(tp^.sval^) do write(chrnrm[ord(tp^.sval^[i])])
         else 
            write(tp^.sval^);
         write('''')

      end;
      tccst:     begin

         write('tccst: character constant: Value: ''');
         if fxltchr then write(chrnrm[ord(tp^.cval)]) else write(tp^.cval);
         write('''')

      end;
      trcst:     write('trcst: real constant: Value: ', tp^.rval);
      tstcst:    begin 

         write('tstcst: set constant');
         write(' Base: '); prtlnk(tp^.stct, 1); 
         write(' Const list: '); prtlnk(tp^.stcc, 1)

      end;
      tstet:     begin

         { Note: Set elements could be character, and would be encoded if
           character encoding is enabled. This is an interpretation issue. }
         write('tstet: set constant element: next element: ');
         prtlnk(tp^.sten, 1);
         write(' Starting value: '); wrtssint(tp^.stes);
         write(' Ending value: '); wrtssint(tp^.stee);
         write(' Head: '); prtlnk(tp^.steh, 1)

      end; 
      tarrcst:    begin

         write('tarrcst: array constant: first list entry: ');
         prtlnk(tp^.arcn, 1)

      end;
      tarrcel:    begin

         write('tarrcel: array constant element: next: ');
         prtlnk(tp^.aren, 1);
         write(' constant link: ');
         prtlnk(tp^.arec, 1)

      end;   
      treccst:    begin

         write('treccst: record constant: first list entry: ');
         prtlnk(tp^.recn, 1)

      end;
      treccel:    begin

         write('treccel: record constant element: next: ');
         prtlnk(tp^.reen, 1);
         write(' constant link: ');
         prtlnk(tp^.reec, 1)

      end;
      tenum:      begin

         write('tenum: enumerated type: first list entry: ');
         prtlnk(tp^.enc, 1)

      end;
      tenme:      begin

         write('tenme: enumerated constant: next: ');
         prtlnk(tp^.enx, 1);
         write(' head: ');
         prtlnk(tp^.enh, 1);
         write(' constant: ', tp^.env:1)

      end;
      tsub:       begin

         write('tsub: subrange type: base type: ');
         prtlnk(tp^.subt, 1);
         write(' lower bound: ');
         wrtssint(tp^.subl);
         write(' upper bound: ');
         wrtssint(tp^.subu)

      end;
      tptr:       begin

         write('tptr: pointer type: base type: ');
         prtlnk(tp^.ptrt, 1)

      end;
      tarray:     begin

         write('tarray: array type: base type: ');
         prtlnk(tp^.arrt, 1);
         write(' index type: ');
         prtlnk(tp^.arri, 1)

      end;
      tgarry:     begin

         write('tgarry: general array type: base type');
         prtlnk(tp^.gart, 1)

      end;
      tfile:      begin

         write('tfile: file type: base type: ');
         prtlnk(tp^.filt, 1)

      end;
      tset:       begin

         write('tset: set type: base type: ');
         prtlnk(tp^.sett, 1)

      end;
      trecord:    begin

         write('trecord: record type: field list: ');
         prtlnk(tp^.recf, 1)

      end;
      tfield:     begin

         write('tfield: record field: next: ');
         prtlnk(tp^.fldn, 1);
         write(' head: ');
         prtlnk(tp^.fldh, 1);
         write(' base: ');
         prtlnk(tp^.fldt, 1)

      end;
      tftag:      begin

         write('tftag: record tag field: case list: ');
         prtlnk(tp^.ftgc, 1);
         write(' head: ');
         prtlnk(tp^.ftgh, 1);
         write(' base: ');
         prtlnk(tp^.ftgt, 1);
         write(' exists: ', tp^.ftge)

      end;
      tfcas:      begin

         write('tfcas: record tag field case: next: ');
         prtlnk(tp^.fcsn, 1);
         write(' field list: ');
         prtlnk(tp^.fcsf, 1);
         write(' case constant low: ');
         wrtssint(tp^.fcss);
         write(' case constant high: ');
         wrtssint(tp^.fcse)

      end;
      tvar:       begin

         write('tvar: variable: base type: ');
         prtlnk(tp^.vart, 1);
         write(' external: ', tp^.vare:0);
         write(' referenced: ', tp^.varr:0)

      end;
      tfix:       begin

         write('tfix: fixed: base type: ');
         prtlnk(tp^.fixt, 1);
         write(' constant fill: ');
         prtlnk(tp^.fixc, 1);
         write(' external: ', tp^.fixe:0);
         write(' referenced: ', tp^.fixr:0)

      end;
      tproc:      begin

         write('tproc: procedure: parameter list: '); prtlnk(tp^.prcp, 1);
         write(' total locals allocation: ', tp^.prcv:1);
         write(' total parameters allocation: ', tp^.prca:1);
         write(' offset for goto entry: ', tp^.prcg:1);
         write(' external: ', tp^.prce:0);
         write(' assembly: ', tp^.prcas:0);
         write(' overload head: '); prtlnk(tp^.prch, 1);
         write(' referenced: ', tp^.prcr:0);
         write(' global: ', tp^.prcx:0);
         write(' static: ', tp^.prcst:0);
         write(' virtual: ', tp^.prcvt:0);
         write(' overrider link: '); prtlnk(tp^.prcol, 1);
         write(' override head link: '); prtlnk(tp^.prcoh, 1);
         write(' class type link: '); prtlnk(tp^.prccl, 1);
         write(' virtual vector: '); prtlnk(tp^.prcvv, 1);

      end;
      tfunc:      begin

         write('tfunc: function: parameter list: '); prtlnk(tp^.fncp, 1);
         write(' result: '); prtlnk(tp^.fncr, 1);
         write(' total locals allocation: ', tp^.fncv:1);
         write(' total parameters allocation: ', tp^.fnca:1);
         write(' offset for goto entry: ', tp^.fncg:1);
         write(' external: ', tp^.fnce:0);
         write(' assembly: ', tp^.fncas:0);
         write(' overload head: '); prtlnk(tp^.fnch, 1);
         write(' referenced: ', tp^.fnct:0);
         write(' global: ', tp^.fncx:0);
         write(' static: ', tp^.fncst:0);
         write(' virtual: ', tp^.fncvt:0);
         write(' overrider link: '); prtlnk(tp^.fncol, 1);
         write(' override head link: '); prtlnk(tp^.fncoh, 1);
         write(' class type link: '); prtlnk(tp^.fnccl, 1);
         write(' virtual vector: '); prtlnk(tp^.fncvv, 1);

      end;
      tpar:       begin

         write('tpar: value parameter: next: ');
         prtlnk(tp^.parn, 1);
         write(' base type: ');
         prtlnk(tp^.part, 1);
         write(' head: ');
         prtlnk(tp^.parh, 1)

      end;
      tvpar:      begin

         write('tvpar: variable parameter: next: ');
         prtlnk(tp^.vprn, 1);
         write(' base type: ');
         prtlnk(tp^.vprt, 1);
         write(' head: ');
         prtlnk(tp^.vprh, 1)

      end;
      twpar:      begin

         write('twpar: view parameter: next: ');
         prtlnk(tp^.wprn, 1);
         write(' base type: ');
         prtlnk(tp^.wprt, 1);
         write(' head: ');
         prtlnk(tp^.wprh, 1)

      end;
      tpproc:     begin

         write('tpproc: procedure parameter: parameter list: ');
         prtlnk(tp^.pprp, 1);
         write(' next: ');
         prtlnk(tp^.pprn, 1)

      end;
      tpfunc:     begin

         write('tpfunc: function parameter: parameter list: ');
         prtlnk(tp^.pfnp, 1);
         write(' result: ');
         prtlnk(tp^.pfnr, 1);
         write(' next: ');
         prtlnk(tp^.pfnn, 1)

      end;
      tinteger:   write('tinteger: integer type');
      tlinteger:  write('tlinteger: long integer type');
      tcardinal:  write('tcardinal: cardinal type');
      tlcardinal: write('tlcardinal: long cardinal type');
      tchar:      write('tchar: character type');
      tboolean: begin

         write('tboolean: boolean type: enumeration list: ');
         prtlnk(tp^.bnc, 1)

      end;
      treal:      write('treal: real type');
      tsreal:     write('tsreal: short real type');
      ttext:      write('ttext: text type');
      teset:      write('teset: empty set');
      tglbl:      write('tglbl: global mark');
      tsemaphore: write('tsemaphore');
      tclass:     begin

         write('tclass: base class: ');
         prtlnk(tp^.clsi, 1)

      end;
      tatom:     begin

         write('tatom: base class: ');
         prtlnk(tp^.atmi, 1)

      end;
      tthread:     begin

         write('tthread: base class: ');
         prtlnk(tp^.thdi, 1)

      end;
      treference:  begin

         write('treference: referenced class: ');
         prtlnk(tp^.reft, 1)

      end;
      texception: write('texception');
      tnull:      ;
      tfuncr:     begin

         write('tfuncr: function result holder: type: ');
         prtlnk(tp^.fnrt, 1)

      end;
      tlink:      begin

         write('tlink: delayed link entry: (',
         tp^.lnkl:1, ',', tp^.lnke:1, ')')

      end;
      tcastbl:    begin

         write('tcastbl: case jump table: case list: ');
         prtlnk(tp^.ctn, 1)

      end;
      thshtbl:    begin

         write('thshtbl: case hash table: case list: ');
         prtlnk(tp^.htn, 1)

      end;
      tcassel:    begin

         write('tcassel: cas select entry: case select value: ');
         wrtssint(tp^.csv);
         write(' next: ');
         prtlnk(tp^.csn, 1);
         write(' missed hash chain: ');
         prtlnk(tp^.csm, 1);
         write(' missed hash index" ', tp^.csi:1);
         write(' padding entry: ', tp^.csp)

      end;
      trot: write('trot: library routine marker entry: referenced: ', 
                    tp^.rotr);
      tpgm: write('tpgm: program space marker');
      tvrs: write('tvrs: variable space marker');
         

   end

end;

{******************************************************************************

Print type with numbers

Prints the type and fields of the given type, on a single line without eoln,
including the block level and sequence number.

******************************************************************************}

procedure lsttypetyi(tp: typptr);

begin

   prtlnk(tp, 1); { output header }
   write(' ');
   lsttypety(tp) { output type }

end;

{******************************************************************************

Dump block types list

Dumps a specific blocks type lists. For diagnostic purposes.

******************************************************************************}

procedure lsttypblk(blk: blkptr); { block to dump }

{ list types }

procedure lsttyps(tp: typptr);

var e: integer; { entry counter }

begin

   e := 1; { set 1st entry }
   while tp <> nil do begin { traverse }

      if tp^.t <> tnull then begin { eliminate placeholders }

         write('(', blk^.lvl:1, ',', e:1, ') '); { write (level, entry) }
         lsttypety(tp); { write entry }
         writeln; { next line }

      end;
      e := e+1; { count }
      tp := tp^.next { next entry }

   end;
   writeln { space off }

end;

begin

   write('Types for block: [');
   blknam(blk); { output block name }
   writeln('] ', blk^.lvl:1);
   writeln;
   lsttyps(blk^.typ); { list main types }
   write('Alternates for block: [');
   blknam(blk); { output block name }
   writeln('] ', blk^.lvl:1);
   writeln;
   lsttyps(blk^.typa) { list alternate types }

end;

{******************************************************************************

Dump types list for all blocks

Dumps all type lists for all blocks. For diagnostic purposes.

******************************************************************************}

procedure lsttypblkall;

var bp: blkptr; { pointer into block stack }

begin

   bp := blkstk; { index top block }
   while bp <> nil do begin { dump blocks }

      lsttypblk(bp); { list this block }
      bp := bp^.next { next block }

   end

end;

{******************************************************************************

Dump current types list

Dumps the given standard types list. For diagnostic purposes.

******************************************************************************}

procedure lsttyp;


begin

   lsttypblk(blkstk) { list types in current block }

end;

{******************************************************************************

Dump current symbols list

Dumps the current blocks symbols.

******************************************************************************}

procedure dmpsym;

var sp: labptr; { symbols pointer }

begin

   write('Symbols for block: [');
   blknam(blkstk); { output block name }
   writeln('] ', blkstk^.lvl:1);
   writeln;
   sp := blkstk^.sym; { index top of list }
   while sp <> nil do begin

      write('exp: ', sp^.exp, ' typ: '); prtlnk(sp^.typ, 8); writeln(' sym: ',
            sp^.lab^);
      sp := sp^.next { link next }

   end;
   writeln

end;

{******************************************************************************

List registers in set

Lists the registers in a register set.

******************************************************************************}

procedure lstregs(view rs: regset);

var ri:    regt;    { register index }
    first: boolean; { first entry is being output }

begin

   first := true; { set 1st entry }
   for ri := rgeax to rgedi do begin

      if ri in rs then begin

         if not first then write(','); { space off multiples }
         prtreg(ri);
         first := false { set not first }

      end;

   end

end;

{******************************************************************************

List intermediate tree

Lists the tree for a given intermediate. The given entry, and all its branches,
are printed.

******************************************************************************}

procedure lstinttree(ip: intptr; off: integer);

var tp: typptr;

{ indent listing }

procedure indent(off: integer);

var i:  integer;

begin

   for i := 1 to off do write(' ');

end;

{ list type }

procedure lsttyp(tp: typptr);

var sp: labptr; { symbol pointer }

begin

   { check and process nil }
   if tp = nil then write('<nil>')
   else begin

      sp := fndsym(blkstk, tp); { find any symbol }   
      if sp <> nil then begin

         write('[');
         blknam(tp^.blk); { output block name }
         write('.', sp^.lab^, '] ') { output symbol }

      end;
      prttyp(tp^.t);
      write(' ');
      prtlnk(tp, 1) { print as numeric link }

   end

end;

{ list registers and flags }

procedure lstregf(ip: intptr);

procedure prtflgd(f: flag);

begin

   write('eflags(');
   prtflg(f);
   write(')')

end;

begin

   if ip^.freg <> rgnull then begin { there is a transfer register }

      write(' xfr: ');
      if ip^.freg <> rgflg then prtreg(ip^.freg)
      else prtflgd(ip^.fflg);
      if ip^.fregx <> rgnull then begin { register has extention }

         write(',');
         prtreg(ip^.fregx)

      end

   end;
   if ip^.rsreg <> rgnull then begin { there is a result }

      write(' res: ');
      if ip^.rsreg <> rgflg then prtreg(ip^.rsreg)
      else prtflgd(ip^.rsflg);
      if ip^.rsregx <> rgnull then begin { register has extention }

         write(',');
         prtreg(ip^.rsregx)

      end

   end;
   if ip^.lreg <> rgnull then begin { there is a left }

      write(' lft: ');
      if ip^.lreg <> rgflg then prtreg(ip^.lreg)
      else prtflgd(ip^.lflg);
      if ip^.lregx <> rgnull then begin { register has extention }

         write(',');
         prtreg(ip^.lregx)

      end

   end;
   if ip^.rreg <> rgnull then begin { there is a right }

      write(' rgt: ');
      if ip^.rreg <> rgflg then prtreg(ip^.rreg)
      else prtflgd(ip^.rflg);
      if ip^.rregx <> rgnull then begin { register has extention }

         write(',');
         prtreg(ip^.rregx)

      end

   end;
   if ip^.xreg <> rgnull then begin { there is an extra }

      write(' ext: ');
      if ip^.xreg <> rgflg then prtreg(ip^.xreg)
      else prtflgd(ip^.xflg);
      if ip^.xregx <> rgnull then begin { register has extention }

         write(',');
         prtreg(ip^.xregx)

      end

   end;
   if ip^.x2reg <> rgnull then begin { there is an extra 2 }

      write(' ext2: ');
      if ip^.x2reg <> rgflg then prtreg(ip^.x2reg)
      else prtflgd(ip^.x2flg);
      if ip^.x2regx <> rgnull then begin { register has extention }

         write(',');
         prtreg(ip^.x2regx)

      end

   end;
   if ip^.t1reg <> rgnull then begin { there is a temp 1 }

      write(' tmp1: ');
      prtreg(ip^.t1reg);
      if ip^.t1regx <> rgnull then prtreg(ip^.t1regx)

   end;
   if ip^.t2reg <> rgnull then begin { there is a temp 2 }

      write(' tmp2: ');
      prtreg(ip^.t2reg);
      if ip^.t1regx <> rgnull then prtreg(ip^.t1regx)

   end;
   if ip^.t3reg <> rgnull then begin { there is a temp 3 }

      write(' tmp3: ');
      prtreg(ip^.t3reg);
      if ip^.t1regx <> rgnull then prtreg(ip^.t1regx)

   end;
   if ip^.alc <> [] then begin { there is an allocation }

      write(' alc: ');
      lstregs(ip^.alc)

   end;
   if ip^.push <> [] then begin { there is a push }

      write(' push: ');
      lstregs(ip^.push)

   end

end;

begin

   indent(off); { go to collumn }
   prttic(ip^.i, 1); { print intermediate code }
   case ip^.i of

      tilodadr, tilodfadr, tilodint, tilodrel, tilodsrl, tilodset, tilodchr,
      tilodbol, tilodsrc, tilodptr, tilodtgp: begin

         write(' Address type: '); 
         lsttyp(ip^.base); 
         write(' Result type: '); 
         lsttyp(ip^.rbase); 
         lstregf(ip);
         writeln

      end;
      tiarrref, tiarfgar: begin

         write(' Array type: '); 
         lsttyp(ip^.base); 
         write(' Result type: '); 
         lsttyp(ip^.rbase); 
         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('Base operand + ');
         lstintsec(ip^.left, off+4);
         indent(off+2);
         writeln('Index operand + ');
         lstintsec(ip^.right, off+4)
         
      end;
      tiequstr, tineqstr, tileqstr, tigeqstr, tiltnstr, tigtnstr: begin

         write(' Array type: '); 
         lsttyp(ip^.base); 
         write(' Result type: '); 
         lsttyp(ip^.rbase); 
         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('Left operand + ');
         lstintsec(ip^.left, off+4);
         indent(off+2);
         writeln('Right operand + ');
         lstintsec(ip^.right, off+4)
         
      end;
      tirecoff, tildiint, tilodlen, tildisrc: begin

         write(' Address type: '); 
         lsttyp(ip^.base); 
         write(' Result type: '); 
         lsttyp(ip^.rbase); 
         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('Base + ');
         lstintsec(ip^.left, off+4)

      end;
      tilimint: begin

         write(' Integer: ');
         if constis(ip^.base) then write('-');
         write(consti(ip^.base):1);
         write(' Result type: '); 
         lsttyp(ip^.rbase); 
         lstregf(ip);
         writeln

      end;
      tilimrel: begin

         write(' Real: ', ip^.base^.rval);
         write(' Result type: '); 
         lsttyp(ip^.rbase); 
         lstregf(ip);
         writeln

      end;
      tilimns: begin

         write(' Result type: '); 
         lsttyp(ip^.rbase); 
         lstregf(ip);
         writeln

      end;
      tinotint, tinotbol, ticvtntg, ticvtitr, tinegint, tinegrel, tiabsrel, tiabsint,
      tisqrrel, tisqrint, tiatnrel, ticosrel, tiexprel, tilgnrel, tisinrel, tisqtrel, 
      ticvtrtsr: begin

         write(' Result type: '); 
         lsttyp(ip^.rbase); 
         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('Operand + ');
         lstintsec(ip^.left, off+4)

      end;
      tilditgp, tildiptr, tildibol, tildichr,
      tildiset, tildisrl, tildirel: begin

         write(' Result type: '); 
         lsttyp(ip^.rbase); 
         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('Address + ');
         lstintsec(ip^.left, off+4)

      end;
      tirngset: begin

         write(' Result type: '); 
         lsttyp(ip^.rbase); 
         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('Set + ');
         lstintsec(ip^.left, off+4);
         indent(off+2);
         writeln('Starting element + ');
         lstintsec(ip^.right, off+4);
         indent(off+2);
         writeln('Ending element + ');
         lstintsec(ip^.right, off+4)

      end;
      ticvtgtf: begin

         write(' Fixed array type: '); 
         lsttyp(ip^.base); 
         write(' Result type: '); 
         lsttyp(ip^.rbase); 
         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('General array + ');
         lstintsec(ip^.left, off+4)

      end;
      ticvtftg: begin

         write(' Fixed array type: '); 
         lsttyp(ip^.base); 
         write(' Result type: '); 
         lsttyp(ip^.rbase); 
         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('Fixed array + ');
         lstintsec(ip^.left, off+4)

      end;
      tisinset: begin

         write(' Result type: '); 
         lsttyp(ip^.rbase); 
         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('Set + ');
         lstintsec(ip^.left, off+4);
         indent(off+2);
         writeln('Ordinal + ');
         lstintsec(ip^.right, off+4)

      end;
      tiintset, timltrel, timltint, tidivrel, tidivint, timodint, tiandint,
      tiuniset, tiaddrel, tiaddint, tidifset, tisubrel, tisubint, tiorint, tixorint,
      tiincset, tiequset, tiequrel, tiequgst, tiequint, tiequtgp, tineqset, tineqrel,
      tineqgst, tineqint, tineqtgp, tileqset, tileqrel, tileqgst, tileqint, tigeqset,
      tigeqrel, tigeqgst, tigeqint, tiltnrel, tiltngst, tiltnint, tigtnrel, tigtngst,
      tigtnint: begin

         write(' Result type: '); 
         lsttyp(ip^.rbase); 
         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('Left operand + ');
         lstintsec(ip^.left, off+4);
         indent(off+2);
         writeln('Right operand + ');
         lstintsec(ip^.right, off+4)

      end;
      tiifbgn: begin

         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('Condition + ');
         lstintsec(ip^.left, off+4);
         indent(off+2);
         writeln('True + ');
         lstintsec(ip^.flow2, off+4);
         if ip^.flow3 <> nil then begin

             indent(off+2);
             writeln('False + ');
             lstintsec(ip^.flow3, off+4)

         end

      end;
      ticasbgn: begin

         write(' Case table: ');
         lsttyp(ip^.base); 
         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('Case selector + ');
         lstintsec(ip^.left, off+4);
         indent(off+2);
         writeln('Case list + ');
         lstintsec(ip^.flow2, off+4)

      end;
      ticasstb: begin

         write(' Case value(s): ');
         tp := ip^.base;
         while tp <> nil do begin

            wrtssint(tp^.csv);
            write(' ');
            tp := tp^.css

         end;
         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('Case code + ');
         lstintsec(ip^.flow2, off+4)

      end;
      ticasels: begin

         writeln;
         indent(off+2);
         writeln('Case else code + ');
         lstintsec(ip^.flow2, off+4)

      end;
      tiwhlbgn: begin

         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('Condition + ');
         lstintsec(ip^.left, off+4);
         indent(off+2);
         writeln('Loop body + ');
         lstintsec(ip^.flow2, off+4)

      end;
      tirptbgn: begin

         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('Condition + ');
         lstintsec(ip^.left, off+4);
         indent(off+2);
         writeln('Loop body + ');
         lstintsec(ip^.flow2, off+4)

      end;
      tifortint, tifortchr, tifortbol, tifordint, tifordchr, tifordbol: begin

         write(' Index type: '); 
         lsttyp(ip^.base); 
         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('Start value + ');
         lstintsec(ip^.left, off+4);
         indent(off+2);
         writeln('End value + ');
         lstintsec(ip^.right, off+4);
         indent(off+2);
         writeln('Loop body + ');
         lstintsec(ip^.flow2, off+4)

      end;
      tiwthbgn: begin

         write(' Record type: '); 
         lsttyp(ip^.base); 
         lstregf(ip);
         writeln;
         indent(off+2);
         writeln('Record base load + ');
         lstintsec(ip^.left, off+4);
         indent(off+2);
         writeln('With body + ');
         lstintsec(ip^.flow2, off+4);

      end;
      titrybgn: begin

         indent(off+2);
