program dpint(output);

procedure parnam; { file name return }

var i: 1..10; { file name index }
    p: 0..8;   { primary length }

procedure getncr; { get name character }

begin

   writeln('i: ', i);

end;

begin

   i := 1; { initalize index }
   if 'a' in ['_'] then;
   getncr; { get character }

end;

begin

   parnam; { parse file }

end.
