{*******************************************************************************

Convert single register

Converts a single register to a 3 bit code. Accepts a 32 bit general register.

*******************************************************************************}

function sreg(p: regt): byte;

var r: byte;

begin

   case p of

      rgeax: r := 0; { eax }
      rgebx: r := 3; { ebx }
      rgecx: r := 1; { ecx }
      rgedx: r := 2; { edx }
      rgesi: r := 6; { esi }
      rgedi: r := 7  { edi }

   end;
   sreg := r

end;

{*******************************************************************************

Find signed index multiplier

Gives the ss code for a SIB modifier, based on the scaling number given. The
scaler must be 1, 2, 4, or 8.

*******************************************************************************}

function sib(i: integer): byte;

var b: byte;

begin

   case i of { multiplier }

      1: b := $00; { * 1 }
      2: b := $40; { * 2 }
      4: b := $80; { * 4 }
      8: b := $c0  { * 8 }

   end;
   sib := b { return result }

end;

{*******************************************************************************

Assembly routines

These are various routines to create 80386 assembly instructions without the
details.
The naming convention for assembler output routines is:

asxxx   - Operation with single or double registers.
asxxxi  - Operation with single or double registers, indirect second register.
asxxxbi - Operation with single or double registers, indirect second register
          with byte offset.
asxxxdi - Operation with single or double registers, indirect second register
          with dword offset.
asxxxa  - Operation with single register, direct source
asxxxs  - Short or jump short.
asxxxl  - Long or jump long.
asxxxr  - For reverse, on a binary operator means the r/m applies to the left
          side operand.
asxxxc  - Right operand is a constant in the instruction. Normal is long.
asxxxbn - Right operand is a constant signed byte.

*******************************************************************************}


{ Find conditional code. }

function ccode(f: flag): byte;

var b: byte; { returns the code }

begin

   case f of { flag }

      flnull: error(esysflt103); { should not happen }
      fla:    b := $07;
      flae:   b := $03;
      flb:    b := $02;
      flbe:   b := $06;
      flc:    b := $02;
      fle:    b := $04;
      flg:    b := $0f;
      flge:   b := $0d;
      fll:    b := $0c;
      flle:   b := $0e;
      flna:   b := $06;
      flnae:  b := $02;
      flnb:   b := $03;
      flnbe:  b := $07;
      flnc:   b := $03;
      flne:   b := $05;
      flng:   b := $0e;
      flnge:  b := $0c;
      flnl:   b := $0d;
      flnle:  b := $0f;
      flno:   b := $01;
      flnp:   b := $0b;
      flns:   b := $09;
      flnz:   b := $05;
      flo:    b := $00;
      flp:    b := $0a;
      flpe:   b := $0a;
      flpo:   b := $0b;
      fls:    b := $08;
      flz:    b := $04

   end;
   ccode := b { return result }

end;

{ output dual register/mode operands }

procedure dumod(mode:  modt; { mode of r/m }
                reg:  regt; { register }
                rmrg: regt; { register of r/m }
                off:  integer); { offset }

begin

   emitbyt(ord(mode)*128+sreg(reg)*8+sreg(rmrg));
   if mode = mdindbo then emitbyt(off)
   else if mode = mdinddo then emitint(off)

end;

{ output single register/mode operands }

procedure snmod(mode:  modt; { mode of r/m }
                opc:  byte; { opcode }
                rmrg: regt; { register of r/m }
                off:  integer); { offset }

begin

   emitbyt(ord(mode)*128+opc*8+sreg(rmrg));
   { output any displacement }
   if mode = mdindbo then emitbyt(off)
   else if mode = mdinddo then emitint(off)

end;

{ assemble dual operand instruction with single instruction byte }

procedure asdual(ins:  byte;     { 1st instruction byte }
                 mode: modt;     { mode of r/m }
                 reg:  regt;     { register }
                 rmrg: regt;     { register of r/m }
                 off:  integer); { displacement }

begin

   emitbyt(ins); { emit instruction byte }
   dumod(mode, reg, rmrg, off) { output mode }

end;

{ assemble single operand instruction with single instruction byte }

procedure assing(ins:  byte;     { 1st instruction byte }
                 mode: modt;     { mode of r/m }
                 opc:  byte;     { opcode }
                 rmrg: regt;     { register of r/m }
                 off:  integer); { displacement }

begin

   emitbyt(ins); { emit instruction byte }
{ ????? }
   { dumod(mode, opc, rmrg, off) } { output mode }

end;

procedure asmov(ra: regt; rb: regt); { mov ra,rb }
   begin asdual($8b, mdreg, ra, rb, 0) end;

procedure asmovi(ra: regt; rb: regt); { mov ra,[rb] }
   begin asdual($8b, mdind, ra, rb, 0) end;

procedure asmovir(ra: regt; rb: regt); { mov [ra],rb }
   begin asdual($89, mdind, rb, ra, 0) end;

procedure asmovc(r: regt; n: integer); { mov r,n }
   begin emitbyt($b8+sreg(r)); emitint(n) end;

procedure asand(ra: regt; rb: regt); { and ra,rb }
   begin asdual($23, mdreg, ra, rb, 0) end;

procedure asandi(ra: regt; rb: regt); { and ra,[rb] }
   begin asdual($23, mdind, ra, rb, 0) end;

procedure asor(ra: regt; rb: regt); { or ra,rb }
   begin asdual($0b, mdreg, ra, rb, 0) end;

procedure asxor(ra: regt; rb: regt); { xor ra,rb }
   begin asdual($33, mdreg, ra, rb, 0) end;

procedure asxori(ra: regt; rb: regt); { xor ra,[rb] }
   begin asdual($33, mdind, ra, rb, 0) end;

procedure ascmp(ra: regt; rb: regt); { cmp ra,rb }
   begin asdual($3b, mdreg, ra, rb, 0) end;

procedure ascmpi(ra: regt; rb: regt); { cmp ra,[rb] }
   begin asdual($3b, mdind, ra, rb, 0) end;

procedure ascmpn(r: regt; n: integer); { cmp r,n }

begin 

   if sbyte(n) then begin assing($83, mdreg, $07, r, 0); emitbyt(n) end
   else begin assing($81, mdreg, $07, r, 0); emitint(n) end

end;

procedure asinci(r: regt); { inc [r] }
   begin assing($ff, mdind, $00, r, 0) end;

procedure asdeci(r: regt); { dec [r] }
   begin assing($ff, mdind, $01, r, 0) end;

procedure asdiv(r: regt); { div eax,r }
   begin assing($f7, mdreg, $06, r, 0) end;

{ jump short conditional }

procedure asjccs(f: flag; l: typptr); { jcc l }

begin

   emitbyt($70+ccode(f)); { output jump opcode }
   emitadr(l, itbradr) { output jump location }

end;

{ jump long conditional }

procedure asjccl(f: flag; l: typptr); { jcc l }

begin

   emitbyt($0f); { output opcode }
   emitbyt($80+ccode(f));
   emitadr(l, itradr) { output jump location }

end;

{ jump short }

procedure asjmps(l: typptr); { jmp l }

begin

   emitbyt($eb); { output opcode }
   emitadr(l, itbradr) { output jump location }

end;

{ jump long }

procedure asjmpl(l: typptr); { jmp l }

begin

   emitbyt($e9); { output opcode }
   emitadr(l, itradr) { output jump location }

end;

{ call }

procedure ascall(l: typptr); { call l }

begin

   emitbyt($e8); { output opcode }
   emitadr(l, itradr) { output jump location }

