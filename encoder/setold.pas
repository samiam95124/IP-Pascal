      flg:    f := flng;  
      flge:   f := flnge; 
      fll:    f := flnl;  
      flle:   f := flnle; 
      flna:   f := fla;
      flnae:  f := flae;
      flnb:   f := flb;  
      flnbe:  f := flbe; 
      flnc:   f := flc;  
      flne:   f := fle;  
      flng:   f := flg;  
      flnge:  f := flge; 
      flnl:   f := fll;  
