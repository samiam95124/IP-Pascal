{*******************************************************************************

Generate display load

Generates a display load for the local given in the passed operator node.
The display is loaded into the node register. Will do nothing in the case of
a local in the current frame. A return parameter gives the code for the base
register so formed, which for a current block local, is the ebp register.
The displacement to get the display value is optimized for byte. Since 64
display levels can be reached this way, this is the most common display load.

*******************************************************************************}

procedure gendsl(    bp:  typptr;   { base type }
                     reg: regt;     { register to load to }
                 var sr:  integer); { returns base register code }

begin

   sr := $05; { set ebp as offset register }
   if bp^.level <> blkcnt then begin

      { must get a stored ebp from the display }
      emitbyt($8b); { mov x,[ebp-lvl] }
      emitbyt($80+sreg(reg)*8+$05);
      { offset to proper display level }
      if sbyte(-((bp^.level-1)*4)) then begin

         emitbyt($40+sreg(reg)*8+$05);
         emitbyt(-((bp^.level-1)*4))

      end else begin

         emitbyt($80+sreg(reg)*8+$05);
         emitint(-((bp^.level-1)*4))

      end;
      sr := sreg(reg) { now set that as base register }

   end

end;

{*******************************************************************************

Generate direct address instruction

Generates a one or two byte instruction with a direct address, either a local
or global. Takes the base of the address type, the instruction bytes, the valid
flags for the bytes, and an offset.

*******************************************************************************}

procedure gendir(bp:  typptr;   { base type }
                 reg: regt;     { register }
                 i1:  byte;     { instruction byte 1 }
                 v1:  boolean;  { valid flag 1 }
                 i2:  byte;     { instruction byte 2 }
                 v2:  boolean;  { valid flag 2 }
                 off: integer); { offset from address }

var sr:   byte; { register code save }
    mode: byte; { mode bits }

begin

   { we have not implemented "with" object loads yet }
   if bp^.local then begin { local address }

      {gendsl(bp, reg, sr);} { generate display load }
      if v1 then emitbyt(i1); { emit instruction bytes as applicable }
      if v2 then emitbyt(i2);
      { set displacement mode }
      if sbyte(bp^.addr) then mode := $40 else mode := $80;
      emitbyt(mode+sreg(reg)*8+sr);
      if mode = $40 then emitbyt(bp^.addr+off) { place address byte }
      else emitint(bp^.addr+off) { place address dword }

   end else begin { global address }

      if v1 then emitbyt(i1); { emit instruction bytes as applicable }
      if v2 then emitbyt(i2);
      emitbyt($00+sreg(reg)*8+$05); { generate r/m byte }
      if off = 0 then emitadr(bp, itadr) { place address }
      else emitadro(bp, itadr, off) { place address with offset }

   end

end;

{*******************************************************************************

Generate direct address instruction for single byte instruction

This is gendir for a single byte instruction.

*******************************************************************************}

procedure gendir1(bp:  typptr;   { base type }
                  reg: regt;     { register }
                  ins: byte;     { instruction byte }
                  off: integer); { offset from address }

begin

   { generate single byte instruction }
   gendir(bp, reg, $00, false, ins, true, off)

end;

{********************************************************************************

Generate direct address instruction for double byte instruction

This is gendir for a double byte instruction.

********************************************************************************}

procedure gendir2(bp:   typptr;   { base type }
                  reg:  regt;     { register }
                  ins1: byte;     { instruction byte 1 }
                  ins2: byte;     { instruction byte 2 }
                  off:  integer); { offset from address }

begin

   { generate double byte instruction }
   gendir(bp, reg, ins1, true, ins2, true, off)

end;

{*******************************************************************************

Generate address load

Generates an address load given an operand node. If the operand is a local,
it is either directly offset from ebp, or a stored ebp from the frame's
display is fetched and offset. If it is global, the address is loaded directly.

*******************************************************************************}

procedure genlad(ip: intptr); { node pointer }

var sr: integer; { register code save }

begin

   { lea x,[addr] }
   gendir1(ip^.base, ip^.rsreg, $8d, 0)

end;

{*******************************************************************************

Generate variable load with size and offset

Generates an variable load given an operand node. If the operand is a local,
it is either directly offset from ebp, or a stored ebp from the frame's
display is fetched and offset. If it is global, it is loaded directly.
The size, byte, word or dword is specified, as is an offset from the base to
load from. This is used to pick apart sets and perhaps packed structures.

*******************************************************************************}

procedure genlodso(ip:  intptr;   { node pointer }
                   sz:  integer;  { size to load }
                   off: integer); { offset }

var sr:         byte; { register code save }
    mode:       byte; { mode bits }
    ins1, ins2: byte; { instruction bytes }

{ make instruction code }

procedure makins;

begin

   if sz = 4 then begin { use standard load }

      ins1 := $00; { set no 1st byte }
      ins2 := $8b { mov r,[addr] }

   end else begin { extended load }
                             
      { movsx or movzx }            
      ins1 := $0f; { set 1st byte }           
      if sz = 2 then ins2 := $b7 { word }
      else if sz = 1 then ins2 := $b6 { byte }
      else error(einvfmt); { invalid format }
      { set movsx for signed }
      if chksgn(ip^.base) then ins2 := ins2+$08

   end

end;

begin

   makins; { create instruction code }
   if ins1 = $00 then gendir1(ip^.base, ip^.rsreg, ins2, off) { generate single }
   else gendir2(ip^.base, ip^.rsreg, ins1, ins2, off) { generate double }

end;

{*******************************************************************************

Generate tagged pointer load direct

Generates a load of a tagged pointer from local or global store. rreg of the
node will contain the base address, and rregx will contain the length.

*******************************************************************************}

procedure genlodtp(ip: intptr);   { node pointer }

begin

   gendir1(ip^.base, ip^.rsreg, $8b, 0); { load address }
   gendir1(ip^.base, ip^.rsregx, $8b, ptrsiz) { load length }

end;

{*******************************************************************************

Generate real load/short real load

Generates a real or short real load from the local or global address.
A local is offset from ebp, with a displacement optimized to byte. A global is
just loaded indirect.

*******************************************************************************}

procedure genlodr(ip: intptr); { node to load from }

var mode: byte;    { mode bits }
    sr:   integer;

begin

   if ip^.base^.size = srlsiz then emitbyt($d9) { flds x }
   else emitbyt($dd); { fldd x }
   if ip^.base^.local then begin { local address }

      gendsl(ip^.base, ip^.rsreg, sr); { generate display load }
      { set displacement mode }
      if sbyte(ip^.base^.addr) then mode := $40 else mode := $80;
      emitbyt(mode+$00*8+sr);
      if mode = $40 then emitbyt(ip^.base^.addr) { place address byte }
      else emitint(ip^.base^.addr) { place address dword }

   end else begin

      emitbyt($00+$00*8+$05); { generate r/m byte }
      emitadr(ip^.base, itadr) { place address }

   end
   
end;

{*******************************************************************************

Generate variable store with size and offset

Generates an variable store given an operand node for the source, a base for the
destination, a size and an offset. If the operand is a local, it is either
directly offset from ebp, or a stored ebp from the frame's display is fetched
and offset. If it is global, it is stored directly.
The size, byte, word or dword is specified, as is an offset from the base to
store to.

*******************************************************************************}

procedure genstoso(base: typptr;   { base of destination variable }
                   ip:   intptr;   { node pointer }
                   sz:   integer;  { size to store }
                   off:  integer); { offset }

begin

   if sz = 4 then { dword }
      gendir1(base, ip^.rsreg, $89, off) { mov [addr],dr }
   else if sz = 2 then { word }
      gendir2(base, ip^.rsreg, $66, $89, off) { mov [addr],wr }
   else { byte }
      gendir1(base, ip^.rsreg, $88, off) { mov [addr],br }

end;

{********************************************************************************

Generate real load/short real store

Generates a real or short real load from the local or global address.
A local is offset from ebp, with a displacement optimized to byte. A global is
just loaded indirect.

********************************************************************************}

procedure genstor(ip: intptr); { node to store to }

var mode: byte;    { mode bits }
    sr:   integer;

begin

   if ip^.base^.size = srlsiz then emitbyt($d9) { flds x }
   else emitbyt($dd); { fldd x }
   if ip^.base^.local then begin { local address }

      gendsl(ip^.base, ip^.rsreg, sr); { generate display load }
      { set displacement mode }
      if sbyte(ip^.base^.addr) then mode := $40 else mode := $80;
      emitbyt(mode+$02*8+sr);
      if mode = $40 then emitbyt(ip^.base^.addr) { place address byte }
      else emitint(ip^.base^.addr) { place address dword }

   end else begin

      emitbyt($00+$02*8+$05); { generate r/m byte }
      emitadr(ip^.base, itadr) { place address }

   end
   
end;

{*******************************************************************************

Generate compare immediate

Generates an efficient compare immediate for the given node. The node must
allready be processed to a register.

*******************************************************************************}

procedure gencmp(ip: intptr;   { node to process }
                 i:  integer); { immediate compare value }

begin

   { if the index is in eax, and not a single byte, we use a special
     instruction for that }
   if (ip^.rsreg = rgeax) and not sbyte(i) then begin

      emitbyt($3d); { cmp eax,imm32 }
      emitint(i)

   end else begin { not eax }

      { cmp x,n }
      if sbyte(i) then begin

         emitbyt($83); { cmp x,imm8 }
         emitbyt($c0+$07*8+sreg(ip^.rsreg));
         emitbyt(i)

      end else begin

         emitbyt($81); { cmp x,imm32 }
         emitbyt($c0+$07*8+sreg(ip^.rsreg));
{ ????? }
         { emitint(lbound(tp)) }

      end
   
   end

end;

{*******************************************************************************

Generate skip error call

Generates a skip over jump, followed by a call to the error routine.
The jump instruction is a 2 byte relative.

*******************************************************************************}

procedure genske(jmpins: byte;     { jump instruction byte }
                 errcod: rerrcod); { error code }

begin

   emitbyt(jmpins); { jle over }
   emitbyt(7); { relative jump over error call }
   { generate error routine call }
   asmovc(rgeax, ord(errcod)); { mov eax,errcod }
   ascall(pserror); { call ps_error }
   pserror^.rotr := true { set referenced }

end;

{*******************************************************************************

Generate overflow check

Generates a check if the overflow bit is set. Either routes this to int
trap, or generates an error routine call depending on fcustrp.
If fovfchk is not true, this routine is a no op.

*******************************************************************************}

procedure genovf;

begin

   if fovfchk then begin { overflow checking is on }

      if fcustrp then { generate a custom trap }
         emitbyt($ce) { into }
      else genske($71, rerngchk) { generate error call }

   end

end;

{*******************************************************************************

Generate bounds check

Given a node, generates a bounds check for the value in the register. There are
two bounds check modes. First, we can use the bounds check instruction provided
in the CPU. This is done if custom trapping is on. The second method is to use
two compares and a call to the error routine.
A third method, not done here, is to first subtract the base, then compare to
the high limit only. That works because any value range can be bounded against
zero (it essentially folds the base adjust and compare together).
Note that we can also drop the first (base) check of a handrolled bounds
compare if the base is in fact zero. This is not done on the trap version.
Note also that the bounds instruction requires templetes be placed in constant
store for it to reference.
Note finally that the value must already be processed into a register.
Note that the base of the node must address the descriptor for the type.

*******************************************************************************}

procedure genbnd(ip: intptr;  { pointer to node }
                 tp: typptr); { index type }

{ find length of compare immediate for index }

function lencmp(i: integer): integer;

var l: integer;

begin

   if (ip^.rsreg = rgeax) and not sbyte(i) then l := 5
   else if sbyte(i) then l := 3
                    else l := 6;

   lencmp := l { return result }

end;

begin

   if fbndins then begin { use bounds instruction }

      { to make bounds work, we store the bound
        descriptors in the constants gallery }
      emitbyt($62); { bound x,[arrbnd] }
      emitbyt($00+sreg(ip^.rsreg)*8+$05);
      emitadr(ip^.base, itadr) { place address }

   end else begin { use normal (handrolled) bounds check }
   
      if lbound(ip^.base^.arri) > 0 then begin { generate low side check }

         gencmp(ip^.right, lbound(tp)); { generate low bound check }
         emitbyt($7c); { jl error }
         { relative jump to error call }
         emitbyt(lencmp(ubound(tp))+2)

      end;
      gencmp(ip^.right, ubound(tp)); { generate high bound check }
      genske($7e, rerngchk) { generate error call }

   end

end;

{*******************************************************************************

Perform doi instruction with immediate

Performs one of the following instructions with an immediate operand:

add - $00
adc - $10
and - $20
cmp - $38
or  - $08
sub - $28
sbb - $18
xor - $30

The operation is performed differently depending on if the right operand is
in eax, and if the constant fits in a signed byte. Also, adds and subs are
performed with inc/decs to save code if appropriate.
Note that the zero immediate case is supposed to have been eliminated from the
intermediate, but we do it here anyways because of the other uses for this
routine.

*******************************************************************************}

procedure gendoii(ins: integer;  { instruction type }
                  ip:  intptr;   { register to add to }
                  i:   integer;  { immediate operand }
                  err: boolean); { generate overflow error }

begin

   if i <> 0 then begin { is the operation even required ? }

      if ((ins = $00) or (ins = $28)) and (ip^.rsreg = rgeax) and
         ((i = 1) or (i = -1)) and (err or not fovfchk) then begin

         { for eax right, and single increment/decrement, we can perform with
           increment/decrement instructions and save a byte }
         if ((ins = $00) and (i = 1)) or ((ins = $28) and (i = -1)) then
            emitbyt($40+sreg(ip^.rsreg)) { inc eax }
         else
            emitbyt($48+sreg(ip^.rsreg)) { dec eax }

      end else if ((ins = $00) or (ins = $28)) and
                  ((i = 1) or (i = -1) or (i = 2) or (i = -2)) and
                  (err or not fovfchk) then begin

         { for single or double increment/decrement, we can perform with
           increment/decrement instructions and save one or two bytes }
         if ((ins = $00) and (i = 1)) or ((ins = $28) and (i < 0)) then
            emitbyt($40+sreg(ip^.rsreg)) { inc eax }
         else
            emitbyt($48+sreg(ip^.rsreg)); { dec eax }
         if ((i = 2) or (i = -2)) then begin { do it again }

            if ((ins = $00) and (i = 1)) or ((ins = $28) and (i < 0)) then
               emitbyt($40+sreg(ip^.rsreg)) { inc eax }
            else
               emitbyt($48+sreg(ip^.rsreg)); { dec eax }

         end

      end else begin { perform with add }

         { a special form exists for add eax,n, but it can be shorter to use
           the "long" form if the immediate fits in a signed byte }
         if (ip^.rsreg = rgeax) and not sbyte(i) then begin { add eax,n }

            emitbyt(ins+$05); { add eax,n }
            emitint(i) { output constant }
         
         end else begin { add x,n }

            { use short or long according to constant size }
            if sbyte(i) then emitbyt($83) else emitbyt($81);
            emitbyt($c0+ins+sreg(ip^.rsreg));
            emitbyt(i)

         end;
         { if error is selected and the operation can overflow, generate
           check }
         if err and (ins in [$00, $10, $28, $18]) then genovf

      end

   end

end;

{*******************************************************************************

Perform multiply with immediate

Generates a multiply of the given node register by the constant. The node must
be processed to a register, and further, the "in" register must be on the left
fork of the node. This is to allow three address modes.
Several optimizations are performed. First, we determine if a simple shift can
give the result. Next, we see if a power sequence can cover it. This is a
series of add ones and doubles to give the same result. Because an add is the
same code size as a multiply, we only do this if the speed flag is set, since
an add takes 1/30th of a multiply time. Lastly, we perform a three address 
multiply immediate, which can be used by the register layer to fold a move
into the multiply.
Another special case that must done in the register pass is to reserve a copy
register for power series cases, saved in the "b" side of operator node.

*******************************************************************************}

procedure genmlti(ip:  intptr;   { node to process }
                  oip: intptr;   { operand fork }
                  i:   integer;  { constant }
                  err: boolean); { generate error checks }

var shft: 0..31;   { shift count }
    t:    integer; { constant save }
    ti:   1..10;   { index for multiply table }

begin

   { 0 and 1 are eliminated in the above pass. Now we take all of the powers
     of 2 out. Find constant shift.. }
   shft := pow2(i); { find shift power }
   if (shft <> 0) and not (err or not fovfchk) then begin
 
      { shift value found, perform it }
      emitbyt($c0); { sal rl,imm8 }
      emitbyt($c0+$04*8+sreg(ip^.rsreg));
      emitbyt(shft)

   end else begin { not found }

      if (i <= maxmlt) and fspeed and not (err or not fovfchk) then begin

         { We can generate a power sequence to cover small multiplies, but
           why do it when an add takes as many bytes as one imul ? Because
           adds are a lot faster. We perform up to 10 of these, although
           we could do more and stay within a fairly stunning 30 to 1
           timing advantage. Note that Intel could flush this by
           coming up with an efficient multiply. The copy register is
           reserved in the register pass. }
         emitbyt($8b); { mov rs,rl }
         emitbyt($c0+sreg(ip^.rsregx)*8+sreg(ip^.rsreg));
         for ti := 1 to 10 do begin { perform +1, *2 }

            if powtab[i, ti] = 'a' then begin { +1 }

               emitbyt($03); { add rl,rs }
               emitbyt($c0+sreg(ip^.rsreg)*8+sreg(ip^.rsregx))

            end else if powtab[i, ti] = 'd' then begin { *2 }

               emitbyt($03); { add rl,rl }
               emitbyt($c0+sreg(ip^.rsreg)*8+sreg(ip^.rsreg))

            end

         end

      end else begin { perform conventional multiply immediate }
         
         { The three operand form does not cost any more than the two
           operand form here. This allows any result register to be used,
           and can be taken advantage of in the registers pass. }
         if sbyte(i) then begin { perform short version }

            emitbyt($6b); { imul rl,imm8 }
            emitbyt($c0+sreg(ip^.rsreg)*8+sreg(oip^.rsreg));
            emitbyt(i);
            if err then genovf { generate overflow check }

         end else begin { perform long version }

            emitbyt($69); { imul rl,imm8 }
            emitbyt($c0+sreg(ip^.rsreg)*8+sreg(oip^.rsreg));
            emitbyt(i);
            if err then genovf { generate overflow check }

         end

      end

   end

end;

{*******************************************************************************

Process double operand instruction for tree

Given a node that will perform an instruction, it it generated with several
special cases. The instruction is encoded as:

add  - $00
adc  - $10
and  - $20
cmp  - $38
or   - $08
sub  - $28
sbb  - $18
xor  - $30
imul - $0f

We process special cases for right side is constant, loaded direct, loaded
indirect, and an array reference, in that order of preference. If the operator
is associative, we try to swap the operands so that the best one ends up right.
The "left" cases exist, but are in the "store" routines.

*******************************************************************************}

procedure gendoi(ip: intptr;    { intermediate node }
                 ins: byte;     { instruction code }
                 err: boolean); { generate overflow check }

var i:        integer; { integer holding }
    lip, rip: intptr;  { intermediate pointer holding }
    mode:     integer; { mod code for instructions }
    sr:       integer; { register code save }

{ perform default action for right side }

procedure doright;

begin

   gennod(rip); { resolve right }
   if ins = $0f then begin { multiply }

      emitbyt($0f); { imul }
      emitbyt($af)
  
   end else emitbyt(ins+$03); { add x,y }
   emitbyt($c0+sreg(lip^.rsreg)*8+sreg(rip^.rsreg));
   { if error is selected and the operation can overflow, generate check }
   if err and (ins in [$00, $10, $28, $18, $0f]) then genovf

end;

begin

   lip := ip^.left; { get operands }
   rip := ip^.right;
   if ins in [$00, $10, $20, $08, $30, $0f] then begin

      { operands are associative, swap for better advantage }
      if lip^.i = ilimint then begin { swap so that constants are right }
    
         lip := ip^.right;
         rip := ip^.left

      end else if lip^.i = ilodint then begin

         { swap so that direct loads are right }
         lip := ip^.right;
         rip := ip^.left

      end else if lip^.i = ildiint then begin

         { swap so that indirect loads are right }
         lip := ip^.right;
         rip := ip^.left

      end else if lip^.i = iarrref then begin

         { swap so that direct loads are right }
         lip := ip^.right;
         rip := ip^.left

      end

   end;
   gennod(lip); { resolve the left one }
   if rip^.i = ilimint then begin { process immediate form }

      if ins = $0f then { generate multiply immediate }
         genmlti(ip, lip, consti(rip^.base), true)
      else { other operator }
         gendoii(ins, ip, consti(rip^.base), true) { perform }

   end else if rip^.i = ilodint then begin { fold direct load }

      if rip^.base^.size = 4 then begin { must be double }

         if rip^.base^.local then begin { local address }
    
            gendsl(rip^.base, rip^.rsreg, sr); { generate display load }
            if sbyte(rip^.base^.addr) then
               mode := $40 { disp8[base] }
            else
               mode := $80; { disp32[base] }
            if ins = $0f then begin { multiply }

               emitbyt($0f); { imul }
               emitbyt($af)
  
            end else emitbyt(ins+$03); { add x,[addr] }
            emitbyt($80+sreg(lip^.rsreg)*8+$05);
            if mode = $40 then emitbyt(rip^.base^.addr)
            else emitint(rip^.base^.addr); { place address }
            { if error is selected and the operation can overflow, generate
              check }
            if err and (ins in [$00, $10, $28, $18, $0f]) then genovf
            
         end else begin { global address }

            if ins = $0f then begin { multiply }

               emitbyt($0f); { imul }
               emitbyt($af)
  
            end else emitbyt(ins+$03); { add x,[addr] }
            emitbyt($00+sreg(lip^.rsreg)*8+$05);
            emitadr(rip^.base, itadr); { place address }
            { if error is selected and the operation can overflow, generate
              check }
            if err and (ins in [$00, $10, $28, $18, $0f]) then genovf

         end

      end else doright { process as normal }

   end else if rip^.i = ildiint then begin { fold direct load }

      if rip^.base^.size = 4 then begin { must be double }

         gennod(rip); { resolve right }
         if ins = $0f then begin { multiply }

            emitbyt($0f); { imul }
            emitbyt($af)
  
         end else emitbyt(ins+$03); { add x,[addr] }
         emitbyt(sreg(lip^.rsreg)*8+sreg(rip^.rsreg));
         { if error is selected and the operation can overflow, generate
           check }
         if err and (ins in [$00, $10, $28, $18, $0f]) then genovf

      end else doright { process as normal }

   end else if rip^.i = iarrref then begin { try array reference }

      { One thing we can count on, there will be no structured members
        that are accessed for a doi operator. There are some limited
        array cases that could fit into the SIB format. If array checks
        are off, and the base type size is 1, 2, 4 or 8, then we can do it.
        The base value is done by adding it into the displacement. Globals
        or locals can be processed }
      if rip^.base^.t <> tarray then error(einvfmt); 
      i := rip^.base^.arrt^.size; { get base type size }
      if i in [1, 2, 4, 8] then begin { proper base size }

         if rip^.left^.i = ilodadr then begin

            { array is simple, addressed }
            if rip^.left^.base^.local then begin { its a local }

               { generate any display load }
               gendsl(rip^.left^.base, rip^.left^.rsreg, sr);
               { determine mode of displacement by address }
               if sbyte(rip^.base^.addr) then
                  mode := $40 { disp8[base+index*n] }
               else
                  mode := $80; { disp32[base+index*n] }
               gennod(rip^.right); { resolve index }
               if farrchk then
                  genbnd(rip, rip^.base^.arri); { generate bounds check }
               if ins = $0f then begin { multiply }

                  emitbyt($0f); { imul }
                  emitbyt($af)
  
               end else emitbyt(ins+$03); { add x,disp[ebp+index*n] }
               emitbyt(mode+sreg(lip^.rsreg)*8+$04);
               emitbyt(sib(i)+sreg(rip^.right^.rsreg)*8+sr);
               if mode = $40 then emitbyt(lbound(rip^.base^.arri))
               else emitint(lbound(rip^.base^.arri));
               { if error is selected and the operation can overflow, generate
                 check }
               if err and (ins in [$00, $10, $28, $18, $0f]) then genovf

            end else begin { its a global }
               
               gennod(rip^.right); { resolve index }
               if farrchk then
                  genbnd(rip, rip^.base^.arri); { generate bounds check }
               if ins = $0f then begin { multiply }

                  emitbyt($0f); { imul }
                  emitbyt($af)
  
               end else emitbyt(ins+$03); { add x,[base+index*n] }
               emitbyt($80+sreg(lip^.rsreg)*8+$04);
{ ???? }
               emitbyt(sib(i)+sreg(rip^.right^.rsreg)*8+sreg(rip^.left^.rsreg));
               { use normal address or offset address if there is a base }
               if lbound(rip^.base^.arri) = 0 then emitadr(rip^.base, itadr)
               else emitadro(rip^.base, itadr, -lbound(rip^.base^.arri));
               { if error is selected and the operation can overflow,
                 generate check }
                 if err and (ins in [$00, $10, $28, $18, $0f]) then genovf

            end

         end else begin { array is complex }

            { determine mode of displacement by lower bound }
            if lbound(rip^.base^.arri) = 0 then
               mode := $00 { [base+index*n }
            else if sbyte(lbound(rip^.base^.arri)) then
               mode := $40 { disp8[base+index*n] }
            else
               mode := $80; { disp32[base+index*n] }
            gennod(rip^.left); { resolve the array base }
            gennod(rip^.right); { resolve index }
            if farrchk then
               genbnd(rip, rip^.base^.arri); { generate bounds check }
            if ins = $0f then begin { multiply }

               emitbyt($0f); { imul }
               emitbyt($af)
  
            end else emitbyt(ins+$03); { add x,disp[base+index*n] }
            emitbyt(mode+sreg(lip^.rsreg)*8+$04);
{ ???? }
            emitbyt(sib(i)+sreg(rip^.right^.rsreg)*8+sreg(rip^.left^.rsreg));
            if mode = $40 then emitbyt(lbound(rip^.base^.arri))
            else if mode = $80 then emitint(lbound(rip^.base^.arri));
            { if error is selected and the operation can overflow, generate
              check }
            if err and (ins in [$00, $10, $28, $18, $0f]) then genovf

         end

      end else doright { register to register }

   end else doright { register to register }

end;

{*******************************************************************************

Generate bounds check and base remove

Checks the given node for bounds, and removes the lower bound from the index.
If no array checking is active, we just subtract the lower bound.
The reason this operation is combined is that the check against the lower
bound and the base adjustment can be folded together. The node must already
be processed to a register.
Note that sets use the same routines and flags. For sets we do this slightly
different. First, the lower bound will be mod 8, because we allways align
sets to the nearest byte. Second, because the base subtract value and the
lower bound are no longer the same, we can only use the first form of a bounds
check followed by a base subtraction.

*******************************************************************************}

procedure genrchk(ip: intptr;   { node to process }
                  tp: typptr;   { index type }
                  st: boolean); { set type being processed, set or array }
                 
begin

   if fbndins or not farrchk or (st and (lbound(tp) mod 8 <> 0)) then begin

      { use bounds instruction }
      if farrchk then genbnd(ip, tp); { generate bounds check }
{ ???? }
     { gendoi($28, ip^.right, lbound(tp))} { remove lower bound }
   
   end else begin { fold bounds check into offset normalize }
   
      { For this, we can just remove the base, then do a high
        limit check, since it will then bound against 0 }
{ ???? }
      gendoii($28, ip^.right, lbound(ip^.base^.arri), true); { remove lower bound }
      emitbyt($3d); { cmp eax,imm }
      { where compare is "span" of type }
      emitint(ubound(ip^.base^.arri)-lbound(ip^.base^.arri));
      emitbyt($7e); { jle over }
      emitbyt(7); { relative jump over next }
      { generate error routine call }
      emitbyt($6a); { push rerngchk }
      emitbyt(ord(rerngchk)); { place error code }
      emitbyt($e8); { call error }
      emitadr(pserror, itradr); { output error routine address }
      pserror^.rotr := true { set referenced }

   end

end;

{*******************************************************************************

Generate array reference

Expects an array reference node. The code to access the array is generated,
and if the bounds checks are on, that is generated as well.
A future optimization is to determine if bounds checks are unessary because
of index type.

More good stuff:

Cannot perform direct loads where variable is not 4 bytes. Check size of var,
which can be adjusted beforehand for size and the fpakvar flag.

*******************************************************************************}

procedure genarr(ip: intptr); { node to generate }

var sr:   integer; { register code save }
    disp: integer; { net displacement save }
    mode: integer; { mod code for instructions }
    i:    integer;

begin

   if ip^.base^.t <> tarray then error(einvfmt); 
   i := ip^.base^.arrt^.size; { get base type size }
   if i in [1, 2, 4, 8] then begin

      { the base size is one that can be reached by scaling }
      if ip^.left^.i = ilodadr then begin

         { array is simple, addressed }
         if ip^.base^.local then begin { its a local }

            { find net displacement, address - space to 1st element }
            disp := ip^.base^.addr-lbound(ip^.base^.arri)*i;
            gendsl(ip^.base, ip^.rsreg, sr); { generate display load }
            { determine mode of displacement by address }
            if sbyte(disp) then
               mode := $40 { disp8[base+index*n] }
            else
               mode := $80; { disp32[base+index*n] }
            gennod(ip^.right); { resolve index }
            if farrchk then
               genbnd(ip, ip^.base^.arri); { generate bounds check }
            emitbyt($8d); { lea x,disp[ebp+index*n] }
            emitbyt(mode+sreg(ip^.rsreg)*8+$04);
            emitbyt(sib(i)+sreg(ip^.right^.rsreg)*8+sr);
            if mode = $40 then emitbyt(disp)
            else emitint(disp)

         end else begin { its a global }
            
            gennod(ip^.right); { resolve index }
            if farrchk then
               genbnd(ip, ip^.base^.arri); { generate bounds check }
            emitbyt($8d); { lea x,[base+index*n] }
            emitbyt($80+sreg(ip^.rsreg)*8+$04);
{ ???? }
            emitbyt(sib(i)+sreg(ip^.right^.rsreg)*8+sreg(ip^.left^.rsreg));
            { use unmodified or offset address if there is a base }
            if lbound(ip^.base^.arri) = 0 then emitadr(ip^.base, itadr)
            else emitadro(ip^.base, itadr, -lbound(ip^.base^.arri)*i)

         end

      end else begin { array is complex }

         { find net displacement, - space to first element }
         disp := -lbound(ip^.base^.arri)*i;
         { determine mode of displacement by lower bound }
         if disp = 0 then
            mode := $00 { [base+index*n }
         else if sbyte(disp) then
            mode := $40 { disp8[base+index*n] }
         else
            mode := $80; { disp32[base+index*n] }
         gennod(ip^.left); { resolve the array base }
         gennod(ip^.right); { resolve index }
         if farrchk then genbnd(ip, ip^.base^.arri); { generate bounds check }
         emitbyt($8d); { lea x,disp[base+index*n] }
         emitbyt(mode+sreg(ip^.rsreg)*8+$04);
{ ???? }
         emitbyt(sib(i)+sreg(ip^.right^.rsreg)*8+sreg(ip^.left^.rsreg));
         if mode = $40 then emitbyt(disp)
         else if mode = $80 then emitint(disp)

      end

   end else begin { array index is not scalable }

      gennod(ip^.left); { resolve the array base }
      gennod(ip^.right); { resolve index }
      { perform lower bound remove and bounds check }
      genrchk(ip, ip^.base^.arri, false);
      { here is a major assumtion. If the size of an array element fits into
        a signed format, we can use a signed multiply, which has a lot more
        instruction modes. Since we don't currently support unsigned numbers
        at all, this is what we do by default }
      genmlti(ip, ip, i, false); { generate index scale }
{ ???? }
      { gendoi(ip, $00)} { generate offset to address }

   end

end;

{*******************************************************************************

Generate general array reference

Expects a general array reference node. The code to access the array is
generated, and if the bounds checks are on, that is generated as well.

More good stuff:

Cannot perform direct loads where variable is not 4 bytes. Check size of var,
which can be adjusted beforehand for size and the fpakvar flag.

*******************************************************************************}

procedure gengar(ip: intptr); { node to generate }

var sr: integer; { register code save }
    i:  integer;

begin

   if ip^.base^.t <> tgarry then error(einvfmt); 
   i := ip^.base^.arrt^.size; { get base type size }
   if i in [1, 2, 4, 8] then begin

      { the base size is one that can be reached by scaling }
      gennod(ip^.left); { resolve the array base }
      gennod(ip^.right); { resolve index }
      if farrchk then begin

         gencmp(ip^.right, 1); { generate low bound check }
         emitbyt($7c); { jl error }
         { relative jump to error call }
         emitbyt(2+2);
         { generate high bound check from tag }
         emitbyt($3b); { cmp rb,rlen }
{ ???? }
         { emitbyt($c0+sreg(ip^.right^.rsreg)*8+ip^.left^.rsregx);}
         genske($7e, rerngchk) { generate error call }

      end;
      emitbyt($8d); { lea x,disp[base+index*n] }
      emitbyt($40+sreg(ip^.rsreg)*8+$04);
{ ??????? }
      emitbyt(sib(i)+sreg(ip^.right^.rsreg)*8+sreg(ip^.left^.rsreg));
      emitbyt(-i) { displace by single element }

   end else begin { array index is not scalable }

      gennod(ip^.left); { resolve the array base }
      gennod(ip^.right); { resolve index }
      { perform lower bound remove and bounds check }
      emitbyt($48+sreg(ip^.right^.rsreg)); { dec ri }
      if farrchk then begin

         { generate high bound check from tag }
         emitbyt($3b); { cmp rb,rlen }
{ ???? }
         { emitbyt($c0+sreg(ip^.right^.rsreg)*8+ip^.left^.rsregx); }
         genske($7e, rerngchk) { generate error call }
      
      end;
      { here is a major assumtion. If the size of an array element fits into
        a signed format, we can use a signed multiply, which has a lot more
        instruction modes. Since we don't currently support unsigned numbers
        at all, this is what we do by default }
      genmlti(ip, ip, i, false); { generate index scale }
{ ???? }
      { gendoi(ip, $00) } { generate offset to address }

   end

end;

{*******************************************************************************

Generate indirect load

Generates a load indirect from address. Takes into account both the size and
the signed status of the loaded element. If the size is not double, then the
element is either zero or sign extended, for unsigned or signed, respectively.
If the operand is a direct load, that is folded into the instruction. A ilodadr
as an operand is not folded, because an iindxxx referencing a ilodadr is folded
down to an ilodxxx at a pass above us.
Note that we don't care what type of load it is, ilodint, ilodchr or ilodbol,
because these differentiations are just for coders like sim that don't want to
to the typing homework.

*******************************************************************************}

procedure genind(ip: intptr); { node to process }

var sr: integer; { register code save }

begin

   gennod(ip^.left); { resolve operand }
   if ip^.base^.size = 4 then begin { integer }

      emitbyt($8b); { mov rr,[rl] }
      emitbyt($00+sreg(ip^.rsreg)*8+sreg(ip^.left^.rsreg))

   end else if ip^.base^.size = 2 then begin { word }

{ ????? }
      if true {chksgn(tp)} then begin { signed }

         emitbyt($0f); { movsxw eax,[eax] }
         emitbyt($bf);
         emitbyt($00+sreg(ip^.rsreg)*8+sreg(ip^.left^.rsreg))

      end else begin { unsigned }

         emitbyt($0f); { movzxw eax,[eax] }
         emitbyt($b7);
         emitbyt($00+sreg(ip^.rsreg)*8+sreg(ip^.left^.rsreg))

      end

   end else if ip^.base^.size = 1 then begin { byte }

{ ????? }
      if true {chksgn(tp)} then begin { signed }

         emitbyt($0f); { movsxb eax,[eax] }
         emitbyt($be);
         emitbyt($00+sreg(ip^.rsreg)*8+sreg(ip^.left^.rsreg))

      end else begin { unsigned }

         emitbyt($0f); { movzxb eax,[eax] }
         emitbyt($b6);
         emitbyt($00+sreg(ip^.rsreg)*8+sreg(ip^.left^.rsreg))

      end

   end else error(einvfmt); { invalid format }

end;   

{*******************************************************************************

Generate divide integer

Generates an integer divide. If the divisor is constant, and is a single bit,
Then a shift can be done. Otherwise a simple register divide is done.
The register allocation level must give eax and edx for this operation. The
remainder in edx is discarded.
Divides have a fixed error mode, a trap to int 0.

*******************************************************************************}

procedure gendiv(ip: intptr); { node to process }

var shft: integer; { shift count }
    i:    integer;

begin

   gennod(ip^.left); { generate dividend }
   if ip^.right^.i = ilimint then begin { divide immediate }

      i := consti(ip^.right^.base); { get the constant }
      { 0 and 1 are eliminated in the above pass. Now we take all of the powers
        of 2 out. Find simple power. }
      shft := pow2(i); { find power }
      if shft <> 0 then begin { shift value found, perform it }

         emitbyt($c0); { sar rl,imm8 }
         emitbyt($c0+$07*8+sreg(ip^.rsreg));
         emitbyt(shft)

      end else begin { not found }
      
         { do register divide }
         gennod(ip^.right); { generate right }
         emitbyt($f7); { idiv eax,rr }
         emitbyt($c0+$07*8+sreg(ip^.left^.rsreg))

      end

   end

end;

{*******************************************************************************

Generate modulo integer

Generates the modulo of integer. If the divisor is constant, and is a single
bit, then the mod can be accomplished by "anding" with a mask of all the bits
under it. Otherwise a simple register divide is done.
The register allocation level must give eax and edx for this operation. The
quotient in eax is discarded.
Divides have a fixed error mode, a trap to int 0.

*******************************************************************************}

procedure genmod(ip: intptr); { node to process }

var shft: integer; { shift count }
    mask: integer;
    i:    integer;

begin

   gennod(ip^.left); { generate dividend }
   if ip^.right^.i = ilimint then begin { divide immediate }

      i := consti(ip^.right^.base); { get the constant }
      { 0 and 1 are eliminated in the above pass. Now we take all of the powers
        of 2 out. Check simple power. }
      shft := pow2(i); { find power }
      if shft <> 0 then begin { shift value found, perform it }

         { now find the mask by shifting up bits until not less than }
         mask := 1; { place starting mask }
         while mask < i do mask := mask*2+1; { shift up }
         mask := mask div 2; { back one to be under bit }
         gendoii($20, ip, mask, true) { generate "and" }

      end else begin { not found }
      
         { do register divide }
         gennod(ip^.right); { generate right }
         emitbyt($f7); { idiv eax,rr }
         emitbyt($c0+$07*8+sreg(ip^.left^.rsreg))

      end

   end

end;

{*******************************************************************************

Generate routine call

Built in routines are almost identical to "transient" routines at this level.
The registers are allocated above us, and no real work is required here.
We generate subtrees for all the leaves below us, then perform the routine
call.

*******************************************************************************}

{ ???? }

{ *** don't we also have to make sure parameters are not paged out ??? }

procedure genrot(ip: intptr; { node to generate }
                 tp: typptr); { routine to reference }

begin

   { generate all the leaves in order }
   if ip^.left <> nil then gennod(ip^.left);
   if ip^.right <> nil then gennod(ip^.right);
   if ip^.xtra <> nil then gennod(ip^.xtra);
   if ip^.xtra2 <> nil then gennod(ip^.xtra2);
   { generate routine call }
   emitbyt($e8); { call ps_routine }
   emitadr(tp, itradr); { output routine address }
   tp^.rotr := true { set referenced }

end;

{*******************************************************************************

Generate routine call with extra constant

Generates a routine with a left and right parameter, and an extra constant
that is loaded into a special register reserved in the right hand rregx.
This is done for several routines that need to convert or add to the right
hand operand before the call.

*******************************************************************************}

procedure genroti(ip: intptr;   { node to generate }
                  tp: typptr;   { routine to reference }
                  i:  integer); { constant to load }

begin

   gennod(ip^.left); { generate left }
   gennod(ip^.right); { generate right }
   { load constant to rregx }
   emitbyt($c7); { mov r,imm32 }
   emitbyt($c0+$00*8+sreg(ip^.right^.rsregx));
   emitint(i);
   { call routine }
   emitbyt($e8); { call routine }
   emitadr(tp, itradr); { output routine address }
   tp^.rotr := true { set referenced }

end;

{*******************************************************************************

Generate routine call with extra constant and stacked right

As genroti, but the right parameter is special. It has to be converted to 
an address. The most efficient instruction sequence for this is to push it
onto the stack, address that, then pop it (discard it) after completion.
We can also optimize this by looking in to the right branch and checking for
an ilodimm, ilimint, or iindopr. All of these can be bypassed to get an
address.

*******************************************************************************}

procedure genrotis(ip: intptr;   { node to generate }
                   tp: typptr;   { routine to reference }
                   i:  integer); { constant to load }

var x:     integer; { holding for constant }
    popit: boolean; { pop/don't pop the result }

begin

   popit := true; { set to pop the operand }
   gennod(ip^.left); { generate left }
   { check right is an integer immediate load }
   if ip^.right^.i = ilimint then begin

      x := consti(ip^.right^.base); { get the constant }
      if sbyte(x) or ubyte(x) then begin { use short format }

         emitbyt($6a); { push imm8 }
         emitbyt(x)

      end else begin { use long format }

         emitbyt($68); { push imm32 }
         emitint(x)

      end

   end else if ip^.right^.i in [ildiint, ildirel, ildisrl, ildiset, ildichr,
                                ildibol, ildisrc, ildiptr, ilditgp] then begin

      { indirect load, we can just get rid of this and load the address under
        it }
      gennod(ip^.right^.left); { generate address load }
      popit := false { and suppress the dispose }
     
   end else begin

      gennod(ip^.right); { generate right }
      { place on stack }
      emitbyt($50+sreg(ip^.right^.rsreg)); { push r }

   end;
   { address that }
   emitbyt($8b); { mov r,esp }
   emitbyt($c0+sreg(ip^.right^.rsreg)*8+$04);
   { load constant to rregx }
   emitbyt($c7); { mov r,imm32 }
   emitbyt($c0+$00*8+sreg(ip^.right^.rsregx));
   emitint(i);
   { call routine }
   emitbyt($e8); { call routine }
   emitadr(tp, itradr); { output routine address }
   tp^.rotr := true; { set referenced }
   { remove operand from stack }
   if popit then emitbyt($58+sreg(ip^.right^.rsreg)) { pop r }

end;

{*******************************************************************************

Load direct to temp

This processes special direct loads that will go to multibyte temps, which only
include nonregisterable sets and structures as created by ilod instructions.
Such an entry must contain both the object type and register, and a temp type
and register. We do this by packing rreg and base for the object, and base2 and
rregx for the temp. To make this easier, we unpack the entry into a temporary
intermediate node, which is disposed of at the end of the routine.
The question then, is, since these ilods are created during optimization from
iind/ilda combinations, why not just leave them alone if not registerable ?
The answer is that it is better left to the coding end to decide that.

*******************************************************************************}

procedure genltp(ip: intptr); { node to load }

var tip: intptr; { temporary intermediate entry }

begin

   { The register allocation pass has given us esi, edi, and ecx for
     the move. The temp is in rregx and base2, which makes processing it
     very difficult. We move it to a temporary int structure.  }
   getint(tip, ihalt); { get a temporary holder (type not important) }
   tip^.base := ip^.base2; { copy temp side parameters }
   tip^.rsreg := ip^.rsregx;
   genlad(ip); { resolve operand to esi }
   genlad(tip); { load address of temp to edi }
   emitbyt($c7); { mov ecx,size/4 }
   emitbyt($c1);
   emitint(wrdsiz(ip^.base^.size) div 4);
   { move into place, but retain the base address in edi }
   emitbyt($57); { push edi }
   emitbyt($f3); { rep }
   emitbyt($a5); { movsd }
   emitbyt($5f); { pop edi }
   putint(tip) { return temp int to free }

end;

{*******************************************************************************

Align register sets

Aligns the given register node set to meet the "base" of another set.
The set must be registerable, and loaded into the register. If the sets are
disjoint, it is cleared. Note this is the stupid way to do this, and such
operations should be optimized out.

*******************************************************************************}

procedure alnbas(op: intptr;  { operand to adjust }
                 bp: intptr); { base to adjust to }

var ob: integer; { object base }
    tb: integer; { target base }

begin

   ob := lbound(op^.base) div 8*8; { find the operand base }
   tb := lbound(bp^.base) div 8*8; { find the target base }
   { Use shift right or left as required. We only shift in bytes. }
   if tb < ob then begin

      if ob-tb >= bits then begin { clear result }

         emitbyt($33); { xor r,r }
{ ????? }
         {emitbyt($c0+sreg(ip^.rsreg)*8+sreg(ip^.rsreg))}

      end else begin { shift }

         emitbyt($c1); { ror }
         emitbyt($c0+$01*8+sreg(op^.rsreg));
         emitbyt(ob-tb)

      end

   end else if tb > ob then begin

      if tb-ob >= bits then begin { clear result }

         emitbyt($33); { xor r,r }
{ ????? }
         { emitbyt($c0+sreg(ip^.rsreg)*8+sreg(ip^.rsreg)) }

      end else begin

         emitbyt($c1); { rol r,offset }
         emitbyt($c0+$00*8+sreg(op^.rsreg));
         emitbyt(tb-ob)

      end;

   end

end;

{*******************************************************************************

Offset pickup sets

Processing two sets together in an operation is usually simplfied by
considering cases where both are in a register, or none are in a register. If
the operands are mixed, then the non-registered one is loaded from somewhere
within the in memory set to match the register. We must come up with a register
to match the target register, ie, the same base. If the register set is
contained within the set, that is "offset loaded". If instead the set is
partially off the end of the set, the nearest whole part of the set is loaded,
then shifted to match the target. If a registerable set is passed, then it is
simply aligned, making this routine a "universal prepare".
The target set must be a registerable set.
If the set is disjoint with the base, we load a zero, which is accurate for
"what the bits off the end would be".

*******************************************************************************}

procedure offpkp(ip: intptr;  { operand to process }
                 bp: intptr); { base to adjust to }

var olb, oub: integer; { object bounds }
    blb, bub: integer; { result bounds }
    off:      integer; { net offset to load }

begin

   olb := lbound(ip^.base) div 8*8; { find the operand lower bound }
   blb := lbound(bp^.base) div 8*8; { find the base lower bound }
   oub := ubound(ip^.base) div 8*8; { find the operand upper bound }
   if ubound(ip^.base) div 8*8 <> 0 then oub := oub+1;
   bub := ubound(bp^.base) div 8*8; { find the base upper bound }
   if ubound(bp^.base) div 8*8 <> 0 then bub := bub+1;
   if (oub < blb) or (olb > bub) then begin { clear set }

      emitbyt($33); { xor r,r }
      emitbyt($c0+sreg(ip^.rsreg)*8+sreg(ip^.rsreg))

   end else if ip^.base^.size <= 4 then begin

      { operand set fits in a register, just load and align }
      gennod(ip); { get the operand }
      alnbas(ip, bp) { align operand with result }

   end else begin { operand is in mem }

      if olb < blb then off := olb { off low end, set low end }
      else if oub > bub then off := oub-regsiz { off high end, set high end }
      else off := olb; { just load at base }
      if ip^.i = ilodset then genlodso(ip, regsiz, off) { direct set load }
      else begin { load within operand }

         gennod(ip); { process operand (becomes address) }
         if sbyte(off) then begin { use byte offset }

            emitbyt($8b); { mov r,off[r] }
            emitbyt($80+sreg(ip^.rsreg)*8+sreg(ip^.rsreg));
            emitint(off)

         end else begin

            emitbyt($8b); { mov r,off[r] }
            emitbyt($40+sreg(ip^.rsreg)*8+sreg(ip^.rsreg));
            emitbyt(off)

         end

      end

   end

end;

{*******************************************************************************

Generate set operation

Generates the intersection, union, or difference of sets. Sets can be
registerable or not, and can be any size but 3 bytes (because that is rounded
to dword). They can also be aligned in any way possible. The case where the
sets have no intersecting elements should have been optimized out. Otherwise,
we have to set both a byte and bit offset.
Expects a temp for length > 4 sets, whose type is in the base of the node.
This temp will by definition be the same type as the left hand operand. Temps
must be "conserved", that is, we must assume the left entry could be reading
and writing from the same temp.
All set entries must carry base type, and that is "normalized" or allways a
tset.
A important matter is the result type. This could be the size of a set that
can contain both sets (required if a union is to be found), or it could be
a byte aligned set to reduce offsets, or most likely, it is the size of the
eventual result. rregrdless, we use this as a guide for how to perform it.
Note that cases where one or more operands are completely out of range of the
result should have been optimized out. If passed here, they will generate
nop code.

*******************************************************************************}

procedure gensop(ip: intptr); { node to process }

var rip, lip, tip: intptr; { node pointers }
    llb:           integer; { lower bound, left operand }
    rlb:           integer; { lower bound, right operand }
    dlb:           integer; { lower bound, destination }
    lub:           integer; { upper bound, left operand }
    rub:           integer; { upper bound, right operand }
    dub:           integer; { upper bound, destination }
    minb, maxb:    integer; { minimum/maximum bound }
    dwl:           integer; { double word length }
    mode:          byte;    { mod byte }

{ find "bytes in common" or size of overlapping set range in bytes }

function bytcom(lip, rip: intptr) { operands to find in common }
               : integer;         { number of bytes in common }

var ll, rl: integer; { left and right lower bound, to byte }
    lu, ru: integer; { left and right upper bound, to byte }
    nl, nu: integer; { net overlapping bounds, to byte }

begin

   ll := lbound(lip^.base) div 8*8; { find lower bounds }
   rl := lbound(rip^.base) div 8*8;
   lu := ubound(lip^.base) div 8*8; { find upper bounds }
   if ubound(lip^.base) mod 8 <> 0 then lu := lu+1; { round up }
   ru := ubound(rip^.base) div 8*8;
   if ubound(rip^.base) mod 8 <> 0 then ru := ru+1;
   nl := ll; { find maximum lower }
   if ll < rl then nl := rl;
   nu := lu; { find minimum upper }
   if lu > ru then nu := ru;
   bytcom := nu-nl+1 { return byte count }

end;

begin

   { check both are normalized }
   if (ip^.left^.base^.t <> tset) or (ip^.right^.base^.t <> tset) then
      error(esysflt105); { bad types }
   { load all the bounds for convienence }
   llb := lbound(ip^.left^.base) div 8*8; { get the lower bound left }
   rlb := lbound(ip^.right^.base) div 8*8; { get the lower bound right }
   dlb := lbound(ip^.base) div 8*8; { get the lower bound result }
   lub := ubound(ip^.left^.base) div 8*8; { get the upper bound left }
   if ubound(ip^.left^.base) mod 8 <> 0 then lub := lub+1; { round up }
   rub := ubound(ip^.right^.base) div 8*8; { get the upper bound right }
   if ubound(ip^.right^.base) mod 8 <> 0 then rub := rub+1; { round up }
   dub := ubound(ip^.base) div 8*8; { get the upper bound result }
   if ubound(ip^.base) mod 8 <> 0 then dub := dub+1; { round up }
   if ip^.base^.size <= 4 then begin { result fits in register }

{ ???? }
      if (llb = rlb) {and (ip^.left^.size <= 4) and (ip^.right^.size <= 4)} then
         begin

         { Bases are equal, and in registers, we can use normal ops for this.
           If the operands are aligned with each other and registerable, we can
           perform the operation, then align. This is more code efficient
           because we only perform alignment once. }
         if ip^.i = iintset then
{ ???? }
            {gendoi(ip, $20)} { perform "and" for intersection }
         else if ip^.i = iuniset then
{ ???? }
            { gendoi(ip, $08) } { perform "or" for union }
         else begin { set difference }

            { generate "xor" and "and" for difference }
{ ???? }
            { gendoi(ip, $30); } { generate "xor" }
            emitbyt($23); { and rl,rr }
            emitbyt($c0+sreg(ip^.left^.rsreg)*8+sreg(ip^.right^.rsreg))

         end;
         alnbas(ip^.left, ip) { align to result }

      end else begin { alignment required }

         { The operands aren't aligned with each other, so it makes sense to
           align them both to the result, then perform the operation. }
         offpkp(ip^.left, ip); { pick up left }
         offpkp(ip^.right, ip); { pick up right }
         { Now they are aligned, perform operand in register }
         if ip^.i = iintset then begin
  
            { perform "and" for intersection }
            emitbyt($23); { and rl,rr }
            emitbyt($c0+sreg(ip^.left^.rsreg)*8+sreg(ip^.right^.rsreg))

         end else if ip^.i = iuniset then begin

            { perform "or" for union }
            emitbyt($0b); { or rl,rr }
            emitbyt($c0+sreg(ip^.left^.rsreg)*8+sreg(ip^.right^.rsreg))

         end else begin { set difference }

            { generate "xor" and "and" for difference }
            emitbyt($33); { xor rl,rr }
            emitbyt($c0+sreg(ip^.left^.rsreg)*8+sreg(ip^.right^.rsreg));
            emitbyt($23); { and rl,rr }
            emitbyt($c0+sreg(ip^.left^.rsreg)*8+sreg(ip^.right^.rsreg))

         end

      end

   end else if (ip^.left^.base^.size > 4) and
               (ip^.right^.base^.size > 4) then begin { all in memory }

      { For the result in memory, we perform a three address operation with
        length N. There are 5 phases to this operation, some of which could
        be null:

           1. Fill result with zero.
           2. Copy part or all of an operand in place.
           3. Combine both operands with indicated operation, placing
              result.
           4. Copy part or all of an operand in place.

        Because copies are involved, esi, edi, eax and ecx are reserved for
        this sequence. edi contains the result, esi, eax, and ecx are reserved
        but unoccupied.

      }
      genlad(ip); { load temp result address to edi }
      gennod(ip^.left); { load operand addresses }
      gennod(ip^.right);
      minb := llb; { find minimum operand bound }
      if llb > rlb then minb := rlb;
      maxb := lub; { find maximum operand bound }
      if lub < rub then maxb := rub;
      { Here we find if all parts of the result are matched by some part of
        either operand. If not, we clear the entire result set, so that
        unoccupied parts of the result are correct. }
      if (minb <> dlb) or (maxb <> dub) then begin { clear result }

         { the result is in edi }
         emitbyt($c7); { mov ecx,size }
         emitbyt($c1);
         emitint(ip^.base^.size);
         emitbyt($33); { xor eax,eax }
         emitbyt($c0+sreg(rgeax)*8+sreg(rgeax));
         emitbyt($57); { push edi }
         emitbyt($f3); { rep }
         emitbyt($aa); { stosb }
         emitbyt($5f) { pop edi }

      end;
      { perform preamble partial operand }
      if llb <> rlb then begin { transfer partial operand into place }

         if llb < rlb then begin { do left }

            emitbyt($8b); { mov esi,rl }
            emitbyt($c0+sreg(rgesi)*8+sreg(ip^.left^.rsreg));
            emitbyt($c7); { mov ecx,size }
            emitbyt($c1);
            emitint(rlb-llb+1);
            emitbyt($f3); { rep }
            emitbyt($a4); { movsb }
            emitbyt($8b); { mov rl,esi }
            { copy back to use as base }
            if lub >= rlb then { sets overlap, there is more to do }
               emitbyt($c0+sreg(ip^.left^.rsreg)*8+sreg(rgesi))

         end else begin
            
            emitbyt($8b); { mov esi,rr }
            emitbyt($c0+sreg(rgesi)*8+sreg(ip^.right^.rsreg));
            emitbyt($c7); { mov ecx,size }
            emitbyt($c1);
            emitint(rlb-llb+1);
            emitbyt($f3); { rep }
            emitbyt($a4); { movsb }
            emitbyt($8b); { mov rl,esi }
            { copy back to use as base }
            if rub >= llb then { sets overlap, there is more to do }
               emitbyt($c0+sreg(ip^.right^.rsreg)*8+sreg(rgesi)) { mov rl,esi }

         end

      end;
      { check there is any overlap }
      if (lub < rlb) or (rub < llb) then begin { overlap }

         { perform specified set operation on overlap }
         emitbyt($c7); { mov ecx,size }
         emitbyt($c1);
         emitint(maxb-minb+1);
         { Get left side. This is the top of the loop. }
         emitbyt($8a); { mov al,[rl] }
         emitbyt($00+sreg(rgeax)*8+sreg(ip^.left^.rsreg));
         { perform set operation }
         if ip^.i = iintset then begin
  
            { perform "and" for intersection }
            emitbyt($22); { and al,[rr] }
            emitbyt($00+sreg(rgeax)*8+sreg(ip^.right^.rsreg))

         end else if ip^.i = iuniset then begin

            { perform "or" for union }
            emitbyt($0a); { or al,[rr] }
            emitbyt($00+sreg(rgeax)*8+sreg(ip^.right^.rsreg))

         end else begin { set difference }

            { generate "xor" and "and" for difference }
            emitbyt($32); { xor al,[rr] }
            emitbyt($00+sreg(rgeax)*8+sreg(ip^.right^.rsreg));
            emitbyt($22); { and al,[rr] }
            emitbyt($00+sreg(rgeax)*8+sreg(ip^.right^.rsreg))

         end;
         { place result }
         emitbyt($88); { mov [rd],al }
         emitbyt($00+sreg(rgeax)*8+sreg(ip^.rsreg));
         { increment all pointers }
         emitbyt($40+sreg(ip^.left^.rsreg)); { inc rl }
         emitbyt($40+sreg(ip^.right^.rsreg)); { inc rr }
         emitbyt($40+sreg(ip^.rsreg)); { inc rd }
         { loop repeat }
         emitbyt($e2); { loop back }
         { place length back to start }
         if ip^.i = idifset then emitbyt(-13)
         else emitbyt(-11)

      end;
      { perform postamble partial operand }
      if lub <> rub then begin { transfer partial operand into place }

         if lub > rub then begin { do left }

            emitbyt($8b); { mov esi,rl }
            emitbyt($c0+sreg(rgesi)*8+sreg(ip^.left^.rsreg));
            emitbyt($c7); { mov ecx,size }
            emitbyt($c1);
            emitint(lub-rub+1);
            emitbyt($f3); { rep }
            emitbyt($a4); { movsb }
            emitbyt($8b) { mov rl,esi }

         end else begin
            
            emitbyt($8b); { mov esi,rr }
            emitbyt($c0+sreg(rgesi)*8+sreg(ip^.right^.rsreg));
            emitbyt($c7); { mov ecx,size }
            emitbyt($c1);
            emitint(rub-lub+1);
            emitbyt($f3); { rep }
            emitbyt($a4); { movsb }
            emitbyt($8b) { mov rl,esi }

         end

      end;

   end else begin

      { one or both of the operands in register, and the result in memory.
        For this, we just clear the result, transfer the left into it, then
        perform the operation to the right wherever it is. }
      genlad(ip); { load temp result address to edi }
      gennod(ip^.left); { load operand addresses }
      gennod(ip^.right);
      { the result is in edi }
      emitbyt($c7); { mov ecx,size }
      emitbyt($c1);
      emitint(ip^.base^.size);
      emitbyt($33); { xor eax,eax }
      emitbyt($c0+sreg(rgeax)*8+sreg(rgeax));
      emitbyt($57); { push edi }
      emitbyt($f3); { rep }
      emitbyt($aa); { stosb }
      emitbyt($5f); { pop edi }
      { process left }
      if (lub >= dlb) and (llb <= dub) then begin

         { left is in range }
         if ip^.left^.base^.size <= 4 then begin { left in register }

            { if we are within range, the remaining cases are:

                 1. Totally contained in the result.
                 2. Off the low end of the result.
                 3. Off the top end of the result.

              Case 1 is done by offsets. Cases 2 and 3 are done by placing the
              register operand at either end of the result, but shifting it so
              that it contains only the bits in common with the result. }
            if llb < dlb then begin { shift right to fit result }

               emitbyt($c1); { sar }
               emitbyt($c0+$07*8+sreg(ip^.rsreg));
               emitbyt(dlb-llb);
               mode := $00 { use no offset }

            end else if (lub > dub) then begin { shift left to fit result }

               emitbyt($c1); { sal r,offset }
               emitbyt($c0+$04*8+sreg(ip^.rsreg));
               emitbyt(lub-dub);
               mode := $00 { use no offset }

            end else if dlb = llb then mode := $00 { use no offset }
            else if sbyte(llb-dlb) then mode := $40 { use byte offset }
            else mode := $80; { use dword offset }
            emitbyt($89); { mov off8[edi],rl }
            emitbyt(mode+sreg(ip^.left^.rsreg)*8+sreg(ip^.rsreg));
            if mode = $40 then emitbyt(llb-dlb) { byte offset }
            else emitint(llb-dlb)

         end else begin { left in memory }

            emitbyt($57); { push edi }
            { offset whichever operand is lower in base }
            if llb > dlb then
               gendoii($00, ip, llb-dlb, false) { offset result pointer }
            else if dlb > llb then
               gendoii($00, ip^.left, dlb-llb, false); { offset result pointer }
            emitbyt($8b); { mov esi,rl }
            emitbyt($c0+sreg(rgesi)*8+sreg(ip^.left^.rsreg));
            emitbyt($c7); { mov ecx,size }
            emitbyt($c1);
            emitint(bytcom(ip, ip^.left)); { move bytes in common }
            emitbyt($f3); { rep }
            emitbyt($a4); { movsb }
            emitbyt($8b); { mov rl,esi }
            emitbyt($5f) { pop edi }
         
         end

      end;
      { process right }
      if (rub >= dlb) and (rlb <= dub) then begin

         { right is in range }
         if ip^.right^.base^.size <= 4 then begin { right in register }

            if rlb < dlb then begin { shift right to fit result }

               emitbyt($c1); { sar }
               emitbyt($c0+$07*8+sreg(ip^.rsreg));
               emitbyt(dlb-rlb);
               mode := $00 { use no offset }

            end;
            if rub > dub then begin { shift left to fit result }

               emitbyt($c1); { sal r,offset }
               emitbyt($c0+$04*8+sreg(ip^.rsreg));
               emitbyt(rub-dub);
               mode := $00 { use no offset }

            end else if dlb = rlb then mode := $00 { use no offset }
            else if sbyte(rlb-dlb) then mode := $40 { use byte offset }
            else mode := $80; { use dword offset }
            if ip^.i = iintset then emitbyt($21) { and [edi],rr }
            else if ip^.i = iuniset then emitbyt($09) { or [edi].rr }
            else begin { set difference }

               { generate "xor" and "and" for difference }
               emitbyt($32); { xor [edi],rr }
               emitbyt(mode+sreg(ip^.right^.rsreg)*8+sreg(ip^.rsreg));
               if mode = $40 then emitbyt(rlb-dlb) { byte offset }
               else emitint(rlb-dlb);
               emitbyt($21); { and [edi],rr }

            end;
            emitbyt(mode+sreg(ip^.right^.rsreg)*8+sreg(ip^.rsreg));
            if mode = $40 then emitbyt(rlb-dlb) { byte offset }
            else emitint(rlb-dlb)

         end else begin { right in memory }

            { offset whichever operand is lower in base }
            if rlb > dlb then
               gendoii($00, ip, rlb-dlb, false) { offset result pointer }
            else if dlb > rlb then
               gendoii($00, ip^.right, dlb-llb, false); { offset result pointer }
            emitbyt($8b); { mov esi,rl }
            emitbyt($c0+sreg(rgesi)*8+sreg(ip^.right^.rsreg));
            emitbyt($c7); { mov ecx,size }
            emitbyt($c1);
            emitint(bytcom(ip, ip^.right)); { move bytes in common }
            { this is the top of the loop }
            emitbyt($8a); { mov al,[rr] }
            emitbyt($c0+sreg(rgeax)*8+sreg(ip^.right^.rsreg));
            if ip^.i = iintset then emitbyt($20) { and [edi],al }
            else if ip^.i = iuniset then emitbyt($08) { or [edi].al }
            else begin { set difference }

               { generate "xor" and "and" for difference }
               emitbyt($30); { xor [edi],al }
               emitbyt($00+sreg(rgeax)*8+sreg(ip^.rsreg));
               emitbyt($20); { and [edi],al }

            end;
            emitbyt($00+sreg(rgeax)*8+sreg(ip^.rsreg));
            { increment pointers }
            emitbyt($40+sreg(ip^.right^.rsreg)); { inc rr }
            emitbyt($40+sreg(ip^.rsreg)); { inc rd }
            { loop repeat }
            emitbyt($e2); { loop back }
            { place length back to start }
            if ip^.i = idifset then emitbyt(-10)
            else emitbyt(-8)
         
         end

      end      
   
   end   

end;

{*******************************************************************************

Generate set inclusion/equals

Generates a check for the left set included in the right set, which is also
reversed and used to check right included in left, or set equals.
Sets can be registerable, and we must handle differing length sets, sets where
one set is in a register and one not, and sets where there are non overlapping
ranges. For registerable sets, these are simply checked equal. For memory sets,
the same is done across multiple bytes. For non-overlapping sets, the "white
space" around the overlapping set portions must be verified to be zero.
The exit status is zero flag set for equal, otherwise not set.

*******************************************************************************}

procedure geneqinst(ip:  intptr;  { result node }
                    lip: intptr;  { left side }
                    rip: intptr); { right side }

var llb, rlb, lub, rub: integer; { byte bounds for sets }
    olb, oub:           integer; { overlapping bounds }
    lab1, lab2:         typptr; { jump labels }

{ check section for zero }

procedure zerchk(ip:  intptr;   { pointer to section }
                 len: integer); { length to check for }

var loplab: typptr; { loop label }

begin

   emitbyt($33); { xor eax,eax }
   emitbyt($c0+sreg(rgeax)*8+sreg(rgeax));
   emitbyt($c7); { mov ecx,len }
   emitbyt($c1);
   emitint(len);
   gettypa(loplab, tlab); { get loop label }
   loplab^.addr := pgmcnt; { equate }
   emitbyt($0a); { or al,[r] }
   emitbyt($40+sreg(ip^.rsreg)); { inc r }
   emitbyt($00+sreg(rgeax)*8+sreg(ip^.rsreg));
   emitbyt($e2); { loop back }
   emitadr(loplab, itbradr) { generate address }

end;

{ align sets with zero check }

procedure alnbasz(op: intptr;   { operand to adjust }
                  bp: intptr;   { base to adjust to }
                  lab: typptr); { jump over label }

var ob:  integer; { object base }
    tb:  integer; { target base }
    mk:  integer; { mask value }
    cnt: integer; { mask count }

begin

   ob := lbound(op^.base) div 8*8; { find the operand base }
   tb := lbound(bp^.base) div 8*8; { find the target base }
   { Use shift right or left as required. We only shift in bytes. }
   if tb < ob then begin

      if ob-tb >= bits then begin { clear result }

         emitbyt($0b); { or r,r }
         emitbyt($c0+sreg(ip^.rsreg)*8+sreg(ip^.rsreg));
         emitbyt($75); { jnz over }
         emitadr(lab, itbradr); { generate address }
         emitbyt($33); { xor r,r }
         emitbyt($c0+sreg(ip^.rsreg)*8+sreg(ip^.rsreg))

      end else begin { shift }

         { form zero check mask }
         mk := 1;
         cnt := ob-tb;
         while cnt <> 0 do begin mk := mk*2+1; cnt := cnt+1 end;
         emitbyt($f7); { test r,mask }
         emitbyt($c0+$00*8+sreg(op^.rsreg));
         emitint(mk);
         emitbyt($75); { jnz over }
         { perform alignment }
         emitadr(lab, itbradr); { generate address }
         emitbyt($c1); { ror }
         emitbyt($c0+$01*8+sreg(op^.rsreg));
         emitbyt(ob-tb)

      end

   end else if tb > ob then begin

      if tb-ob >= bits then begin { clear result }

         emitbyt($0b); { or r,r }
         emitbyt($c0+sreg(ip^.rsreg)*8+sreg(ip^.rsreg));
         emitbyt($75); { jnz over }
         emitadr(lab, itbradr); { generate address }
         emitbyt($33); { xor r,r }
         emitbyt($c0+sreg(ip^.rsreg)*8+sreg(ip^.rsreg))

      end else begin

         { form zero check mask }
         mk := -1;
         cnt := bits-(tb-ob);
         while cnt <> 0 do begin mk := mk*2+1; cnt := cnt+1 end;
         emitbyt($f7); { test r,mask }
         emitbyt($c0+$00*8+sreg(op^.rsreg));
         emitint(mk);
         emitbyt($75); { jnz over }
         { perform alignment }
         emitbyt($c1); { rol r,offset }
         emitbyt($c0+$00*8+sreg(op^.rsreg));
         emitbyt(tb-ob)

      end;

   end

end;

{ offset pickup with zero check }

procedure offpkpz(ip:  intptr;  { operand to process }
                  bp:  intptr;  { base to adjust to }
                  lab: typptr); { zero check label }

var olb, oub: integer; { object bounds }
    blb, bub: integer; { result bounds }
    off:      integer; { net offset to load }

begin

   olb := lbound(ip^.base) div 8*8; { find the operand lower bound }
   blb := lbound(bp^.base) div 8*8; { find the base lower bound }
   oub := ubound(ip^.base) div 8*8; { find the operand upper bound }
   if ubound(ip^.base) div 8*8 <> 0 then oub := oub+1;
   bub := ubound(bp^.base) div 8*8; { find the base upper bound }
   if ubound(bp^.base) div 8*8 <> 0 then bub := bub+1;
   if (oub < blb) or (olb > bub) then begin { clear set }

      emitbyt($33); { xor r,r }
      emitbyt($c0+sreg(ip^.rsreg)*8+sreg(ip^.rsreg))

   end else if ip^.base^.size <= regsiz then begin

      { operand set fits in a register, just load and align }
      gennod(ip); { get the operand }
      alnbasz(ip, bp, lab) { align operand with result }

   end else begin { operand is in mem }

      if olb < blb then off := olb { off low end, set low end }
      else if oub > bub then off := oub-regsiz { off high end, set high end }
      else off := olb; { just load at base }
      gennod(ip); { process operand (becomes address) }
      if off > 0 then begin

         zerchk(ip, off); { check 1st section for zero }
         emitbyt($75); { jnz over }
         emitadr(lab, itbradr) { generate address }

      end;
      emitbyt($8b); { mov r,off[r] }
      emitbyt($00+sreg(ip^.rsreg)*8+sreg(ip^.rsreg));
      if oub-olb+1-(off+4) > 0 then begin

         emitbyt($83); { add r,4 }
         emitbyt($c0+$00*8+sreg(ip^.rsreg));
         emitbyt(4);
         zerchk(ip, oub-olb+1-(off+4));
         emitbyt($75); { jnz over }
         emitadr(lab, itbradr) { generate address }

      end

   end

end;

begin

   { load all the bounds for convienence }
   llb := lbound(lip^.base) div 8*8; { get the lower bound left }
   rlb := lbound(rip^.base) div 8*8; { get the lower bound right }
   lub := ubound(lip^.base) div 8*8; { get the upper bound left }
   if ubound(lip^.base) mod 8 <> 0 then lub := lub+1; { round up }
   rub := ubound(rip^.base) div 8*8; { get the upper bound right }
   if ubound(rip^.base) mod 8 <> 0 then rub := rub+1; { round up }
   olb := llb; { find overlapping bounds }
   if llb < rlb then olb := rlb;
   oub := lub;
   if lub > rub then olb := rub;
{ ????? }
   if true {(lip^.base^.size <= regsiz) and 
      (rip^.base^.size <= regsiz)} then begin

      { operands are both in registers }
      gettypa(lab1, tlab); { get a jump over label }
      gennod(lip); { generate trees }
      gennod(rip);
      alnbasz(lip, rip, lab1); { align sets to each other }
      if (ip^.i = iequset) or (ip^.i = ineqset) then begin { equality }

         emitbyt($3b); { cmp rl,rr }
         emitbyt($c0+sreg(lip^.rsreg)*8+sreg(rip^.rsreg))

      end else begin { inclusion }

         { find the bits in both operands, then compare that to the left. If the
           result is zero, the inclusion is true, otherwise not (the bits in
           common are not equal to the left }
         emitbyt($23); { and rr,rl }
         emitbyt($c0+sreg(rip^.rsreg)*8+sreg(lip^.rsreg));
         emitbyt($33); { xor rr,rl }
         emitbyt($c0+sreg(rip^.rsreg)*8+sreg(lip^.rsreg))

      end;
      lab1^.addr := pgmcnt { equate skip label }

{ ?????? }
   end else if true {(lip^.base^.size > regsiz) and
               (rip^.base^.size > regsiz)} then begin

      { Operands are both in memory. For this, we should have one operand
        in esi, and one in edi, but they are associative. eax and ecx are also
        reserved for this. For inclusion, we must also have ebx for
        and operational register. }
      gennod(lip); { generate trees }
      gennod(rip);
      { check operands are disjoint (no bits in common). In this case, both
        sets must simply be nil }
      if (lub < rlb) or (llb > rub) then begin { disjoint }

{ ?????? }
         {zerchk(lip, lip^.size);} { check left zero }
         emitbyt($75); { jnz over }
{ ?????? }
         { emitadr(lab, itbradr);} { generate address }
{ ?????? }
         { zerchk(rip, rip^.size) } { check right zero }
     
      end else begin { standard check }

         gettypa(lab1, tlab); { get a jump over label }
         { check either operand is lapped under, and zero check if so }
         if llb < rlb then begin

{ ?????? }
            {zerchk(lip, lab, rlb-llb+1)} { left laps under right }
            emitbyt($75); { jnz over }
{ ?????? }
            { emitadr(lab1, itbradr) } { generate address }

         end else if (rlb < llb) and
                     ((ip^.i = iequset) or (ip^.i = ineqset)) then begin

{ ?????? }
            { zerchk(rip, lab, llb-rlb+1);}  { right laps under left }
            emitbyt($75); { jnz over }
            emitadr(lab1, itbradr) { generate address }

         end;
         if (ip^.i = iequset) or (ip^.i = ineqset) then begin { equality }

            { check overlapping section equal }
            emitbyt($c7); { mov ecx,len }
            emitbyt($c1);
            emitint(oub-olb+1);
            emitbyt($f3); { rep }
            emitbyt($a6); { cmpsb }

         end else begin { inclusion }

            { perform inclusion on overlapping section }
            emitbyt($c7); { mov ecx,len }
            emitbyt($c1);
            emitint(oub-olb+1);
            { clear accumulator }
            emitbyt($33); { xor eax,eax }
            emitbyt($c0+sreg(rgeax)*8+sreg(rgeax));
            { top of loop }
            gettypa(lab2, tlab); { get loop label }
{ ?????? }
            {loplab^.addr := pgmcnt;} { equate }
            asmovi(rgebx, lip^.rsreg); { mov ebx,[rl] }
            asandi(rgebx, rip^.rsreg); { and ebx,[rr] }
            asxori(rgebx, lip^.rsreg); { xor ebx,[rl] }
            asor(rgeax, rgebx); { or eax,ebx }
            emitbyt($e2); { loop }
            emitadr(lab2, itbradr) { generate address }

         end;
         if lub <> rub then begin { skip end zero check }

            emitbyt($75); { jnz over }
{ ?????? }
            {emitadr(lab, itbradr)} { generate address }
            
         end;
         { check either operand is lapped over, and zero check if so }
         if lub > rub then
{ ?????? }
            {zerchk(lip, lab1, lub-rub+1)} { left laps over right }
         else if (rub > lub) and ((ip^.i = iequset) or (ip^.i = ineqset)) then
{ ?????? }
            {zerchk(rip, lab1, rub-lub+1)}; { right laps over left }
         lab1^.addr := pgmcnt { equate skip label }

      end

   end else begin { one operand in register, one in memory }

      gettypa(lab1, tlab); { get a jump over label }
      offpkpz(lip, rip, lab1); { load left }
      offpkpz(rip, lip, lab1); { load right }
      if (ip^.i = iequset) or (ip^.i = ineqset) then { equality }
         ascmp(lip^.rsreg, rip^.rsreg) { cmp rl,rr }
      else begin { inclusion }

         { find the bits in both operands, then compare that to the left. If the
           result is zero, the inclusion is true, otherwise not (the bits in
           common are not equal to the left }
         asand(rip^.rsreg, lip^.rsreg); { and rr,rl }
         asxor(rip^.rsreg, lip^.rsreg) { xor rr,rl }

      end;
      lab1^.addr := pgmcnt { equate skip label }

   end

end;

{*******************************************************************************

Generate string compare

Compares two strings. A string compare stops after the first mismatching
character, and the sense of the flags is the same as left-right.
One of the operands must be in the esi register, and the other in the edi
register. Typically this is left->esi, right->edi, but the operands can be
reversed if the flags are also understood in reverse.
ecx and the flags are modified.

*******************************************************************************}

procedure gencmps(ip: intptr); { node to process }

begin

   gennod(ip^.left); { generate trees }
   gennod(ip^.right);
   emitbyt($c7); { mov ecx,len }
   emitbyt($c1);
{ ?????? }
   { emitint(ip^.left^.size); }
   emitbyt($f3); { repe }
   emitbyt($a6) { cmpsb }

end;

{*******************************************************************************

Convert boolean to conditional

If the node given is a register, then a convertion to flag is generated for it.
Otherwise, no operation is performed. rreg is changed to flag, and the flag
set to flnz. The flag is allways zero for false, nonzero for true.

*******************************************************************************}

procedure conbol(ip: intptr); { node to process }

begin

   if ip^.rsreg <> rgflg then begin { its in a register }

      emitbyt($a8); { test al,1 }
      emitbyt(1);
      ip^.rsreg := rgflg; { set now a flag }
      ip^.rsflg := flnz

   end

end;

{*******************************************************************************

Convert conditional to boolean

If the node given is a flag, then a convertion to a boolean is generated for
it. Otherwise, no operation is performed. Accepts the node to process, and
the register it is to be placed in.
The rotine accepts a flag to determine if the destination is cleared before the
boolean byte is set. Some applications require the entire register have the
boolean, such as parameter passing, and others, like store, are only going to
use the lower byte of the register.

*******************************************************************************}

procedure conflg(ip:  intptr;   { node to process }
                 r:   regt;     { register to place in }
                 clr: boolean); { clear destination register }

begin

   if ip^.rsreg = rgflg then begin { its a flag, convert it }

      if clr then begin { clear destination register }

         emitbyt($33); { xor r,r }
         emitbyt($c0+sreg(r)*8+sreg(r))

      end;
      { set register to boolean }
      emitbyt($0f); { setcc }
      emitbyt($90+ccode(ip^.rsflg));
      emitbyt($c0+$00*8+sreg(r));
      ip^.rsreg := r { set new register }

   end;

end;

{******************************************************************************

Generate general string compare

Compares two general strings. A string compare stops after the first
mismatching character, and the sense of the flags is the same as left-right.
One of the operands must be in the esi register, and the other in the edi
register. Typically this is left->esi, right->edi, but the operands can be
reversed if the flags are also understood in reverse.
One of the length tags must be in ecx. The lengths are compared for equal, an
error processed if not, then the length in ecx is used to walk the string.

******************************************************************************}

procedure gencmpg(ip: intptr); { node to process }

begin

   gennod(ip^.left); { generate trees }
   gennod(ip^.right);
   emitbyt($3b); { cmp ltr,rtr }
   emitbyt($c0+sreg(ip^.left^.rsregx)*8+sreg(ip^.right^.rsregx));
   genske($74, relenmat); { generate error }
   emitbyt($f3); { repe }
   emitbyt($a6) { cmpsb }

end;

{*******************************************************************************

Make hash table

Expects an unfinished hash table. First, we allocate a construction array of
case values, and an array of links. The links are set to 0 to indicate unfilled
entries (any value is ok for a case selector). Then, all the case values are
hashed and an attempt made to place them in the table. If there is already a
case occupying the slot, it is skipped. Each entry thus occupied has its link
set to -1. These are the "prime" entries, which we place first to avoid having
an entry occupy a slot that could have matched.
Next, the non-prime entries are laid in "chains". If an entry has -1, it means
"terminal" (all primes are terminal). If 0, it means "free". Other numbers
indicate a valid link. The entries are followed until a terminal is reached,
then the first free entry in the table is found and the case placed there, and
the link changed to terminal (-1). This is done until the values run out, which
they will by definition (since the table is the size of the case list).
The resulting table will have chains of case values, starting from the prime,
with -1 link indicating the terminal entry (which could be the prime).
Finally, the case list is saved, and replaced back into the same order as the
constructed hash table, then the links are placed into the list.
Note that although we construct the list with 1..n table format, it is output
adjusted to 0..n, which is more efficient for assembly language.

*******************************************************************************}

procedure makhst(tp: typptr); { hash table head }

var casval: pintarr; { case values array }
    caslnk: pintarr; { link pointers array }
    p:      typptr;  { pointer to case entries }
    len:    integer; { number of cases in table }
    hold:   typptr;  { holding list }
    i:      integer; { index for table }
{ ????? }
h: integer;

{ find first free entry }

function free: integer;

var f: integer; { found free entry }
    i: integer; { index for table }

begin

   f := 0; { clear found }
   for i := 1 to len do if caslnk^[i] = 0 then f := i; { find first free }
   free := i { return that }

end;

{ remove entry from case list }

procedure remove(    v: integer; { case value to remove }
                 var p: typptr); { case entry pointer }

var lp: typptr; { last entry pointer }

begin

   lp := nil; { set no last entry }
   p := tp^.htn; { index top of case list }
   while p^.csv <> v do begin { find matching case }

      lp := p; { set new last }
      p := p^.csn; { link next }
      if p = nil then error(esysflt106) { no match, should not happen }

   end;
   if lp = nil then{ gap head of list }
     tp^.htn := tp^.htn^.csn
   else { gap mid list }
     lp^.csn := p^.csn

end;

begin

   if tp^.t <> thshtbl then error(esysflt107); { should not happen }
   len := tp^.htc; { get the entry count }
   { allocate holding tables }
   new(casval, len);
   new(caslnk, len);
   for i := 1 to len do casval^[i] := 0; { clear case value }
   for i := 1 to len do caslnk^[i] := 0; { set unoccupied }
   { lay prime entries in table }
   p := tp^.htn; { index 1st case }
   while p <> nil do begin { set prime entries }

      h := p^.csv mod len+1; { find hash value }
      if caslnk^[h] = 0 then begin { lay down prime }

         casval^[h] := p^.csv; { place value }
         caslnk^[h] := -1 { set occupied }

      end;
      p := p^.csn { link next case }

   end;
   { lay non-primes }
   p := tp^.htn; { index 1st case }
   while p <> nil do begin { set non-primes }

      h := p^.csv mod len+1; { find hash value }
      { find terminal entry }
