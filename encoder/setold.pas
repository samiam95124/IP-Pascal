      end else if (ip^.left^.i in [iaddint, iorint, iandint, ixorint]) and
                  (match(ip^.left^.left) or match(ip^.left^.right)) then begin

         { associative operator and one side is the destination }

      end else dosto { perform default store }

   end else if ip^.left^.i in [isucint, iprdint] then begin { succ, pred }

      if match(ip^.left^.left) then begin { perform inc/dec }

      end else dosto { perform default store }

   end else if ip^.left^.i = imltint then begin { multiply }

      if ip^.left^.left^.i = ilimint then begin { left is constant }

         { Check /2**N }
         shft := pow2(consti(ip^.left^.right^.base)); { find simple power }
         if shft <> 0 then begin { its a simple shift }

         end else dosto { perform default store }

      end else if ip^.left^.right^.i = ilimint then begin { right is constant }

         { Check /2**N }
         shft := pow2(consti(ip^.left^.right^.base)); { find simple power }
         if shft <> 0 then begin { its a simple shift }

         end else dosto { perform default store }

