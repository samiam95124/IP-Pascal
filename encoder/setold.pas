{*******************************************************************************

Generate procedure/function call

Expects a procedure/function call node. Parameters are laid down in two passes:

1. All the stack occupying parameters are processed, and forced onto the stack
if required (if they are registerable, they must be specifically pushed onto
the stack). The parameters are processed from left to right.

2. The address of the routine is processed, if it is a parameter procedure or
function call.

3. All registerable parameters are processed, from left to right.

4. The registerable parameters are "confirmed" into registers, or poped back
registers if they have been pushed.

This method keeps the stack parameters from paging out any registerable
parameters. Since that leaves registerable parameters pushing each other out,
the register allocator places a push mask at the procedure entry. This mask
tells us what parameters need to be pushed directly after they are formed, and
poped (in right to left order) before the call.
The address of the call, if a procedure/function parameter call, is processed
before the registerable parameters. This is done because if it should be pushed
onto the stack, we can just return to it there instead of bringing it back into
a register. This is required if it is not to tie up a register, but if it does
not get pushed, it can be more efficently executed direct from the register.
Functions are identical to procedures at the call level. They just have a return
result in eax or on the stack, which is used upwards in the tree.
Indirect procedure or function calls start the same as normal calls, but have
an address operand. Usually this is just an address load, but we process it
as a complex for future capabilities.

*******************************************************************************}

procedure genprc(ip: intptr); { procedure entry }

var p: intptr; { parameter traversal pointer }
    r: regt;

begin

   { perform stacking pass }
   p := ip^.left; { index top of parameter list }
   while p <> nil do begin { traverse }

      gennod(p^.left); { generate parameter }
      { if registerable, specifically push to stack }
{ ?????? }
      { if p^.left^.base^.size <= regsiz then emitbyt($50+sreg(p^.left^.rsreg)); }
      p := p^.flow { link next parameter }

   end;
   { perform registerable pass }
   p := ip^.left; { index top of parameter list }
   while p <> nil do begin { traverse }

      gennod(p^.left); { generate parameter }
      { If the parameter ends as a flag, we must convert to proper boolean for
        the pass. The register to move the flag to is in the head entry rreg. }
      conflg(p^.left, p^.rsreg, true); { convert to boolean from flag }
      { if this is on the push list, then we must push before the next parameter
        is processed }
      if p^.rsreg in ip^.push then emitbyt($50+sreg(p^.left^.rsreg));
      p := p^.flow { link next parameter }

   end;
   { now restore all pushed registerable parameters back from stack }
   for r := rgeax to rgedi do if r in ip^.push then emitbyt($58+sreg(r));
   if (ip^.i = iprccali) or (ip^.i = ifnccali) then begin { call indirect }

      { check for load direct }
      if ip^.right^.i = ilodptr then begin

         emitbyt($ff); { call [addr] }
         emitbyt($00+$02*8+$05);
         emitadr(ip^.right^.base, itadr)

      end else begin { generate complex load }

         gennod(ip^.right); { generate procedure/function address }
         emitbyt($ff); { call [r] }
{ ?????? }
         emitbyt($00+$02*8+sreg(ip^.right^.rsreg))

      end

   end else begin { call direct }

      { call procedure }
      emitbyt($e8); { call addr }
      emitadr(ip^.base, itradr) { generate address }

   end
   
end;

{*******************************************************************************

Generate new/dispose

Accepts the operator node. The tag list, if any, is traversed and the complete
type size built. Then the allocate or deallocate is done. Although the tags are
accepted (and checked) on dispose, as the standard requires, they are unused
in IP.
You might note that we recheck the links that were checked at the top level.
Since the consequence of a missed check is space, this pays back for now.

*******************************************************************************}

procedure gennwdp(ip: intptr);

var tp:          typptr; { pointer to type }
    rsiz, rsiz1: integer; { record sizes }
    ip1:         intptr; { intermediate pointer }

begin

   tp := ip^.base; { get variable type }
   if tp^.t <> tptr then error(esysflt110); { must be pointer }
   tp := tp^.ptrt; { link base type }
   rsiz := tp^.size; { set whole size }
   ip1 := ip^.right; { read the next tag }
   if tp^.t = trecord then begin { it's a record, process tagging }

      rsiz1 := tp^.size; { clear tag size }
      tp := tp^.recf; { index field list }
      rsiz := 0; { clear total size }
      while ip1 <> nil do begin { get tags }

         { a more compact form was specified than the whole type,
           so we find the new minimum size by finding
           all the fixed elements, adding that to the total, and
           then finding a new minimum }
         while tp^.t = tfield do begin { add fixed fields }

            rsiz := rsiz+tp^.fldt^.size; { add in size }
            tp := tp^.next; { next entry }
            if tp = nil then error(esysflt111); { invalid format }

         end;
         { now we should be pointing at the tag }
         if tp^.t <> tftag then error(esysflt112); { invalid format }
         if tp^.ftge then { tag field exists }
            rsiz := rsiz+tp^.size; { add in tag size }
         tp := tp^.ftgc; { index case list }
         while tp^.fcsc <> ip^.base^.ival do begin { find matching case }

            tp := tp^.fcsn;
            if tp = nil then error(esysflt113) { invalid format }

         end;
         rsiz1 := tp^.size; { find new minimum }
         tp := tp^.fcsf; { index that case list }
         getcod(ic) { read the next tag }

      end;
      rsiz := rsiz+rsiz1 { add any tag size }

   end;
   if ip1 <> nil then error(esysflt114); { should be terminated }
   if ip^.i = inew then begin

      { Because the actual routine for new accepts a tagged pointer, we have to
        first allocate to a temp, then load the pointer from that. }
      gennod(ip^.left); { generate variable to allocate }
      genlad(ip); { index temp }
      { generate routine call }
      emitbyt($e8); { call ps_routine }
      emitadr(ssgetspace, itradr); { output routine address }
      ssgetspace^.rotr := true; { set referenced }
      genlodso(ip, regsiz, 0); { load address from that }
      asmovir(ip^.left^.rsreg, ip^.rsreg) { store to final }

   end else 
      { Dispose is also a format change to tagged pointer, but its easier
        because we just add the length. }
      genroti(ip, ssputspace, rsiz) { generate dispose call }

end;

{*******************************************************************************

Generate store direct

Generates a store direct to the node, which has the operand at the left and the
variable at base.
Stores are made complex because many operations can also do a store, so we look
into the operand and see if one of the operands is the same as the destination.
If so, and if on the right side of the operator, it is performed with a store
operator. The following operators qualify for this trick:

Operator    Destination match side
==================================
iaddint     Any
isubint     Left
iorint      Any
iandint     Any
ixorint     Any

In addition, several unary special instructions are available:

Operator    Matches
==================================
iaddint     d := d+1
isucint     d := succ(d)
isubint     d := d-1
iprdint     d := pred(d)
imltint     d := d*2**N
idivint     d := d/2**N

*******************************************************************************}

procedure gensto(ip: intptr); { node to generate }

var shft: integer; { shift count }

{ check for match with destination type }

function match(p: intptr): boolean;

var m: boolean; { match variable }

begin

   m := false; { set false }
   if p <> nil then { there is an operand }
      if p^.i = ilodint then { a load direct operator }
         m := p^.base = ip^.base; { check matches }
   match := m { return result }

end;
   
{ perform default store }

procedure dosto;

begin

   gennod(ip^.left); { generate left }
