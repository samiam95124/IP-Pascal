   end else if ip^.left^.i = idivint then begin { divide }

      if ip^.left^.right^.i = ilimint then begin { constant divide }

         { check /2**N }
         shft := pow2(consti(ip^.left^.right^.base)); { find simple power }
         if shft <> 0 then begin { its a simple shift }

