{*******************************************************************************

Generate operand node

Given an intermediate operator, outputs code for that based on registers and
other context information. Decends the expression tree, and accomplishes a full
left hand walk and code output.
This routine is called during the generator intermediate tour for each
expression. The reason we go ahead and decend the tree, is that many of the
optimizations can look down in the tree and fold a branch into the instruction
to be generated, eliminating the need for that branch.

*******************************************************************************}

procedure gennod(ip: intptr);

var i:          integer; { immediate value }
    rm:         byte;    { r/m code }
    tp:         typptr;  { type pointer }
    rg:         regt;    { register }
    lab1, lab2: typptr;  { jump labels }
    ti:         intptr;  { temp intermediate node }
    mode:       integer; { mod code for instructions }

begin

   { perform the push mask }
   for rg := rgeax to rgedi do if rg in ip^.push then
      { this register needs to be saved }
      emitbyt($50+sreg(rg)); { push r }
   case ip^.i of { intermediate type }

      { these intermediates don't generate code }
      ibgnlvl, iendlvl, iusefil, inil, ilab, iicst, iscst, iccst, ircst, istcst,
      istet, iarrcst, iarrcel, ireccst, ireccel, ienum, ienme, isub, iptr,
      iarray, igarry, ifile, iset, irecord, ifield, iftag, ifcas, ivar, ifix,
      iproc, ifunc, ipar, ivpar, iwpar, ipproc, ipfunc, iint, ichar,
      iboolean, ireal, isreal, itext, ieset, iglbl, inull, isym,
      issym, iswptop, ipoptop, ilodfadr: error(esysflt115); { should not occur }
      ibgnpgm: ;
      iendpgm: ;
      ibgnext: ;
      iendext: ;
      ilodadr: genlad(ip); { load address }
      iarrref: genarr(ip); { array reference }
      iarfgar: gengar(ip); { general array reference }   
      irecoff: begin { record offset }

         gennod(ip^.left); { resolve left }
         gendoii($00, ip, ip^.base^.addr, false); { perform offset }

      end;
      ilodint: genlodso(ip, ip^.base^.size, 0); { generate load direct }
      ilodrel, ilimrel: genlodr(ip); { load double real }
      ilodsrl: genlodr(ip); { load short real }
      ilodset: begin { load set direct }

         { For sets larger than regsiz bytes, we have established temps at a
           higher level. The base entry of the node contains the type for 
           <= regsiz, or a temp if > 4 }
         if ip^.base^.size <= regsiz then
            genlodso(ip, ip^.base^.size, 0) { registerable, process load }
         else begin { load to designated temp }

            { The register allocation pass has given us esi, edi, and ecx for
              the move. }
            genlad(ip); { get address in esi }
            { there is a temp at base2, rregx, which is inconvenient to get at.
              So we create an entry for just that. }
            getint(ti, ip^.i);
            ti^.base := ip^.base2; { copy parameters }
            ti^.rsreg := ip^.rsregx;
            genlad(ti); { load address of temp to edi }
            emitbyt($c7); { mov ecx,size/4 }
            emitbyt($c1);
            emitint(wrdsiz(ti^.base^.size) div 4);
            { move into place, but retain the base address in edi }
            emitbyt($57); { push edi }
            emitbyt($f3); { rep }
            emitbyt($a5); { movsd }
            emitbyt($5f); { pop edi }
            putint(ti) { release temp entry }
            
         end

      end;
      ilodchr: genlodso(ip, ip^.base^.size, 0); { generate load direct }
      ilodbol: genlodso(ip, ip^.base^.size, 0); { generate load direct }
      ilodsrc: begin { load structure direct }

         { The register allocation pass has given us esi, edi, and ecx for
           the move  }
         genlad(ip); { get address in esi }
         { there is a temp at base2, rregx, which is inconvenient to get at.
           So we create an entry for just that. }
         getint(ti, ip^.i);
         ti^.base := ip^.base2; { copy parameters }
         ti^.rsreg := ip^.rsregx;
         genlad(ti); { load address of temp to edi }
         { note that stacked structures are rounded to words }
         emitbyt($c7); { mov ecx,size/4 }
         emitbyt($c1);
         emitint(wrdsiz(ti^.base^.size) div 4);
         { move into place, but retain the base address in edi }
         emitbyt($57); { push edi }
         emitbyt($f3); { rep }
         emitbyt($a5); { movsd }
         emitbyt($5f); { pop edi }
         putint(ti) { release temp entry }

      end;
      ilodptr: genlodso(ip, ip^.base^.size, 0); { generate load direct }
      ilodtgp: genlodtp(ip); { generate load tagged pointer direct }
      ildiint, ildichr, ildibol, ildiptr: genind(ip); { indirect fetch }
      ildirel, ildisrl: begin

         gennod(ip^.left); { resolve operand }
         if ip^.i = ildirel then emitbyt($dd) { fldd [r] }
         else emitbyt($d9); { flds [r] }
         emitbyt($00+$00*8+sreg(ip^.rsreg))

      end;
      ildiset: begin { load set indirect }

         { For sets larger than 4 bytes, we have established temps at a higher
           level. The base entry of the node contains the type for <= 4, or a
           temp if > 4 }
         if ip^.base^.size <= regsiz then genind(ip) { registerable, process load }
         else begin { load to designated temp }

            { The register allocation pass has given us esi, edi, and ecx for
              the move. The temp is in the base. }
            gennod(ip^.left); { resolve operand to esi }
            genlad(ip); { load address of temp to edi }
            emitbyt($c7); { mov ecx,size/4 }
            emitbyt($c1);
            emitint(wrdsiz(ip^.base^.size) div 4);
            { move into place, but retain the base address in edi }
            emitbyt($57); { push edi }
            emitbyt($f3); { rep }
            emitbyt($a5); { movsd }
            emitbyt($5f) { pop edi }
            
         end

      end;
      ildisrc: begin { load structure indirect }

         { The register allocation pass has given us esi, edi, and ecx for
           the move  }
         gennod(ip^.left); { resolve operand to esi }
         genlad(ip); { load address of temp to edi }
         { note that stacked structures are rounded to words }
         emitbyt($c7); { mov ecx,size/4 }
         emitbyt($c1);
         emitint(wrdsiz(ip^.base^.size) div 4);
         { move into place, but retain the base address in edi }
         emitbyt($57); { push edi }
         emitbyt($f3); { rep }
         emitbyt($a5); { movsd }
         emitbyt($5f) { pop edi }

      end;
      ilditgp: begin { load tagged pointer indirect }

         { Load pointer section. Two double registers are reserved for this. }
         gennod(ip); { generate subtree }
         emitbyt($8b); { mov rr,[rl] }
         emitbyt($00+sreg(ip^.rsreg)*8+sreg(ip^.left^.rsreg));
         emitbyt($8b); { mov rr,regsiz[rl] }
         emitbyt($40+sreg(ip^.rsregx)*8+sreg(ip^.left^.rsregx));
         emitbyt(regsiz)

      end;   
      ilimint: begin { load immediate integer }

         emitbyt($c7); { mov r,imm32 }
         emitbyt($c0+$00*8+sreg(ip^.rsreg));
         emitint(consti(ip^.base))

      end;   
      ilimns: begin { load null set }

         { Null sets cannot be typeless at this level, because typeless is
           sizeless. The size is set above dependent on context.
           For sets larger than 4 bytes, we have established temps at a higher
           level. The base entry of the node contains the type for <= 4, or a
           temp if > 4 }
         if ip^.base^.size <= regsiz then begin { clear register }

            emitbyt($33); { xor r,r }
            emitbyt($c0+sreg(ip^.rsreg)*8+sreg(ip^.rsreg))

         end else begin { load to designated temp }

            { The register allocation pass has given us edi, eax, and ecx for
              the clear  }
            genlad(ip); { load address of temp to edi }
            { note that stacked sets are allways even }
            emitbyt($c7); { mov ecx,size/4 }
            emitbyt($c1);
            emitint(wrdsiz(ip^.base^.size) div 4);
            { move into place, but retain the base address in edi }
            emitbyt($33); { xor eax,eax }
            emitbyt($c0+sreg(rgeax)*8+sreg(rgeax));
            emitbyt($57); { push edi }
            emitbyt($f3); { rep }
            emitbyt($ab); { stosd }
            emitbyt($5f) { pop edi }
            
         end

      end;   
      ilodlen: ; { This simply becomes the length register, performed above }   
      inotint: begin { negate }

         gennod(ip^.left); { generate subtree }
         emitbyt($f7); { not r }
         emitbyt($c0+$02*8+sreg(ip^.rsreg))

      end;
      inotbol: begin { complement boolean }

         gennod(ip^.left); { generate subtree }
         if ip^.left^.rsreg <> rgflg then begin

            { For flag complements, this is taken care of above by placing the
              complemented flag, in the register pass. }
            emitbyt($0f); { btc r,0 }
            emitbyt($ba);
            emitbyt($c0+$07*8+sreg(ip^.rsreg));
            emitbyt($00)

         end

      end;
      isinset: begin { set single set element }

         gennod(ip^.left); { generate subtrees }
         gennod(ip^.right);
         genrchk(ip^.right, ip^.base, true); { generate bounds check and adjust }
         rm := $00; { set indirect r/m }
         if ip^.base^.size <= regsiz then rm := $c0; { set is in a register }
         emitbyt($0f); { bts rl,rr }
         emitbyt($ab);
         emitbyt(rm+sreg(ip^.right^.rsreg)*8+sreg(ip^.left^.rsreg))
         
      end;
      irngset: begin { set range of set elements }

         gennod(ip^.left); { generate subtrees }
         gennod(ip^.right);
         gennod(ip^.xtra);
         genrchk(ip^.right, ip^.base, true); { generate bounds checks and adjusts }
         rm := $00; { set indirect r/m }
         if ip^.base^.size < 4 then rm := $c0; { set is in a register }
         emitbyt($3b); { cmp rr,rx }
         emitbyt($c0+sreg(ip^.right^.rsreg)*8+sreg(ip^.xtra^.rsreg));
         emitbyt($77); { ja over }
         emitbyt(10);
         emitbyt($50+sreg(ip^.left^.rsreg)); { push rl }
         emitbyt($0f); { bts rl,rr }
         emitbyt($ab);
         emitbyt(rm+sreg(ip^.right^.rsreg)*8+sreg(ip^.left^.rsreg));
         emitbyt($40+sreg(ip^.left^.rsreg)); { inc rr }
         emitbyt($3b); { cmp rr,rx }
         emitbyt($c0+sreg(ip^.right^.rsreg)*8+sreg(ip^.xtra^.rsreg));
         emitbyt($76); { jna loop }
         emitbyt(-8);
         emitbyt($58+sreg(ip^.left^.rsreg)) { pop rl }
         
      end;  
      icvtitr: begin { convert integer to real }

         gennod(ip^.left); { generate integer }
         { we must address the integer to load it, so it is placed on stack and
           loaded from there. }
         emitbyt($50+sreg(ip^.rsreg)); { push r }
         { get address of int on stack }
         emitbyt($8b); { mov eax,esp }
         emitbyt($c0+sreg(ip^.rsreg)*8+$04);
         { load and convert to real }
         emitbyt($db); { fildd [eax] }
         emitbyt($00)

      end;
      icvtgtf: begin { convert tagged pointer to fixed }

         gennod(ip^.left); { generate subtree }
         gencmp(ip^.left, ip^.base^.size); { generate compare }
         genske($74, relenmat) { generate skip error }
         
      end;
      icvtftg: begin { convert fixed pointer to tagged }

         { all we need do is load the length into the choosen register }
         gennod(ip^.left); { generate subtree }
         emitbyt($b8+sreg(ip^.rsregx)); { mov len,size }
         emitint(ip^.base^.size) { place size }
         
      end;
      icvtntg: error(esysflt116); { this should get optimized out }   
      iintset: gensop(ip); { generate set operation }   
      imltrel: begin { multiply real }

         gennod(ip^.left); { generate left to sos }
         gennod(ip^.right); { generate right to tos }
         { multiply and pop top }
         emitbyt($de); { fmulp }
         emitbyt($c9)

      end;
{ ???? }
      imltint: {gendoi(ip, $0f)}; { multiply integer }
      idivrel: begin { divide real }

         gennod(ip^.left); { generate left to sos }
         gennod(ip^.right); { generate right to tos }
         { divide and pop top }
         emitbyt($de); { fdivp }
         emitbyt($f9)

      end;
      idivint: gendiv(ip); { divide integer }   
      imodint: genmod(ip); { modulo integer }
{ ???? }
      iandint: { gendoi(ip, $20)}; { generate "and" instruction }     
      inegint: begin { negate integer }

         gennod(ip^.left); { resolve operand }
         emitbyt($f7); { neg r }
         emitbyt($c0+$03*8+sreg(ip^.left^.rsreg));
         genovf { generate overflow check }

      end;
      inegrel: begin { negate real }

         gennod(ip^.left); { generate operand to tos }
         { change sign of tos }
         emitbyt($d9); { fchs }
         emitbyt($e0)

      end;
      iuniset: gensop(ip); { generate set operation }
      iaddrel: begin { add real }

         gennod(ip^.left); { generate left to sos }
         gennod(ip^.right); { generate right to tos }
         { add and pop top }
         emitbyt($de); { faddp }
         emitbyt($c1)

      end;
{ ???? }
      iaddint: { gendoi(ip, $00)}; { generate add instruction }
      idifset: gensop(ip); { generate set operation }
      isubrel: begin { subtract real }

         gennod(ip^.left); { generate left to sos }
         gennod(ip^.right); { generate right to tos }
         { subtract and pop top }
         emitbyt($de); { fsubrp }
         emitbyt($e1)

      end;
{ ???? }
      isubint: {gendoi(ip, $28)}; { generate subtract instruction }   
{ ???? }
      iorint:  { gendoi(ip, $08)}; { generate "or" instruction }   
{ ???? }
      ixorint: {gendoi(ip, $30)}; { generate "xor" instruction }
      iincset: begin { test set inclusion }

         gennod(ip^.left); { generate subtrees }
         gennod(ip^.right);
